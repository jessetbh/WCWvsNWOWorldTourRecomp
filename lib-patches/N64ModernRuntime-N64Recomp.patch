+#ifndef __RECOMP_CONSTANT_RA_H__
+#define __RECOMP_CONSTANT_RA_H__
+
+#include <cstdint>
+
+namespace N64Recomp {
+    // [wcw fullconv] A hack's "fake return address": `lui $ra, %hi(T)` + `addiu/ori $ra, $ra, %lo(T)`, then a `jr $ra`
+    // that on the N64 jumps to T (the middle of a stock function, whose own epilogue then returns). The live
+    // recompiler compiles every `jr $ra` as a host return, which instead went back into the function that jumped to
+    // the hook, and that function then returned without its epilogue: its frame stayed on the stack and the caller got
+    // garbage callee-saved registers (No Mercy Plus V3, Jericho's entrance: payload 0x804715EC sets ra = 0x8010F8FC
+    // and its jr ra at 0x80471634 returns into ovl_b 0x8010F794; the main loop's s2 came back 0 and the game crashed).
+    //
+    // The compiled code notes T when it builds it (constant_ra_pair at compile time, note_constant_ra at run time,
+    // only when $ra really holds T then), with the host frame of the function that built it. A `jr $ra` in that same
+    // frame takes the note (take_constant_ra): with $ra still T it is a jump to T (a tail call through the lookup),
+    // otherwise a plain return; either way the note is gone. Tail calls keep the frame (the live generator compiles
+    // them as SLJIT_CALL_RETURN, and every compiled function has the same frame size), so the hack's `j` from the
+    // function that built T to the one that does the jr ra still matches. Calls (jal) don't write $ra here, so a
+    // jr ra in a function called from there (a deeper frame) still sees T: it is a real return and leaves the note
+    // alone. A jr ra in a shallower frame means the frame that built T has returned without its jr ra: the note is
+    // dropped, so it can't redirect a later, unrelated return.
+
+    // prev, cur: two consecutive instruction words (host order). True, with the value, when prev is `lui $ra, hi`
+    // and cur is `addiu $ra, $ra, lo` or `ori $ra, $ra, lo` building a KSEG0 code address.
+    inline bool constant_ra_pair(uint32_t prev, uint32_t cur, uint32_t& value) {
+        constexpr uint32_t ra = 31;
+        if ((prev >> 26) != 0x0F || ((prev >> 16) & 31) != ra || ((prev >> 21) & 31) != 0) {
+            return false;
+        }
+        const uint32_t op = cur >> 26, rs = (cur >> 21) & 31, rt = (cur >> 16) & 31, imm = cur & 0xFFFF;
+        if (rs != ra || rt != ra) {
+            return false;
+        }
+        const uint32_t hi = (prev & 0xFFFF) << 16;
+        uint32_t v;
+        if (op == 0x09) {           // addiu
+            v = hi + (uint32_t)(int32_t)(int16_t)imm;
+        }
+        else if (op == 0x0D) {      // ori
+            v = hi | imm;
+        }
+        else {
+            return false;
+        }
+        if (v < 0x80000000u || v >= 0x80800000u || (v & 3) != 0) {
+            return false;
+        }
+        value = v;
+        return true;
+    }
+
+    struct ConstantRa {
+        uint32_t value = 0;
+        uintptr_t frame = 0;   // host frame (the live function's local base) that built it
+        bool armed = false;
+    };
+
+    inline void note_constant_ra(ConstantRa& s, uint32_t ra, uintptr_t frame) {
+        s.value = ra;
+        s.frame = frame;
+        s.armed = true;
+    }
+
+    // At a `jr $ra` (ra: its low 32 bits; frame: the host frame running it; the stack grows down): true when it
+    // jumps to the noted constant.
+    inline bool take_constant_ra(ConstantRa& s, uint32_t ra, uintptr_t frame) {
+        if (!s.armed || frame < s.frame) {
+            return false;       // nothing noted, or a function called from the noting one returning: a real return
+        }
+        const bool hit = frame == s.frame && s.value == ra;
+        s.armed = false;
+        return hit;
+    }
+}
+
+#endif
