@@ -0,0 +1,50 @@
+//
+// N64ModernRuntime (librecomp)
+//
+
+// [wcw] When the stall watchdog dumps (aki-roadmap#187). Pure logic, unit tested; the dump itself is stall_watchdog.cpp.
+
+#ifndef __LIBRECOMP_STALL_RULES_HPP__
+#define __LIBRECOMP_STALL_RULES_HPP__
+
+#include <cstdint>
+
+namespace recomp::stall {
+    // Dumps per stall, at this many times the first threshold: a thread that's moved on between them isn't the cause.
+    constexpr double DumpMultiples[] = { 1.0, 3.0, 12.0 };
+    constexpr int MaxDumpsPerRun = 12; // a game with long legitimate waits can't fill the log
+
+    enum class Event {
+        None,
+        Dump,    // stalled_for() has reached the next dump time
+        Resumed, // frames came back after at least one dump: that stall was a wait, not a freeze
+    };
+
+    class Detector {
+    public:
+        explicit Detector(double first_dump_s) : first_dump_s(first_dump_s) {}
+
+        // frames: a counter that rises while the game makes frames. Nothing counts until it has moved once (boot).
+        Event update(double now_s, uint64_t frames);
+
+        double stalled_for() const { return stalled_s; }
+        int dumps_this_stall() const { return stall_dumps; }
+
+    private:
+        double first_dump_s;
+        double last_change_s = 0;
+        double stalled_s = 0;
+        uint64_t last_frames = 0;
+        bool started = false;
+        int stall_dumps = 0;
+        int run_dumps = 0;
+    };
+
+    // WCW_STALL_DUMP's value: seconds to the first dump, 0 for off (unset, unparsable, zero or negative).
+    double parse_threshold(const char *env);
+
+    // Runtime half (stall_watchdog.cpp): starts the watchdog thread if WCW_STALL_DUMP is set.
+    void start_watchdog(uint8_t *rdram);
+}
+
+#endif
diff --git a/librecomp/include/librecomp/startup_shutdown.hpp b/librecomp/include/librecomp/startup_shutdown.hpp
new file mode 100644
index 0000000..26e3a4a
--- /dev/null
+++ b/librecomp/include/librecomp/startup_shutdown.hpp
@@ -0,0 +1,42 @@
+#ifndef __LIBRECOMP_STARTUP_SHUTDOWN_HPP__
+#define __LIBRECOMP_STARTUP_SHUTDOWN_HPP__
+
+#include <atomic>
+
+namespace recomp {
+    // [wcw fix] jessetbh/aki-roadmap#73. A quit (WCW_QUIT_AFTER, or closing the window
+    // before a game is picked) can land while the game start thread is still in
+    // ultramodern::preinit, which waits for the gfx thread to create the renderer. On
+    // Windows that creation touches the main thread's window (RT64's
+    // ApplicationWindow::setFullScreen calls SetWindowLongPtr), which only completes once
+    // the main thread processes window messages. recomp::start used to stop pumping as
+    // soon as `exited` was set and then block joining the game thread: a deadlock.
+    //
+    // Keep calling pump() until startup_done is true, then return. Shutdown proceeds as
+    // before afterwards, so a quit after startup behaves exactly as it used to.
+    template <typename Pump, typename Sleep>
+    void pump_until_startup_done(const std::atomic_bool& startup_done, Pump&& pump, Sleep&& sleep) {
+        while (!startup_done.load()) {
+            sleep();
+            pump();
+        }
+    }
+
+    // [wcw fix] jessetbh/aki-roadmap#252. The end of recomp::start, after the game threads were
+    // asked to park and the host threads (events, timer, saving: the last save is flushed) have
+    // stopped. All parked: free rdram and return to main as before. A game thread still running
+    // (a busy loop that never makes another OS call, e.g. a hung conversion): returning would let
+    // main exit and run the process's static destructors under that thread, which then faults
+    // on freed state (an access violation at a small address after "recomp::start returned").
+    // End the process right here instead, with the exit code of a normal quit.
+    template <typename FreeRdram, typename EndProcess>
+    void finish_shutdown(bool game_threads_parked, FreeRdram&& free_rdram, EndProcess&& end_process) {
+        if (!game_threads_parked) {
+            end_process();
+            return;
+        }
+        free_rdram();
+    }
+}
+
+#endif
diff --git a/librecomp/src/ai.cpp b/librecomp/src/ai.cpp
index 0195f2b..f5c4a50 100644
--- a/librecomp/src/ai.cpp
+++ b/librecomp/src/ai.cpp
@@ -6,24 +6,49 @@
 
 #define VI_NTSC_CLOCK 48681812
 
+// [wcw2k] Hardware-accurate osAiSetFrequency return, opt-in per project (default off =
+// WT/Revenge unchanged). On console the AI quantizes the rate through the DAC divisor
+// and osAiSetFrequency RETURNS the actual rate (28800 -> dacRate 1690 -> 28805); AKI
+// audio init sizes its heap allocations from that return value. Returning the requested
+// rate unquantized shrinks WM2000's audio DMA buffers by a few samples each, shifting
+// every subsequent audio-heap allocation ~0xA0-0x140 LOW — low enough that the audio
+// manager's scheduler-client node lands INSIDE thread 6's linker-fixed boot stack
+// (top 0x800839A0). The scheduler then writes message values over the stack slot
+// where the transition chain saved s0 -> thread 6 restores s0=1 -> deterministic crash
+// in func_800222D8 entering gameplay (boots 48-54, session-5 part 5).
+bool wcw_ai_accurate_freq = false;
+
 extern "C" void osAiSetFrequency_recomp(uint8_t* rdram, recomp_context* ctx) {
     uint32_t freq = ctx->r4;
-    // This makes actual audio frequency more accurate to console, but may not be desirable
-    //uint32_t dacRate = (uint32_t)(((float)VI_NTSC_CLOCK / freq) + 0.5f);
-    //freq = VI_NTSC_CLOCK / dacRate;
+    if (wcw_ai_accurate_freq) {
+        uint32_t dacRate = (uint32_t)(((float)VI_NTSC_CLOCK / freq) + 0.5f);
+        freq = VI_NTSC_CLOCK / dacRate;
+        fprintf(stderr, "[wcw][ai] osAiSetFrequency(%u) -> %u (dacRate %u)\n", (unsigned)ctx->r4, freq, dacRate);
+    }
     ctx->r2 = freq;
     ultramodern::set_audio_frequency(freq);
 }
 
 extern "C" void osAiSetNextBuffer_recomp(uint8_t* rdram, recomp_context* ctx) {
+    // [wcw] totals every 64 calls to see whether the audio driver still feeds buffers late in a run
+    { static int n = 0; static const bool wcwTrace = getenv("WCW_TRACE") != nullptr; if (wcwTrace && (n++ % 64) == 0) fprintf(stderr, "[wcw][ai] osAiSetNextBuffer #%d len=0x%X\n", n - 1, (unsigned)ctx->r5); }
     ultramodern::queue_audio_buffer(rdram, ctx->r4, ctx->r5);
     ctx->r2 = 0;
 }
 
 extern "C" void osAiGetLength_recomp(uint8_t* rdram, recomp_context* ctx) {
     ctx->r2 = ultramodern::get_remaining_audio_bytes();
+    { static int n = 0; static const bool wcwTrace = getenv("WCW_TRACE") != nullptr; if (wcwTrace && (n++ % 256) == 0) fprintf(stderr, "[wcw][ai] osAiGetLength #%d -> 0x%X\n", n - 1, (unsigned)ctx->r2); }
 }
 
 extern "C" void osAiGetStatus_recomp(uint8_t* rdram, recomp_context* ctx) {
-    ctx->r2 = 0x00000000; // Pretend the audio DMAs finish instantly
+    // [wcw2k] Report AI_STATUS_FULL|AI_STATUS_DMA_BUSY while the host queue is backlogged
+    // so the game's own FULL-wait loop paces generation (it blocks on its frame message, so
+    // this never spins). Previously hardcoded 0 ("DMAs finish instantly"), which disabled
+    // WM2000's only audio throttle.
+    bool full = ultramodern::is_audio_backlogged();
+    ctx->r2 = full ? 0xC0000000 : 0x00000000;
+    { static int n = 0, fulls = 0; if (full) fulls++;
+      static const bool wcwTrace = getenv("WCW_TRACE") != nullptr;
+      if (wcwTrace && (n++ % 4096) == 0) fprintf(stderr, "[wcw][ai] osAiGetStatus #%d fulls=%d\n", n - 1, fulls); }
 }
diff --git a/librecomp/src/bundled_packs.cpp b/librecomp/src/bundled_packs.cpp
new file mode 100644
index 0000000..29bac66
--- /dev/null
+++ b/librecomp/src/bundled_packs.cpp
@@ -0,0 +1,141 @@
+// [wcw] Installs the bundled model packs (see bundled_packs.hpp): the file work around the pure rules.
+
+#include "librecomp/bundled_packs.hpp"
+
+#include <cstdio>
+#include <fstream>
+#include <iterator>
+#include <system_error>
+
+namespace recomp::mods::bundled_packs {
+    namespace fs = std::filesystem;
+
+    static std::string read_file(const fs::path &path) {
+        std::ifstream f(path, std::ios::binary);
+        return std::string((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>());
+    }
+
+    // A pack folder's files as (relative '/' path, contents). A walk error ends the walk (the hash then won't match).
+    static std::vector<std::pair<std::string, std::string>> read_pack(const fs::path &folder) {
+        std::vector<std::pair<std::string, std::string>> files;
+        std::error_code ec;
+        for (fs::recursive_directory_iterator it(folder, ec), end; !ec && it != end; it.increment(ec)) {
+            std::error_code file_ec;
+            if (!it->is_regular_file(file_ec)) {
+                continue;
+            }
+            const std::u8string rel = it->path().lexically_relative(folder).generic_u8string();
+            files.emplace_back(std::string(rel.begin(), rel.end()), read_file(it->path()));
+        }
+        return files;
+    }
+
+    // Copies src into dst via a temporary folder; replacing: the old copy moves aside first and comes back on failure.
+    static bool copy_pack(const fs::path &src, const fs::path &dst, bool replace, std::error_code &ec) {
+        fs::path temp = dst;
+        temp += ".installing";
+        fs::path old = dst;
+        old += ".replaced";
+        std::error_code cleanup;
+        fs::remove_all(temp, cleanup);
+        fs::copy(src, temp, fs::copy_options::recursive, ec);
+        if (ec) {
+            fs::remove_all(temp, cleanup);
+            return false;
+        }
+        if (replace) {
+            fs::remove_all(old, cleanup);
+            fs::rename(dst, old, ec);
+            if (ec) {
+                fs::remove_all(temp, cleanup);
+                return false;
+            }
+        }
+        fs::rename(temp, dst, ec);
+        if (ec) {
+            fs::remove_all(temp, cleanup);
+            if (replace) {
+                fs::rename(old, dst, cleanup);   // the player keeps the copy they had
+            }
+            return false;
+        }
+        if (replace) {
+            fs::remove_all(old, cleanup);
+        }
+        return true;
+    }
+
+    void install(const fs::path &src, const fs::path &dst) {
+        std::error_code ec;
+        if (!fs::is_directory(src, ec)) {
+            return;
+        }
+        fs::create_directories(dst, ec);
+        const fs::path record_path = dst / RecordFile;
+        std::set<std::string> record = parse_record(read_file(record_path));
+        const std::map<std::string, std::vector<uint64_t>> history = parse_history(read_file(src / HistoryFile));
+        bool record_changed = false;
+
+        std::error_code walk_ec;
+        for (fs::directory_iterator it(src, walk_ec), end; !walk_ec && it != end; it.increment(walk_ec)) {
+            const fs::directory_entry &entry = *it;
+            const std::string name = entry.path().filename().string();
+            const fs::path target = dst / entry.path().filename();
+            std::error_code entry_ec;
+            if (entry.is_regular_file(entry_ec)) {
+                if (name == "CREDITS.md" && (!fs::exists(target, entry_ec) || read_file(target) != read_file(entry.path()))) {
+                    fs::copy_file(entry.path(), target, fs::copy_options::overwrite_existing, entry_ec);
+                }
+                continue;
+            }
+            if (!entry.is_directory(entry_ec) || entry.path().extension() != ".akimodel") {
+                continue;
+            }
+
+            // A replace cut short between its two renames leaves the copy under .replaced: put it back first, or the
+            // pack would count as deleted by the player.
+            fs::path replaced = target;
+            replaced += ".replaced";
+            if (!fs::exists(target, entry_ec) && fs::is_directory(replaced, entry_ec)) {
+                fs::rename(replaced, target, entry_ec);
+                fprintf(stderr, "[wcw] bundled model pack %s: restored from an interrupted update%s\n", name.c_str(),
+                    entry_ec ? " (failed)" : "");
+            }
+
+            const uint64_t bundled_hash = pack_hash(read_pack(entry.path()));
+            const std::string bundled_version = pack_version(read_file(entry.path() / "pack.json"));
+            Installed installed;
+            installed.recorded = record.count(name) != 0;
+            installed.present = fs::exists(target, entry_ec);
+            if (installed.present) {
+                installed.hash = pack_hash(read_pack(target));
+                installed.version = pack_version(read_file(target / "pack.json"));
+            }
+            const std::string id = name.substr(0, name.size() - std::string(".akimodel").size());
+            const auto hist = history.find(id);
+            const Action action = decide(installed, bundled_hash, bundled_version,
+                (hist != history.end()) ? hist->second : std::vector<uint64_t>{});
+
+            if (action == Action::Install || action == Action::Replace) {
+                std::error_code copy_ec;
+                const bool ok = copy_pack(entry.path(), target, action == Action::Replace, copy_ec);
+                fprintf(stderr, "[wcw] bundled model pack %s: %s%s\n", name.c_str(),
+                    ok ? (action == Action::Replace ? "updated to " : "installed ") : "",
+                    ok ? (bundled_version.empty() ? "" : bundled_version.c_str()) : copy_ec.message().c_str());
+                if (ok && !installed.recorded) {
+                    record.insert(name);
+                    record_changed = true;
+                }
+            }
+            else if (action == Action::Keep && !installed.recorded) {
+                record.insert(name);   // the player's own pack of that name, or one already up to date: never touched
+                record_changed = true;
+            }
+        }
+
+        if (record_changed) {
+            std::ofstream out(record_path, std::ios::binary | std::ios::trunc);
+            out << format_record(record);
+        }
+    }
+}
diff --git a/librecomp/src/bundled_packs_rules.cpp b/librecomp/src/bundled_packs_rules.cpp
new file mode 100644
index 0000000..f9705f4
--- /dev/null
+++ b/librecomp/src/bundled_packs_rules.cpp
@@ -0,0 +1,168 @@
+#include "librecomp/bundled_packs.hpp"
+
+#include <algorithm>
+#include <cctype>
+#include <cstdio>
+
+#include "json/json.hpp"
+
+namespace recomp::mods::bundled_packs {
+    bool is_text_file(const std::string &path) {
+        // The extension as Python's os.path.splitext sees it: leading dots of the file name don't start one.
+        const size_t slash = path.find_last_of('/');
+        std::string name = (slash == std::string::npos) ? path : path.substr(slash + 1);
+        const size_t first = name.find_first_not_of('.');
+        if (first == std::string::npos) {
+            return false;
+        }
+        const size_t dot = name.find_last_of('.');
+        if (dot == std::string::npos || dot < first) {
+            return false;
+        }
+        std::string ext = name.substr(dot);
+        std::transform(ext.begin(), ext.end(), ext.begin(), [](unsigned char c) { return char(std::tolower(c)); });
+        return ext == ".json" || ext == ".md" || ext == ".txt";
+    }
+
+    uint64_t pack_hash(std::vector<std::pair<std::string, std::string>> files) {
+        std::sort(files.begin(), files.end(), [](const auto &a, const auto &b) { return a.first < b.first; });
+        uint64_t h = 14695981039346656037ULL;
+        auto feed = [&h](unsigned char byte) {
+            h ^= byte;
+            h *= 1099511628211ULL;
+        };
+        for (const auto &file : files) {
+            for (unsigned char c : file.first) {
+                feed(c);
+            }
+            feed(0);
+            const bool text = is_text_file(file.first);
+            const std::string &data = file.second;
+            for (size_t i = 0; i < data.size(); i++) {
+                if (text && data[i] == '\r' && (i + 1) < data.size() && data[i + 1] == '\n') {
+                    continue;   // CRLF counts as LF
+                }
+                feed(static_cast<unsigned char>(data[i]));
+            }
+            feed(0);
+        }
+        return h;
+    }
+
+    std::string hash_hex(uint64_t hash) {
+        char buf[17];
+        std::snprintf(buf, sizeof(buf), "%016llx", static_cast<unsigned long long>(hash));
+        return buf;
+    }
+
+    int compare_versions(const std::string &a, const std::string &b) {
+        size_t i = 0, j = 0;
+        while (i < a.size() || j < b.size()) {
+            auto part = [](const std::string &s, size_t &pos) {
+                unsigned long long v = 0;
+                bool digits = true;
+                const size_t start = pos;
+                while (pos < s.size() && s[pos] != '.') {
+                    if (s[pos] < '0' || s[pos] > '9') {
+                        digits = false;
+                    }
+                    else if (digits && v < 1000000000ULL) {
+                        v = v * 10 + unsigned(s[pos] - '0');
+                    }
+                    pos++;
+                }
+                if (pos < s.size()) {
+                    pos++;   // the '.'
+                }
+                return (digits && pos > start) ? v : 0ULL;
+            };
+            const unsigned long long x = part(a, i);
+            const unsigned long long y = part(b, j);
+            if (x != y) {
+                return (x < y) ? -1 : 1;
+            }
+        }
+        return 0;
+    }
+
+    std::string pack_version(const std::string &pack_json_text) {
+        const nlohmann::json j = nlohmann::json::parse(pack_json_text, nullptr, false);
+        if (j.is_discarded() || !j.is_object()) {
+            return {};
+        }
+        const auto it = j.find("version");
+        return (it != j.end() && it->is_string()) ? it->get<std::string>() : std::string();
+    }
+
+    Action decide(const Installed &installed, uint64_t bundled_hash, const std::string &bundled_version,
+        const std::vector<uint64_t> &earlier_hashes) {
+        if (!installed.present) {
+            return installed.recorded ? Action::Skip : Action::Install;
+        }
+        if (installed.hash == bundled_hash) {
+            return Action::Keep;
+        }
+        const bool earlier_bundle = std::find(earlier_hashes.begin(), earlier_hashes.end(), installed.hash) != earlier_hashes.end();
+        if (earlier_bundle && compare_versions(installed.version, bundled_version) < 0) {
+            return Action::Replace;
+        }
+        return Action::Keep;
+    }
+
+    std::set<std::string> parse_record(const std::string &text) {
+        std::set<std::string> out;
+        size_t start = 0;
+        while (start <= text.size()) {
+            size_t end = text.find('\n', start);
+            if (end == std::string::npos) {
+                end = text.size();
+            }
+            std::string line = text.substr(start, end - start);
+            while (!line.empty() && (line.back() == '\r' || line.back() == ' ' || line.back() == '\t')) {
+                line.pop_back();
+            }
+            if (!line.empty()) {
+                out.insert(line);
+            }
+            start = end + 1;
+        }
+        return out;
+    }
+
+    std::string format_record(const std::set<std::string> &names) {
+        std::string out;
+        for (const std::string &n : names) {
+            out += n;
+            out += '\n';
+        }
+        return out;
+    }
+
+    std::map<std::string, std::vector<uint64_t>> parse_history(const std::string &json_text) {
+        std::map<std::string, std::vector<uint64_t>> out;
+        const nlohmann::json j = nlohmann::json::parse(json_text, nullptr, false);
+        if (j.is_discarded() || !j.is_object()) {
+            return out;
+        }
+        const auto prev = j.find("previous");
+        if (prev == j.end() || !prev->is_object()) {
+            return out;
+        }
+        for (const auto &[id, list] : prev->items()) {
+            if (!list.is_array()) {
+                continue;
+            }
+            for (const auto &h : list) {
+                if (!h.is_string()) {
+                    continue;
+                }
+                const std::string s = h.get<std::string>();
+                if (s.size() != 16 || s.find_first_not_of("0123456789abcdefABCDEF") != std::string::npos) {
+                    continue;
+                }
+                out[id].push_back(std::stoull(s, nullptr, 16));
+            }
+        }
+        return out;
+    }
+}
diff --git a/librecomp/src/conversion.cpp b/librecomp/src/conversion.cpp
new file mode 100644
index 0000000..5fdec44
--- /dev/null
+++ b/librecomp/src/conversion.cpp
@@ -0,0 +1,483 @@
+// [wcw fullconv] The active conversion (AKI_CONVERSION): read once at the first mod scan. See conversion.hpp.
+
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <mutex>
+#include <optional>
+#include <sstream>
+
+#include "librecomp/conversion.hpp"
+#include "librecomp/conversion_codes.hpp"
+#include "librecomp/live_code_rules.hpp"
+#include "librecomp/retrace_codes_rules.hpp"
+#include "ultramodern/ultramodern.hpp"
+#include "librecomp/files.hpp"
+#include "librecomp/game.hpp"
+#include "ultramodern/error_handling.hpp"
+
+extern "C" void wcw_commit_low_user_segment(uint8_t* rdram);   // recomp.cpp
+
+namespace {
+    std::mutex conversion_mutex;
+    std::optional<recomp::mods::conversion::Conversion> active;
+    std::filesystem::path active_folder;
+    std::string port_rom_revision;
+    std::string cheats_mod_id = "aki_cheats";
+
+    // The session's conversion, decided once (aki-roadmap#57): the mod scan and the save folder both use it.
+    bool session_decided = false;
+    recomp::mods::conversion::StartupChoice session_choice;
+    // A Mods-menu choice's aki.json as checked when the session was decided, so the load can't fail on a second read.
+    std::optional<recomp::mods::conversion::Conversion> session_checked;
+    std::string choice_notice; // why a Mods-menu choice couldn't run (logged at the mod scan, shown by the Mods menu)
+
+    std::string read_text(const std::filesystem::path &path) {
+        std::ifstream file(path, std::ios::binary);
+        std::stringstream ss;
+        ss << file.rdbuf();
+        return ss.str();
+    }
+}
+
+namespace {
+    // A conversion that can't run must not start the game: its saves folder or mods would silently become the
+    // player's normal ones.
+    [[noreturn]] void refuse(const std::string &message) {
+        fprintf(stderr, "[conversion] %s\n", message.c_str());
+        ultramodern::error_handling::message_box((message + "\n\nThe game will close; your normal saves were not touched.").c_str());
+        ULTRAMODERN_QUICK_EXIT();
+    }
+}
+
+namespace recomp::mods {
+    // Decides once which conversion this session runs: the launcher's AKI_CONVERSION, else the Mods-menu choice in
+    // conversions/active.txt. A choice that can't run (bad id, not installed, unreadable aki.json) is dropped: the game
+    // starts normally, active.txt is removed and the scan shows why. Called with conversion_mutex held.
+    static const conversion::StartupChoice &decide_session(const std::filesystem::path &config_path) {
+        if (session_decided) {
+            return session_choice;
+        }
+
+        session_decided = true;
+        const std::filesystem::path choice_file = config_path / conversion::Folder / conversion::ChoiceFile;
+        session_choice = conversion::choose_startup(std::getenv(conversion::EnvVar), read_text(choice_file));
+        if (!session_choice.lenient()) {
+            return session_choice;
+        }
+
+        const std::string id = session_choice.id;
+        conversion::Conversion c;
+        const std::string reason = conversion::check_choice(id, conversion::valid_id(id) ?
+            read_text(config_path / conversion::Folder / id / conversion::ManifestFile) : std::string(), c);
+        if (reason.empty()) {
+            session_checked = std::move(c);
+        }
+        else {
+            choice_notice = "The conversion chosen in the Mods menu (" + id + ") can't run: " + reason +
+                ". The game starts normally with your own saves, and the choice was cleared.";
+            std::error_code ec;
+            std::filesystem::remove(choice_file, ec);
+            session_choice = conversion::StartupChoice{};
+        }
+
+        return session_choice;
+    }
+
+    std::string session_conversion_id() {
+        std::lock_guard lock(conversion_mutex);
+        const std::filesystem::path config_path = recomp::get_config_path();
+        if (config_path.empty()) {
+            const char *env = std::getenv(conversion::EnvVar);
+            return (env != nullptr) ? std::string(env) : std::string();
+        }
+
+        return decide_session(config_path).id;
+    }
+
+    bool session_conversion_from_launcher() {
+        std::lock_guard lock(conversion_mutex);
+        const std::filesystem::path config_path = recomp::get_config_path();
+        if (config_path.empty()) {
+            const char *env = std::getenv(conversion::EnvVar);
+            return (env != nullptr) && (env[0] != '\0');
+        }
+
+        return decide_session(config_path).from_launcher;
+    }
+
+    std::string conversion_choice_notice() {
+        std::lock_guard lock(conversion_mutex);
+        return choice_notice;
+    }
+
+    std::string chosen_conversion() {
+        const std::filesystem::path config_path = recomp::get_config_path();
+        if (config_path.empty()) {
+            return {};
+        }
+
+        return conversion::choose_startup(nullptr, read_text(config_path / conversion::Folder / conversion::ChoiceFile)).id;
+    }
+
+    bool set_chosen_conversion(const std::string &id) {
+        const std::filesystem::path config_path = recomp::get_config_path();
+        if (config_path.empty() || (!id.empty() && !conversion::valid_id(id))) {
+            return false;
+        }
+
+        const std::filesystem::path folder = config_path / conversion::Folder;
+        const std::filesystem::path file = folder / conversion::ChoiceFile;
+        std::error_code ec;
+        if (id.empty()) {
+            std::filesystem::remove(file, ec);
+            return !ec;
+        }
+
+        std::filesystem::create_directories(folder, ec);
+        const std::filesystem::path temp = folder / (std::string(conversion::ChoiceFile) + ".tmp");
+        bool written;
+        {
+            std::ofstream out(temp, std::ios::binary | std::ios::trunc);
+            out << id << "\n";
+            out.close();
+            written = !out.fail();
+        }
+
+        if (written) {
+            std::filesystem::rename(temp, file, ec);
+        }
+        if (!written || ec) {
+            std::filesystem::remove(temp, ec);
+            return false;
+        }
+        return true;
+    }
+
+    std::vector<InstalledConversion> list_installed_conversions() {
+        std::vector<InstalledConversion> out;
+        const std::filesystem::path config_path = recomp::get_config_path();
+        if (config_path.empty()) {
+            return out;
+        }
+
+        std::error_code ec;
+        std::filesystem::directory_iterator it(config_path / conversion::Folder, ec);
+        for (; !ec && (it != std::filesystem::directory_iterator()); it.increment(ec)) {
+            const std::filesystem::directory_entry &entry = *it;
+            std::error_code entry_ec;
+            if (!entry.is_directory(entry_ec)) {
+                continue;
+            }
+
+            const std::u8string name8 = entry.path().filename().u8string();
+            const std::string id(reinterpret_cast<const char *>(name8.data()), name8.size());
+            if (id.empty() || (id[0] == '_') || (id[0] == '.')) {
+                continue; // _packages and hidden folders
+            }
+
+            InstalledConversion installed;
+            installed.folder = entry.path();
+            const std::string text = read_text(entry.path() / conversion::ManifestFile);
+            if (text.empty()) {
+                continue;
+            }
+
+            if (!conversion::valid_id(id)) {
+                // Listed rather than skipped, so a wrongly named folder (AEW64) doesn't just go missing.
+                installed.error = "its folder name isn't a conversion id (lowercase letters, digits, '_', '.' and '-')";
+                installed.conversion.id = id;
+                installed.conversion.name = id;
+            }
+            else if (!conversion::parse(text, id, installed.conversion, installed.error)) {
+                installed.conversion.id = id;
+                installed.conversion.name = id;
+            }
+
+            out.emplace_back(std::move(installed));
+        }
+
+        std::sort(out.begin(), out.end(), [](const InstalledConversion &a, const InstalledConversion &b) {
+            return a.conversion.name < b.conversion.name;
+        });
+        return out;
+    }
+
+    // Called by scan_mods: loads <config>/conversions/<AKI_CONVERSION>/aki.json and returns the folders whose mods the
+    // session runs (the conversion's own, plus its texture dependency package when installed). Empty: no conversion.
+    std::vector<std::filesystem::path> load_active_conversion(const std::filesystem::path &config_path) {
+        std::lock_guard lock(conversion_mutex);
+        active.reset();
+        active_folder.clear();
+        const conversion::StartupChoice &choice = decide_session(config_path);
+        if (!choice_notice.empty()) {
+            // Not a message box: the game starts normally, so nothing needs confirming before it (a modal here also
+            // held up unattended starts). The Mods menu's Conversions dialog shows it.
+            fprintf(stderr, "[conversion] %s\n", choice_notice.c_str());
+        }
+
+        const std::string id_text = choice.id;
+        const char *id = id_text.c_str();
+        if (id_text.empty()) {
+            return {};
+        }
+
+        const std::filesystem::path folder = config_path / conversion::Folder / id;
+        conversion::Conversion c;
+        if (session_checked) {
+            c = *session_checked; // a Mods-menu choice, checked by decide_session
+        }
+        else {
+            if (!conversion::valid_id(id)) {
+                refuse(std::string(conversion::EnvVar) + "=" + id + " is not a valid conversion id.");
+            }
+
+            const std::string text = read_text(folder / conversion::ManifestFile);
+            std::string error;
+            if (text.empty() || !conversion::parse(text, id, c, error)) {
+                refuse("Can't start conversion \"" + std::string(id) + "\": " + (text.empty() ? std::string("it isn't installed (no ") +
+                    (folder / conversion::ManifestFile).string() + ")" : error) + ".");
+            }
+        }
+
+        std::vector<std::filesystem::path> folders{ folder };
+        if (!c.textures_package.empty()) {
+            const std::filesystem::path package = config_path / conversion::Folder / conversion::PackagesFolder / c.textures_package;
+            std::error_code ec;
+            if (std::filesystem::is_directory(package, ec)) {
+                folders.emplace_back(package);
+            }
+            else {
+                fprintf(stderr, "[conversion] texture package %s isn't installed; running without it\n", c.textures_package.c_str());
+            }
+        }
+        if (!c.textures_dir.empty()) {
+            // An inline pack opens as a manifest-less mod folder (rt64.json at its root) from a scan of its parent.
+            const std::filesystem::path pack = folder / std::filesystem::u8path(c.textures_dir);
+            std::error_code ec;
+            if (!std::filesystem::is_directory(pack, ec)) {
+                fprintf(stderr, "[conversion] texture folder %s is missing; running without it\n", c.textures_dir.c_str());
+            }
+            else {
+                const bool legacyNames = (c.textures_naming == "rice") || (c.textures_naming == "jabo");
+                if (legacyNames && !std::filesystem::exists(pack / "rt64.json", ec)) {
+                    // A pack as its author shipped it (Rice / GLideN64 or Jabo Direct3D8 names): rt64 matches the names
+                    // at runtime, so the database needs no entries.
+                    std::ofstream out(pack / "rt64.json", std::ios::binary);
+                    out << R"({ "configuration": { "configurationVersion": 3, "hashVersion": 5, "autoPath": ")" <<
+                        ((c.textures_naming == "rice") ? "rice" : "rt64") << R"(", "defaultShift": "none" }, "textures": [] })";
+                }
+                if (pack.parent_path() != folder) {
+                    folders.emplace_back(pack.parent_path());
+                }
+            }
+        }
+
+        if (c.has_models) {
+            std::error_code ec;
+            if (!std::filesystem::is_directory(folder / std::filesystem::u8path(c.models_dir), ec)) {
+                fprintf(stderr, "[conversion] models folder %s is missing; running without models\n", c.models_dir.c_str());
+            }
+            for (const conversion::Conversion::ModelSlot &s : c.models_slots) {
+                fprintf(stderr, "[conversion] model slot: wrestler 0x%04X%s%s -> %s\n", s.wrestler, s.name.empty() ? "" : " ",
+                    s.name.c_str(), s.pack.c_str());
+            }
+        }
+
+        // aki-roadmap#242: seed saves the launcher's Install didn't copy (a conversion copied in by hand, built in place,
+        // or a test run), before the game reads its save. Never over an existing file.
+        // Once per session: the Mods menu rescans, and a save the player removed mid-session stays removed.
+        static bool seeded_once = false;
+        if (!c.seed_saves.empty() && !seeded_once) {
+            seeded_once = true;
+            const conversion::SeedReport seeded = conversion::seed_saves(c, folder, config_path / u8"saves" / std::filesystem::u8path(c.id));
+            for (const std::string &line : seeded.lines) {
+                fprintf(stderr, "[conversion] %s\n", line.c_str());
+            }
+        }
+
+        // aki-roadmap#241: the conversion's RT rig without the launcher's WCW_RT_LIGHTS_FILE (Mods-menu choice, AKI_CONVERSION
+        // by hand). rt64 reads the variable at its first ray-traced frame, after this scan.
+        const std::filesystem::path rt_lights = conversion::rt_lights_path(c, folder, std::getenv("WCW_RT_LIGHTS_FILE"));
+        std::error_code rt_ec;
+        if (!rt_lights.empty() && !std::filesystem::is_regular_file(rt_lights, rt_ec)) {
+            fprintf(stderr, "[conversion] rt lights %s are missing from the conversion; the stock rig stays\n", c.rt_lights_file.c_str());
+        }
+        else if (!rt_lights.empty()) {
+#ifdef _WIN32
+            _wputenv_s(L"WCW_RT_LIGHTS_FILE", rt_lights.wstring().c_str());
+#else
+            setenv("WCW_RT_LIGHTS_FILE", rt_lights.string().c_str(), 1);
+#endif
+            const std::u8string text = rt_lights.u8string();
+            fprintf(stderr, "[conversion] rt lights: %.*s\n", int(text.size()), reinterpret_cast<const char *>(text.data()));
+        }
+        if (!c.rt_materials_file.empty()) {
+            fprintf(stderr, "[conversion] rt materials %s ignored: this version doesn't read per-surface materials yet\n",
+                c.rt_materials_file.c_str());
+        }
+
+        fprintf(stderr, "[conversion] running %s (\"%s\"):%s%s%s%s%s%s; saves in saves/%s\n", c.id.c_str(), c.name.c_str(),
+            c.has_patch ? " patch" : "", c.has_codes ? " codes" : "", c.has_saves ? " saves" : "", c.has_textures ? " textures" : "",
+            c.has_rt ? " rt" : "", c.has_models ? " models" : "", c.id.c_str());
+        active = std::move(c);
+        active_folder = folder;
+        return folders;
+    }
+
+    const conversion::Conversion *active_conversion() {
+        std::lock_guard lock(conversion_mutex);
+        return active ? &*active : nullptr;
+    }
+
+    void set_active_conversion_models_refusal(const std::string &reason) {
+        std::lock_guard lock(conversion_mutex);
+        if (active) {
+            active->models_refusal = reason;
+        }
+    }
+
+    std::filesystem::path active_conversion_models_dir() {
+        std::lock_guard lock(conversion_mutex);
+        if (!active || !active->has_models || !active->models_refusal.empty()) {
+            return {};
+        }
+        return active_folder / std::filesystem::u8path(active->models_dir);
+    }
+
+    bool active_conversion_models_txt(std::string &out) {
+        std::lock_guard lock(conversion_mutex);
+        if (!active || !active->has_models || !active->models_refusal.empty() || !active->models_has_slots) {
+            return false;
+        }
+        out = conversion::models_txt(active->models_slots);
+        return true;
+    }
+
+    std::string active_conversion_codes() {
+        std::lock_guard lock(conversion_mutex);
+        // The codes file's own "# rom:" tag is the authority: the cheats engine refuses another game's codes and
+        // translates another revision's (AkiMods aki_cheats). The manifest's tag only feeds the launcher's notes.
+        if (!active || !active->has_codes) {
+            return {};
+        }
+
+        return read_text(active_folder / active->codes_file);
+    }
+
+    bool active_conversion_codes_runnable() {
+        std::lock_guard lock(conversion_mutex);
+        return active && active->has_codes;
+    }
+
+    std::string active_conversion_cheats_mod() {
+        std::lock_guard lock(conversion_mutex);
+        return cheats_mod_id;
+    }
+
+    void set_port_rom_revision(const std::string &tag) {
+        std::lock_guard lock(conversion_mutex);
+        port_rom_revision = tag;
+    }
+
+    void set_cheats_mod_id(const std::string &mod_id) {
+        std::lock_guard lock(conversion_mutex);
+        cheats_mod_id = mod_id;
+    }
+
+    namespace {
+        std::once_flag native_codes_once;
+        std::vector<conversion::codes::Code> native_codes;
+        bool native_codes_ready = false;
+    }
+
+    bool active_native_codes_ready() {
+        std::call_once(native_codes_once, []() {
+            std::string text = active_conversion_codes();
+            std::string port;
+            {
+                std::lock_guard lock(conversion_mutex);
+                port = port_rom_revision;
+            }
+
+            if (text.empty() || port.empty()) {
+                return;
+            }
+
+            std::string game_key;
+            int native_rev = 0;
+            conversion::codes::split_rom_tag(port, game_key, native_rev);
+            conversion::codes::Report r;
+            if (!conversion::codes::parse_file(text, game_key, native_rev, native_codes, r)) {
+                return; // another revision: the cheats mod translates those
+            }
+
+            native_codes_ready = true;
+            fprintf(stderr, "[conversion] codes: %d active (native table: %d writes, %d conditionals, %d repeaters, %zu KB of text)",
+                r.added, r.writes, r.conditionals, r.repeaters, text.size() / 1024);
+            if (r.enablers > 0) fprintf(stderr, ", %d enabler codes ignored (not needed)", r.enablers);
+            if (r.buttons > 0) fprintf(stderr, ", %d button codes (88/89) ignored", r.buttons);
+            if (r.unknown > 0) fprintf(stderr, ", %d unknown code types ignored", r.unknown);
+            if (r.malformed > 0) fprintf(stderr, ", %d malformed lines, first at line %d", r.malformed, r.first_bad_line);
+            fprintf(stderr, "\n");
+        });
+
+        return native_codes_ready;
+    }
+
+    namespace {
+        void apply_native_codes_now(uint8_t *rdram, uint32_t rdram_size, bool live_pass = true) {
+            // Packs are tested on lenient emulators, and their codes can drive the game down paths stock never takes: Some No
+            // Mercy Mod's Better Managers makes a manager act, whose target slot is 0xFFFF, and stock code then reads through a
+            // null pointer (aki-roadmap#194). As for de-relinked hacks, the low user segment reads as zero pages. Stock games,
+            // with no codes, keep faulting there.
+            static std::once_flag low_segment_once;
+            std::call_once(low_segment_once, [rdram]() { wcw_commit_low_user_segment(rdram); });
+            conversion::codes::apply(native_codes, rdram, rdram_size);
+            if (live_pass) {
+                live_codes::after_apply(native_codes, rdram, rdram_size);
+            }
+        }
+
+        // aki-roadmap#324: the codes once per VI retrace (retrace_codes_rules.hpp), on the game thread that takes the
+        // retrace message; the frame hook's call only while retraces don't come. Both run on game threads, one at a time.
+        constexpr uint32_t RetraceRdramSize = 0x800000; // 8 MB, as the frame hook passes
+        std::mutex retrace_mutex;
+        recomp::retrace_codes::FrameGate retrace_gate;
+
+        uint64_t steady_ms() {
+            return (uint64_t)std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+        }
+
+        void apply_native_codes_on_retrace(uint8_t *rdram) {
+            std::lock_guard lock(retrace_mutex);
+            // The writes only: the live-code pass (recompiling code the pack writes) stays on the frame path, once a frame,
+            // so it never holds up the scheduler thread that takes the retrace message.
+            apply_native_codes_now(rdram, RetraceRdramSize, false);
+            retrace_gate.on_retrace(steady_ms());
+            if (retrace_gate.retrace_count() == 1) {
+                fprintf(stderr, "[conversion] codes: now applied on every VI retrace message (aki-roadmap#324)\n");
+            }
+        }
+    }
+
+    void apply_active_native_codes(uint8_t *rdram, uint32_t rdram_size) {
+        if (active_native_codes_ready()) {
+            // WCW_CODES_PER_FRAME=1: the old behaviour, once a game frame only (A/B checks).
+            static const bool per_frame_only = []() { const char *v = getenv("WCW_CODES_PER_FRAME"); return (v != nullptr) && (v[0] == '1'); }();
+            static std::once_flag retrace_once;
+            if (!per_frame_only) {
+                std::call_once(retrace_once, []() { ultramodern::set_retrace_hook(&apply_native_codes_on_retrace); });
+            }
+            std::lock_guard lock(retrace_mutex);
+            if (per_frame_only || retrace_gate.frame_should_apply(steady_ms())) {
+                apply_native_codes_now(rdram, rdram_size);
+            }
+            else {
+                live_codes::after_apply(native_codes, rdram, rdram_size);   // the writes came with the retraces
+            }
+        }
+    }
+}
diff --git a/librecomp/src/conversion_codes.cpp b/librecomp/src/conversion_codes.cpp
new file mode 100644
index 0000000..e3333fd
--- /dev/null
+++ b/librecomp/src/conversion_codes.cpp
@@ -0,0 +1,248 @@
+// [wcw fullconv] Native GameShark codes table (see librecomp/conversion_codes.hpp). Pure: no runtime state, unit
+// tested in tests/wcw/conversion_tests.cpp.
+
+#include "librecomp/conversion_codes.hpp"
+
+namespace recomp::mods::conversion::codes {
+    namespace {
+        constexpr uint32_t RdramStart = 0x80000000u;
+
+        int hex_value(char c) {
+            if ((c >= '0') && (c <= '9')) return c - '0';
+            if ((c >= 'a') && (c <= 'f')) return c - 'a' + 10;
+            if ((c >= 'A') && (c <= 'F')) return c - 'A' + 10;
+            return -1;
+        }
+
+        char lower(char c) {
+            return ((c >= 'A') && (c <= 'Z')) ? char(c - 'A' + 'a') : c;
+        }
+
+        bool is_space(char c) {
+            return (c == ' ') || (c == '\t') || (c == '\r');
+        }
+
+        bool is_conditional(uint32_t type) {
+            return (type >= 0xD0) && (type <= 0xD3);
+        }
+
+        bool is_write(uint32_t type) {
+            return (type == 0x80) || (type == 0x81) || (type == 0xA0) || (type == 0xA1);
+        }
+
+        bool is_enabler(uint32_t type) {
+            return (type == 0xF0) || (type == 0xF1) || (type == 0xF6) || (type == 0xFF) || (type == 0xEE) || (type == 0xDE) ||
+                (type == 0x2A) || (type == 0x3C);
+        }
+
+        bool is_prefix(uint32_t type) {
+            return (type == 0x50) || is_conditional(type);
+        }
+
+        // The tag value: "<game>" or "<game>-rev<N>" ('-', '_' or ' ' before "rev"); nothing else after it.
+        bool parse_rom_tag(const char *p, const char *end, const std::string &game_key, Report &r) {
+            while ((p < end) && is_space(*p)) p++;
+            size_t k = 0;
+            while ((k < game_key.size()) && (p < end) && (lower(*p) == game_key[k])) { p++; k++; }
+            if (k != game_key.size()) return false;
+            if ((p < end) && ((*p == '-') || (*p == '_') || (*p == ' '))) {
+                p++;
+                if (((end - p) >= 3) && (lower(p[0]) == 'r') && (lower(p[1]) == 'e') && (lower(p[2]) == 'v')) {
+                    p += 3;
+                    while ((p < end) && is_space(*p)) p++;
+                    if ((p < end) && (*p >= '0') && (*p <= '9')) {
+                        r.rom_rev = *p - '0';
+                        p++;
+                    }
+                }
+            }
+
+            while ((p < end) && is_space(*p)) p++;
+            return p == end;
+        }
+
+        uint8_t read8(const uint8_t *rdram, uint32_t size, uint32_t addr, bool &ok) {
+            const uint32_t offset = addr - RdramStart;
+            if ((addr < RdramStart) || (offset >= size)) { ok = false; return 0; }
+            return rdram[offset ^ 3];
+        }
+
+        void write8(uint8_t *rdram, uint32_t size, uint32_t addr, uint8_t value) {
+            const uint32_t offset = addr - RdramStart;
+            if ((addr >= RdramStart) && (offset < size)) rdram[offset ^ 3] = value;
+        }
+
+        void write_value(uint8_t *rdram, uint32_t size, uint32_t type, uint32_t addr, uint32_t value) {
+            if ((type == 0x80) || (type == 0xA0)) {
+                write8(rdram, size, addr, uint8_t(value));
+            }
+            else {
+                addr &= ~1u;
+                const uint32_t offset = addr - RdramStart;
+                if ((addr >= RdramStart) && ((uint64_t(offset) + 2) <= size)) {
+                    rdram[offset ^ 3] = uint8_t(value >> 8);
+                    rdram[(offset + 1) ^ 3] = uint8_t(value);
+                }
+            }
+        }
+
+        bool condition_holds(const uint8_t *rdram, uint32_t size, const Code &c) {
+            bool ok = true;
+            uint32_t current;
+            uint32_t value = c.value;
+            if ((c.type == 0xD0) || (c.type == 0xD2)) {
+                current = read8(rdram, size, c.addr, ok);
+                value &= 0xFF;
+            }
+            else {
+                const uint32_t addr = c.addr & ~1u;
+                current = (uint32_t(read8(rdram, size, addr, ok)) << 8) | read8(rdram, size, addr + 1, ok);
+            }
+
+            if (!ok) return false;
+            return ((c.type == 0xD0) || (c.type == 0xD1)) ? (current == value) : (current != value);
+        }
+
+        size_t unit_end(const std::vector<Code> &codes, size_t i) {
+            while ((i < codes.size()) && is_prefix(codes[i].type)) i++;
+            return (i < codes.size()) ? (i + 1) : codes.size();
+        }
+    }
+
+    void split_rom_tag(const std::string &tag, std::string &game_key, int &rev) {
+        const size_t at = tag.find("-rev");
+        game_key = tag.substr(0, at);
+        rev = 0;
+        if ((at != std::string::npos) && ((at + 4) < tag.size()) && (tag[at + 4] >= '0') && (tag[at + 4] <= '9')) {
+            rev = tag[at + 4] - '0';
+        }
+    }
+
+    bool parse_file(std::string_view text, const std::string &game_key, int native_rev, std::vector<Code> &out, Report &r) {
+        out.clear();
+        r = Report();
+        const char *p = text.data();
+        const char *text_end = p + text.size();
+        if ((text.size() >= 3) && (uint8_t(p[0]) == 0xEF) && (uint8_t(p[1]) == 0xBB) && (uint8_t(p[2]) == 0xBF)) p += 3;
+
+        // The tag decides everything, so find it first (the first one counts).
+        for (const char *q = p; q < text_end;) {
+            const char *eol = q;
+            while ((eol < text_end) && (*eol != '\n')) eol++;
+            const char *a = q;
+            while ((a < eol) && is_space(*a)) a++;
+            const char *b = eol;
+            while ((b > a) && is_space(b[-1])) b--;
+            if ((a < b) && (*a == '#')) {
+                const char *t = a + 1;
+                while ((t < b) && is_space(*t)) t++;
+                if (((b - t) >= 4) && (lower(t[0]) == 'r') && (lower(t[1]) == 'o') && (lower(t[2]) == 'm') && (t[3] == ':')) {
+                    if (!parse_rom_tag(t + 4, b, game_key, r)) r.rom_mismatch = true;
+                    break;
+                }
+            }
+
+            q = (eol < text_end) ? (eol + 1) : eol;
+        }
+
+        if ((r.rom_rev >= 0) && (r.rom_rev != native_rev)) r.rom_mismatch = true;
+        if (r.rom_mismatch) return false;
+
+        int line_no = 0;
+        while (p < text_end) {
+            const char *eol = p;
+            while ((eol < text_end) && (*eol != '\n')) eol++;
+            line_no++;
+            const char *a = p;
+            while ((a < eol) && is_space(*a)) a++;
+            p = (eol < text_end) ? (eol + 1) : eol;
+
+            uint32_t word = 0;
+            int len = 0;
+            const char *c = a;
+            while ((c < eol) && (hex_value(*c) >= 0) && (len < 13)) { word = (word << 4) | uint32_t(hex_value(*c)); c++; len++; }
+            if (len < 8) continue; // comment, header, name, blank
+            bool ok = false;
+            uint32_t code = 0, value = 0;
+            if (len == 12) {
+                const char *d = a;
+                for (int i = 0; i < 8; i++) code = (code << 4) | uint32_t(hex_value(*d++));
+                for (int i = 0; i < 4; i++) value = (value << 4) | uint32_t(hex_value(*d++));
+                ok = true;
+            }
+            else if (len == 8) {
+                code = word;
+                const char *d = c;
+                int seps = 0;
+                while ((d < eol) && (is_space(*d) || (*d == ':') || (*d == '-'))) { d++; seps++; }
+                int vlen = 0;
+                while ((d < eol) && (hex_value(*d) >= 0) && (vlen < 5)) { value = (value << 4) | uint32_t(hex_value(*d)); d++; vlen++; }
+                ok = (seps > 0) && (vlen == 4);
+                c = d;
+            }
+
+            if (ok && (c < eol) && !is_space(*c) && (*c != '#') && !((*c == '/') && ((c + 1) < eol) && (c[1] == '/'))) ok = false;
+            if (!ok) {
+                const bool looks_like_code = (len >= 8) && ((c >= eol) || is_space(*c) || (*c == ':') || (*c == '-'));
+                const char *d = c;
+                while ((d < eol) && (is_space(*d) || (*d == ':') || (*d == '-'))) d++;
+                if (looks_like_code && ((d >= eol) || (hex_value(*d) >= 0))) {
+                    r.malformed++;
+                    if (r.first_bad_line == 0) r.first_bad_line = line_no;
+                }
+                continue;
+            }
+
+            const uint32_t type = code >> 24;
+            if (is_enabler(type)) { r.enablers++; continue; }
+            if ((type == 0x88) || (type == 0x89)) { r.buttons++; continue; }
+            if (!is_write(type) && !is_prefix(type)) { r.unknown++; continue; }
+            Code entry;
+            entry.type = uint8_t(type);
+            entry.addr = (type == 0x50) ? (code & 0x00FFFFFF) : (RdramStart | (code & 0x00FFFFFF));
+            entry.value = uint16_t(value);
+            out.push_back(entry);
+        }
+
+        // A trailing conditional or repeater has nothing to govern.
+        while (!out.empty() && is_prefix(out.back().type)) out.pop_back();
+        for (const Code &c : out) {
+            if (is_write(c.type)) r.writes++;
+            else if (c.type == 0x50) r.repeaters++;
+            else r.conditionals++;
+        }
+
+        r.added = int(out.size());
+        return true;
+    }
+
+    void apply(const std::vector<Code> &codes, uint8_t *rdram, uint32_t rdram_size) {
+        size_t i = 0;
+        while (i < codes.size()) {
+            const Code &c = codes[i];
+            if (is_conditional(c.type)) {
+                i = condition_holds(rdram, rdram_size, c) ? (i + 1) : unit_end(codes, i + 1);
+            }
+            else if (c.type == 0x50) {
+                if ((i + 1) >= codes.size()) break;
+                const Code &next = codes[i + 1];
+                const uint32_t count = (c.addr >> 8) & 0xFF;
+                const uint32_t step = c.addr & 0xFF;
+                if (is_write(next.type)) {
+                    for (uint32_t k = 0; k < count; k++) {
+                        write_value(rdram, rdram_size, next.type, next.addr + k * step, uint32_t(next.value) + k * c.value);
+                    }
+
+                    i += 2;
+                }
+                else {
+                    i = unit_end(codes, i + 1); // 50 before a conditional isn't a GameShark form: skip both
+                }
+            }
+            else {
+                write_value(rdram, rdram_size, c.type, c.addr, c.value);
+                i++;
+            }
+        }
+    }
+}
diff --git a/librecomp/src/conversion_rules.cpp b/librecomp/src/conversion_rules.cpp
new file mode 100644
index 0000000..b04507f
--- /dev/null
+++ b/librecomp/src/conversion_rules.cpp
@@ -0,0 +1,534 @@
+#include "librecomp/conversion.hpp"
+
+#include <algorithm>
+#include <cstdio>
+#include <system_error>
+
+#include "json/json.hpp"
+
+namespace recomp::mods::conversion {
+    bool valid_id(const std::string &id) {
+        if (id.empty() || (id.size() > 48) || (id[0] == '.') || (id[0] == '_')) {
+            return false;
+        }
+
+        for (char c : id) {
+            const bool ok = ((c >= 'a') && (c <= 'z')) || ((c >= '0') && (c <= '9')) || (c == '_') || (c == '.') || (c == '-');
+            if (!ok) {
+                return false;
+            }
+        }
+
+        return true;
+    }
+
+    namespace {
+        bool pack_id_ok(const std::string &id) {
+            if (id.empty() || (id.size() > 64) || (id[0] == '.')) {
+                return false;
+            }
+            for (char ch : id) {
+                if (!(((ch >= 'a') && (ch <= 'z')) || ((ch >= 'A') && (ch <= 'Z')) || ((ch >= '0') && (ch <= '9')) ||
+                      (ch == '_') || (ch == '-') || (ch == '.'))) {
+                    return false;
+                }
+            }
+            return true;
+        }
+
+        // "0x0404", "404" (hex, as models.txt and the roster tools write them) or a number.
+        bool wrestler_id(const nlohmann::json &v, uint32_t &out) {
+            if (v.is_number_unsigned()) {
+                out = v.get<uint32_t>();
+                return out <= 0xFFFF;
+            }
+            if (!v.is_string()) {
+                return false;
+            }
+            std::string s = v.get<std::string>();
+            if ((s.size() > 2) && (s[0] == '0') && ((s[1] == 'x') || (s[1] == 'X'))) {
+                s = s.substr(2);
+            }
+            if (s.empty() || (s.size() > 4) || (s.find_first_not_of("0123456789abcdefABCDEF") != std::string::npos)) {
+                return false;
+            }
+            out = uint32_t(std::stoul(s, nullptr, 16));
+            return true;
+        }
+
+        // components.models into c. A bad dir leaves has_models false; a bad format or slot keeps the component
+        // (the conversion still runs) with models_refusal saying why its models are off.
+        void parse_models(const nlohmann::json &models, Conversion &c) {
+            if (!models.is_object()) {
+                return;
+            }
+            c.models_dir = models.value("dir", std::string());
+            while (!c.models_dir.empty() && ((c.models_dir.back() == '/') || (c.models_dir.back() == '\\'))) {
+                c.models_dir.pop_back();
+            }
+            c.has_models = !c.models_dir.empty();
+            if (!c.has_models) {
+                return;
+            }
+            const auto format = models.find("format");
+            c.models_format = (format == models.end()) ? 1 : (format->is_number_integer() ? format->get<int>() : -1);
+            c.models_roster = models.value("roster", std::string());
+            if (c.models_format < 1) {
+                c.models_refusal = "its models component has no usable \"format\" (the model pack version, 1 to " +
+                    std::to_string(ModelsFormat) + ")";
+                return;
+            }
+            if (c.models_format > ModelsFormat) {
+                c.models_refusal = "its models are format " + std::to_string(c.models_format) + ", and this build reads up to " +
+                    std::to_string(ModelsFormat) + ": update the game";
+                return;
+            }
+            const auto slots = models.find("slots");
+            if (slots == models.end()) {
+                return;
+            }
+            c.models_has_slots = true;
+            if (!slots->is_array()) {
+                c.models_refusal = "its models \"slots\" is not a list";
+                return;
+            }
+            for (size_t i = 0; i < slots->size(); i++) {
+                const nlohmann::json &s = (*slots)[i];
+                Conversion::ModelSlot slot;
+                const auto wrestler = s.is_object() ? s.find("wrestler") : s.end();
+                const auto costume = s.is_object() ? s.find("costume") : s.end();
+                const bool ok = s.is_object() && (wrestler != s.end()) && wrestler_id(*wrestler, slot.wrestler) &&
+                    ((costume == s.end()) || (costume->is_number_integer() && (costume->get<int>() >= 0) && (costume->get<int>() < 256)));
+                slot.pack = ok ? s.value("pack", std::string()) : std::string();
+                if (!ok || !pack_id_ok(slot.pack)) {
+                    c.models_refusal = "its models slot " + std::to_string(i + 1) + " needs a wrestler id (\"0x0404\"), a pack id and "
+                        "an optional costume 0-255";
+                    c.models_slots.clear();
+                    return;
+                }
+                slot.costume = (costume == s.end()) ? -1 : costume->get<int>();
+                slot.name = s.value("name", std::string());
+                c.models_slots.push_back(std::move(slot));
+            }
+        }
+    }
+
+    std::string models_txt(const std::vector<Conversion::ModelSlot> &slots) {
+        std::string out = "# from aki.json components.models.slots\n";
+        char line[160];
+        for (const Conversion::ModelSlot &s : slots) {
+            if (s.costume >= 0) {
+                snprintf(line, sizeof(line), "%s wrestler 0x%04X costume %d\n", s.pack.c_str(), s.wrestler, s.costume);
+            }
+            else {
+                snprintf(line, sizeof(line), "%s wrestler 0x%04X\n", s.pack.c_str(), s.wrestler);
+            }
+            out += line;
+        }
+        return out;
+    }
+
+    namespace {
+    // parse() without the type guard: nlohmann's value() throws json::type_error on a value of the wrong type.
+    bool parse_manifest(const std::string &json_text, const std::string &expected_id, Conversion &out, std::string &error) {
+        using json = nlohmann::json;
+        const json root = json::parse(json_text, nullptr, false);
+        if (root.is_discarded() || !root.is_object()) {
+            error = "aki.json is not valid JSON";
+            return false;
+        }
+
+        if ((root.value("format", std::string()) != "aki-conversion") || (root.value("format_version", 0) != 1)) {
+            error = "not an aki-conversion v1 manifest";
+            return false;
+        }
+
+        Conversion c;
+        c.id = root.value("id", std::string());
+        c.name = root.value("name", c.id);
+        c.game = root.value("game", std::string());
+        if (!valid_id(c.id)) {
+            error = "invalid conversion id \"" + c.id + "\"";
+            return false;
+        }
+
+        if (!expected_id.empty() && (c.id != expected_id)) {
+            error = "aki.json id \"" + c.id + "\" doesn't match its folder \"" + expected_id + "\"";
+            return false;
+        }
+
+        const auto components = root.find("components");
+        if ((components == root.end()) || !components->is_object() || components->empty()) {
+            error = "no components";
+            return false;
+        }
+
+        // These components are objects. One written as anything else (a list, a string) is refused, not skipped:
+        // the launcher still lists it, so skipping would run the conversion without it (aki-roadmap#243).
+        for (const char *key : { "patch", "codes", "textures", "rt", "models" }) {
+            const auto it = components->find(key);
+            if ((it != components->end()) && !it->is_object()) {
+                error = std::string("components.") + key + " must be an object";
+                return false;
+            }
+        }
+        auto object = [&](const char *key) -> const json * {
+            const auto it = components->find(key);
+            return (it != components->end()) ? &*it : nullptr;
+        };
+
+        if (const json *patch = object("patch")) {
+            c.has_patch = patch->contains("file");
+        }
+
+        if (const json *codes = object("codes")) {
+            c.codes_file = codes->value("file", std::string());
+            c.codes_rom = codes->value("rom", codes->value("rom_revision", std::string()));
+            c.has_codes = !c.codes_file.empty();
+        }
+
+        if (const json *saves = object("saves")) {
+            c.has_saves = saves->is_array() && !saves->empty();
+            if (saves->is_array()) {
+                for (const json &save : *saves) {
+                    if (!save.is_object()) {
+                        continue;
+                    }
+                    const std::string file = save.value("file", std::string());
+                    if (!file.empty() && (save.value("mode", std::string("seed")) == "seed")) {
+                        c.seed_saves.push_back(file);
+                    }
+                }
+            }
+        }
+
+        if (const json *textures = object("textures")) {
+            c.textures_package = textures->value("package", std::string());
+            c.textures_dir = textures->value("dir", std::string());
+            while (!c.textures_dir.empty() && ((c.textures_dir.back() == '/') || (c.textures_dir.back() == '\\'))) {
+                c.textures_dir.pop_back();
+            }
+            c.textures_naming = textures->value("naming", std::string());
+            c.has_textures = textures->contains("file") || !c.textures_package.empty() || !c.textures_dir.empty();
+        }
+
+        if (const json *rt = object("rt")) {
+            c.rt_lights_file = rt->value("lights", std::string());
+            c.rt_materials_file = rt->value("materials", std::string());
+            c.has_rt = !c.rt_lights_file.empty() || !c.rt_materials_file.empty();
+        }
+
+        if (const json *models = object("models")) {
+            parse_models(*models, c);
+        }
+
+        if (const auto addons = root.find("addons"); addons != root.end() && addons->is_object()) {
+            const auto allow = addons->find("allow");
+            const std::string a = (allow != addons->end() && allow->is_string()) ? allow->get<std::string>() : std::string();
+            c.addons_allow = (a == "none") ? AddonsAllow::None : (a == "all") ? AddonsAllow::All : AddonsAllow::Data;
+            if (const auto mods = addons->find("mods"); mods != addons->end() && mods->is_array()) {
+                for (const json &m : *mods) {
+                    if (m.is_string()) {
+                        c.addons_mods.push_back(m.get<std::string>());
+                    }
+                }
+            }
+        }
+
+        // Paths stay inside the conversion folder.
+        for (const std::string *path : { &c.codes_file, &c.textures_dir, &c.rt_lights_file, &c.rt_materials_file, &c.models_dir, &c.models_roster }) {
+            if ((path->find("..") != std::string::npos) || (!path->empty() && ((path->front() == '/') || (path->front() == '\\') ||
+                (path->find(':') != std::string::npos)))) {
+                error = "path leaves the conversion folder: " + *path;
+                return false;
+            }
+        }
+        for (const std::string &path : c.seed_saves) {
+            if ((path.find("..") != std::string::npos) || (path.front() == '/') || (path.front() == '\\') || (path.find(':') != std::string::npos)) {
+                error = "path leaves the conversion folder: " + path;
+                return false;
+            }
+        }
+
+        if (!c.has_patch && !c.has_codes && !c.has_saves && !c.has_textures && !c.has_rt && !c.has_models) {
+            error = "no usable components";
+            return false;
+        }
+
+        out = std::move(c);
+        return true;
+    }
+    }
+
+    bool parse(const std::string &json_text, const std::string &expected_id, Conversion &out, std::string &error) {
+        // A wrongly typed value ("id": 5, "codes": { "file": 5 }) refuses the conversion like any other bad
+        // manifest. Uncaught, the exception ended the game in list_installed_conversions() (aki-roadmap#243).
+        try {
+            return parse_manifest(json_text, expected_id, out, error);
+        }
+        catch (const nlohmann::json::exception &e) {
+            error = std::string("aki.json has a value of the wrong type: ") + e.what();
+            return false;
+        }
+    }
+
+    std::string models_refusal(const std::string &relink_json) {
+        if (relink_json.empty()) {
+            return {};
+        }
+        const nlohmann::json root = nlohmann::json::parse(relink_json, nullptr, false);
+        if (root.is_discarded() || !root.is_object()) {
+            return "its patch's relink.json doesn't parse, so the memory it uses is unknown";
+        }
+        // [start, end) as KSEG0/KSEG1/physical addresses; compared physically.
+        auto overlaps = [](uint64_t start, uint64_t end) {
+            if (end <= start) {
+                return false;
+            }
+            const uint64_t ps = start & 0x1FFFFFFF;
+            const uint64_t pe = ps + (end - start);
+            return (ps < ModelsWindowEnd) && (pe > ModelsWindowStart);
+        };
+        auto number = [](const nlohmann::json &v) -> uint64_t { return v.is_number_unsigned() ? v.get<uint64_t>() : 0; };
+        uint64_t hit = 0;
+        bool found = false;
+        auto check = [&](uint64_t start, uint64_t end) {
+            if (!found && overlaps(start, end)) {
+                hit = start;
+                found = true;
+            }
+        };
+        auto list = [&](const char *key) -> const nlohmann::json & {
+            static const nlohmann::json empty = nlohmann::json::array();
+            const auto it = root.find(key);
+            return ((it != root.end()) && it->is_array()) ? *it : empty;
+        };
+        for (const char *key : { "code_ranges", "data_ranges" }) {
+            for (const nlohmann::json &r : list(key)) {
+                if (r.is_array() && (r.size() >= 2)) {
+                    check(number(r[0]), number(r[1]));
+                }
+            }
+        }
+        for (const char *key : { "preload", "zero" }) {
+            for (const nlohmann::json &r : list(key)) {
+                if (r.is_object()) {
+                    const uint64_t ram = number(r.value("ram", nlohmann::json()));
+                    check(ram, ram + number(r.value("size", nlohmann::json())));
+                }
+            }
+        }
+        if (!found) {
+            return {};
+        }
+        char address[16];
+        snprintf(address, sizeof(address), "0x%08X", uint32_t(hit));
+        return std::string("its patch uses Expansion RAM (from ") + address + "), where model packs load; custom models "
+            "in relinked conversions aren't supported yet";
+    }
+
+    std::unordered_set<std::string> session_enabled_mods(const std::vector<std::string> &conversion_mod_ids,
+        bool codes_runnable, const std::string &cheats_mod_id)
+    {
+        std::unordered_set<std::string> enabled(conversion_mod_ids.begin(), conversion_mod_ids.end());
+        if (codes_runnable && !cheats_mod_id.empty()) {
+            enabled.emplace(cheats_mod_id);
+        }
+
+        return enabled;
+    }
+
+    PlayerAddons parse_player_addons(const std::string &json_text) {
+        PlayerAddons out;
+        const nlohmann::json root = nlohmann::json::parse(json_text, nullptr, false);
+        if (root.is_discarded() || !root.is_object()) {
+            return out;
+        }
+        for (auto [key, list] : { std::pair{ "enabled", &out.enabled }, std::pair{ "disabled", &out.disabled } }) {
+            const auto it = root.find(key);
+            if (it == root.end() || !it->is_array()) {
+                continue;
+            }
+            for (const nlohmann::json &v : *it) {
+                if (v.is_string()) {
+                    list->push_back(v.get<std::string>());
+                }
+            }
+        }
+        return out;
+    }
+
+    std::unordered_set<std::string> session_enabled_mods(const std::vector<std::string> &conversion_mod_ids,
+        bool codes_runnable, const std::string &cheats_mod_id, const std::vector<PlayerMod> &player_mods,
+        const Conversion &conversion, const PlayerAddons &player, std::vector<std::string> *why)
+    {
+        std::unordered_set<std::string> enabled = session_enabled_mods(conversion_mod_ids, codes_runnable, cheats_mod_id);
+        // aki-roadmap#226: the model import mod is part of a conversion with usable models, as the cheats engine is of
+        // one with codes. Refused models (models_refusal) leave it to the add-on rules below.
+        const bool models_on = conversion.has_models && conversion.models_refusal.empty();
+        if (models_on) {
+            enabled.emplace(ModelsModId);
+        }
+        auto listed = [](const std::vector<std::string> &list, const std::string &id) {
+            return std::find(list.begin(), list.end(), id) != list.end();
+        };
+        auto note = [&](const PlayerMod &m, bool on, const char *reason) {
+            if (why) {
+                why->push_back(m.id + ": " + (on ? "on" : "off") + " (" + reason + ")");
+            }
+        };
+        for (const PlayerMod &m : player_mods) {
+            if (enabled.contains(m.id)) {
+                if (models_on && (m.id == ModelsModId)) {
+                    note(m, true, "model import: the conversion has models");
+                }
+                continue;   // the conversion's own, the cheats engine for its codes, or model import for its models
+            }
+            bool on = false;
+            const char *reason;
+            if (m.rom_patch) {
+                reason = "another ROM hack: only the conversion's own patch runs";
+            }
+            else if (listed(player.disabled, m.id)) {
+                reason = "you turned it off for this conversion";
+            }
+            else if (listed(player.enabled, m.id)) {
+                on = true;
+                reason = "you turned it on for this conversion";
+            }
+            else if (!m.enabled) {
+                reason = "not enabled";
+            }
+            else if (conversion.addons_allow == AddonsAllow::None) {
+                reason = "this conversion runs no add-ons";
+            }
+            else if (m.id == cheats_mod_id) {
+                reason = "cheats engine: the conversion has no codes for it (turn it on for this conversion to use your own)";
+            }
+            else if (!m.code) {
+                on = true;
+                reason = "data pack";
+            }
+            else if (conversion.addons_allow == AddonsAllow::All || listed(conversion.addons_mods, m.id)) {
+                on = true;
+                reason = "code add-on this conversion allows";
+            }
+            else {
+                reason = "code add-on this conversion doesn't list";
+            }
+            if (on) {
+                enabled.insert(m.id);
+            }
+            note(m, on, reason);
+        }
+        return enabled;
+    }
+
+    StartupChoice choose_startup(const char *env_value, const std::string &choice_file_text) {
+        StartupChoice choice;
+        if ((env_value != nullptr) && (env_value[0] != '\0')) {
+            choice.id = env_value;
+            choice.from_launcher = true;
+            return choice;
+        }
+
+        const std::string line = choice_file_text.substr(0, choice_file_text.find_first_of("\r\n"));
+        const size_t first = line.find_first_not_of(" \t");
+        const size_t last = line.find_last_not_of(" \t");
+        choice.id = (first == std::string::npos) ? std::string() : line.substr(first, last - first + 1);
+        return choice;
+    }
+
+    std::string check_choice(const std::string &id, const std::string &manifest_text, Conversion &out) {
+        if (!valid_id(id)) {
+            return "\"" + id + "\" is not a valid conversion id";
+        }
+        if (manifest_text.empty()) {
+            return "it isn't installed any more";
+        }
+
+        std::string error;
+        if (!parse(manifest_text, id, out, error)) {
+            return error;
+        }
+        return {};
+    }
+
+    bool resolve_save_subfolder(const char *env_value, const std::string &patch_mod_id, std::string &out) {
+        if ((env_value == nullptr) || (env_value[0] == '\0')) {
+            out = patch_mod_id;
+            return true;
+        }
+
+        if (!valid_id(env_value)) {
+            out.clear();
+            return false;
+        }
+
+        out = env_value;
+        return true;
+    }
+
+    std::filesystem::path rt_lights_path(const Conversion &c, const std::filesystem::path &folder, const char *env_value) {
+        if (c.rt_lights_file.empty() || ((env_value != nullptr) && (env_value[0] != 0))) {
+            return {};
+        }
+        return folder / std::filesystem::u8path(c.rt_lights_file);
+    }
+
+    SeedReport seed_saves(const Conversion &c, const std::filesystem::path &folder, const std::filesystem::path &saves_folder) {
+        SeedReport r;
+        for (const std::string &file : c.seed_saves) {
+            const std::filesystem::path from = folder / std::filesystem::u8path(file);
+            const std::filesystem::path name = from.filename();
+            std::error_code ec;
+            if (name.empty()) {
+                r.failed++;
+                r.lines.push_back("seed save " + file + " names no file; skipped");
+                continue;
+            }
+
+            const std::u8string name8 = name.u8string();
+            const std::string name_text(reinterpret_cast<const char *>(name8.data()), name8.size());
+            const std::filesystem::path to = saves_folder / name;
+            if (std::filesystem::exists(to, ec)) {
+                r.kept++;
+                r.lines.push_back("save " + file + ": kept the existing saves/" + c.id + "/" + name_text);
+                continue;
+            }
+            if (!std::filesystem::is_regular_file(from, ec)) {
+                r.failed++;
+                r.lines.push_back("seed save " + file + " is missing from the conversion; the game starts without it");
+                continue;
+            }
+
+            // Copied beside it first, so a failed copy never leaves a half save the game would then read.
+            std::filesystem::create_directories(saves_folder, ec);
+            const std::filesystem::path temp = saves_folder / (name8 + u8".seed-tmp");
+            std::filesystem::remove(temp, ec);
+            ec.clear();
+            std::filesystem::copy_file(from, temp, ec);
+            if (!ec) {
+                std::filesystem::rename(temp, to, ec);
+            }
+            if (ec) {
+                std::error_code ignored;
+                std::filesystem::remove(temp, ignored);
+                r.failed++;
+                r.lines.push_back("seed save " + file + " couldn't be copied: " + ec.message());
+                continue;
+            }
+            r.seeded++;
+            r.lines.push_back("seeded saves/" + c.id + "/" + name_text + " from " + file);
+        }
+        return r;
+    }
+
+    bool codes_runnable(const std::string &codes_rom, const std::string &port_rom) {
+        // Codes for the same game run: the cheats engine (AkiMods aki_cheats) reads the file's "# rom:" tag and
+        // translates another revision's addresses as it applies them (No Mercy Rev 0 -> Rev 1), dropping codes it
+        // can't map. Untagged codes and other games' codes stay off (Rev 0 codes written as they are corrupt Rev 1).
+        auto game = [](const std::string &tag) { return tag.substr(0, tag.find("-rev")); };
+        return !codes_rom.empty() && !port_rom.empty() && (game(codes_rom) == game(port_rom));
+    }
+}
