+namespace {
+    Code code(uint8_t type, uint32_t addr, uint16_t value = 0) {
+        Code c{};
+        c.type = type;
+        c.addr = addr;
+        c.value = value;
+        return c;
+    }
+
+    // 16 bytes of RDRAM from 0x80000000 and the same words in the big-endian ROM at rom offset 0.
+    struct Memory {
+        std::vector<uint8_t> rdram = std::vector<uint8_t>(16);
+        std::vector<uint8_t> rom = std::vector<uint8_t>(16);
+        Memory() {
+            const uint32_t words[4] = { 0x27BDFFE0u, 0x3C013E49u, 0xAFBF0018u, 0x03E00008u };
+            for (int i = 0; i < 4; i++) {
+                set_ram(i, words[i]);
+                rom[i * 4 + 0] = uint8_t(words[i] >> 24);
+                rom[i * 4 + 1] = uint8_t(words[i] >> 16);
+                rom[i * 4 + 2] = uint8_t(words[i] >> 8);
+                rom[i * 4 + 3] = uint8_t(words[i]);
+            }
+        }
+        void set_ram(int index, uint32_t word) { std::memcpy(rdram.data() + index * 4, &word, 4); }
+    };
+
+    Watch watch_word1() {
+        return Watch{ FunctionSpan{ 0x80000000u, 0, 16, 0 }, { 0x80000004u } };
+    }
+}
+
+TEST_CASE("live codes: writes give their word address, conditions give none") {
+    const std::vector<Code> codes = {
+        code(0xD1, 0x80159A50, 3),      // a condition reads, it doesn't write
+        code(0x81, 0x801132BA, 0x3E49), // Undertaker pin: the low half of the word at 0x801132B8
+        code(0x80, 0x801132BB, 0x01),   // same word
+        code(0xA0, 0x80100001, 0x01),
+        code(0xA1, 0x80100006, 0x01),
+    };
+    const std::vector<uint32_t> expected = { 0x80100000u, 0x80100004u, 0x801132B8u };
+    CHECK(written_words(codes) == expected);
+}
+
+TEST_CASE("live codes: repeaters are expanded") {
+    const std::vector<Code> codes = {
+        code(0x50, 0x00000304, 1), // 3 times, +4
+        code(0x81, 0x80100002, 0x10),
+    };
+    const std::vector<uint32_t> expected = { 0x80100000u, 0x80100004u, 0x80100008u };
+    CHECK(written_words(codes) == expected);
+}
+
+TEST_CASE("live codes: a repeater before a conditional writes nothing itself") {
+    const std::vector<Code> codes = { code(0x50, 0x00000304, 1), code(0xD0, 0x80100000, 1), code(0x80, 0x80200000, 1) };
+    const std::vector<uint32_t> expected = { 0x80200000u };
+    CHECK(written_words(codes) == expected);
+}
+
+TEST_CASE("live codes: a word lands in one function per overlay sharing its address") {
+    const std::vector<uint32_t> words = { 0x80100004u };
+    const std::vector<FunctionSpan> functions = {
+        { 0x80100000u, 0x1000, 0x10, 7 },
+        { 0x80100000u, 0x2000, 0x20, 9 },
+    };
+    const std::vector<Watch> watches = build_watches(words, functions);
+    CHECK(watches.size() == 2);
+    CHECK(watches[0].func.id == 7);
+    CHECK(watches[1].func.id == 9);
+}
+
+TEST_CASE("live codes: function ends are exclusive, and untouched or empty functions are left out") {
+    const std::vector<uint32_t> words = { 0x80100000u, 0x80100010u };
+    const std::vector<FunctionSpan> functions = {
+        { 0x80100000u, 0x1000, 0x10, 1 }, // holds 0x80100000, not 0x80100010
+        { 0x80100010u, 0x1010, 0x00, 2 }, // no ROM code
+        { 0x80100020u, 0x1020, 0x10, 3 }, // nothing written
+    };
+    const std::vector<Watch> watches = build_watches(words, functions);
+    CHECK(watches.size() == 1);
+    CHECK(watches[0].func.id == 1);
+    CHECK(watches[0].words.size() == 1);
+    CHECK(watches[0].words[0] == 0x80100000u);
+}
+
+TEST_CASE("live codes: RDRAM words compare with the big-endian ROM") {
+    Memory m;
+    const Watch w = watch_word1();
+    CHECK(watched_match_rom(w, m.rdram.data(), 16, m.rom));
+    m.set_ram(1, 0x3C012FE0u);
+    CHECK(!watched_match_rom(w, m.rdram.data(), 16, m.rom));
+}
+
+TEST_CASE("live codes: an unwatched word is not a code write, it marks foreign content") {
+    Memory m;
+    const Watch w = watch_word1();
+    CHECK(others_match_rom(w, m.rdram.data(), 16, m.rom));
+    m.set_ram(2, 0); // unwatched only
+    CHECK(watched_match_rom(w, m.rdram.data(), 16, m.rom));
+    CHECK(!others_match_rom(w, m.rdram.data(), 16, m.rom));
+}
+
+TEST_CASE("live codes: a change in the watched word is still this function's code") {
+    Memory m;
+    const Watch w = watch_word1();
+    m.set_ram(1, 0x3C012FE0u);
+    CHECK(others_match_rom(w, m.rdram.data(), 16, m.rom));
+    CHECK(!watched_match_rom(w, m.rdram.data(), 16, m.rom));
+}
+
+TEST_CASE("live codes: others_match_rom fails on words out of range") {
+    Memory m;
+    const Watch past_ram{ FunctionSpan{ 0x80000000u, 0, 32, 0 }, { 0x80000004u } };
+    CHECK(!others_match_rom(past_ram, m.rdram.data(), 16, m.rom));
+    const Watch past_rom{ FunctionSpan{ 0x80000000u, 0xFFFFFFF0u, 16, 0 }, { 0x80000004u } };
+    CHECK(!others_match_rom(past_rom, m.rdram.data(), 16, m.rom));
+}
+
+TEST_CASE("live codes: nested function spans each get the word (No Mercy 0x80112FE0 holds 0x801131AC)") {
+    const std::vector<uint32_t> words = { 0x80113288u };
+    const std::vector<FunctionSpan> functions = {
+        { 0x80112FE0u, 0x1000, 808, 1 },
+        { 0x801131ACu, 0x11CC, 348, 2 },
+    };
+    const std::vector<Watch> watches = build_watches(words, functions);
+    CHECK(watches.size() == 2);
+    CHECK(watches[0].func.id == 1);
+    CHECK(watches[1].func.id == 2);
+}
+
+TEST_CASE("live codes: out-of-range words never match") {
+    Memory m;
+    const Watch past_ram{ FunctionSpan{ 0x80000000u, 0, 16, 0 }, { 0x80000010u } };
+    CHECK(!watched_match_rom(past_ram, m.rdram.data(), 16, m.rom));
+    const Watch past_rom{ FunctionSpan{ 0x80000000u, 0xFFFFFFF0u, 16, 0 }, { 0x80000004u } };
+    CHECK(!watched_match_rom(past_rom, m.rdram.data(), 16, m.rom));
+    const Watch below_ram{ FunctionSpan{ 0x7FFFFFF0u, 0, 16, 0 }, { 0x7FFFFFF4u } };
+    CHECK(!watched_match_rom(below_ram, m.rdram.data(), 16, m.rom));
+}
+
+TEST_CASE("live codes: the content key follows the watched words only and is never 0") {
+    Memory m;
+    const Watch w = watch_word1();
+    const uint64_t stock = content_key(w, m.rdram.data(), 16);
+    CHECK(stock != 0);
+    m.set_ram(2, 0);
+    CHECK(content_key(w, m.rdram.data(), 16) == stock);
+    m.set_ram(1, 0x3C012FE0u);
+    const uint64_t other = content_key(w, m.rdram.data(), 16);
+    CHECK(other != stock);
+    m.set_ram(1, 0x3C013E49u);
+    CHECK(content_key(w, m.rdram.data(), 16) == stock);
+}
+
+TEST_CASE("live codes: a jump into RAM outside known code is caught") {
+    Memory m;
+    const Watch w = watch_word1();
+    const std::vector<CodeRange> code = { { 0x80000000u, 0x80100000u } };
+    CHECK(!hooks_outside_code(w, m.rdram.data(), 16, m.rom, code)); // stock
+    m.set_ram(1, 0x080F801Du);                                      // Legends Ring Ropes: j 0x803E0074
+    CHECK(hooks_outside_code(w, m.rdram.data(), 16, m.rom, code));
+    m.set_ram(1, 0x0C0F801Du);                                      // jal
+    CHECK(hooks_outside_code(w, m.rdram.data(), 16, m.rom, code));
+    const std::vector<CodeRange> wider = { { 0x80000000u, 0x80100000u }, { 0x803E0000u, 0x803F0000u } };
+    CHECK(!hooks_outside_code(w, m.rdram.data(), 16, m.rom, wider)); // the target is known code
+    m.set_ram(1, 0x08000010u);                                       // j into known code
+    CHECK(!hooks_outside_code(w, m.rdram.data(), 16, m.rom, code));
+    m.set_ram(1, 0x3C012FE0u);                                       // an immediate, not a jump
+    CHECK(!hooks_outside_code(w, m.rdram.data(), 16, m.rom, code));
+}
+
+TEST_CASE("live codes: a jump into what the table writes is the pack's code, once it's there") {
+    // 32 bytes of RAM: the watched word at 0x80000004, the pack's code at 0x80000010.
+    std::vector<uint8_t> rdram(32);
+    std::vector<uint8_t> rom(32);
+    const auto set = [&](uint32_t index, uint32_t value) { std::memcpy(rdram.data() + index * 4, &value, 4); };
+    Watch w{};
+    w.func = FunctionSpan{ 0x80000000u, 0, 16, 0 };
+    w.words = { 0x80000004u };
+    const std::vector<CodeRange> code = { { 0x80000000u, 0x80000010u } };
+    const std::vector<CodeRange> pack = { { 0x80000010u, 0x80000018u } };
+
+    set(1, 0x08000004u);                   // j 0x80000010
+    CHECK(hooks_outside_code(w, rdram.data(), 32, rom, code));          // no table: refused
+    CHECK(hooks_outside_code(w, rdram.data(), 32, rom, code, pack));    // nothing there yet
+    set(4, 0x3C011234u);
+    CHECK(!hooks_outside_code(w, rdram.data(), 32, rom, code, pack));   // written: followed
+    CHECK(check_exits(w, rdram.data(), 32, rom, code, code, pack) == ExitCheck::Fine);
+    set(4, 0);
+    CHECK(check_exits(w, rdram.data(), 32, rom, code, code, pack) == ExitCheck::NotNow); // may be written later
+    CHECK(check_exits(w, rdram.data(), 32, rom, code, code) == ExitCheck::Never);
+
+    set(4, 0x3C011234u);
+    set(1, 0x08000007u);                   // j 0x8000001C: a target the table doesn't write, the old-revision case
+    CHECK(hooks_outside_code(w, rdram.data(), 32, rom, code, pack));
+    CHECK(check_exits(w, rdram.data(), 32, rom, code, code, pack) == ExitCheck::Never);
+    set(1, 0x00200008u);                   // jr at: still refused, the table says nothing about where that goes
+    CHECK(hooks_outside_code(w, rdram.data(), 32, rom, code, pack));
+}
+
+TEST_CASE("live codes: written words become ranges") {
+    const std::vector<CodeRange> r = ranges_of_words({ 0x80000108u, 0x80000100u, 0x80000104u, 0x80000104u, 0x80000200u });
+    CHECK(r.size() == 2);
+    if (r.size() != 2) return;
+    CHECK(r[0].start == 0x80000100u);
+    CHECK(r[0].end == 0x8000010Cu);
+    CHECK(r[1].start == 0x80000200u);
+    CHECK(r[1].end == 0x80000204u);
+    CHECK(ranges_of_words({}).empty());
+}
+
+TEST_CASE("live codes: branch words for tracing RAM code, float branches included") {
+    // No Mercy's rope builder func_80021B10 (aki-roadmap#245)
+    CHECK(is_branch_word(0x1440FFE6u));   // 0x80021C48 bne v0,zero
+    CHECK(is_branch_word(0x45020004u));   // 0x80021B84 bc1fl: missed before, which split the function into extra pieces
+    CHECK(is_branch_word(0x45010006u));   // 0x80021C90 bc1t
+    CHECK(is_branch_word(0x45000001u));   // bc1f
+    CHECK(is_branch_word(0x45030001u));   // bc1tl
+    CHECK(is_branch_word(0x04410003u));   // bgez
+    CHECK(is_branch_word(0x04110003u));   // bgezal
+    CHECK(is_branch_word(0x50400002u));   // beql
+    CHECK(!is_branch_word(0x080086FEu));  // j: a jump, not a branch
+    CHECK(!is_branch_word(0x0C006000u));  // jal
+    CHECK(!is_branch_word(0x03E00008u));  // jr ra
+    CHECK(!is_branch_word(0x44820000u));  // mtc1 (op 0x11, rs 4)
+    CHECK(!is_branch_word(0x46080032u));  // c.eq.s (op 0x11, rs 16)
+    CHECK(!is_branch_word(0x04080001u));  // regimm rt 8 (tgei): no branch
+}
+
+TEST_CASE("live codes: units_writing keeps only the units that write the range, conditions and repeaters whole") {
+    // Legends' Ring Ropes (aki-roadmap#245): the hook into game code under its D1 check, the cave, the colour table.
+    const std::vector<Code> table = {
+        code(0xD1, 0x80021BECu, 0x8042), code(0x81, 0x80021BF0u, 0x0817),  // hook, guarded
+        code(0x81, 0x805E0074u, 0x3C01), code(0x81, 0x805E0076u, 0x8005),  // cave
+        code(0xD0, 0x800D9968u, 0x3C), code(0xD1, 0x8015982Cu, 0x1234), code(0x81, 0x805E0078u, 0x0008), // stacked guards
+        code(0x81, 0x80052860u, 0x1000),                                     // colour table: game data
+        code(0x50, 0x00000204u, 0x0001), code(0x81, 0x805E0080u, 0x2400),   // repeater into the cave (0x80, 0x84)
+        code(0x50, 0x00000204u, 0x0001), code(0x81, 0x805E0100u, 0x2400),   // repeater elsewhere
+    };
+    const std::vector<Code> cave = units_writing(table, CodeRange{ 0x805E0074u, 0x805E00A8u });
+    CHECK(cave.size() == 7);
+    if (cave.size() != 7) return;
+    CHECK(cave[0].addr == 0x805E0074u);
+    CHECK(cave[1].addr == 0x805E0076u);
+    CHECK(cave[2].type == 0xD0);          // both guards of the stacked unit come with it
+    CHECK(cave[3].type == 0xD1);
+    CHECK(cave[4].addr == 0x805E0078u);
+    CHECK(cave[5].type == 0x50);          // the repeater with its write
+    CHECK(cave[6].addr == 0x805E0080u);
+
+    const std::vector<Code> hook = units_writing(table, CodeRange{ 0x80021BF0u, 0x80021BF4u });
+    CHECK(hook.size() == 2);
+    if (hook.size() == 2) CHECK(hook[0].type == 0xD1);
+
+    // a repeater whose first write misses but a later one hits
+    const std::vector<Code> late = units_writing({ code(0x50, 0x00000410u, 0), code(0x81, 0x805E0040u, 0) }, CodeRange{ 0x805E0070u, 0x805E0074u });
+    CHECK(late.size() == 2);
+    CHECK(units_writing(table, CodeRange{ 0x80400000u, 0x80400010u }).empty());
+    CHECK(units_writing({ code(0xD1, 0x80000000u, 0) }, CodeRange{ 0x80000000u, 0x80000010u }).empty()); // dangling guard
+
+    // malformed repeaters: apply() skips the 50 together with the unit after it, so the refresh must not take that unit
+    const CodeRange r{ 0x80000000u, 0x80000010u };
+    CHECK(units_writing({ code(0x50, 0x0204u, 0), code(0xD1, 0x80000020u, 0), code(0x81, 0x80000000u, 1) }, r).empty());
+    CHECK(units_writing({ code(0x50, 0x0204u, 0), code(0x50, 0x0204u, 0), code(0x81, 0x80000000u, 1) }, r).empty());
+    const std::vector<Code> after = units_writing({ code(0x50, 0x0204u, 0), code(0xD1, 0x80000020u, 0), code(0x81, 0x80000000u, 1),
+                                                    code(0x81, 0x80000004u, 2) }, r);
+    CHECK(after.size() == 1);                 // the unit after the skipped one is read normally
+    if (after.size() == 1) CHECK(after[0].addr == 0x80000004u);
+    CHECK(units_writing({ code(0xD1, 0x80000020u, 0), code(0x50, 0x0204u, 0) }, r).empty()); // repeater at the end
+}
+
+TEST_CASE("live codes: a hook written in two halves is judged by the word it makes") {
+    Memory m;
+    const Watch w = watch_word1();
+    const std::vector<CodeRange> code = { { 0x80000000u, 0x80100000u } };
+    m.set_ram(1, 0x080F3E49u); // the high half written, low half stock: j 0x803CF924
+    CHECK(hooks_outside_code(w, m.rdram.data(), 16, m.rom, code));
+    m.set_ram(1, 0x3C01801Du); // the low half written, high half stock: a lui, no hook yet
+    CHECK(!hooks_outside_code(w, m.rdram.data(), 16, m.rom, code));
+}
+
+TEST_CASE("live codes: a branch out of the function is a hook, one inside it isn't") {
+    Memory m;
+    const Watch w = watch_word1(); // 0x80000000..0x80000010, the word at 0x80000004
+    const std::vector<CodeRange> code = { { 0x80000000u, 0x80100000u } };
+    m.set_ram(1, 0x10000001u); // b +1: 0x8000000C, inside
+    CHECK(!hooks_outside_code(w, m.rdram.data(), 16, m.rom, code));
+    m.set_ram(1, 0x10000010u); // b past the end, though in known code
+    CHECK(hooks_outside_code(w, m.rdram.data(), 16, m.rom, code));
+    m.set_ram(1, 0x1000FFF0u); // b back before the start
+    CHECK(hooks_outside_code(w, m.rdram.data(), 16, m.rom, code));
+    m.set_ram(1, 0x04410010u); // bgez out
+    CHECK(hooks_outside_code(w, m.rdram.data(), 16, m.rom, code));
+    m.set_ram(1, 0x54400010u); // bnel out
+    CHECK(hooks_outside_code(w, m.rdram.data(), 16, m.rom, code));
+    m.set_ram(1, 0x45000010u); // bc1f out
+    CHECK(hooks_outside_code(w, m.rdram.data(), 16, m.rom, code));
+}
+
+TEST_CASE("live codes: jr and jalr count as hooks unless through ra") {
+    Memory m;
+    const Watch w = watch_word1();
+    const std::vector<CodeRange> code = { { 0x80000000u, 0x80100000u } };
+    m.set_ram(1, 0x00200008u); // jr at
+    CHECK(hooks_outside_code(w, m.rdram.data(), 16, m.rom, code));
+    m.set_ram(1, 0x0320F809u); // jalr t9
+    CHECK(hooks_outside_code(w, m.rdram.data(), 16, m.rom, code));
+    m.set_ram(1, 0x03E00008u); // jr ra: an early return
+    CHECK(!hooks_outside_code(w, m.rdram.data(), 16, m.rom, code));
+}
+
+TEST_CASE("live codes: hooks_outside_code skips words out of range") {
+    Memory m;
+    const std::vector<CodeRange> code = { { 0x80000000u, 0x80100000u } };
+    const Watch past_ram{ FunctionSpan{ 0x80000000u, 0, 32, 0 }, { 0x80000010u } };
+    CHECK(!hooks_outside_code(past_ram, m.rdram.data(), 16, m.rom, code));
+}
+
+TEST_CASE("live codes: code ranges include their start and not their end") {
+    const std::vector<CodeRange> code = { { 0x80001000u, 0x80002000u }, { 0x80100000u, 0x80100010u } };
+    CHECK(in_code_ranges(0x80001000u, code));
+    CHECK(in_code_ranges(0x80100008u, code));
+    CHECK(!in_code_ranges(0x80002000u, code));
+    CHECK(!in_code_ranges(0x803E0074u, code));
+    CHECK(!in_code_ranges(0x80001000u, std::vector<CodeRange>{}));
+}
+
+TEST_CASE("live codes: a jump to an unloaded overlay is not now, a jump outside all code is never") {
+    Memory m;
+    const Watch w = watch_word1();
+    const std::vector<CodeRange> all = { { 0x80000000u, 0x80100000u }, { 0x80106760u, 0x80140000u } };
+    const std::vector<CodeRange> loaded = { { 0x80000000u, 0x80100000u } };
+    CHECK(check_exits(w, m.rdram.data(), 16, m.rom, all, loaded) == ExitCheck::Fine); // stock
+    m.set_ram(1, 0x0C041DE0u); // jal 0x80107780, in the overlay slot
+    CHECK(check_exits(w, m.rdram.data(), 16, m.rom, all, loaded) == ExitCheck::NotNow);
+    CHECK(check_exits(w, m.rdram.data(), 16, m.rom, all, all) == ExitCheck::Fine);    // the same word once it's loaded
+    m.set_ram(1, 0x080F801Du); // j 0x803E0074, the pack's RAM
+    CHECK(check_exits(w, m.rdram.data(), 16, m.rom, all, loaded) == ExitCheck::Never);
+    CHECK(check_exits(w, m.rdram.data(), 16, m.rom, all, all) == ExitCheck::Never);
+    m.set_ram(1, 0x08000010u); // j into loaded code
+    CHECK(check_exits(w, m.rdram.data(), 16, m.rom, all, loaded) == ExitCheck::Fine);
+}
+
+TEST_CASE("live codes: an unchanged jump in the ROM isn't a hook") {
+    Memory m;
+    const uint32_t stock_jump = 0x080F801Du;
+    m.set_ram(1, stock_jump);
+    m.rom[4] = 0x08; m.rom[5] = 0x0F; m.rom[6] = 0x80; m.rom[7] = 0x1D;
+    const std::vector<CodeRange> code = { { 0x80000000u, 0x80100000u } };
+    CHECK(!hooks_outside_code(watch_word1(), m.rdram.data(), 16, m.rom, code));
+}
+
+TEST_CASE("live codes: nothing happens while a function matches the ROM") {
+    FunctionState s;
+    CHECK(decide(s, true, true, 5, 8) == Action::None);
+    CHECK(decide(s, false, false, 5, 8) == Action::None); // written, but its overlay isn't there
+}
+
+TEST_CASE("live codes: new content compiles, then flipping back and forth doesn't compile again") {
+    FunctionState s;
+    CHECK(decide(s, true, false, 5, 8) == Action::Compile);
+    s.compiled.insert(5);
+    s.current = 5;
+    CHECK(decide(s, true, false, 5, 8) == Action::None);
+    CHECK(decide(s, true, true, 5, 8) == Action::ToStatic); // the pack restores the stock word
+    s.current = 0;
+    CHECK(decide(s, true, false, 5, 8) == Action::UseCompiled);
+    CHECK(decide(s, true, false, 5, 0) == Action::UseCompiled); // a cached version costs no compile budget
+}
+
+TEST_CASE("live codes: a section that unloads goes back to static at once") {
+    FunctionState s;
+    s.compiled.insert(5);
+    s.current = 5;
+    CHECK(decide(s, false, false, 5, 8) == Action::ToStatic);
+}
+
+TEST_CASE("live codes: content that can't run isn't retried, and a running version goes back to static") {
+    FunctionState s;
+    s.failed.insert(5);
+    CHECK(decide(s, true, false, 5, 8) == Action::None); // already static
+    s.compiled.insert(6);
+    s.current = 6;
+    CHECK(decide(s, true, false, 5, 8) == Action::ToStatic); // a half-written hook's version doesn't keep running
+    s.current = 0;
+    CHECK(decide(s, true, false, 6, 8) == Action::UseCompiled); // its other content still runs
+}
+
+TEST_CASE("live codes: failed content counts toward the cap") {
+    FunctionState s;
+    for (uint64_t k = 1; k <= MaxVersionsPerFunction; k++) s.failed.insert(k + 100);
+    CHECK(decide(s, true, false, 5, 8) == Action::AtCap);
+    s.failed.erase(101);
+    CHECK(decide(s, true, false, 5, 8) == Action::Compile);
+}
+
+TEST_CASE("live codes: the compile budget defers and the version cap stops") {
+    FunctionState s;
+    CHECK(decide(s, true, false, 5, 0) == Action::Deferred);
+    for (uint64_t k = 1; k <= MaxVersionsPerFunction; k++) s.compiled.insert(k + 100);
+    CHECK(decide(s, true, false, 5, 8) == Action::AtCap);
+    CHECK(decide(s, true, false, 101, 8) == Action::UseCompiled);
+}
+
+TEST_CASE("live codes: a refused function never switches") {
+    FunctionState s;
+    s.refused = true;
+    CHECK(decide(s, true, false, 5, 8) == Action::None);
+    CHECK(decide(s, true, true, 5, 8) == Action::None);
+    CHECK(decide(s, false, false, 5, 8) == Action::None);
+}
+
+TEST_CASE("live codes: the entry jump reaches its target and refuses out of range") {
+    uint8_t out[EntryPatchSize];
+    CHECK(encode_entry_jump(0x140001000ull, 0x140002000ull, out));
+    CHECK(out[0] == 0xE9);
+    int32_t rel;
+    std::memcpy(&rel, out + 1, 4);
+    CHECK(rel == 0x1000 - 5);
+    CHECK(encode_entry_jump(0x140002000ull, 0x140001000ull, out));
+    std::memcpy(&rel, out + 1, 4);
+    CHECK(rel == -0x1000 - 5);
+    CHECK(!encode_entry_jump(0x140000000ull, 0x240000000ull, out));
+    CHECK(!encode_entry_jump(0x240000000ull, 0x140000000ull, out));
+}
+
+TEST_CASE("live codes: the stub jumps through its 8-byte aligned target") {
+    uint8_t out[StubSize];
+    encode_stub(0x1122334455667788ull, out);
+    CHECK(out[0] == 0xFF);
+    CHECK(out[1] == 0x25);
+    int32_t disp;
+    std::memcpy(&disp, out + 2, 4);
+    CHECK(6 + disp == int32_t(StubTargetOffset)); // rip is past the 6-byte jmp
+    uint64_t target;
+    std::memcpy(&target, out + StubTargetOffset, 8);
+    CHECK(target == 0x1122334455667788ull);
+    CHECK((StubTargetOffset % 8) == 0);
+}
diff --git a/librecomp/tests/wcw/mod_enable_rules_tests.cpp b/librecomp/tests/wcw/mod_enable_rules_tests.cpp
new file mode 100644
index 0000000..acc2f89
--- /dev/null
+++ b/librecomp/tests/wcw/mod_enable_rules_tests.cpp
@@ -0,0 +1,71 @@
+//
+// librecomp
+//
+
+// [wcw] Unit tests for librecomp/mod_enable_rules (dependency auto-enable, aki-roadmap#100) and the manifest-less
+// mod id rule in mod_folder_rules. Built and run as part of every librecomp build (LIBRECOMP_WCW_TESTS); a failure
+// fails the build.
+
+#include "librecomp/mod_enable_rules.hpp"
+#include "librecomp/mod_folder_rules.hpp"
+
+#include <map>
+#include <string>
+#include <unordered_set>
+#include <vector>
+
+#include "wcw_test.h"
+
+using namespace recomp::mods;
+
+namespace {
+    using Graph = std::map<std::string, std::vector<enable_rules::Dependency>>;
+
+    std::vector<std::string> enable(const Graph &graph, const std::string &mod_id, std::unordered_set<std::string> &auto_enabled) {
+        return enable_rules::newly_auto_enabled(mod_id, [&](const std::string &id) {
+            auto it = graph.find(id);
+            return (it != graph.end()) ? it->second : std::vector<enable_rules::Dependency>();
+        }, auto_enabled);
+    }
+}
+
+TEST_CASE("mod enable: enabling a mod auto-enables its dependency, not itself (on_enabled fired with the dependent's handle)") {
+    const Graph graph = { { "hd_textures", { { "base_pack" } } }, { "base_pack", {} } };
+    std::unordered_set<std::string> auto_enabled;
+    const std::vector<std::string> found = enable(graph, "hd_textures", auto_enabled);
+    CHECK_EQ(found.size(), size_t(1));
+    CHECK(!found.empty() && found[0] == "base_pack");
+    CHECK(auto_enabled.contains("base_pack"));
+    CHECK(!auto_enabled.contains("hd_textures"));
+}
+
+TEST_CASE("mod enable: dependencies of dependencies, each once") {
+    const Graph graph = { { "a", { { "b" }, { "c" } } }, { "b", { { "c" }, { "d" } } }, { "c", {} }, { "d", {} } };
+    std::unordered_set<std::string> auto_enabled;
+    const std::vector<std::string> found = enable(graph, "a", auto_enabled);
+    CHECK_EQ(found.size(), size_t(3));
+    CHECK(auto_enabled == std::unordered_set<std::string>({ "b", "c", "d" }));
+    // Enabling another mod that needs them again auto-enables nothing new (no second on_enabled).
+    const Graph more = { { "e", { { "c" } } } };
+    CHECK(enable(more, "e", auto_enabled).empty());
+}
+
+TEST_CASE("mod enable: optional and deprecated dependencies are skipped; a mod that isn't opened is still noted") {
+    const Graph graph = { { "a", { { "opt", true }, { "missing" } } } };
+    std::unordered_set<std::string> auto_enabled;
+    const std::vector<std::string> found = enable(graph, "a", auto_enabled);
+    CHECK_EQ(found.size(), size_t(1));
+    CHECK(!found.empty() && found[0] == "missing");
+    CHECK(!auto_enabled.contains("opt"));
+}
+
+TEST_CASE("mod ids: a folder without a mod.json keeps its whole name (pack.v2 lost its .v2)") {
+    CHECK(folder_rules::manifestless_mod_id("pack.v2", true) == "pack.v2");
+    CHECK(folder_rules::manifestless_mod_id("My Pack 1.0.1", true) == "My Pack 1.0.1");
+    CHECK(folder_rules::manifestless_mod_id("pack", true) == "pack");
+}
+
+TEST_CASE("mod ids: a container file without a mod.json drops only its extension") {
+    CHECK(folder_rules::manifestless_mod_id("pack.v2.rtz", false) == "pack.v2");
+    CHECK(folder_rules::manifestless_mod_id("pack.rtz", false) == "pack");
+}
diff --git a/librecomp/tests/wcw/mod_folder_rules_tests.cpp b/librecomp/tests/wcw/mod_folder_rules_tests.cpp
new file mode 100644
index 0000000..6a1466a
--- /dev/null
+++ b/librecomp/tests/wcw/mod_folder_rules_tests.cpp
@@ -0,0 +1,60 @@
+//
+// librecomp
+//
+
+// [wcw] Unit tests for librecomp/mod_folder_rules (texture pack folders without a mod.json, aki-roadmap#48). Built and run
+// as part of every librecomp build (LIBRECOMP_WCW_TESTS); a failure fails the build.
+
+#include "librecomp/mod_folder_rules.hpp"
+
+#include <set>
+#include <string>
+#include <vector>
+
+#include "wcw_test.h"
+
+using namespace recomp::mods::folder_rules;
+
+namespace {
+    // The games' registrations: 0 = binary_syms (.nrm code), 1 = rom_patch, 2 = rt64.json texture packs.
+    const std::vector<std::string> ContentFiles = { "mod_binary.bin", "patch.bps", "rt64.json" };
+    // .nrm needs a mod.json and may hold anything; .rtz holds texture packs and needs none.
+    const std::vector<Container> Containers = { Container{ {}, true }, Container{ { 2 }, false } };
+
+    std::vector<size_t> typesFor(const std::set<std::string> &files, const std::vector<Container> &containers = Containers) {
+        return manifestless_folder_types(containers, ContentFiles, [&](const std::string &name) { return files.count(name) > 0; });
+    }
+}
+
+TEST_CASE("mod folders: a folder with rt64.json and no mod.json opens as a texture pack") {
+    const std::vector<size_t> types = typesFor({ "rt64.json", "0123456789abcdef.png" });
+    CHECK_EQ(types.size(), size_t(1));
+    CHECK(!types.empty() && types[0] == 2);
+}
+
+TEST_CASE("mod folders: a folder without a manifest-less content file is not such a mod (it still needs a mod.json)") {
+    CHECK(typesFor({ "readme.txt", "0123456789abcdef.png" }).empty());
+    CHECK(typesFor({}).empty());
+}
+
+TEST_CASE("mod folders: code content only counts with a mod.json") {
+    // mod_binary.bin belongs to a container that requires a manifest.
+    CHECK(typesFor({ "mod_binary.bin" }).empty());
+    const std::vector<size_t> types = typesFor({ "mod_binary.bin", "rt64.json" });
+    CHECK_EQ(types.size(), size_t(1));
+    CHECK(!types.empty() && types[0] == 2);
+}
+
+TEST_CASE("mod folders: no manifest-less container registered means no change from upstream") {
+    CHECK(typesFor({ "rt64.json" }, { Container{ {}, true } }).empty());
+    // A container that allows rt64.json but needs a mod.json doesn't make a bare folder a mod.
+    CHECK(typesFor({ "rt64.json" }, { Container{ { 2 }, true } }).empty());
+    // A manifest-less container that allows any content has no content file to look for.
+    CHECK(typesFor({ "rt64.json" }, { Container{ {}, false } }).empty());
+}
+
+TEST_CASE("mod folders: a type allowed by two containers appears once, out-of-range ids are ignored") {
+    const std::vector<Container> containers = { Container{ { 2, 9 }, false }, Container{ { 2 }, false } };
+    const std::vector<size_t> types = typesFor({ "rt64.json" }, containers);
+    CHECK_EQ(types.size(), size_t(1));
+}
diff --git a/librecomp/tests/wcw/packages_install_tests.cpp b/librecomp/tests/wcw/packages_install_tests.cpp
new file mode 100644
index 0000000..0c3771d
--- /dev/null
+++ b/librecomp/tests/wcw/packages_install_tests.cpp
@@ -0,0 +1,470 @@
+//
+// librecomp
+//
+
+// [wcw] Unit tests for installing, upgrading and removing packages and the drop folder (aki-roadmap#154 step 2).
+// Built and run as part of every librecomp build (LIBRECOMP_WCW_TESTS); a failure fails the build.
+
+#include "librecomp/packages.hpp"
+
+#include <algorithm>
+#include <chrono>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <map>
+#include <string>
+#include <vector>
+
+#include "miniz.h"
+#include "miniz_zip.h"
+#include "wcw_test.h"
+
+using namespace recomp::packages;
+namespace fs = std::filesystem;
+
+namespace {
+    void write(const fs::path &p, const std::string &data) {
+        fs::create_directories(p.parent_path());
+        std::ofstream f(p, std::ios::binary | std::ios::trunc);
+        f << data;
+    }
+
+    std::string read(const fs::path &p) {
+        std::ifstream f(p, std::ios::binary);
+        return std::string((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>());
+    }
+
+    struct TempDir {
+        fs::path path;
+        TempDir() {
+            static int n = 0;
+            path = fs::temp_directory_path() / ("wcw_pkg_install_test_" +
+                std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()) + "_" + std::to_string(n++));
+            fs::create_directories(path);
+        }
+        ~TempDir() {
+            std::error_code ec;
+            fs::remove_all(path, ec);
+        }
+    };
+
+    const char *Rom = "0123456789abcdef0123456789abcdef01234567";
+    const char *OtherRom = "fedcba9876543210fedcba9876543210fedcba98";
+
+    std::string manifest_json(const std::string &kind, const std::string &id, const std::string &version, const std::string &payload,
+        const std::string &extra = "") {
+        return "{\"format\": 1, \"kind\": \"" + kind + "\", \"id\": \"" + id + "\", \"version\": \"" + version + "\", "
+            "\"game_id\": \"wwfnomercy\", \"display_name\": \"" + id + " pack\", \"authors\": [\"A\"], \"payload\": " + payload + extra + "}";
+    }
+
+    // A package folder: aki-package.json plus files.
+    fs::path make_package(const fs::path &dir, const std::string &manifest, const std::map<std::string, std::string> &files) {
+        write(dir / ManifestFile, manifest);
+        for (const auto &[rel, data] : files) {
+            write(dir / rel, data);
+        }
+        return dir;
+    }
+
+    bool make_zip(const fs::path &zip, const std::map<std::string, std::string> &entries, mz_uint flags = 0) {
+        mz_zip_archive a{};
+        if (!mz_zip_writer_init_file(&a, zip.string().c_str(), 0)) {
+            return false;
+        }
+        for (const auto &[name, data] : entries) {
+            mz_zip_writer_add_mem(&a, name.c_str(), data.data(), data.size(), MZ_DEFAULT_COMPRESSION | flags);
+        }
+        const bool ok = mz_zip_writer_finalize_archive(&a);
+        mz_zip_writer_end(&a);
+        return ok;
+    }
+
+    InstallOptions opts() {
+        InstallOptions o;
+        o.game_id = "wwfnomercy";
+        o.rom_sha1 = Rom;
+        o.recomp_version = "1.2.0";
+        o.date = "20261029";
+        o.now = "2026-10-29T12:00:00Z";
+        return o;
+    }
+
+    Manifest parsed(const std::string &text) {
+        Manifest m;
+        std::vector<Problem> p;
+        parse_manifest(text, m, p);
+        return m;
+    }
+}
+
+TEST_CASE("install: placements by kind") {
+    const auto addon = placements(parsed(manifest_json("addon", "cam", "1.0.0", "{\"nrm\": \"bin/aki_camera.nrm\"}")));
+    CHECK(addon.size() == 1 && addon[0].from == "bin/aki_camera.nrm" && addon[0].to == "mods/aki_camera.nrm" && !addon[0].folder);
+    const auto loose = placements(parsed(manifest_json("texture-pack", "arena", "1.0.0", "{\"folder\": \"tex/\"}")));
+    CHECK(loose.size() == 1 && loose[0].from == "tex" && loose[0].to == "mods/arena" && loose[0].folder);
+    const auto model = placements(parsed(manifest_json("model-pack", "q", "1.0.0", "{\"packs\": [\"p/q-robot.akimodel/\"], \"hd\": [\"q-robot-hd.rtz\"]}")));
+    CHECK(model.size() == 2 && model[0].to == "mods/models/q-robot.akimodel" && model[1].to == "mods/q-robot-hd.rtz");
+    const auto conv = placements(parsed(manifest_json("conversion", "nmp", "1.0.0", "{\"folder\": \"c\", \"addons\": [\"t.rtz\"]}",
+        std::string(", \"base_rom\": {\"sha1\": [\"") + Rom + "\"]}")));
+    CHECK(conv.size() == 2 && conv[0].to == "conversions/nmp" && conv[0].folder && conv[1].to == "mods/t.rtz");
+}
+
+TEST_CASE("install: plan rules") {
+    Registry r;
+    const Manifest addon = parsed(manifest_json("addon", "cam", "1.1.0", "{\"nrm\": \"cam.nrm\"}"));
+    CHECK(plan_install(r, addon, opts()).action == Action::Install);
+
+    InstallOptions other = opts();
+    other.game_id = "vpw2";
+    CHECK(plan_install(r, addon, other).action == Action::Refuse);
+
+    const Manifest needs = parsed(manifest_json("addon", "cam", "1.0.0", "{\"nrm\": \"cam.nrm\"}", ", \"requires\": {\"minimum_recomp_version\": \"1.3.0\", \"packages\": [\"aki_cheats\"]}"));
+    CHECK(plan_install(r, needs, opts()).action == Action::Refuse);
+    InstallOptions unknown_build = opts();
+    unknown_build.recomp_version.clear();
+    const Plan p = plan_install(r, needs, unknown_build);
+    CHECK(p.action == Action::Install);
+    CHECK(p.notes.size() == 1 && !p.notes[0].error && p.notes[0].field == "requires.packages");
+
+    const std::string other_rom = std::string(", \"base_rom\": {\"sha1\": [\"") + OtherRom + "\"], \"name\": \"WWF No Mercy (Rev 0)\"}";
+    CHECK(plan_install(r, parsed(manifest_json("conversion", "nmp", "1.0.0", "{\"folder\": \"c\"}", other_rom)), opts()).action == Action::Refuse);
+    const Plan warned = plan_install(r, parsed(manifest_json("texture-pack", "t", "1.0.0", "{\"rtz\": \"t.rtz\"}", other_rom)), opts());
+    CHECK(warned.action == Action::Install && warned.notes.size() == 1 && warned.notes[0].field == "base_rom");
+    InstallOptions no_rom = opts();
+    no_rom.rom_sha1.clear();
+    CHECK(plan_install(r, parsed(manifest_json("conversion", "nmp", "1.0.0", "{\"folder\": \"c\"}", other_rom)), no_rom).action == Action::Refuse);
+    const Plan unchecked = plan_install(r, parsed(manifest_json("texture-pack", "t", "1.0.0", "{\"rtz\": \"t.rtz\"}", other_rom)), no_rom);
+    CHECK(unchecked.action == Action::Install && unchecked.notes.empty());   // a pack doesn't need the ROM checked
+    // Two parts landing on one path (different source folders, same file name; case doesn't matter).
+    CHECK(plan_install(r, parsed(manifest_json("model-pack", "two", "1.0.0", "{\"packs\": [\"a/x.akimodel\", \"b/X.akimodel\"]}")), opts()).action == Action::Refuse);
+
+    const Plan own_use = plan_install(r, parsed(manifest_json("addon", "cam", "1.0.0", "{\"nrm\": \"cam.nrm\"}", ", \"permission\": {\"redistribute\": \"no\"}")), opts());
+    CHECK(own_use.notes.size() == 1 && own_use.notes[0].field == "permission");
+
+    Entry e;
+    e.id = "cam";
+    e.kind = Kind::Addon;
+    e.version = "1.0.0";
+    e.files = { { "mods/cam.nrm", 1 } };
+    upsert(r, e);
+    CHECK(plan_install(r, addon, opts()).action == Action::Upgrade);
+    CHECK(plan_install(r, addon, opts()).old_version == "1.0.0");
+    const Manifest same = parsed(manifest_json("addon", "cam", "1.0.0", "{\"nrm\": \"cam.nrm\"}"));
+    CHECK(plan_install(r, same, opts()).action == Action::AlreadyInstalled);
+    InstallOptions again = opts();
+    again.reinstall = true;
+    CHECK(plan_install(r, same, again).action == Action::Reinstall);
+    const Manifest older = parsed(manifest_json("addon", "cam", "0.9.0", "{\"nrm\": \"cam.nrm\"}"));
+    CHECK(plan_install(r, older, opts()).action == Action::Refuse);
+    InstallOptions down = opts();
+    down.allow_downgrade = true;
+    CHECK(plan_install(r, older, down).action == Action::Downgrade);
+
+    // The id is taken by another kind; a path another package owns; "replaces" frees it.
+    CHECK(plan_install(r, parsed(manifest_json("texture-pack", "cam", "1.0.0", "{\"rtz\": \"cam.rtz\"}")), opts()).action == Action::Refuse);
+    const Manifest takes = parsed(manifest_json("addon", "camera2", "1.0.0", "{\"nrm\": \"cam.nrm\"}"));
+    CHECK(plan_install(r, takes, opts()).action == Action::Refuse);
+    const Manifest renames = parsed(manifest_json("addon", "camera2", "1.0.0", "{\"nrm\": \"cam.nrm\"}", ", \"replaces\": [\"cam\", \"gone\"]"));
+    const Plan rp = plan_install(r, renames, opts());
+    CHECK(rp.action == Action::Install);
+    CHECK(rp.replaced == std::vector<std::string>{ "cam" });
+}
