index 0000000..790ceeb
--- /dev/null
+++ b/librecomp/tests/wcw/patcher_tests.cpp
@@ -0,0 +1,217 @@
+//
+// librecomp
+//
+
+// [wcw fullconv] Unit tests for the BPS patcher's source ROM check (aki-roadmap#173). Built and run as part of every
+// librecomp build (LIBRECOMP_WCW_TESTS); a failure fails the build.
+
+#include "librecomp/patcher.hpp"
+#include "recompiler/jump_table_bound.h"
+#include "recompiler/runs_off_end.h"
+#include "recompiler/constant_ra.h"
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "wcw_test.h"
+
+using recomp::patcher::PatcherResult;
+using recomp::patcher::patch_rom;
+
+namespace {
+    using Bytes = std::vector<uint8_t>;
+
+    // Bitwise CRC-32, independent of the patcher's table (check value: "123456789" -> 0xCBF43926).
+    uint32_t crc32_of(const Bytes &data) {
+        uint32_t crc = 0xFFFFFFFF;
+        for (uint8_t byte : data) {
+            crc ^= byte;
+            for (int bit = 0; bit < 8; bit++) {
+                crc = (crc >> 1) ^ ((crc & 1) ? 0xEDB88320u : 0u);
+            }
+        }
+        return ~crc;
+    }
+
+    void put_number(Bytes &out, uint64_t value) {
+        while (true) {
+            uint8_t low = value & 0x7f;
+            value >>= 7;
+            if (value == 0) {
+                out.push_back(low | 0x80);
+                return;
+            }
+            out.push_back(low);
+            value--;
+        }
+    }
+
+    void put_u32(Bytes &out, uint32_t value) {
+        for (int i = 0; i < 4; i++) {
+            out.push_back((value >> (8 * i)) & 0xff);
+        }
+    }
+
+    // SourceRead of the first `keep` bytes, TargetRead of `tail`, the way a BPS stores one changed byte.
+    Bytes make_patch(const Bytes &source, size_t keep, const Bytes &tail) {
+        Bytes target(source.begin(), source.begin() + keep);
+        target.insert(target.end(), tail.begin(), tail.end());
+
+        Bytes patch{ 'B', 'P', 'S', '1' };
+        put_number(patch, source.size());
+        put_number(patch, target.size());
+        put_number(patch, 0);
+        put_number(patch, ((keep - 1) << 2) | 0);
+        put_number(patch, ((tail.size() - 1) << 2) | 1);
+        patch.insert(patch.end(), tail.begin(), tail.end());
+        put_u32(patch, crc32_of(source));
+        put_u32(patch, crc32_of(target));
+        put_u32(patch, crc32_of(patch));
+        return patch;
+    }
+}
+
+TEST_CASE("patcher_crc_helper_matches_the_standard_check_value") {
+    const std::string text = "123456789";
+    CHECK(crc32_of(Bytes(text.begin(), text.end())) == 0xCBF43926u);
+}
+
+TEST_CASE("patcher_applies_a_patch_to_the_rom_it_was_built_on") {
+    const Bytes rom{ 0x90, 0xE7, 0xA1, 0x70 };
+    const Bytes patch = make_patch(rom, 3, { 0xF0 });
+    Bytes out;
+    CHECK(patch_rom(rom, patch, out) == PatcherResult::Success);
+    CHECK((out == Bytes{ 0x90, 0xE7, 0xA1, 0xF0 }));
+}
+
+// aki-roadmap#173: a patch built on WM2000's "V1.2" hack, applied to the retail ROM, turned 90E7A1F0 into 000000F0 (the
+// kept bytes came from retail's zeros) and the game hit a trap at boot.
+TEST_CASE("patcher_refuses_a_patch_built_on_another_rom") {
+    const Bytes built_on{ 0x90, 0xE7, 0xA1, 0x70 };
+    const Bytes players_rom{ 0x00, 0x00, 0x00, 0x00 };
+    const Bytes patch = make_patch(built_on, 3, { 0xF0 });
+    Bytes out;
+    CHECK(patch_rom(players_rom, patch, out) == PatcherResult::WrongRom);
+    CHECK(out.empty());
+}
+
+TEST_CASE("patcher_refuses_a_one_byte_difference_in_the_source") {
+    const Bytes built_on{ 1, 2, 3, 4, 5, 6, 7, 8 };
+    Bytes other = built_on;
+    other[7] ^= 1;
+    const Bytes patch = make_patch(built_on, 4, { 9 });
+    Bytes out;
+    CHECK(patch_rom(other, patch, out) == PatcherResult::WrongRom);
+}
+
+TEST_CASE("patcher_still_reports_a_bad_header_as_invalid") {
+    const Bytes rom{ 1, 2, 3, 4 };
+    Bytes patch = make_patch(rom, 3, { 9 });
+    patch[0] = 'X';
+    Bytes out;
+    CHECK(patch_rom(rom, patch, out) == PatcherResult::InvalidPatchFile);
+}
+
+// aki-roadmap#173: House Party Mixtape's hook returns to 0x8001E340, one word before func_8001E344. With no tail call the
+// generated code ran into whatever follows the batch (the first switch error stub).
+// A hand-written switch head, as Function::words holds it: in ROM byte order (aki-roadmap#206).
+static uint32_t rom_order(uint32_t w) {
+    return (w >> 24) | ((w >> 8) & 0xFF00) | ((w << 8) & 0xFF0000) | (w << 24);
+}
+
+TEST_CASE("jump_table_bound_reads_words_in_rom_byte_order") {
+    using N64Recomp::find_jump_table_bound;
+    const uint32_t v0 = 2;
+    const uint32_t words[] = {
+        rom_order(0x2C62000Bu),  // sltiu $v0, $v1, 11
+        rom_order(0x10400010u),  // beqz $v0
+        rom_order(0x00031080u),  // sll $v0, $v1, 2
+        rom_order(0x3C018013u),  // lui $at, 0x8013
+        rom_order(0x00220821u),  // addu $at, $at, $v0
+    };
+    auto found = find_jump_table_bound(words, 5, 4, v0);
+    CHECK(found.has_value());
+    CHECK(found.value_or(0) == 11);
+}
+
+TEST_CASE("jump_table_bound_needs_the_whole_pattern") {
+    using N64Recomp::find_jump_table_bound;
+    const uint32_t v0 = 2;
+    const uint32_t no_guard[] = { rom_order(0x00031080u), rom_order(0x3C018013u), rom_order(0x00220821u) };
+    CHECK(!find_jump_table_bound(no_guard, 3, 2, v0).has_value());
+    const uint32_t index_rewritten[] = {
+        rom_order(0x2C62000Bu),  // sltiu $v0, $v1, 11
+        rom_order(0x24630001u),  // addiu $v1, $v1, 1: not the index the guard checked
+        rom_order(0x00031080u), rom_order(0x3C018013u), rom_order(0x00220821u),
+    };
+    CHECK(!find_jump_table_bound(index_rewritten, 5, 4, v0).has_value());
+    CHECK(!find_jump_table_bound(no_guard, 3, 3, v0).has_value());   // addu index past the function
+}
+
+TEST_CASE("runs_off_end_counts_a_one_word_function") {
+    using N64Recomp::function_runs_off_end;
+    const uint32_t slti = 0x2A220004, nop = 0, j = 0x08000000, jr_ra = 0x03E00008, b = 0x10000002, eret = 0x42000018;
+    CHECK(function_runs_off_end(1, slti, 0, false));
+    CHECK(function_runs_off_end(1, nop, 0, false));
+    CHECK(!function_runs_off_end(1, j, 0, false));
+    CHECK(!function_runs_off_end(1, jr_ra, 0, false));
+    CHECK(!function_runs_off_end(1, eret, 0, false));
+    CHECK(!function_runs_off_end(0, 0, 0, false));
+    // The rules for longer functions stay: a delay slot after a jump ends, a branch landing on it runs on (aki-roadmap#76).
+    CHECK(function_runs_off_end(2, slti, nop, false));
+    CHECK(!function_runs_off_end(2, nop, j, false));
+    CHECK(function_runs_off_end(2, nop, j, true));
+    CHECK(!function_runs_off_end(2, b, nop, true));
+}
+
+// No Mercy Plus V3, Jericho's entrance: payload 0x804715EC builds ra = 0x8010F8FC and its jr ra at 0x80471634 jumps
+// there (the middle of ovl_b 0x8010F794). Compiled as a plain return, 0x8010F794 returned without its epilogue and the
+// main loop's s2 came back 0 (crash). constant_ra.h decides when a jr ra is that jump.
+TEST_CASE("constant_ra_pair_finds_a_hacks_fake_return_address") {
+    using N64Recomp::constant_ra_pair;
+    uint32_t v = 0;
+    CHECK(constant_ra_pair(0x3C1F8011u, 0x27FFF8FCu, v));          // lui $ra, 0x8011; addiu $ra, $ra, -0x704
+    CHECK(v == 0x8010F8FCu);
+    CHECK(constant_ra_pair(0x3C1F8010u, 0x37FFF8FCu, v));          // ori $ra, $ra, 0xF8FC
+    CHECK(v == 0x8010F8FCu);
+    CHECK(!constant_ra_pair(0x3C088011u, 0x27FFF8FCu, v));         // the lui writes $t0, not $ra
+    CHECK(!constant_ra_pair(0x3C1F8011u, 0x2508F8FCu, v));         // addiu $t0, $t0: not $ra
+    CHECK(!constant_ra_pair(0x3C1F8011u, 0x27E8F8FCu, v));         // addiu $t0, $ra: $ra itself unchanged
+    CHECK(!constant_ra_pair(0x00000000u, 0x27FFF8FCu, v));         // no lui before it
+    CHECK(!constant_ra_pair(0x3C1F0000u, 0x27FF1234u, v));         // not a KSEG0 code address
+    CHECK(!constant_ra_pair(0x3C1F8011u, 0x27FFF8FEu, v));         // misaligned
+    CHECK(!constant_ra_pair(0x3C1F8011u, 0x8FBF0024u, v));         // lw $ra, 0x24($sp)
+}
+
+TEST_CASE("constant_ra_pair_edges") {
+    using N64Recomp::constant_ra_pair;
+    uint32_t v = 0;
+    CHECK(constant_ra_pair(0x3C1F8080u, 0x27FFFFFCu, v));          // 0x807FFFFC: the last code address taken
+    CHECK(v == 0x807FFFFCu);
+    CHECK(!constant_ra_pair(0x3C1F8080u, 0x27FF0000u, v));         // 0x80800000: past RDRAM
+    CHECK(!constant_ra_pair(0x3C3F8011u, 0x27FFF8FCu, v));         // rs set in the lui: not a plain lui
+}
+
+TEST_CASE("take_constant_ra_matches_the_noting_frame_only") {
+    using namespace N64Recomp;
+    const uintptr_t frame = 0x1000, deeper = 0x0F00, shallower = 0x1100;
+    ConstantRa s{};
+    CHECK(!take_constant_ra(s, 0x8010F8FCu, frame));               // nothing noted: a plain return
+    note_constant_ra(s, 0x8010F8FCu, frame);
+    CHECK(take_constant_ra(s, 0x8010F8FCu, frame));                // same frame (the hack's j chain), ra = T: jump
+    CHECK(!take_constant_ra(s, 0x8010F8FCu, frame));               // taken: the next jr ra is a return again
+    // A function called from the noting one (calls don't write ra, so it still sees T) returns normally and keeps
+    // the note for the noting frame's own jr ra.
+    note_constant_ra(s, 0x8010F8FCu, frame);
+    CHECK(!take_constant_ra(s, 0x8010F8FCu, deeper));
+    CHECK(take_constant_ra(s, 0x8010F8FCu, frame));
+    // ra changed since: a return, and the note is gone
+    note_constant_ra(s, 0x8010F8FCu, frame);
+    CHECK(!take_constant_ra(s, 0x80026A20u, frame));
+    CHECK(!take_constant_ra(s, 0x8010F8FCu, frame));
+    // the noting frame returned another way: a shallower jr ra drops the note, even with ra still T
+    note_constant_ra(s, 0x8010F8FCu, frame);
+    CHECK(!take_constant_ra(s, 0x8010F8FCu, shallower));
+    CHECK(!take_constant_ra(s, 0x8010F8FCu, frame));
+}
diff --git a/librecomp/tests/wcw/regen_rules_tests.cpp b/librecomp/tests/wcw/regen_rules_tests.cpp
new file mode 100644
index 0000000..8d554f8
--- /dev/null
+++ b/librecomp/tests/wcw/regen_rules_tests.cpp
@@ -0,0 +1,44 @@
+//
+// librecomp
+//
+
+// [wcw fullconv] Unit tests for librecomp/regen_rules (aki-roadmap#76): a regenerated function whose span ends on a
+// jump or branch takes in its delay slot. Built and run as part of every librecomp build (LIBRECOMP_WCW_TESTS).
+
+#include "librecomp/regen_rules.hpp"
+
+#include "wcw_test.h"
+
+using namespace recomp::mods::regen_rules;
+
+TEST_CASE("regen rules: jumps and branches have delay slots") {
+    CHECK(has_delay_slot(0x00200008u));  // jr $at (No Mercy Plus V3 func_80126FFC's last word)
+    CHECK(has_delay_slot(0x03E00008u));  // jr $ra
+    CHECK(has_delay_slot(0x0320F809u));  // jalr $t9
+    CHECK(has_delay_slot(0x0C0502F5u));  // jal (mid_80110B04's last word)
+    CHECK(has_delay_slot(0x08049FC6u));  // j
+    CHECK(has_delay_slot(0x04410003u));  // bgez $v0, +3 (mid_8011BC04's last word)
+    CHECK(has_delay_slot(0x04110001u));  // bal (bgezal $zero)
+    CHECK(has_delay_slot(0x1000FFFFu));  // b
+    CHECK(has_delay_slot(0x5440FFFBu));  // bnel
+    CHECK(has_delay_slot(0x45000002u));  // bc1f
+    CHECK(has_delay_slot(0x45030002u));  // bc1tl
+}
+
+TEST_CASE("regen rules: other instructions don't") {
+    CHECK(!has_delay_slot(0x00000000u)); // nop
+    CHECK(!has_delay_slot(0x00461021u)); // addu $v0, $v0, $a2
+    CHECK(!has_delay_slot(0x0000000Du)); // break
+    CHECK(!has_delay_slot(0x0000000Cu)); // syscall
+    CHECK(!has_delay_slot(0x04080001u)); // tgei (REGIMM, rt 0x08)
+    CHECK(!has_delay_slot(0x44820000u)); // mtc1
+    CHECK(!has_delay_slot(0x42000018u)); // eret (no delay slot)
+    CHECK(!has_delay_slot(0x8FBF0014u)); // lw $ra
+}
+
+TEST_CASE("regen rules: a span ending on a jump or branch takes in one more word, when there is one") {
+    CHECK(words_to_decode(19, 0x00200008u, 1) == 20);
+    CHECK(words_to_decode(19, 0x00200008u, 0) == 19);   // nothing follows (end of the ROM)
+    CHECK(words_to_decode(19, 0x00461021u, 4) == 19);   // ends on an ordinary instruction
+    CHECK(words_to_decode(0, 0x00200008u, 4) == 0);
+}
diff --git a/librecomp/tests/wcw/retrace_codes_rules_tests.cpp b/librecomp/tests/wcw/retrace_codes_rules_tests.cpp
new file mode 100644
index 0000000..f2caf62
--- /dev/null
+++ b/librecomp/tests/wcw/retrace_codes_rules_tests.cpp
@@ -0,0 +1,59 @@
+//
+// librecomp
+//
+
+// [wcw] Unit tests for librecomp/retrace_codes_rules (aki-roadmap#324): conversion codes on every VI retrace message.
+
+#include "librecomp/retrace_codes_rules.hpp"
+#include "ultramodern/ultramodern.hpp"
+
+#include "wcw_test.h"
+
+using namespace recomp::retrace_codes;
+
+TEST_CASE("retrace codes: only the registered queue and message are a retrace") {
+    // No Mercy registers its scheduler's queue with message 0x29A
+    CHECK(is_retrace(0x80057188 + 0x40, 0x29A, 0x80057188 + 0x40, 0x29A));
+    CHECK(!is_retrace(0x80057188 + 0x40, 0x29D, 0x80057188 + 0x40, 0x29A));   // the same queue's other message (pre-NMI)
+    CHECK(!is_retrace(0x80060000, 0x29A, 0x80057188 + 0x40, 0x29A));          // another queue
+    CHECK(!is_retrace(0, 0, 0, 0));                                           // no osViSetEvent yet
+    CHECK(!is_retrace(0x80057188, 0, 0, 0));
+    // a re-registration (WCW at the end of its attract): the same queue with a new message
+    CHECK(!is_retrace(0x800571C8, 0x29A, 0x800571C8, 0x2A0));
+    CHECK(is_retrace(0x800571C8, 0x2A0, 0x800571C8, 0x2A0));
+    // osRecvMesg calls the same check
+    CHECK(ultramodern::is_vi_retrace_message(0x800571C8, 0x2A0, 0x800571C8, 0x2A0) == is_retrace(0x800571C8, 0x2A0, 0x800571C8, 0x2A0));
+    CHECK(!ultramodern::is_vi_retrace_message(0, 0, 0, 0));
+}
+
+TEST_CASE("retrace codes: the frame hook runs them until retraces do") {
+    FrameGate g;
+    CHECK(g.retrace_count() == 0);
+    CHECK(g.frame_should_apply(0));           // the first install: the first frames apply before any retrace has
+    CHECK(g.frame_should_apply(1000));        // nothing from retraces yet: the frame hook keeps the codes running
+    g.on_retrace(1000);
+    CHECK(!g.frame_should_apply(1010));       // retraces run them: the frame hook doesn't again
+    CHECK(!g.frame_should_apply(1000 + RetraceQuietMs));
+    CHECK(g.frame_should_apply(1000 + RetraceQuietMs + 1));   // retraces stopped (a game that unregisters): frames again
+    g.on_retrace(2000);
+    CHECK(!g.frame_should_apply(2016));
+    CHECK(g.frame_should_apply(1999));        // a clock that went back doesn't stop the codes
+    CHECK(g.retrace_count() == 2);
+}
+
+TEST_CASE("retrace codes: a counter that moves 2 per frame is seen at every value once per retrace") {
+    // The Legends case: the counter's low byte rises once a retrace; the game makes a frame every other retrace.
+    int seen_frame[256] = {}, seen_retrace[256] = {};
+    for (int retrace = 0; retrace < 512; retrace++) {
+        const int counter = (retrace + 1) & 0xFF;     // an odd phase: the frame hook only ever sees odd values
+        seen_retrace[counter] = 1;
+        if ((retrace % 2) == 0) seen_frame[counter] = 1;
+    }
+    int frame_evens = 0, retrace_all = 0;
+    for (int v = 0; v < 256; v++) {
+        frame_evens += ((v % 2) == 0) && seen_frame[v];
+        retrace_all += seen_retrace[v];
+    }
+    CHECK(frame_evens == 0);       // 02, 06, ... 22 and the reset at 24 never match once a frame
+    CHECK(retrace_all == 256);     // once a retrace, every value comes by
+}
diff --git a/librecomp/tests/wcw/save_backup_rules_tests.cpp b/librecomp/tests/wcw/save_backup_rules_tests.cpp
new file mode 100644
index 0000000..6d5a504
--- /dev/null
+++ b/librecomp/tests/wcw/save_backup_rules_tests.cpp
@@ -0,0 +1,127 @@
+//
+// librecomp
+//
+
+// [wcw] Unit tests for librecomp/save_backup_rules (automatic save backups, aki-roadmap#50). Built and run as part of
+// every librecomp build (LIBRECOMP_WCW_TESTS); a failure fails the build.
+
+#include "librecomp/save_backup_rules.hpp"
+
+#include <algorithm>
+#include <string>
+#include <vector>
+
+#include "wcw_test.h"
+
+using namespace recomp::save_backups;
+
+static Timestamp at(int y, int mo, int d, int h, int mi, int s) {
+    return Timestamp{ y, mo, d, h, mi, s };
+}
+
+// Names
+
+TEST_CASE("names: a backup is the save's name with a sortable timestamp before .bin") {
+    CHECK(backup_file_name("wwf.nomercy.us.bin", at(2026, 10, 14, 3, 15, 2)) == "wwf.nomercy.us.20261014-031502.bin");
+    CHECK(backup_file_name("wwf.nomercy.us.pak.bin", at(2026, 1, 2, 23, 59, 59)) == "wwf.nomercy.us.pak.20260102-235959.bin");
+}
+
+TEST_CASE("names: a backup name parses back to its timestamp") {
+    const Timestamp t = at(2026, 10, 14, 3, 15, 2);
+    const auto parsed = parse_backup_file_name("wwf.nomercy.us.bin", backup_file_name("wwf.nomercy.us.bin", t));
+    CHECK(parsed.has_value());
+    CHECK(parsed.has_value() && (*parsed == t));
+}
+
+TEST_CASE("names: the main save and its pak file never claim each other's backups") {
+    const std::string mainBackup = backup_file_name("wcw.bin", at(2026, 10, 14, 3, 15, 2));
+    const std::string pakBackup = backup_file_name("wcw.pak.bin", at(2026, 10, 14, 3, 15, 2));
+    CHECK(!parse_backup_file_name("wcw.bin", pakBackup).has_value());
+    CHECK(!parse_backup_file_name("wcw.pak.bin", mainBackup).has_value());
+    CHECK(parse_backup_file_name("wcw.pak.bin", pakBackup).has_value());
+}
+
+TEST_CASE("names: other files are not backups (no restore of stray or malformed files)") {
+    const std::string save = "vpw.vpw2.jp.bin";
+    CHECK(!parse_backup_file_name(save, "vpw.vpw2.jp.bin").has_value());
+    CHECK(!parse_backup_file_name(save, "vpw.vpw2.jp.bin.bak").has_value());
+    CHECK(!parse_backup_file_name(save, "restore.txt").has_value());
+    CHECK(!parse_backup_file_name(save, "vpw.vpw2.jp.2026101-031502.bin").has_value());
+    CHECK(!parse_backup_file_name(save, "vpw.vpw2.jp.20261014_031502.bin").has_value());
+    CHECK(!parse_backup_file_name(save, "vpw.vpw2.jp.20261314-031502.bin").has_value());
+    CHECK(!parse_backup_file_name(save, "vpw.vpw2.jp.20261014-251502.bin").has_value());
+    CHECK(!parse_backup_file_name(save, "other.20261014-031502.bin").has_value());
+}
+
+// Rotation
+
+TEST_CASE("rotation: listing is newest first, across days and years") {
+    const std::string save = "s.bin";
+    const std::vector<std::string> names = {
+        backup_file_name(save, at(2025, 12, 31, 23, 0, 0)),
+        backup_file_name(save, at(2026, 1, 1, 0, 0, 1)),
+        "s.bin", "junk.txt",
+        backup_file_name(save, at(2026, 1, 1, 0, 0, 0)),
+    };
+    const std::vector<std::string> sorted = backups_newest_first(save, names);
+    CHECK_EQ(sorted.size(), size_t(3));
+    CHECK(sorted[0] == backup_file_name(save, at(2026, 1, 1, 0, 0, 1)));
+    CHECK(sorted[2] == backup_file_name(save, at(2025, 12, 31, 23, 0, 0)));
+}
+
+TEST_CASE("rotation: the oldest beyond the limit are deleted, oldest first") {
+    const std::string save = "s.bin";
+    std::vector<std::string> names;
+    for (int m = 0; m < 13; m++) {
+        names.push_back(backup_file_name(save, at(2026, 10, 14, 12, m, 0)));
+    }
+    std::reverse(names.begin(), names.end());
+
+    const std::vector<std::string> doomed = backups_to_delete(save, names, MaxBackupsPerFile);
+    CHECK_EQ(doomed.size(), size_t(3));
+    CHECK(doomed[0] == backup_file_name(save, at(2026, 10, 14, 12, 0, 0)));
+    CHECK(doomed[2] == backup_file_name(save, at(2026, 10, 14, 12, 2, 0)));
+}
+
+TEST_CASE("rotation: never deletes another file's backups or anything that isn't a backup") {
+    const std::string save = "s.bin";
+    std::vector<std::string> names = { "s.pak.20200101-000000.bin", "s.bin", "notes.txt" };
+    for (int m = 0; m < 12; m++) {
+        names.push_back(backup_file_name(save, at(2026, 10, 14, 12, m, 0)));
+    }
+    for (const std::string &name : backups_to_delete(save, names, MaxBackupsPerFile)) {
+        CHECK(parse_backup_file_name(save, name).has_value());
+    }
+    CHECK(backups_to_delete(save, { "s.bin", "notes.txt" }, MaxBackupsPerFile).empty());
+}
+
+// When a backup is due
+
+TEST_CASE("due: launch and before-restore backups are always taken") {
+    const Timestamp now = at(2026, 10, 14, 3, 0, 0);
+    CHECK(backup_due(BackupReason::Launch, now, now));
+    CHECK(backup_due(BackupReason::BeforeRestore, now, now));
+    CHECK(backup_due(BackupReason::Launch, std::nullopt, now));
+}
+
+TEST_CASE("due: change backups are rate-limited so a game that saves constantly can't rotate out every backup") {
+    const Timestamp now = at(2026, 10, 14, 3, 30, 0);
+    CHECK(backup_due(BackupReason::Change, std::nullopt, now));
+    CHECK(!backup_due(BackupReason::Change, at(2026, 10, 14, 3, 25, 0), now));
+    CHECK(!backup_due(BackupReason::Change, at(2026, 10, 14, 3, 20, 1), now));
+    CHECK(backup_due(BackupReason::Change, at(2026, 10, 14, 3, 20, 0), now));
+    // Across midnight and month ends.
+    CHECK(backup_due(BackupReason::Change, at(2026, 9, 30, 23, 55, 0), at(2026, 10, 1, 0, 5, 0)));
+    CHECK(!backup_due(BackupReason::Change, at(2026, 9, 30, 23, 55, 0), at(2026, 10, 1, 0, 4, 59)));
+}
+
+TEST_CASE("due: a clock set back never stops change backups") {
+    CHECK(backup_due(BackupReason::Change, at(2027, 1, 1, 0, 0, 0), at(2026, 10, 14, 3, 0, 0)));
+}
+
+TEST_CASE("time: exact differences, including leap days") {
+    CHECK_EQ(seconds_between(at(2024, 2, 28, 0, 0, 0), at(2024, 3, 1, 0, 0, 0)), int64_t(2 * 86400));
+    CHECK_EQ(seconds_between(at(2026, 2, 28, 0, 0, 0), at(2026, 3, 1, 0, 0, 0)), int64_t(86400));
+    CHECK_EQ(at(1970, 1, 1, 0, 0, 1).sort_key(), int64_t(1));
+    CHECK(display_time(at(2026, 10, 14, 3, 15, 2)) == "2026-10-14 03:15:02");
+}
