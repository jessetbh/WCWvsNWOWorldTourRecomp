diff --git a/librecomp/tests/wcw/packages_migrate_tests.cpp b/librecomp/tests/wcw/packages_migrate_tests.cpp
new file mode 100644
index 0000000..0de4b15
--- /dev/null
+++ b/librecomp/tests/wcw/packages_migrate_tests.cpp
@@ -0,0 +1,242 @@
+//
+// librecomp
+//
+
+// [wcw] Unit tests for the migration to the package registry (aki-roadmap#154 step 3).
+// Built and run as part of every librecomp build (LIBRECOMP_WCW_TESTS); a failure fails the build.
+
+#include "librecomp/packages.hpp"
+#include "librecomp/conversion.hpp"
+
+#include <algorithm>
+#include <chrono>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <map>
+#include <string>
+#include <vector>
+
+#include "json/json.hpp"
+#include "miniz.h"
+#include "miniz_zip.h"
+#include "wcw_test.h"
+
+using namespace recomp::packages;
+namespace fs = std::filesystem;
+
+namespace {
+    void write(const fs::path &p, const std::string &data) {
+        fs::create_directories(p.parent_path());
+        std::ofstream f(p, std::ios::binary | std::ios::trunc);
+        f << data;
+    }
+
+    std::string read(const fs::path &p) {
+        std::ifstream f(p, std::ios::binary);
+        return std::string((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>());
+    }
+
+    struct TempDir {
+        fs::path path;
+        TempDir() {
+            static int n = 0;
+            path = fs::temp_directory_path() / ("wcw_pkg_migrate_test_" +
+                std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()) + "_" + std::to_string(n++));
+            fs::create_directories(path);
+        }
+        ~TempDir() {
+            std::error_code ec;
+            fs::remove_all(path, ec);
+        }
+    };
+
+    void make_zip(const fs::path &zip, const std::map<std::string, std::string> &entries) {
+        fs::create_directories(zip.parent_path());
+        mz_zip_archive a{};
+        mz_zip_writer_init_file(&a, zip.string().c_str(), 0);
+        for (const auto &[name, data] : entries) {
+            mz_zip_writer_add_mem(&a, name.c_str(), data.data(), data.size(), MZ_DEFAULT_COMPRESSION);
+        }
+        mz_zip_writer_finalize_archive(&a);
+        mz_zip_writer_end(&a);
+    }
+
+    std::string mod_json(const std::string &id, const std::string &version) {
+        return "{\"id\": \"" + id + "\", \"display_name\": \"" + id + " name\", \"version\": \"" + version + "\", \"authors\": [\"A\"], \"game_id\": \"wwfnomercy\"}";
+    }
+
+    MigrateOptions opts() {
+        MigrateOptions o;
+        o.game_id = "wwfnomercy";
+        o.rom_sha1 = "0123456789abcdef0123456789abcdef01234567";
+        o.now = "2026-10-29T12:00:00Z";
+        return o;
+    }
+
+    // A data folder as players have it today.
+    void populate(const fs::path &data) {
+        make_zip(data / "mods" / "aki_camera.nrm", { { "mod.json", mod_json("aki_camera", "0.7.0") }, { "mod_binary.bin", "code" } });
+        make_zip(data / "mods" / "nm_unlocked.nrm", { { "mod.json", mod_json("nm_unlocked", "1.0.0") }, { "patch.bps", "bps" } });
+        make_zip(data / "mods" / "nmp_hack.nrm", { { "mod.json", mod_json("nmp_hack", "2.1.0") }, { "patch.bps", "bps2" } });
+        make_zip(data / "mods" / "Bad_Id.nrm", { { "mod.json", mod_json("Bad_Id", "1.0.0") }, { "mod_binary.bin", "code" } });
+        make_zip(data / "mods" / "arena.rtz", { { "rt64.json", "{}" } });
+        write(data / "mods" / "loose_pack" / "rt64.json", "{}");
+        write(data / "mods" / "models" / "q-robot.akimodel" / "pack.json", "{\"id\": \"q-robot\", \"version\": \"1.3.0\", \"name\": \"Robot\"}");
+        write(data / "mods" / "models" / "mine.akimodel" / "pack.json", "{\"id\": \"mine\"}");
+        write(data / "mods" / "models" / ".bundled", "q-robot.akimodel\n");
+        write(data / "conversions" / "aew64" / "aki.json", "{\"format\": \"aki-conversion\", \"format_version\": 1, \"id\": \"aew64\", \"name\": \"AEW 64\", "
+            "\"version\": \"1.0.0\", \"components\": {\"patch\": {\"file\": \"patch.nrm\"}}}");
+        write(data / "conversions" / "_packages" / "shared.rtz", "x");
+        write(data / "saves" / "nmp_hack" / "slot.sram", "save");
+        write(data / "mods.json", "{\"enabled_mods\": [\"aki_camera\", \"nmp_hack\", \"nm_unlocked\"], \"mod_order\": [\"nmp_hack\", \"aki_camera\", \"nm_unlocked\"]}");
+    }
+}
+
+TEST_CASE("migrate: patch hacks become conversions, the first enabled one is chosen") {
+    TempDir t;
+    const fs::path data = t.path / "data";
+    populate(data);
+    const MigrateReport r = migrate(data, opts());
+    CHECK(r.ran);
+    CHECK(r.moved == (std::vector<std::string>{ "nm_unlocked", "nmp_hack" }));
+    CHECK(!fs::exists(data / "mods" / "nmp_hack.nrm"));
+    CHECK(fs::exists(data / "conversions" / "nmp_hack" / "patch.nrm"));
+    const nlohmann::json aki = nlohmann::json::parse(read(data / "conversions" / "nmp_hack" / "aki.json"));
+    CHECK(aki["format"] == "aki-conversion" && aki["format_version"] == 1 && aki["id"] == "nmp_hack");
+    CHECK(aki["game"] == "nomercy" && aki["version"] == "2.1.0");
+    CHECK(aki["components"]["patch"]["file"] == "patch.nrm");
+    CHECK(aki["base_rom"]["sha1"] == "0123456789ABCDEF0123456789ABCDEF01234567");
+    // The runtime's own loader accepts it (what decides whether the hack still plays).
+    recomp::mods::conversion::Conversion c;
+    std::string why;
+    CHECK(recomp::mods::conversion::parse(read(data / "conversions" / "nmp_hack" / "aki.json"), "nmp_hack", c, why));
+    CHECK(c.has_patch);
+    CHECK(r.chosen == "nmp_hack");                              // first in mod order
+    CHECK(r.also_enabled == std::vector<std::string>{ "nm_unlocked" });
+    CHECK(read(data / "conversions" / "active.txt") == "nmp_hack\n");
+    CHECK(read(data / "saves" / "nmp_hack" / "slot.sram") == "save");   // saves untouched, same folder
+}
+
+TEST_CASE("migrate: what is installed is recorded; bad ids stay manual; the marker stops a second run") {
+    TempDir t;
+    const fs::path data = t.path / "data";
+    populate(data);
+    const MigrateReport r = migrate(data, opts());
+    Registry reg;
+    CHECK(load_registry(data, reg) == RegistryStatus::Ok);
+    auto kind_of = [&](const char *id) { const Entry *e = find(reg, id); return e ? std::string(kind_name(e->kind)) : std::string("-"); };
+    CHECK(kind_of("aki_camera") == "addon");
+    CHECK(kind_of("nmp_hack") == "conversion");
+    CHECK(kind_of("nm_unlocked") == "conversion");
+    CHECK(kind_of("aew64") == "conversion");
+    CHECK(kind_of("arena") == "texture-pack");
+    CHECK(kind_of("loose_pack") == "texture-pack");
+    CHECK(kind_of("mine") == "model-pack");
+    CHECK(kind_of("Bad_Id") == "-");                            // not a package id: stays a manual install
+    CHECK(!find(reg, "_packages") && !find(reg, "models"));
+    CHECK(!find(reg, "q-robot"));                               // the game's own starter pack: not recorded
+    CHECK(find(reg, "mine")->source == "migrated" && find(reg, "mine")->version == "0.0.0");
+    CHECK(find(reg, "aki_camera")->version == "0.7.0");
+    CHECK(find(reg, "nmp_hack")->files[0].path == "conversions/nmp_hack");
+    CHECK(find(reg, "aki_camera")->files[0].hash == *hash_path(data / "mods" / "aki_camera.nrm"));
+    CHECK(fs::exists(data / MigrationMarker));
+    CHECK(read(data / MigrationLog).find("Bad_Id") != std::string::npos);
+    CHECK(migration_done(data));
+    CHECK(!migrate(data, opts()).ran);                          // once per data folder
+    CHECK(fs::exists(data / "mods" / "Bad_Id.nrm"));            // nothing deleted
+}
+
+TEST_CASE("migrate: a dry run changes nothing") {
+    TempDir t;
+    const fs::path data = t.path / "data";
+    populate(data);
+    MigrateOptions o = opts();
+    o.dry_run = true;
+    const MigrateReport r = migrate(data, o);
+    CHECK(r.ran);
+    CHECK(r.moved.size() == 2);
+    CHECK(std::find(r.recorded.begin(), r.recorded.end(), "nmp_hack") != r.recorded.end());
+    CHECK(fs::exists(data / "mods" / "nmp_hack.nrm"));
+    CHECK(!fs::exists(data / "conversions" / "nmp_hack"));
+    CHECK(!fs::exists(data / RegistryFile));
+    CHECK(!fs::exists(data / MigrationMarker));
+    CHECK(!fs::exists(data / "conversions" / "active.txt"));
+}
+
+TEST_CASE("migrate: an existing choice, a taken id and a newer registry are respected") {
+    TempDir t;
+    const fs::path data = t.path / "data";
+    populate(data);
+    write(data / "conversions" / "active.txt", "aew64\n");
+    write(data / "conversions" / "nm_unlocked" / "aki.json", "{\"format\": \"aki-conversion\", \"format_version\": 1, \"id\": \"nm_unlocked\"}");
+    const MigrateReport r = migrate(data, opts());
+    CHECK(read(data / "conversions" / "active.txt") == "aew64\n");   // the player's choice stays
+    CHECK(r.chosen.empty());
+    CHECK(fs::exists(data / "mods" / "nm_unlocked.nrm"));           // its conversion id is taken: left alone
+    CHECK(std::find(r.moved.begin(), r.moved.end(), "nm_unlocked") == r.moved.end());
+
+    TempDir t2;
+    const fs::path d2 = t2.path / "data";
+    populate(d2);
+    write(d2 / RegistryFile, "{\"format\": 2, \"packages\": []}");
+    CHECK(!migrate(d2, opts()).ran);
+    CHECK(fs::exists(d2 / "mods" / "nmp_hack.nrm"));
+    CHECK(!fs::exists(d2 / MigrationMarker));
+}
+
+TEST_CASE("migrate: an empty data folder just gets the marker") {
+    TempDir t;
+    const MigrateReport r = migrate(t.path, opts());
+    CHECK(r.ran && r.recorded.empty() && r.moved.empty());
+    CHECK(migration_done(t.path));
+}
+
+// Step 3 review findings.
+
+TEST_CASE("migrate: a wrong-typed field doesn't stop the run; the choice is still written") {
+    TempDir t;
+    const fs::path data = t.path / "data";
+    make_zip(data / "mods" / "a_bad.nrm", { { "mod.json", "{\"id\": \"a_bad\", \"version\": 1, \"display_name\": null}" }, { "patch.bps", "x" } });
+    make_zip(data / "mods" / "b_hack.nrm", { { "mod.json", mod_json("b_hack", "1.0.0") }, { "patch.bps", "y" } });
+    make_zip(data / "mods" / "c_addon.nrm", { { "mod.json", "{\"id\": \"c_addon\", \"version\": [1]}" }, { "mod_binary.bin", "code" } });
+    write(data / "conversions" / "d_conv" / "aki.json", "{\"format\": \"aki-conversion\", \"name\": 5, \"version\": {}}");
+    write(data / "mods.json", "{\"enabled_mods\": [\"b_hack\"], \"mod_order\": [\"b_hack\"]}");
+    const MigrateReport r = migrate(data, opts());
+    CHECK(r.ran);
+    CHECK(std::find(r.moved.begin(), r.moved.end(), "b_hack") != r.moved.end());
+    CHECK(r.chosen == "b_hack");
+    CHECK(read(data / "conversions" / "active.txt") == "b_hack\n");
+    Registry reg;
+    load_registry(data, reg);
+    CHECK(find(reg, "c_addon") && find(reg, "c_addon")->version == "0.0.0");
+    CHECK(find(reg, "d_conv"));
+    CHECK(migration_done(data));
+}
+
+TEST_CASE("migrate: file names inside a zip are case-sensitive, like the runtime") {
+    TempDir t;
+    const fs::path data = t.path / "data";
+    make_zip(data / "mods" / "odd.nrm", { { "mod.json", mod_json("odd", "1.0.0") }, { "Patch.bps", "x" } });   // not a patch mod to the runtime
+    const MigrateReport r = migrate(data, opts());
+    CHECK(r.moved.empty());
+    CHECK(fs::exists(data / "mods" / "odd.nrm"));
+}
+
+TEST_CASE("migrate: the game's bundled files aren't recorded; the log is appended") {
+    TempDir t;
+    const fs::path data = t.path / "data";
+    populate(data);
+    write(data / MigrationLog, "earlier line\n");
+    MigrateOptions o = opts();
+    o.bundled_names = { "aki_camera.nrm", "arena.rtz" };
+    migrate(data, o);
+    Registry reg;
+    load_registry(data, reg);
+    CHECK(!find(reg, "aki_camera"));
+    CHECK(!find(reg, "arena"));
+    CHECK(find(reg, "loose_pack"));
+    const std::string log = read(data / MigrationLog);
+    CHECK(log.rfind("earlier line\n", 0) == 0);
+    CHECK(log.find("package migration") != std::string::npos);
+}
diff --git a/librecomp/tests/wcw/packages_tests.cpp b/librecomp/tests/wcw/packages_tests.cpp
new file mode 100644
index 0000000..3a40fdb
--- /dev/null
+++ b/librecomp/tests/wcw/packages_tests.cpp
@@ -0,0 +1,444 @@
+//
+// librecomp
+//
+
+// [wcw] Unit tests for librecomp/packages (aki-package.json manifests and the packages.json registry, aki-roadmap#154).
+// Built and run as part of every librecomp build (LIBRECOMP_WCW_TESTS); a failure fails the build.
+
+#include "librecomp/packages.hpp"
+#include "librecomp/bundled_packs.hpp"
+
+#include <algorithm>
+#include <chrono>
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <vector>
+
+#include "wcw_test.h"
+
+using namespace recomp::packages;
+namespace fs = std::filesystem;
+
+namespace {
+    void write(const fs::path &p, const std::string &data) {
+        fs::create_directories(p.parent_path());
+        std::ofstream f(p, std::ios::binary | std::ios::trunc);
+        f << data;
+    }
+
+    struct TempDir {
+        fs::path path;
+        TempDir() {
+            path = fs::temp_directory_path() /
+                ("wcw_packages_test_" + std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+            fs::create_directories(path);
+        }
+        ~TempDir() {
+            std::error_code ec;
+            fs::remove_all(path, ec);
+        }
+    };
+
+    const char *Sha = "0123456789abcdef0123456789ABCDEF01234567";
+
+    std::string manifest(const std::string &kind, const std::string &payload, const std::string &extra = "") {
+        return std::string("{\"format\": 1, \"kind\": \"") + kind + "\", \"id\": \"nmp_v3\", \"version\": \"3.0.0\", "
+            "\"game_id\": \"wwfnomercy\", \"display_name\": \"No Mercy Plus V3\", \"authors\": [\"A\"], "
+            "\"payload\": " + payload + extra + "}";
+    }
+
+    bool has_error(const std::vector<Problem> &problems, const std::string &field) {
+        return std::any_of(problems.begin(), problems.end(), [&](const Problem &p) { return p.error && p.field == field; });
+    }
+
+    Entry entry(const std::string &id, Kind kind, std::vector<InstalledFile> files) {
+        Entry e;
+        e.id = id;
+        e.kind = kind;
+        e.version = "1.0.0";
+        e.source = "launcher";
+        e.files = std::move(files);
+        return e;
+    }
+}
+
+TEST_CASE("packages: kind names round-trip") {
+    for (Kind k : { Kind::Addon, Kind::TexturePack, Kind::ModelPack, Kind::Conversion }) {
+        CHECK(parse_kind(kind_name(k)) == k);
+    }
+    CHECK(!parse_kind("mod"));
+    CHECK(!parse_kind(""));
+}
+
+TEST_CASE("packages: ids") {
+    CHECK(valid_id("nmp_v3"));
+    CHECK(valid_id("a"));
+    CHECK(valid_id("0day.pack-2"));
+    CHECK(valid_id(std::string(48, 'a')));
+    CHECK(!valid_id(std::string(49, 'a')));    // a conversion id must fit (conversion::valid_id: 48)
+    CHECK(!valid_id(""));
+    CHECK(!valid_id("_hidden"));
+    CHECK(!valid_id(".x"));
+    CHECK(!valid_id("-x"));
+    CHECK(!valid_id("NMP"));
+    CHECK(!valid_id("a b"));
+    CHECK(!valid_id("a/b"));
+}
+
+TEST_CASE("packages: versions") {
+    CHECK(valid_version("1.2.3"));
+    CHECK(valid_version("10.0.0-beta.1"));
+    CHECK(!valid_version("1.2"));
+    CHECK(!valid_version("1.2.3."));
+    CHECK(!valid_version("v1.2.3"));
+    CHECK(!valid_version("1.2.3-"));
+    CHECK(!valid_version("1.2.3+build"));
+    CHECK(compare_versions("1.10.0", "1.9.0") > 0);
+    CHECK(compare_versions("1.2.0", "1.2.0") == 0);
+    CHECK(compare_versions("1.2.0-beta", "1.2.0") < 0);     // a release beats its prerelease
+    CHECK(compare_versions("1.2.0", "1.2.0-rc.1") > 0);
+    CHECK(compare_versions("1.2.0-alpha", "1.2.0-beta") < 0);
+    CHECK(compare_versions("1.3.0-alpha", "1.2.9") > 0);
+}
+
+TEST_CASE("packages: game ids map to the short keys") {
+    CHECK(game_id_for_key("nomercy") == "wwfnomercy");
+    CHECK(key_for_game_id("wcwnwoworldtour") == "wt");
+    CHECK(key_for_game_id("vpw2") == "vpw2");
+    CHECK(game_id_for_key("wwfnomercy").empty());
+    CHECK(key_for_game_id("nomercy").empty());
+}
+
+TEST_CASE("packages: safe relative paths") {
+    CHECK(safe_relative_path("a.nrm"));
+    CHECK(safe_relative_path("conversion/"));
+    CHECK(safe_relative_path("packs/q-robot.akimodel"));
+    CHECK(!safe_relative_path(""));
+    CHECK(!safe_relative_path("/abs"));
+    CHECK(!safe_relative_path("C:/x"));
+    CHECK(!safe_relative_path("a\\b"));
+    CHECK(!safe_relative_path("../x"));
+    CHECK(!safe_relative_path("a/../b"));
+    CHECK(!safe_relative_path("a/./b"));
+    CHECK(!safe_relative_path("a//b"));
+    CHECK(!safe_relative_path("a//"));
+}
+
+TEST_CASE("packages: an addon manifest parses") {
+    Manifest m;
+    std::vector<Problem> p;
+    const std::string text = manifest("addon", "{\"nrm\": \"aki_camera.nrm\"}",
+        ", \"license\": \"GPL-3.0-only\", \"requires\": {\"minimum_recomp_version\": \"1.2.0\", \"packages\": [\"aki_cheats\"]},"
+        " \"permission\": {\"redistribute\": \"yes\", \"statement\": \"ok\"}, \"replaces\": [\"camera_old\"]");
+    CHECK(parse_manifest(text, m, p));
+    CHECK(p.empty());
+    CHECK(m.kind == Kind::Addon);
+    CHECK(m.id == "nmp_v3");
+    CHECK(m.game_id == "wwfnomercy");
+    CHECK(m.nrm == "aki_camera.nrm");
+    CHECK(m.requires_recomp == "1.2.0");
+    CHECK(m.requires_packages.size() == 1);
+    CHECK(m.permission.redistribute == "yes");
+    CHECK(m.replaces.size() == 1);
+    CHECK(payload_paths(m) == std::vector<std::string>{ "aki_camera.nrm" });
+}
+
+TEST_CASE("packages: texture, model and conversion payloads") {
+    Manifest m;
+    std::vector<Problem> p;
+    CHECK(parse_manifest(manifest("texture-pack", "{\"rtz\": \"arena.rtz\"}"), m, p));
+    CHECK(parse_manifest(manifest("texture-pack", "{\"folder\": \"arena/\"}"), m, p));
+    CHECK(m.folder == "arena/");
+    CHECK(parse_manifest(manifest("model-pack", "{\"packs\": [\"q-robot.akimodel/\", \"q-monk.akimodel\"], \"hd\": [\"q-robot-hd.rtz\"]}"), m, p));
+    CHECK(payload_paths(m).size() == 3);
+    const std::string rom = std::string(", \"base_rom\": {\"sha1\": [\"") + Sha + "\"], \"name\": \"WWF No Mercy (USA) (Rev 1)\"}";
+    CHECK(parse_manifest(manifest("conversion", "{\"folder\": \"conversion\", \"addons\": [\"nmp.rtz\"]}", rom), m, p));
+    CHECK(p.empty());
+    CHECK(m.base_rom_sha1.size() == 1);
+    CHECK(m.base_rom_sha1[0] == "0123456789abcdef0123456789abcdef01234567");   // lower-cased
+    CHECK(payload_paths(m) == (std::vector<std::string>{ "conversion", "nmp.rtz" }));
+}
+
+TEST_CASE("packages: every missing required field is reported") {
+    Manifest m;
+    std::vector<Problem> p;
+    CHECK(!parse_manifest("{}", m, p));
+    for (const char *f : { "format", "kind", "id", "version", "game_id", "display_name", "authors", "payload" }) {
+        CHECK(has_error(p, f));
+    }
+    p.clear();
+    CHECK(!parse_manifest("[1]", m, p));
+    CHECK(p.size() == 1);
+    p.clear();
+    CHECK(!parse_manifest("not json", m, p));
+}
+
+TEST_CASE("packages: bad values are errors") {
+    Manifest m;
+    std::vector<Problem> p;
+    CHECK(!parse_manifest(manifest("addon", "{\"nrm\": \"a.nrm\"}").replace(11, 1, "2"), m, p));   // format 2
+    CHECK(has_error(p, "format"));
+    p.clear();
+    std::string bad_game = manifest("addon", "{\"nrm\": \"a.nrm\"}");
+    bad_game.replace(bad_game.find("wwfnomercy"), 10, "nomercy");
+    CHECK(!parse_manifest(bad_game, m, p));
+    CHECK(has_error(p, "game_id"));
+    CHECK(p.back().message.find("wwfnomercy") != std::string::npos);   // names the right id
+    p.clear();
+    CHECK(!parse_manifest(manifest("conversion", "{\"folder\": \"c\"}"), m, p));    // no base_rom
+    CHECK(has_error(p, "base_rom.sha1"));
+    p.clear();
+    CHECK(!parse_manifest(manifest("addon", "{\"nrm\": \"../evil.nrm\"}"), m, p));
+    CHECK(has_error(p, "payload.nrm"));
+    p.clear();
+    CHECK(!parse_manifest(manifest("addon", "{\"rtz\": \"a.rtz\"}"), m, p));        // wrong payload for the kind
+    CHECK(has_error(p, "payload.nrm"));
+    p.clear();
+    CHECK(!parse_manifest(manifest("texture-pack", "{\"rtz\": \"a.rtz\", \"folder\": \"b\"}"), m, p));
+    CHECK(has_error(p, "payload"));
+    p.clear();
+    CHECK(!parse_manifest(manifest("model-pack", "{\"packs\": [\"q-robot\"]}"), m, p));
+    CHECK(has_error(p, "payload.packs"));
+    p.clear();
+    CHECK(!parse_manifest(manifest("addon", "{\"nrm\": \"a.nrm\"}", ", \"replaces\": [\"nmp_v3\"]"), m, p));
+    CHECK(has_error(p, "replaces"));
