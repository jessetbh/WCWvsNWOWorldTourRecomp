+TEST_CASE("conversion codes: no size cap (a 300,000-code table)") {
+    std::string text = "# rom: nomercy-rev1\n";
+    for (int i = 0; i < 300000; i++) {
+        char line[32];
+        snprintf(line, sizeof(line), "80%06X 00%02X\n", 0x1000 + (i % 0xE000), i & 0xFF);
+        text += line;
