+            const SectionTableEntry& o = sections_info.code_sections[j];
+            if (s.ram_addr < o.ram_addr + (int32_t)o.size && o.ram_addr < s.ram_addr + (int32_t)s.size) {
+                conflict = true; break;
+            }
