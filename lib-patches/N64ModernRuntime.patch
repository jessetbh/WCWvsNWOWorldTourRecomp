@@ -0,0 +1,138 @@
+#include "librecomp/save_backup_rules.hpp"
+
+#include <algorithm>
+#include <cstdio>
+
+namespace recomp {
+    namespace save_backups {
+        // Days since 1970-01-01 for a proleptic Gregorian date (Howard Hinnant's days_from_civil).
+        static int64_t days_from_civil(int64_t y, int64_t m, int64_t d) {
+            y -= (m <= 2) ? 1 : 0;
+            const int64_t era = ((y >= 0) ? y : (y - 399)) / 400;
+            const int64_t yoe = y - era * 400;
+            const int64_t doy = (153 * (m + ((m > 2) ? -3 : 9)) + 2) / 5 + d - 1;
+            const int64_t doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+            return era * 146097 + doe - 719468;
+        }
+
+        int64_t Timestamp::sort_key() const {
+            return days_from_civil(year, month, day) * 86400 + int64_t(hour) * 3600 + int64_t(minute) * 60 + second;
+        }
+
+        int64_t seconds_between(const Timestamp &a, const Timestamp &b) {
+            return b.sort_key() - a.sort_key();
+        }
+
+        static std::string stem_of(const std::string &save_file_name) {
+            const std::string ext = ".bin";
+            if ((save_file_name.size() > ext.size()) && (save_file_name.compare(save_file_name.size() - ext.size(), ext.size(), ext) == 0)) {
+                return save_file_name.substr(0, save_file_name.size() - ext.size());
+            }
+
+            return save_file_name;
+        }
+
+        std::string backup_file_name(const std::string &save_file_name, const Timestamp &when) {
+            char stamp[32];
+            snprintf(stamp, sizeof(stamp), "%04d%02d%02d-%02d%02d%02d", when.year, when.month, when.day, when.hour, when.minute, when.second);
+            return stem_of(save_file_name) + "." + stamp + ".bin";
+        }
+
+        static bool parse_digits(const std::string &s, size_t pos, size_t count, int &out) {
+            out = 0;
+            for (size_t i = pos; i < pos + count; i++) {
+                if ((s[i] < '0') || (s[i] > '9')) {
+                    return false;
+                }
+
+                out = out * 10 + (s[i] - '0');
+            }
+
+            return true;
+        }
+
+        std::optional<Timestamp> parse_backup_file_name(const std::string &save_file_name, const std::string &candidate) {
+            // <stem>.YYYYMMDD-HHMMSS.bin
+            const std::string stem = stem_of(save_file_name);
+            const size_t stampLength = 15;
+            const std::string ext = ".bin";
+            if (candidate.size() != stem.size() + 1 + stampLength + ext.size()) {
+                return std::nullopt;
+            }
+
+            if ((candidate.compare(0, stem.size(), stem) != 0) || (candidate[stem.size()] != '.') ||
+                (candidate.compare(candidate.size() - ext.size(), ext.size(), ext) != 0))
+            {
+                return std::nullopt;
+            }
+
+            const size_t p = stem.size() + 1;
+            Timestamp t;
+            if (!parse_digits(candidate, p, 4, t.year) || !parse_digits(candidate, p + 4, 2, t.month) || !parse_digits(candidate, p + 6, 2, t.day) ||
+                (candidate[p + 8] != '-') || !parse_digits(candidate, p + 9, 2, t.hour) || !parse_digits(candidate, p + 11, 2, t.minute) ||
+                !parse_digits(candidate, p + 13, 2, t.second))
+            {
+                return std::nullopt;
+            }
+
+            if ((t.month < 1) || (t.month > 12) || (t.day < 1) || (t.day > 31) || (t.hour > 23) || (t.minute > 59) || (t.second > 60)) {
+                return std::nullopt;
+            }
+
+            return t;
+        }
+
+        std::vector<std::string> backups_newest_first(const std::string &save_file_name, const std::vector<std::string> &names) {
+            std::vector<std::pair<int64_t, std::string>> dated;
+            for (const std::string &name : names) {
+                if (std::optional<Timestamp> t = parse_backup_file_name(save_file_name, name)) {
+                    dated.emplace_back(t->sort_key(), name);
+                }
+            }
+
+            // Newest first; equal times by name so the order is stable.
+            std::sort(dated.begin(), dated.end(), [](const auto &a, const auto &b) {
+                return (a.first != b.first) ? (a.first > b.first) : (a.second > b.second);
+            });
+
+            std::vector<std::string> out;
+            for (auto &d : dated) {
+                out.push_back(std::move(d.second));
+            }
+
+            return out;
+        }
+
+        std::vector<std::string> backups_to_delete(const std::string &save_file_name, const std::vector<std::string> &names, size_t keep) {
+            std::vector<std::string> sorted = backups_newest_first(save_file_name, names);
+            if (sorted.size() <= keep) {
+                return {};
+            }
+
+            // Oldest first.
+            std::vector<std::string> out(sorted.begin() + keep, sorted.end());
+            std::reverse(out.begin(), out.end());
+            return out;
+        }
+
+        bool backup_due(BackupReason reason, const std::optional<Timestamp> &newest_backup, const Timestamp &now) {
+            if (reason != BackupReason::Change) {
+                return true;
+            }
+
+            if (!newest_backup.has_value()) {
+                return true;
+            }
+
+            // A clock set back (newest backup "in the future") counts as old enough: never stop backing up.
+            const int64_t age = seconds_between(*newest_backup, now);
+            return (age < 0) || (age >= MinChangeBackupIntervalSeconds);
+        }
+
+        std::string display_time(const Timestamp &when) {
+            char text[32];
+            snprintf(text, sizeof(text), "%04d-%02d-%02d %02d:%02d:%02d", when.year, when.month, when.day, when.hour, when.minute, when.second);
+            return text;
+        }
+    }
+}
diff --git a/librecomp/src/save_backups.cpp b/librecomp/src/save_backups.cpp
new file mode 100644
index 0000000..0751323
--- /dev/null
+++ b/librecomp/src/save_backups.cpp
@@ -0,0 +1,214 @@
+#include "librecomp/save_backups.hpp"
+
+#include <chrono>
+#include <cstdio>
+#include <ctime>
+#include <fstream>
+#include <mutex>
+#include <system_error>
+
+namespace recomp {
+    namespace save_backups {
+        // Backups (and the pending-restore note) of all files in one save folder.
+        static std::mutex backups_mutex;
+        static const char *RestoreNoteName = "restore.txt";
+
+        static std::filesystem::path backups_folder(const std::filesystem::path &save_file) {
+            return save_file.parent_path() / "backups";
+        }
+
+        static std::filesystem::path pak_file_of(const std::filesystem::path &main_save) {
+            std::filesystem::path p = main_save;
+            p.replace_extension(".pak.bin");
+            return p;
+        }
+
+        static Timestamp from_time_t(std::time_t t) {
+            std::tm local{};
+#ifdef _WIN32
+            localtime_s(&local, &t);
+#else
+            localtime_r(&t, &local);
+#endif
+            return Timestamp{ local.tm_year + 1900, local.tm_mon + 1, local.tm_mday, local.tm_hour, local.tm_min, local.tm_sec };
+        }
+
+        Timestamp now() {
+            return from_time_t(std::chrono::system_clock::to_time_t(std::chrono::system_clock::now()));
+        }
+
+        static std::vector<std::string> backup_names_in(const std::filesystem::path &folder) {
+            std::vector<std::string> names;
+            std::error_code ec;
+            for (std::filesystem::directory_iterator it(folder, ec), end; !ec && (it != end); it.increment(ec)) {
+                if (it->is_regular_file(ec)) {
+                    names.push_back(it->path().filename().string());
+                }
+            }
+
+            return names;
+        }
+
+        bool backup_save_file(const std::filesystem::path &save_file, BackupReason reason) {
+            std::lock_guard lock{ backups_mutex };
+            std::error_code ec;
+            if (save_file.empty() || !std::filesystem::is_regular_file(save_file, ec)) {
+                return false;
+            }
+
+            const std::filesystem::path folder = backups_folder(save_file);
+            const std::string save_name = save_file.filename().string();
+            const std::vector<std::string> existing = backup_names_in(folder);
+            const std::vector<std::string> newest = backups_newest_first(save_name, existing);
+            std::optional<Timestamp> newest_time;
+            if (!newest.empty()) {
+                newest_time = parse_backup_file_name(save_name, newest.front());
+            }
+
+            const Timestamp when = now();
+            if (!backup_due(reason, newest_time, when)) {
+                return false;
+            }
+
+            std::filesystem::create_directories(folder, ec);
+            const std::filesystem::path target = folder / backup_file_name(save_name, when);
+            std::filesystem::copy_file(save_file, target, std::filesystem::copy_options::overwrite_existing, ec);
+            if (ec) {
+                fprintf(stderr, "[saves] backup of %s failed: %s\n", save_name.c_str(), ec.message().c_str());
+                return false;
+            }
+
+            std::vector<std::string> names = existing;
+            names.push_back(target.filename().string());
+            for (const std::string &old : backups_to_delete(save_name, names, MaxBackupsPerFile)) {
+                std::filesystem::remove(folder / old, ec);
+            }
+
+            fprintf(stderr, "[saves] backed up %s -> backups/%s\n", save_name.c_str(), target.filename().string().c_str());
+            return true;
+        }
+
+        std::vector<BackupEntry> list_backups(const std::filesystem::path &main_save) {
+            std::lock_guard lock{ backups_mutex };
+            std::vector<BackupEntry> out;
+            if (main_save.empty()) {
+                return out;
+            }
+
+            const std::filesystem::path folder = backups_folder(main_save);
+            const std::vector<std::string> names = backup_names_in(folder);
+            for (const std::filesystem::path &save_file : { main_save, pak_file_of(main_save) }) {
+                const std::string save_name = save_file.filename().string();
+                for (const std::string &name : backups_newest_first(save_name, names)) {
+                    out.push_back(BackupEntry{ save_file, folder / name, *parse_backup_file_name(save_name, name), save_file != main_save });
+                }
+            }
+
+            std::stable_sort(out.begin(), out.end(), [](const BackupEntry &a, const BackupEntry &b) {
+                return a.when.sort_key() > b.when.sort_key();
+            });
+
+            return out;
+        }
+
+        std::optional<Timestamp> last_write_time(const std::filesystem::path &save_file) {
+            std::error_code ec;
+            const auto ftime = std::filesystem::last_write_time(save_file, ec);
+            if (ec) {
+                return std::nullopt;
+            }
+
+            const auto sys = std::chrono::clock_cast<std::chrono::system_clock>(ftime);
+            return from_time_t(std::chrono::system_clock::to_time_t(sys));
+        }
+
+        // The note holds two lines: the save file's name and the backup's name (both in the save's folder tree).
+        bool request_restore(const BackupEntry &entry) {
+            std::lock_guard lock{ backups_mutex };
+            std::error_code ec;
+            const std::filesystem::path folder = backups_folder(entry.save_file);
+            std::filesystem::create_directories(folder, ec);
+            std::ofstream note(folder / RestoreNoteName, std::ios::trunc);
+            if (!note.good()) {
+                return false;
+            }
+
+            note << entry.save_file.filename().string() << "\n" << entry.backup_file.filename().string() << "\n";
+            fprintf(stderr, "[saves] restore of %s scheduled for the next start\n", entry.backup_file.filename().string().c_str());
+            return note.good();
+        }
+
+        std::optional<BackupEntry> pending_restore(const std::filesystem::path &main_save) {
+            if (main_save.empty()) {
+                return std::nullopt;
+            }
+
+            const std::filesystem::path folder = backups_folder(main_save);
+            std::ifstream note(folder / RestoreNoteName);
+            std::string save_name, backup_name;
+            if (!note.good() || !std::getline(note, save_name) || !std::getline(note, backup_name)) {
+                return std::nullopt;
+            }
+
+            // Only files of this game's save folder, named like its own backups.
+            const std::filesystem::path save_file = main_save.parent_path() / save_name;
+            if ((save_file != main_save) && (save_file != pak_file_of(main_save))) {
+                return std::nullopt;
+            }
+
+            const std::optional<Timestamp> when = parse_backup_file_name(save_name, backup_name);
+            if (!when.has_value()) {
+                return std::nullopt;
+            }
+
+            return BackupEntry{ save_file, folder / backup_name, *when, save_file != main_save };
+        }
+
+        void cancel_restore(const std::filesystem::path &main_save) {
+            std::lock_guard lock{ backups_mutex };
+            std::error_code ec;
+            std::filesystem::remove(backups_folder(main_save) / RestoreNoteName, ec);
+        }
+
+        // Returns the file it restored (empty if none).
+        static std::filesystem::path apply_pending_restore(const std::filesystem::path &main_save) {
+            const std::optional<BackupEntry> entry = pending_restore(main_save);
+            cancel_restore(main_save);
+            if (!entry.has_value()) {
+                return {};
+            }
+
+            std::error_code ec;
+            if (!std::filesystem::is_regular_file(entry->backup_file, ec)) {
+                fprintf(stderr, "[saves] restore skipped: %s is gone\n", entry->backup_file.filename().string().c_str());
+                return {};
+            }
+
+            // Keep what's there now, so the restore can be undone from the same menu.
+            backup_save_file(entry->save_file, BackupReason::BeforeRestore);
+            std::filesystem::copy_file(entry->backup_file, entry->save_file, std::filesystem::copy_options::overwrite_existing, ec);
+            if (ec) {
+                fprintf(stderr, "[saves] restore of %s failed: %s\n", entry->backup_file.filename().string().c_str(), ec.message().c_str());
+                return {};
+            }
+
+            fprintf(stderr, "[saves] restored %s from backups/%s\n", entry->save_file.filename().string().c_str(), entry->backup_file.filename().string().c_str());
+            return entry->save_file;
+        }
+
+        void on_game_start(const std::filesystem::path &main_save) {
+            if (main_save.empty()) {
+                return;
+            }
+
+            // A just-restored file is already a backup, and its before-restore backup was taken this second: a launch
+            // backup would get the same name and overwrite it.
+            const std::filesystem::path restored = apply_pending_restore(main_save);
+            for (const std::filesystem::path &save_file : { main_save, pak_file_of(main_save) }) {
+                if (save_file != restored) {
+                    backup_save_file(save_file, BackupReason::Launch);
+                }
+            }
+        }
+    }
+}
diff --git a/librecomp/src/si.cpp b/librecomp/src/si.cpp
new file mode 100644
index 0000000..a7fb08b
--- /dev/null
+++ b/librecomp/src/si.cpp
@@ -0,0 +1,380 @@
+// [wcw] SI / PIF (joybus) emulation for games that use the RAW libultra SI primitives
+// (__osSiRawStartDma / __osSiDeviceBusy) instead of the high-level osCont* API.
+//
+// recomp.h's MEM_* macros do not trap MMIO, so the recompiled raw-SI code crashes writing
+// SI_PIF_ADDR_* / reading SI_STATUS (0xA48000xx -> out of RDRAM). We instead reimplement the
+// two SI primitives in C: name func_80023970 -> __osSiRawStartDma and func_800251E0 ->
+// __osSiDeviceBusy in tools/gen_symbols.py, and provide the *_recomp shims here.
+//
+// The game builds a 64-byte PIF RAM joybus command block in RDRAM, does
+// __osSiRawStartDma(OS_WRITE) (DRAM->PIF), waits for the SI message, then
+// __osSiRawStartDma(OS_READ) (PIF->DRAM) to read the result. We keep a 64-byte PIF RAM,
+// run the joybus on the WRITE (filling results from host input via osContGetReadData), and
+// copy it back on the READ. Both directions raise the SI completion message.
+#include "ultramodern/ultramodern.hpp"
+#include "ultramodern/ultra64.h"
+#include "ultramodern/input.hpp"
+
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+#include "helpers.hpp"
+#include "librecomp/files.hpp"
+#include "librecomp/save_backups.hpp"
+
+#define MAXCONTROLLERS 4
+
+static uint8_t pif_ram[64];
+
+// [wcw] Controller Pak emulation. WCW saves to the Controller Pak in port 1 (no cart
+// EEPROM/SRAM), and its homegrown raw-SI driver accesses it with joybus commands 0x02
+// (read 32-byte block) / 0x03 (write 32-byte block) through the same PIF path as the
+// controller reads. We back the pak's 32 KB with librecomp's save subsystem: the game's
+// SaveType is Sram (also exactly 0x8000 bytes), so the pak contents live in the standard
+// save buffer / save file (saves/<game id>.bin) with async persistence + backup for free.
+void save_write_ptr(const void* in, uint32_t offset, uint32_t count);
+void save_read_ptr(void* out, uint32_t offset, uint32_t count);
+
+// [wcw2k] Separate Controller Pak backing. Sharing the save buffer is only safe when the
+// game never writes cart SRAM (WCW/Revenge: pak-only saves). WM2000 saves to cart SRAM
+// AND uses the pak (created wrestlers) — sharing would let the first pak write corrupt the
+// cart save. Projects where both coexist set this true (before boot); the pak then lives
+// in its own 32 KB image persisted next to the save file as <save name>.pak.bin with the
+// same atomic backup scheme. Default false keeps WT/Revenge byte-identical.
+bool wcw_pak_separate_backing = false;
+static uint8_t wcw2k_pak_buffer[0x8000];
+static bool wcw2k_pak_loaded = false;
+static bool wcw2k_pak_dirty = false;
+
+static std::filesystem::path wcw2k_pak_file_path() {
+    std::filesystem::path p = ultramodern::get_save_file_path();
+    p.replace_extension(".pak.bin");
+    return p;
+}
+
+static void wcw2k_pak_ensure_loaded() {
+    if (wcw2k_pak_loaded) { return; }
+    wcw2k_pak_loaded = true;
+    std::ifstream f = recomp::open_input_file_with_backup(wcw2k_pak_file_path(), std::ios_base::binary);
+    if (f.good()) {
+        f.read(reinterpret_cast<char*>(wcw2k_pak_buffer), sizeof(wcw2k_pak_buffer));
+        fprintf(stderr, "[wcw2k][pak] loaded pak image (%lld bytes)\n", (long long)f.gcount());
+    }
+    else {
+        fprintf(stderr, "[wcw2k][pak] no pak image yet - starting blank\n");
+    }
+}
+
+// Pak data-region accessors: route to the dedicated image when separated, else to the
+// shared save buffer (legacy WT/Revenge behavior).
+static void wcw_pak_read(void* out, uint32_t offset, uint32_t count) {
+    if (wcw_pak_separate_backing) {
+        wcw2k_pak_ensure_loaded();
+        memcpy(out, wcw2k_pak_buffer + offset, count);
+    }
+    else {
+        save_read_ptr(out, offset, count);
+    }
+}
+
+static void wcw_pak_write(const void* in, uint32_t offset, uint32_t count) {
+    if (wcw_pak_separate_backing) {
+        wcw2k_pak_ensure_loaded();
+        memcpy(wcw2k_pak_buffer + offset, in, count);
+        wcw2k_pak_dirty = true;
+    }
+    else {
+        save_write_ptr(in, offset, count);
+    }
+}
+
+// Flush once per joybus block (not per 32-byte write): a game save is a burst of block
+// writes across a few frames, so this coalesces to a handful of 32 KB file writes.
+static void wcw2k_pak_flush() {
+    if (!wcw2k_pak_dirty) { return; }
+    wcw2k_pak_dirty = false;
+    std::filesystem::path path = wcw2k_pak_file_path();
+    bool failed = false;
+    {
+        std::ofstream f = recomp::open_output_file_with_backup(path, std::ios_base::binary);
+        if (f.good()) {
+            f.write(reinterpret_cast<const char*>(wcw2k_pak_buffer), sizeof(wcw2k_pak_buffer));
+        }
+        else {
+            failed = true;
+        }
+    }
+    if (!failed) {
+        failed = !recomp::finalize_output_file_with_backup(path);
+    }
+    if (failed) {
+        fprintf(stderr, "[wcw2k][pak] FAILED to write pak image %s\n", path.string().c_str());
+    }
+    else {
+        // [wcw saves] Timestamped backup on change, rate-limited (aki-roadmap#50).
+        recomp::save_backups::backup_save_file(path, recomp::save_backups::BackupReason::Change);
+    }
+}
+
+// [wcw] Hybrid pak identity for rumble support. A real N64 has ONE pak slot per controller:
+// WCW saves to the Controller Pak but also supports the Rumble Pak ("Insert a Rumble Pak
+// now" prompt at the title), and on hardware the player physically swaps them. Our virtual
+// pak can be both: it answers as a Controller Pak by default (save filesystem in the
+// <0x8000 data region), but when the game runs a Rumble Pak probe — writing a uniform
+// 0x80 block to the bank/ID region, libultra osMotorInit-style — it switches identity and
+// answers bank-region reads with 0x80s (Rumble Pak signature) until any other bank value
+// is written (0xFE = the mempak-probe reset in osMotorInit; 0x00 = mempak bank select).
+// Motor commands are pak writes to the 0xC000 region: data 0x01 = on, 0x00 = off,
+// forwarded to the host controller via ultramodern::input::set_rumble. Save-region reads
+// and writes are honored regardless of identity, so saves can never be lost to rumble.
+static bool wcw_pak_is_rumble = false;
+
+// Bounded diagnostic log of bank/ID-region pak traffic (dedup'd), to observe the game's
+// accessory-detect and rumble-probe sequences.
+static void wcw_log_pak_bank_op(char op, uint16_t addr, uint8_t value) {
+    static int lines = 0;
+    static uint32_t last = 0xFFFFFFFF;
+    uint32_t key = ((uint32_t)op << 24) | ((uint32_t)addr << 8) | value;
+    if (key == last || lines >= 64) return;
+    last = key;
+    lines++;
+    fprintf(stderr, "[wcw][pak] %s addr=0x%04X data=0x%02X identity=%s\n",
+            op == 'W' ? "write" : "read ", addr, value, wcw_pak_is_rumble ? "rumble" : "mempak");
+}
+
+// [wcw] Fresh-save Controller Pak formatting. librecomp's save buffer starts all-zero
+// when no save file exists, and libultra's pak filesystem code reads a zeroed page-
+// allocation table as "formatted, 0 pages free, no notes" (free pages are marked
+// 0x0003) — so on a fresh install the game could never create its save note and
+// showed the "Select note to be erased / 0 Pages free" screen at boot (beta QA,
+// 2026-07-07). A real pak is always formatted (checksummed ID block + free-page
+// table), so: on the first data-region access, if the entire 32 KB image has never
+// been written, lay down an empty formatted filesystem. Byte-for-byte per
+// mupen64plus's format_mempak (mempak.c) with its default device id/banks/version.
+static void wcw_pak_ensure_formatted() {
+    static bool checked = false;
+    if (checked) { return; }
+    checked = true;
+
+    uint8_t page[256];
+    for (uint32_t off = 0; off < 0x8000; off += (uint32_t)sizeof(page)) {
+        wcw_pak_read(page, off, (uint32_t)sizeof(page));
+        for (size_t b = 0; b < sizeof(page); b++) {
+            if (page[b] != 0) { return; }        // save has data — leave it alone
+        }
+    }
+
+    uint8_t pages[3 * 256] = {0};
+
+    // Page 0: ID block at +0x20 (serial, device id 0x0001, 1 bank, version 0,
+    // checksum = sum of the 14 leading BE words, inverted checksum = 0xFFF2 - sum),
+    // with backup copies at +0x60, +0x80, +0xC0.
+    uint8_t* id = &pages[0x20];
+    static const uint8_t serial[24] = {          // arbitrary fixed serial (6 BE words)
+        'W', 'C', 'W', 'R', 'E', 'C', 'O', 'M',
+        'P', 'I', 'L', 'E', 'D', 'P', 'A', 'K',
+        0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
+    };
+    memcpy(id, serial, sizeof(serial));
+    id[24] = 0x00; id[25] = 0x01;                // device id
+    id[26] = 0x01;                               // banks
+    id[27] = 0x00;                               // version
+    uint16_t sum = 0;
+    for (int b = 0; b < 28; b += 2) { sum = (uint16_t)(sum + ((id[b] << 8) | id[b + 1])); }
+    uint16_t isum = (uint16_t)(0xFFF2 - sum);
+    id[28] = (uint8_t)(sum >> 8);  id[29] = (uint8_t)sum;
+    id[30] = (uint8_t)(isum >> 8); id[31] = (uint8_t)isum;
+    memcpy(&pages[0x60], id, 32);
+    memcpy(&pages[0x80], id, 32);
+    memcpy(&pages[0xC0], id, 32);
+
+    // Page 1: page-allocation table — pages 5..127 marked free (0x0003), byte 1 =
+    // checksum (byte sum of the 123 entries). Page 2 is its backup. Pages 3-4 (note
+    // table) and the data pages stay zero.
+    uint8_t* inode = &pages[0x100];
+    for (int p = 5; p < 128; p++) { inode[2 * p] = 0x00; inode[2 * p + 1] = 0x03; }
+    uint8_t csum = 0;
+    for (int b = 2 * 5; b < 256; b++) { csum = (uint8_t)(csum + inode[b]); }
+    inode[1] = csum;
+    memcpy(&pages[0x200], inode, 256);
+
+    wcw_pak_write(pages, 0, (uint32_t)sizeof(pages));
+    fprintf(stderr, "[wcw][pak] fresh save image - formatted empty Controller Pak filesystem\n");
+}
+
+// Standard joybus mempak data CRC (poly 0x85 over the 32 data bytes + one zero byte).
+static uint8_t wcw_pak_data_crc(const uint8_t* data) {
+    uint8_t crc = 0;
+    for (int i = 0; i <= 32; i++) {
+        for (int bit = 7; bit >= 0; bit--) {
+            uint8_t xor_tap = (crc & 0x80) ? 0x85 : 0;
+            crc <<= 1;
+            if (i < 32 && (data[i] & (1 << bit))) crc |= 1;
+            crc ^= xor_tap;
+        }
+    }
+    return crc;
+}
+
+extern "C" void __osSiDeviceBusy_recomp(uint8_t* rdram, recomp_context* ctx) {
+    // The host SI is never busy.
+    _return<s32>(ctx, 0);
+}
+
+// Execute the joybus command block currently in pif_ram, filling in result bytes.
+static void wcw_process_pif() {
+    OSContPad pads[MAXCONTROLLERS];
+    for (int c = 0; c < MAXCONTROLLERS; c++) {
+        pads[c].button = 0; pads[c].stick_x = 0; pads[c].stick_y = 0; pads[c].err_no = 0;
+    }
+    // [wcw fix] Latch host input NOW. osContGetReadData only reads state previously latched
+    // by the poll_input callback (recompinput::poll_inputs — it caches SDL_GetKeyboardState
+    // and the controller list). The normal poller is osContStartReadData, which this game
+    // never calls (raw-SI path) — without this poll the cache stays empty forever and all
+    // input reads as neutral.
+    ultramodern::input::poll_input();
+    // osContGetReadData reads current host input (already converted to N64 stick range) and
+    // sets err_no != 0 for absent controllers.
+    osContGetReadData(pads);
+
+    int channel = 0;
+    int i = 0;
+    while (i < 63 && channel < MAXCONTROLLERS) {
+        uint8_t t = pif_ram[i];
+        if (t == 0xFE) { break; }                       // end of commands
+        if (t == 0x00) { channel++; i++; continue; }    // skip this channel
+        if (t == 0xFF) { i++; continue; }               // padding byte (channel unchanged)
+        if (t & 0xC0)  { i++; continue; }               // not a valid tx count
+        uint8_t rx = pif_ram[i + 1] & 0x3F;
+        if (i + 2 + t + rx > 64) { break; }             // malformed / overflow guard
+        uint8_t cmd = pif_ram[i + 2];
+        uint8_t* res = &pif_ram[i + 2 + t];
+        // [wcw] Port 1 (channel 0) is ALWAYS reported connected — a virtual controller is always
+        // present (neutral input when the host pad/key is idle). osContGetReadData sets err_no != 0
+        // whenever the input callback returns no response that frame, which would otherwise make
+        // the game see "no controller in port 1" and refuse to advance past the title.
+        bool connected = (channel == 0) || (pads[channel].err_no == 0);
+
+        if (!connected) {
+            pif_ram[i + 1] |= 0x80;                      // CHNL_ERR_NORESP: no device
+        }
+        else if (cmd == 0x00 || cmd == 0xFF) {           // request status
+            // status byte 0x01 = Controller Pak present (port 1 only; see pak emulation above).
+            if (rx >= 3) { res[0] = 0x05; res[1] = 0x00; res[2] = (channel == 0) ? 0x01 : 0x00; }
+        }
+        else if (cmd == 0x01) {                          // read button
+            if (rx >= 4) {
+                uint16_t b = pads[channel].button;
+                res[0] = (uint8_t)(b >> 8);
+                res[1] = (uint8_t)(b & 0xFF);
+                res[2] = (uint8_t)pads[channel].stick_x;
+                res[3] = (uint8_t)pads[channel].stick_y;
+                // [wcw] WCW_INPUT_LOG=1: throttled per-channel activity log (multiplayer
+                // verification — proves which N64 port each host device's input reaches).
+                static int log_enabled = -1;
+                if (log_enabled < 0) { const char* e = getenv("WCW_INPUT_LOG"); log_enabled = (e && e[0] == '1') ? 1 : 0; }
+                if (log_enabled && (b != 0 || pads[channel].stick_x != 0 || pads[channel].stick_y != 0)) {
+                    static uint64_t last_ms[MAXCONTROLLERS];
+                    uint64_t now = (uint64_t)std::chrono::duration_cast<std::chrono::milliseconds>(
+                        std::chrono::steady_clock::now().time_since_epoch()).count();
+                    if (now - last_ms[channel] >= 500) {
+                        last_ms[channel] = now;
+                        fprintf(stderr, "[wcw][input] ch%d buttons=%04X stick=(%d,%d)\n",
+                                channel, b, pads[channel].stick_x, pads[channel].stick_y);
+                    }
+                }
+            }
+        }
+        else if (cmd == 0x02 && channel == 0 && t >= 3 && rx >= 33) {   // pak read block
+            // tx = cmd, addr_hi, addr_lo; low 5 address bits are an address CRC (ignored).
+            uint16_t addr = (uint16_t)((pif_ram[i + 3] << 8) | pif_ram[i + 4]);
+            uint32_t offset = addr & 0xFFE0u;
+            if (offset < 0x8000) {
+                wcw_pak_ensure_formatted();
+                wcw_pak_read(res, offset, 32);           // pak RAM <- pak backing
+            }
+            else {
+                // Bank/ID region: answer with the current pak identity — 0x80s is the Rumble
+                // Pak signature (only in its 0x8000..0x8FFF window, like real hardware),
+                // zeros is the Controller Pak one.
+                uint8_t fill = (wcw_pak_is_rumble && offset < 0x9000) ? 0x80 : 0x00;
+                memset(res, fill, 32);
+                wcw_log_pak_bank_op('R', addr, fill);
+            }
+            res[32] = wcw_pak_data_crc(res);
+            static bool logged = false;
+            if (!logged) { logged = true; fprintf(stderr, "[wcw] first Controller Pak read (addr=0x%04X)\n", addr); }
+        }
+        else if (cmd == 0x03 && channel == 0 && t >= 35 && rx >= 1) {   // pak write block
+            uint16_t addr = (uint16_t)((pif_ram[i + 3] << 8) | pif_ram[i + 4]);
+            uint32_t offset = addr & 0xFFE0u;
+            const uint8_t* data = &pif_ram[i + 5];
+            if (offset < 0x8000) {
+                wcw_pak_ensure_formatted();              // format first so the game's write wins
+                wcw_pak_write(data, offset, 32);         // persists on block completion (below)
+            }
+            else if (offset >= 0xC000) {
+                // Rumble Pak motor command: a block of 0x01s starts the motor, 0x00s stops it.
+                bool on = (data[0] & 1) != 0;
+                ultramodern::input::set_rumble(0, on);
+                static bool logged_on = false, logged_off = false;
+                bool& logged = on ? logged_on : logged_off;
+                if (!logged) { logged = true; fprintf(stderr, "[wcw][pak] first motor %s (addr=0x%04X data=0x%02X)\n", on ? "ON" : "OFF", addr, data[0]); }
+            }
+            else {
+                // Bank/ID-region write: not stored, but a uniform 0x80 block is the Rumble Pak
+                // probe/init — switch the pak's identity so the probe's readback sees 0x80s.
+                // Any other value (0xFE mempak-probe reset, 0x00 bank select) reverts to mempak.
+                bool uniform = true;
+                for (int b = 1; b < 32; b++) { if (data[b] != data[0]) { uniform = false; break; } }
+                bool want_rumble = uniform && data[0] == 0x80;
+                if (want_rumble != wcw_pak_is_rumble) {
+                    wcw_pak_is_rumble = want_rumble;
+                    if (!want_rumble) ultramodern::input::set_rumble(0, false);
+                    fprintf(stderr, "[wcw][pak] identity -> %s (bank write addr=0x%04X data=0x%02X)\n",
+                            want_rumble ? "RUMBLE PAK" : "CONTROLLER PAK", addr, data[0]);
+                }
+                wcw_log_pak_bank_op('W', addr, data[0]);
+            }
+            res[0] = wcw_pak_data_crc(data);
+            static bool logged = false;
+            if (!logged) { logged = true; fprintf(stderr, "[wcw] first Controller Pak write (addr=0x%04X)\n", addr); }
+        }
+        else {
+            // Unsupported joybus command: report no device so the game falls back gracefully.
+            pif_ram[i + 1] |= 0x80;
+        }
+
+        i += 2 + t + rx;
+        channel++;
+    }
+
+    // [wcw2k] Persist any pak writes this block produced (no-op unless separated + dirty).
+    wcw2k_pak_flush();
+}
+
+extern "C" void __osSiRawStartDma_recomp(uint8_t* rdram, recomp_context* ctx) {
+    s32 dir = (s32)ctx->r4;          // a0: OS_READ(0) = PIF->DRAM, OS_WRITE(1) = DRAM->PIF
+    gpr dram_addr = ctx->r5;          // a1: RDRAM address of the 64-byte PIF block
+
+    if (dir == 1) {
+        // DRAM -> PIF: latch the command block, then run joybus so results are ready.
+        for (int i = 0; i < 64; i++) {
+            pif_ram[i] = (uint8_t)MEM_B(i, dram_addr);
+        }
+        wcw_process_pif();
+    }
+    else {
+        // PIF -> DRAM: hand back the (already-processed) result block.
+        for (int i = 0; i < 64; i++) {
+            MEM_B(i, dram_addr) = (int8_t)pif_ram[i];
+        }
+    }
+
+    // Each SI DMA completion raises the SI interrupt; the game blocks on osRecvMesg for it.
+    ultramodern::send_si_message();
+
+    _return<s32>(ctx, 0);
+}
