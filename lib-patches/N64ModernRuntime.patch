+// [wcw] A last event to the local Datadog Agent when the game dies (aki-roadmap#125). See dd_breadcrumb.hpp.
+// The tag and game-name rules are rt64's (common/rt64_wcw_logic.cpp: ddTag, ddParseTags, ddGameFromExe), so the
+// breadcrumb carries the same tags as the play session it ends.
+
+#include "librecomp/dd_breadcrumb.hpp"
+
+#include <algorithm>
+#include <cstring>
+
+namespace recomp {
+    namespace dd {
+        namespace {
+            std::string lower(std::string s) {
+                for (char& c : s) {
+                    c = ((c >= 'A') && (c <= 'Z')) ? char(c - 'A' + 'a') : c;
+                }
+
+                return s;
+            }
+
+            bool ends_with(const std::string& s, const std::string& suffix) {
+                return (s.size() >= suffix.size()) && (s.compare(s.size() - suffix.size(), suffix.size(), suffix) == 0);
+            }
+
+            std::string trim(const std::string& s, const char* chars) {
+                const size_t a = s.find_first_not_of(chars);
+                if (a == std::string::npos) {
+                    return std::string();
+                }
+
+                return s.substr(a, s.find_last_not_of(chars) - a + 1);
+            }
+
+            std::string sanitize(const std::string& s, const char* allowed_punct) {
+                std::string out;
+                for (char c : lower(s)) {
+                    const bool ok = ((c >= 'a') && (c <= 'z')) || ((c >= '0') && (c <= '9')) || (c == '_') ||
+                        ((c != '\0') && (std::strchr(allowed_punct, c) != nullptr));
+                    const char r = ok ? c : '_';
+                    if ((r == '_') && !out.empty() && (out.back() == '_')) {
+                        continue;
+                    }
+
+                    out.push_back(r);
+                }
+
+                return out;
+            }
+        }
+
+        bool switch_on(const char* value) {
+            return (value != nullptr) && (value[0] != '\0') && (std::strcmp(value, "0") != 0);
+        }
+
+        std::string tag(const std::string& key, const std::string& value) {
+            std::string v = trim(value, " \t\r\n");
+            if (v.empty()) {
+                return std::string();
+            }
+
+            std::string k = trim(sanitize(key, "-./"), "_");
+            if (k.empty() || (k[0] < 'a') || (k[0] > 'z')) {
+                k = "t_" + k;
+            }
+
+            v = trim(sanitize(v, "-:./"), "_");
+            if (v.empty()) {
+                return std::string();
+            }
+
+            std::string t = k + ":" + v;
+            if (t.size() > 200) {
+                t.resize(200);
+            }
+
+            return t;
+        }
+
+        std::vector<std::string> parse_tags(const char* value) {
+            std::vector<std::string> tags;
+            if (value == nullptr) {
+                return tags;
+            }
+
+            const std::string all(value);
+            size_t pos = 0;
+            while (pos <= all.size()) {
+                size_t end = all.find(',', pos);
+                if (end == std::string::npos) {
+                    end = all.size();
+                }
+
+                const std::string entry = all.substr(pos, end - pos);
+                const size_t colon = entry.find(':');
+                if (colon != std::string::npos) {
+                    std::string t = tag(entry.substr(0, colon), entry.substr(colon + 1));
+                    if (!t.empty() && (std::find(tags.begin(), tags.end(), t) == tags.end())) {
+                        tags.push_back(std::move(t));
+                    }
+                }
+
+                pos = end + 1;
+            }
+
+            return tags;
+        }
+
+        std::string game_from_exe(const std::string& exe_name) {
+            const size_t slash = exe_name.find_last_of("/\\");
+            std::string name = lower((slash == std::string::npos) ? exe_name : exe_name.substr(slash + 1));
+            if (ends_with(name, ".exe")) {
+                name.resize(name.size() - 4);
+            }
+
+            if (ends_with(name, "recompiled")) {
+                name.resize(name.size() - 10);
+            }
+
+            return (name == "wcw") ? std::string("wt") : name;
+        }
+
+        std::string fatal_game(const char* env_game, const std::string& exe_name) {
+            return ((env_game != nullptr) && (env_game[0] != '\0')) ? std::string(env_game) : game_from_exe(exe_name);
+        }
+
+        std::string event_line(const std::string& title, const std::string& text, const std::vector<std::string>& tags,
+            const std::string& alert_type, const std::string& aggregation_key)
+        {
+            std::string ti, tx;
+            for (char c : title) {
+                if (c != '\r') {
+                    ti.push_back((c == '\n') ? ' ' : c);
+                }
+            }
+
+            for (char c : text) {
+                if (c == '\n') {
+                    tx += "\\n";
+                }
+                else if (c != '\r') {
+                    tx.push_back(c);
+                }
+            }
+
+            std::string line = "_e{" + std::to_string(ti.size()) + "," + std::to_string(tx.size()) + "}:" + ti + "|" + tx;
+            if (!aggregation_key.empty()) {
+                line += "|k:" + aggregation_key;
+            }
+
+            line += "|s:aki-game";
+            if (!alert_type.empty()) {
+                line += "|t:" + alert_type;
+            }
+
+            std::string joined;
+            for (const std::string& t : tags) {
+                if (!t.empty()) {
+                    joined += (joined.empty() ? "" : ",") + t;
+                }
+            }
+
+            if (!joined.empty()) {
+                line += "|#" + joined;
+            }
+
+            return line;
+        }
+
+        std::string fatal_title(const std::string& game, const std::string& what) {
+            return "aki-game" + (game.empty() ? std::string() : " " + game) + ": " + what;
+        }
+
+        std::vector<std::string> fatal_tags(const std::string& game, const char* extra_tags) {
+            std::vector<std::string> tags;
+            const std::string g = tag("game", game);
+            if (!g.empty()) {
+                tags.push_back(g);
+            }
+
+            tags.push_back("kind:fatal");
+            // WCW_DD_TAGS can't override the breadcrumb's own keys (rt64 skips its built-in keys the same way).
+            for (const std::string& t : parse_tags(extra_tags)) {
+                const std::string key = t.substr(0, t.find(':'));
+                if ((key != "game") && (key != "kind") && (std::find(tags.begin(), tags.end(), t) == tags.end())) {
+                    tags.push_back(t);
+                }
+            }
+
+            return tags;
+        }
+    }
+}
diff --git a/librecomp/src/dd_breadcrumb_send.cpp b/librecomp/src/dd_breadcrumb_send.cpp
new file mode 100644
index 0000000..bdd7251
--- /dev/null
+++ b/librecomp/src/dd_breadcrumb_send.cpp
@@ -0,0 +1,91 @@
+// [wcw] Sends the fatal breadcrumb (aki-roadmap#125): the part of dd_breadcrumb that needs the network and the running
+// game, kept out of the unit tests. See dd_breadcrumb.hpp.
+
+#include "librecomp/dd_breadcrumb.hpp"
+
+#include <cstdint>
+#include <cstdlib>
+
+#if defined(_WIN32)
+#   include <winsock2.h>
+#   include <ws2tcpip.h>
+#else
+#   include <arpa/inet.h>
+#   include <netinet/in.h>
+#   include <sys/socket.h>
+#   include <unistd.h>
+#endif
+
+
+namespace recomp {
+    namespace dd {
+        static void send_fatal(const std::string& title, const std::string& text);
+
+        static std::string exe_name() {
+#if defined(_WIN32)
+            char path[MAX_PATH] = {};
+            const DWORD n = GetModuleFileNameA(nullptr, path, MAX_PATH);
+            return std::string(path, (n < MAX_PATH) ? n : 0);
+#else
+            char path[4096] = {};
+            const ssize_t n = readlink("/proc/self/exe", path, sizeof(path) - 1);
+            return (n > 0) ? std::string(path, size_t(n)) : std::string();
+#endif
+        }
+
+        void fatal(const std::string& title, const std::string& text) noexcept {
+            try {
+                send_fatal(title, text);
+            }
+            catch (...) {
+                // Nothing to do on the way out.
+            }
+        }
+
+        void send_fatal(const std::string& title, const std::string& text) {
+            if (!switch_on(std::getenv("WCW_DD_METRICS"))) {
+                return;
+            }
+
+            const std::string game = fatal_game(std::getenv("WCW_DD_GAME"), exe_name());
+            const std::string line = event_line(fatal_title(game, title), text, fatal_tags(game, std::getenv("WCW_DD_TAGS")),
+                "error", "fatal");
+            unsigned port = 8125;
+            if (const char* p = std::getenv("WCW_DD_PORT")) {
+                const long v = std::strtol(p, nullptr, 10);
+                if ((v > 0) && (v < 65536)) {
+                    port = unsigned(v);
+                }
+            }
+
+#if defined(_WIN32)
+            WSADATA wsa;
+            if (WSAStartup(MAKEWORD(2, 2), &wsa) != 0) {
+                return;
+            }
+
+            const SOCKET s = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+            if (s != INVALID_SOCKET) {
+                sockaddr_in to{};
+                to.sin_family = AF_INET;
+                to.sin_port = htons(uint16_t(port));
+                inet_pton(AF_INET, "127.0.0.1", &to.sin_addr);
+                sendto(s, line.data(), int(line.size()), 0, reinterpret_cast<const sockaddr*>(&to), sizeof(to));
+                closesocket(s);
+            }
+
+            WSACleanup();
+#else
+            const int s = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+            if (s >= 0) {
+                sockaddr_in to{};
+                to.sin_family = AF_INET;
+                to.sin_port = htons(uint16_t(port));
+                inet_pton(AF_INET, "127.0.0.1", &to.sin_addr);
+                sendto(s, line.data(), line.size(), 0, reinterpret_cast<const sockaddr*>(&to), sizeof(to));
+                close(s);
+            }
+#endif
+        }
+    }
+}
diff --git a/librecomp/src/entry_prologue_rules.cpp b/librecomp/src/entry_prologue_rules.cpp
new file mode 100644
index 0000000..b00e909
--- /dev/null
+++ b/librecomp/src/entry_prologue_rules.cpp
@@ -0,0 +1,51 @@
+#include "librecomp/entry_prologue_rules.hpp"
+
+namespace recomp::mods::entry_prologues {
+
+size_t encode(size_t prologue, bool has_slot, size_t slot) {
+    size_t index = Tag | ((prologue & (MaxPrologues - 1)) << 32);
+    if (has_slot) {
+        index |= HasSlot | (slot & 0xFFFFFFFFu);
+    }
+    return index;
+}
+
+Decoded decode(size_t hook_index) {
+    Decoded d{};
+    if ((hook_index & Tag) == 0) {
+        d.has_slot = true;
+        d.slot = hook_index;
+        return d;
+    }
+    d.is_prologue = true;
+    d.prologue = (hook_index >> 32) & (MaxPrologues - 1);
+    d.has_slot = (hook_index & HasSlot) != 0;
+    d.slot = d.has_slot ? (hook_index & 0xFFFFFFFFu) : 0;
+    return d;
+}
+
+size_t add_to_entry_hooks(std::span<const void* const> func_ptrs, const std::unordered_map<const void*, size_t> &prologue_of,
+    std::unordered_map<size_t, size_t> &entry_hooks)
+{
+    size_t added = 0;
+    for (size_t i = 0; i < func_ptrs.size(); i++) {
+        auto found = prologue_of.find(func_ptrs[i]);
+        if (found == prologue_of.end()) {
+            continue;
+        }
+        auto hooked = entry_hooks.find(i);
+        if (hooked == entry_hooks.end()) {
+            entry_hooks[i] = encode(found->second, false, 0);
+        }
+        else if ((hooked->second & Tag) == 0) {
+            hooked->second = encode(found->second, true, hooked->second);
+        }
+        else {
+            continue; // already carries a prologue
+        }
+        added++;
+    }
+    return added;
+}
+
+}
diff --git a/librecomp/src/live_code_rules.cpp b/librecomp/src/live_code_rules.cpp
new file mode 100644
index 0000000..c6ff2b2
--- /dev/null
+++ b/librecomp/src/live_code_rules.cpp
@@ -0,0 +1,248 @@
+// [wcw fullconv] Decisions for codes that rewrite instructions at run time (see librecomp/live_code_rules.hpp). Pure: no
+// runtime state, unit tested in tests/wcw/live_code_rules_tests.cpp.
+
+#include "librecomp/live_code_rules.hpp"
+
+#include <algorithm>
+#include <cstring>
+
+namespace recomp::mods::live_codes {
+    namespace {
+        constexpr uint32_t RdramStart = 0x80000000u;
+
+        bool is_write(uint8_t type) {
+            return (type == 0x80) || (type == 0x81) || (type == 0xA0) || (type == 0xA1);
+        }
+
+        bool read_rdram_word(const uint8_t *rdram, uint32_t rdram_size, uint32_t addr, uint32_t &out) {
+            const uint32_t offset = addr - RdramStart;
+            if ((addr < RdramStart) || (offset > rdram_size) || ((rdram_size - offset) < 4)) return false;
+            std::memcpy(&out, rdram + offset, 4);
+            return true;
+        }
+
+        bool read_rom_word(std::span<const uint8_t> rom, uint32_t offset, uint32_t &out) {
+            if ((offset > rom.size()) || ((rom.size() - offset) < 4)) return false;
+            out = (uint32_t(rom[offset]) << 24) | (uint32_t(rom[offset + 1]) << 16) | (uint32_t(rom[offset + 2]) << 8) | uint32_t(rom[offset + 3]);
+            return true;
+        }
+    }
+
+    std::vector<uint32_t> written_words(const std::vector<conversion::codes::Code> &codes) {
+        std::vector<uint32_t> words;
+        for (size_t i = 0; i < codes.size(); i++) {
+            const conversion::codes::Code &c = codes[i];
+            if (is_write(c.type)) {
+                words.push_back(c.addr & ~3u);
+            }
+            else if ((c.type == 0x50) && ((i + 1) < codes.size()) && is_write(codes[i + 1].type)) {
+                const uint32_t count = (c.addr >> 8) & 0xFF;
+                const uint32_t step = c.addr & 0xFF;
+                for (uint32_t k = 0; k < count; k++) {
+                    words.push_back((codes[i + 1].addr + k * step) & ~3u);
+                }
+
+                i++;
+            }
+        }
+
+        std::sort(words.begin(), words.end());
+        words.erase(std::unique(words.begin(), words.end()), words.end());
+        return words;
+    }
+
+    bool is_branch_word(uint32_t w) {
+        const uint32_t op = w >> 26, rs = (w >> 21) & 31, rt = (w >> 16) & 31;
+        return ((op >= 4) && (op <= 7)) || ((op >= 0x14) && (op <= 0x17)) ||
+            ((op == 1) && ((rt <= 3) || ((rt >= 0x10) && (rt <= 0x13)))) ||
+            ((op == 0x11) && (rs == 8));   // bc1: the rope builder Legends hooks branches on float compares (aki-roadmap#245)
+    }
+
+    std::vector<conversion::codes::Code> units_writing(const std::vector<conversion::codes::Code> &codes, CodeRange range) {
+        std::vector<conversion::codes::Code> out;
+        size_t i = 0;
+        while (i < codes.size()) {
+            // a unit: its conditionals, then a write or a repeater with its write
+            const size_t first = i;
+            while ((i < codes.size()) && (codes[i].type >= 0xD0) && (codes[i].type <= 0xD3)) i++;
+            if (i >= codes.size()) break;
+            bool hits = false;
+            size_t last = i;
+            const conversion::codes::Code &c = codes[i];
+            if (is_write(c.type)) {
+                hits = in_code_ranges(c.addr & ~3u, std::span<const CodeRange>(&range, 1));
+            }
+            else if ((c.type == 0x50) && ((i + 1) < codes.size()) && is_write(codes[i + 1].type)) {
+                const uint32_t count = (c.addr >> 8) & 0xFF;
+                const uint32_t step = c.addr & 0xFF;
+                for (uint32_t k = 0; (k < count) && !hits; k++) {
+                    hits = in_code_ranges((codes[i + 1].addr + k * step) & ~3u, std::span<const CodeRange>(&range, 1));
+                }
+                last = i + 1;
+            }
+            else if (c.type == 0x50) {
+                // a repeater before anything but a write isn't a GameShark form: apply() skips it with the unit after
+                // it, so that unit isn't taken either
+                size_t j = i + 1;
+                while ((j < codes.size()) && ((codes[j].type == 0x50) || ((codes[j].type >= 0xD0) && (codes[j].type <= 0xD3)))) j++;
+                last = std::min(j, codes.size() - 1);
+            }
+            if (hits) {
+                out.insert(out.end(), codes.begin() + first, codes.begin() + last + 1);
+            }
+            i = last + 1;
+        }
+
+        return out;
+    }
+
+    std::vector<Watch> build_watches(const std::vector<uint32_t> &words, std::span<const FunctionSpan> functions) {
+        std::vector<Watch> watches;
+        for (const FunctionSpan &f : functions) {
+            if (f.size == 0) continue;
+            auto first = std::lower_bound(words.begin(), words.end(), f.vram);
+            auto last = std::lower_bound(first, words.end(), f.vram + f.size);
+            if (first != last) {
+                watches.push_back(Watch{ f, std::vector<uint32_t>(first, last) });
+            }
+        }
+
+        return watches;
+    }
+
+    bool watched_match_rom(const Watch &watch, const uint8_t *rdram, uint32_t rdram_size, std::span<const uint8_t> rom) {
+        for (uint32_t addr : watch.words) {
+            uint32_t ram_word, rom_word;
+            if (!read_rdram_word(rdram, rdram_size, addr, ram_word) || !read_rom_word(rom, watch.func.rom + (addr - watch.func.vram), rom_word)) {
+                return false;
+            }
+
+            if (ram_word != rom_word) return false;
+        }
+
+        return true;
+    }
+
+    bool others_match_rom(const Watch &watch, const uint8_t *rdram, uint32_t rdram_size, std::span<const uint8_t> rom) {
+        size_t next_watched = 0;
+        for (uint32_t offset = 0; (offset + 4) <= watch.func.size; offset += 4) {
+            const uint32_t addr = watch.func.vram + offset;
+            while ((next_watched < watch.words.size()) && (watch.words[next_watched] < addr)) next_watched++;
+            if ((next_watched < watch.words.size()) && (watch.words[next_watched] == addr)) continue;
+            uint32_t ram_word, rom_word;
+            if (!read_rdram_word(rdram, rdram_size, addr, ram_word) || !read_rom_word(rom, watch.func.rom + offset, rom_word)) {
+                return false;
+            }
+
+            if (ram_word != rom_word) return false;
+        }
+
+        return true;
+    }
+
+    bool in_code_ranges(uint32_t addr, std::span<const CodeRange> code) {
+        for (const CodeRange &range : code) {
+            if ((addr >= range.start) && (addr < range.end)) return true;
+        }
+
+        return false;
+    }
+
+    std::vector<CodeRange> ranges_of_words(const std::vector<uint32_t> &words) {
+        std::vector<uint32_t> sorted = words;
+        std::sort(sorted.begin(), sorted.end());
+        std::vector<CodeRange> ranges;
+        for (uint32_t word : sorted) {
+            if (!ranges.empty() && (word <= ranges.back().end)) {
+                ranges.back().end = std::max(ranges.back().end, word + 4);
+            }
+            else {
+                ranges.push_back(CodeRange{ word, word + 4 });
+            }
+        }
+
+        return ranges;
+    }
+
+    bool hooks_outside_code(const Watch &watch, const uint8_t *rdram, uint32_t rdram_size, std::span<const uint8_t> rom, std::span<const CodeRange> code,
+        std::span<const CodeRange> pack_writes) {
+        for (uint32_t addr : watch.words) {
+            uint32_t w, rom_word;
+            if (!read_rdram_word(rdram, rdram_size, addr, w) || !read_rom_word(rom, watch.func.rom + (addr - watch.func.vram), rom_word)) {
+                continue;
+            }
+
+            if (w == rom_word) continue;
+            const uint32_t op = w >> 26, rs = (w >> 21) & 31, funct = w & 0x3F;
+            if ((op == 2) || (op == 3)) {
+                const uint32_t target = ((addr + 4) & 0xF0000000u) | ((w & 0x03FFFFFFu) << 2);
+                if (!in_code_ranges(target, code)) {
+                    uint32_t there = 0;
+                    if (!in_code_ranges(target, pack_writes) || !read_rdram_word(rdram, rdram_size, target, there) || (there == 0)) return true;
+                }
+            }
+            else if ((op == 0) && ((funct == 0x08) || (funct == 0x09))) {
+                if (rs != 31) return true;
+            }
+            else if (is_branch_word(w)) {
+                const uint32_t target = addr + 4 + uint32_t(int32_t(int16_t(w & 0xFFFF)) * 4);
+                if ((target < watch.func.vram) || (target >= (watch.func.vram + watch.func.size))) return true;
+            }
+        }
+
+        return false;
+    }
+
+    ExitCheck check_exits(const Watch &watch, const uint8_t *rdram, uint32_t rdram_size, std::span<const uint8_t> rom,
+        std::span<const CodeRange> all, std::span<const CodeRange> loaded, std::span<const CodeRange> pack_writes)
+    {
+        std::vector<CodeRange> known(all.begin(), all.end());
+        known.insert(known.end(), pack_writes.begin(), pack_writes.end());
+        if (hooks_outside_code(watch, rdram, rdram_size, rom, known)) return ExitCheck::Never;
+        return hooks_outside_code(watch, rdram, rdram_size, rom, loaded, pack_writes) ? ExitCheck::NotNow : ExitCheck::Fine;
+    }
+
+    uint64_t content_key(const Watch &watch, const uint8_t *rdram, uint32_t rdram_size) {
+        uint64_t h = 0xCBF29CE484222325ull;
+        for (uint32_t addr : watch.words) {
+            uint32_t word = 0;
+            read_rdram_word(rdram, rdram_size, addr, word);
+            for (int shift = 0; shift < 32; shift += 8) {
+                h = (h ^ ((word >> shift) & 0xFF)) * 0x100000001B3ull;
+            }
+        }
+
+        return (h == 0) ? 1 : h;
+    }
+
+    Action decide(const FunctionState &state, bool section_loaded, bool at_rom, uint64_t key, int compiles_left) {
+        if (state.refused) return Action::None;
+        if (!section_loaded || at_rom) {
+            return (state.current != 0) ? Action::ToStatic : Action::None;
+        }
+
+        if (state.failed.contains(key)) {
+            return (state.current != 0) ? Action::ToStatic : Action::None;
+        }
+
+        if (key == state.current) return Action::None;
+        if (state.compiled.contains(key)) return Action::UseCompiled;
+        if ((state.compiled.size() + state.failed.size()) >= MaxVersionsPerFunction) return Action::AtCap;
+        return (compiles_left > 0) ? Action::Compile : Action::Deferred;
+    }
+
+    bool encode_entry_jump(uintptr_t from, uintptr_t to, uint8_t out[EntryPatchSize]) {
+        const int64_t distance = int64_t(to) - int64_t(from + EntryPatchSize);
+        if ((distance < INT32_MIN) || (distance > INT32_MAX)) return false;
+        const int32_t rel = int32_t(distance);
+        out[0] = 0xE9;
+        std::memcpy(out + 1, &rel, 4);
+        return true;
+    }
+
+    void encode_stub(uint64_t target, uint8_t out[StubSize]) {
+        static const uint8_t head[StubTargetOffset] = { 0xFF, 0x25, 0x02, 0x00, 0x00, 0x00, 0xCC, 0xCC };
+        std::memcpy(out, head, sizeof(head));
+        std::memcpy(out + StubTargetOffset, &target, 8);
+    }
+}
diff --git a/librecomp/src/math_routines.cpp b/librecomp/src/math_routines.cpp
index 4d6a01d..9e2dc24 100644
--- a/librecomp/src/math_routines.cpp
