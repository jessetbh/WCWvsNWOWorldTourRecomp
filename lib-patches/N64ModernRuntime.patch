+    auto with = [](const std::string &saves) {
+        return R"json({ "format": "aki-conversion", "format_version": 1, "id": "s", "game": "nomercy",
+            "components": { "patch": { "file": "patch.nrm" }, "saves": )json" + saves + " } }";
+    };
+    Conversion c;
+    std::string error;
+    CHECK(parse(with(R"json([ { "file": "saves/wwf.nomercy.us.bin", "kind": "flash" },
+        { "file": "saves/pak0.bin", "kind": "pak0", "mode": "seed" }, { "file": "saves/other.bin", "mode": "later" }, "junk", {} ])json"), "", c, error));
+    CHECK(c.has_saves);
+    CHECK(c.seed_saves.size() == 2);
+    CHECK(c.seed_saves[0] == "saves/wwf.nomercy.us.bin");
+    CHECK(c.seed_saves[1] == "saves/pak0.bin");
+
+    CHECK(parse(Full, "nomercy_unlocked", c, error));
+    CHECK(c.seed_saves.size() == 1);
+
+    for (const char *bad : { "../wwf.nomercy.us.bin", "/wwf.nomercy.us.bin", "\\\\wwf.nomercy.us.bin", "C:/wwf.nomercy.us.bin" }) {
+        CHECK(!parse(with(std::string(R"json([ { "file": ")json") + bad + R"json(" } ])json"), "", c, error));
+        CHECK(error.find("leaves the conversion folder") != std::string::npos);
+    }
+}
+
+TEST_CASE("conversion: the RT rig path is set only when the conversion has one and the variable is unset (#241)") {
+    Conversion c;
+    std::string error;
+    CHECK(parse(Full, "nomercy_unlocked", c, error));
+    const std::filesystem::path folder = std::filesystem::u8path("conv/nomercy_unlocked");
+    CHECK(rt_lights_path(c, folder, nullptr) == folder / "rt_lights.json");
+    CHECK(rt_lights_path(c, folder, "") == folder / "rt_lights.json");
+    CHECK(rt_lights_path(c, folder, "C:/launcher/rt_lights.json").empty());   // the launcher's (or a test run's) wins
+
+    Conversion none;
+    CHECK(rt_lights_path(none, folder, nullptr).empty());
+}
+
+TEST_CASE("conversion: seed saves are copied once, never over an existing save; a missing one is logged (#242)") {
+    namespace fs = std::filesystem;
+    const fs::path root = fs::temp_directory_path() / ("wcw_conversion_seed_" + std::to_string(
+        std::chrono::steady_clock::now().time_since_epoch().count()));
+    const fs::path folder = root / "conversions" / "s";
+    const fs::path saves = root / "saves" / "s";
+    fs::create_directories(folder / "saves");
+    auto write = [](const fs::path &p, const std::string &text) { std::ofstream(p, std::ios::binary) << text; };
+    auto read = [](const fs::path &p) { std::ifstream f(p, std::ios::binary); std::stringstream ss; ss << f.rdbuf(); return ss.str(); };
+    write(folder / "saves" / "wwf.nomercy.us.bin", "seed-flash");
+    write(folder / "saves" / "pak0.bin", "seed-pak");
+
+    Conversion c;
+    c.id = "s";
+    c.seed_saves = { "saves/wwf.nomercy.us.bin", "saves/pak0.bin", "saves/missing.bin" };
+
+    SeedReport r = seed_saves(c, folder, saves);   // creates saves/s/
+    CHECK(r.seeded == 2 && r.kept == 0 && r.failed == 1);
+    CHECK(r.lines.size() == 3);
+    CHECK(read(saves / "wwf.nomercy.us.bin") == "seed-flash");
+    CHECK(read(saves / "pak0.bin") == "seed-pak");
+    CHECK(!fs::exists(saves / "missing.bin"));
+    CHECK(!fs::exists(saves / "wwf.nomercy.us.bin.seed-tmp"));
+
+    // The player's progress stays.
+    write(saves / "wwf.nomercy.us.bin", "player");
+    fs::remove(saves / "pak0.bin");
+    r = seed_saves(c, folder, saves);
+    CHECK(r.seeded == 1 && r.kept == 1 && r.failed == 1);
+    CHECK(read(saves / "wwf.nomercy.us.bin") == "player");
+    CHECK(read(saves / "pak0.bin") == "seed-pak");
+
+    std::error_code ec;
+    fs::remove_all(root, ec);
+}
diff --git a/librecomp/tests/wcw/dd_breadcrumb_tests.cpp b/librecomp/tests/wcw/dd_breadcrumb_tests.cpp
new file mode 100644
index 0000000..3c04c29
--- /dev/null
+++ b/librecomp/tests/wcw/dd_breadcrumb_tests.cpp
@@ -0,0 +1,109 @@
+//
+// librecomp
+//
+
+// [wcw] Unit tests for librecomp/dd_breadcrumb (the last event to the local Datadog Agent when the game dies,
+// aki-roadmap#125). Built and run as part of every librecomp build (LIBRECOMP_WCW_TESTS); a failure fails the build.
+
+#include "librecomp/dd_breadcrumb.hpp"
+
+#include <string>
+#include <vector>
+
+#include "wcw_test.h"
+
+using namespace recomp::dd;
+
+TEST_CASE("dd breadcrumb: WCW_DD_METRICS switches it on like rt64's metrics (set, not empty, not 0)") {
+    CHECK(!switch_on(nullptr));
+    CHECK(!switch_on(""));
+    CHECK(!switch_on("0"));
+    CHECK(switch_on("1"));
+    CHECK(switch_on("yes"));
+}
+
+TEST_CASE("dd breadcrumb: the event line matches rt64's DogStatsD format (lengths, source, alert, tags)") {
+    const std::string line = event_line("switch-case out of bounds", "in func_80001234 at 0x80001240\nexit 1",
+        { "game:nomercy", "kind:fatal" }, "error", "fatal");
+    // The text's newline is escaped: 38 characters.
+    CHECK(line == "_e{25,38}:switch-case out of bounds|in func_80001234 at 0x80001240\\nexit 1|k:fatal|s:aki-game|t:error"
+                  "|#game:nomercy,kind:fatal");
+    CHECK(event_line("a\nb", "x\r", {}, "", "") == "_e{3,1}:a b|x|s:aki-game");
+}
+
+TEST_CASE("dd breadcrumb: the title reads like rt64's session events (aki-game <game>: ...)") {
+    CHECK(fatal_title("nomercy", "switch-case out of bounds") == "aki-game nomercy: switch-case out of bounds");
+    CHECK(fatal_title("", "break") == "aki-game: break");
+}
+
+TEST_CASE("dd breadcrumb: the game name is rt64's (exe name, or a non-empty WCW_DD_GAME)") {
+    // Review finding: the running game's id (wwf.nomercy.us) tagged the breadcrumb differently from the session.
+    CHECK(game_from_exe("C:\\Games\\NoMercyRecompiled.exe") == "nomercy");
+    CHECK(game_from_exe("/opt/aki/Vpw2Recompiled") == "vpw2");
+    CHECK(game_from_exe("WCWRecompiled.exe") == "wt");
+    CHECK(fatal_game("revenge", "NoMercyRecompiled.exe") == "revenge");
+    CHECK(fatal_game("", "NoMercyRecompiled.exe") == "nomercy");
+    CHECK(fatal_game(nullptr, "NoMercyRecompiled.exe") == "nomercy");
+}
+
+TEST_CASE("dd breadcrumb: tags are cleaned like rt64's (WCW_DD_TAGS cannot break the datagram)") {
+    CHECK(tag("Conversion", " NMP Plus ") == "conversion:nmp_plus");
+    CHECK(tag("1x", "a|b") == "t_1x:a_b");
+    CHECK(tag("k", "  ").empty());
+    const std::vector<std::string> tags = parse_tags(" conversion:nmp , bogus,,owner:Jesse ,conversion:nmp");
+    CHECK(tags.size() == 2);
+    CHECK(tags[0] == "conversion:nmp");
+    CHECK(tags[1] == "owner:jesse");
+}
+
+TEST_CASE("dd breadcrumb: fatal tags: the game, kind:fatal, then WCW_DD_TAGS without game or kind") {
+    const std::vector<std::string> tags = fatal_tags("nomercy", "conversion:nmp,game:other,kind:x,owner:jesse");
+    CHECK(tags.size() == 4);
+    CHECK(tags[0] == "game:nomercy");
+    CHECK(tags[1] == "kind:fatal");
+    CHECK(tags[2] == "conversion:nmp");
+    CHECK(tags[3] == "owner:jesse");
+    CHECK(fatal_tags("", nullptr).size() == 1);
+}
+
+// The golden cases shared with rt64's in-game metrics (dd_event_golden.inc, the same file in both repos): both copies
+// of the tag and event format give the same strings (aki-roadmap#125).
+static std::vector<std::string> golden_split(const std::string& joined) {
+    std::vector<std::string> out;
+    if (joined.empty()) {
+        return out;
+    }
+
+    size_t pos = 0;
+    while (true) {
+        const size_t end = joined.find(';', pos);
+        out.push_back(joined.substr(pos, (end == std::string::npos) ? std::string::npos : end - pos));
+        if (end == std::string::npos) {
+            return out;
+        }
+
+        pos = end + 1;
+    }
+}
+
+static std::string golden_join(const std::vector<std::string>& tags) {
+    std::string out;
+    for (const std::string& t : tags) {
+        out += t + ";";
+    }
+
+    return out;
+}
+
+TEST_CASE("dd breadcrumb: the shared golden cases (rt64's metrics make the same lines)") {
+#define DD_GOLDEN_TAG(key, value, want) CHECK(tag(key, value) == want);
+#define DD_GOLDEN_TAGS(list, want) CHECK(golden_join(parse_tags(list)) == want);
+#define DD_GOLDEN_GAME(exe, want) CHECK(game_from_exe(exe) == want);
+#define DD_GOLDEN_EVENT(title, text, tags, alert, key, want) \
+    CHECK(event_line(title, text, golden_split(tags), alert, key) == want);
+#include "dd_event_golden.inc"
+#undef DD_GOLDEN_TAG
+#undef DD_GOLDEN_TAGS
+#undef DD_GOLDEN_GAME
+#undef DD_GOLDEN_EVENT
+}
diff --git a/librecomp/tests/wcw/dd_event_golden.inc b/librecomp/tests/wcw/dd_event_golden.inc
new file mode 100644
index 0000000..2b9d296
--- /dev/null
+++ b/librecomp/tests/wcw/dd_event_golden.inc
@@ -0,0 +1,59 @@
+// [wcw dd] Shared golden cases for the in-game Datadog line format (aki-roadmap#125).
+//
+// The same file, byte for byte, is rt64 tests/wcw/dd_event_golden.inc and N64ModernRuntime
+// librecomp/tests/wcw/dd_event_golden.inc. rt64's metrics (ddTag, ddParseTags, ddGameFromExe, ddEventLine) and the
+// runtime's fatal breadcrumb (recomp::dd::tag, parse_tags, game_from_exe, event_line) must both produce these exact
+// strings, so their two copies of the format can't drift apart: change one, and its tests fail until the cases (and
+// so the other copy) agree again. AkiTools tests/test_lib_sync.py checks that the two files stay identical (on the
+// forks' release and wcw branches, and in every game checkout); nothing runs it automatically: run it after editing.
+//
+// Each test file defines the four macros before including this one:
+//   DD_GOLDEN_TAG(key, value, expected tag)
+//   DD_GOLDEN_TAGS(WCW_DD_TAGS list, expected tags joined with ';', each followed by ';')
+//   DD_GOLDEN_GAME(exe path or name, expected game)
+//   DD_GOLDEN_EVENT(title, text, tags joined with ';', alert type, aggregation key, expected event line)
+
+DD_GOLDEN_TAG("game", "nomercy", "game:nomercy")
+DD_GOLDEN_TAG("Game", "No Mercy!", "game:no_mercy")
+DD_GOLDEN_TAG("1st", "x", "t_1st:x")
+DD_GOLDEN_TAG("owner", "Fire Ant", "owner:fire_ant")
+DD_GOLDEN_TAG("k", "a|b,c#d", "k:a_b_c_d")
+DD_GOLDEN_TAG("k", "  spaced  ", "k:spaced")
+DD_GOLDEN_TAG("k", "", "")
+DD_GOLDEN_TAG("", "v", "t_:v")
+DD_GOLDEN_TAG("k", "__x__", "k:x")
+DD_GOLDEN_TAG("con-ver.sion/x", "btbw:1", "con-ver.sion/x:btbw:1")
+DD_GOLDEN_TAG("k", "\xC3\x84\xC3\x96", "")
+DD_GOLDEN_TAG("_k_", "v", "k:v")
+DD_GOLDEN_TAG("k", "a  !b", "k:a_b")
+DD_GOLDEN_TAG("k", "\tv\n", "k:v")
+DD_GOLDEN_TAG("!!!", "v", "t_:v")
+DD_GOLDEN_TAG("-k", "v", "t_-k:v")
+// The 200-character cap: applied after cleaning, with no trim after it, so a cut can end on '_'.
+DD_GOLDEN_TAG("k", std::string(198, 'a'), "k:" + std::string(198, 'a'))
+DD_GOLDEN_TAG("k", std::string(199, 'a'), "k:" + std::string(198, 'a'))
+DD_GOLDEN_TAG("k", std::string(197, 'a') + " bb", "k:" + std::string(197, 'a') + "_")
+
+DD_GOLDEN_TAGS("conversion:btbw,owner:Fire Ant", "conversion:btbw;owner:fire_ant;")
+DD_GOLDEN_TAGS("a:1,,b,c:,a:1,D:Two words", "a:1;d:two_words;")
+DD_GOLDEN_TAGS("", "")
+DD_GOLDEN_TAGS("x:y|z", "x:y_z;")
+DD_GOLDEN_TAGS(":v,k:", "t_:v;")
+DD_GOLDEN_TAGS("c:btbw:1", "c:btbw:1;")
+DD_GOLDEN_TAGS(nullptr, "")
+
+DD_GOLDEN_GAME("NoMercyRecompiled.exe", "nomercy")
+DD_GOLDEN_GAME("C:\\games\\Vpw2Recompiled.exe", "vpw2")
+DD_GOLDEN_GAME("/x/WCWRecompiled.exe", "wt")
+DD_GOLDEN_GAME("AkiLauncher", "akilauncher")
+DD_GOLDEN_GAME("Foo.EXE", "foo")
+DD_GOLDEN_GAME("", "")
+DD_GOLDEN_GAME("NoMercyRecompiled", "nomercy")
+
+DD_GOLDEN_EVENT("t", "x", "", "", "", "_e{1,1}:t|x|s:aki-game")
+DD_GOLDEN_EVENT("title\nwith newline", "line1\nline2\r\n", "game:nm;kind:fatal", "error", "aki-fatal",
+    "_e{18,14}:title with newline|line1\\nline2\\n|k:aki-fatal|s:aki-game|t:error|#game:nm,kind:fatal")
+DD_GOLDEN_EVENT("\xC3\xA9", "\xC3\xBC", "a:b;", "info", "", "_e{2,2}:\xC3\xA9|\xC3\xBC|s:aki-game|t:info|#a:b")
+DD_GOLDEN_EVENT("t", "x", "", "", "agg", "_e{1,1}:t|x|k:agg|s:aki-game")
+DD_GOLDEN_EVENT("a\r\nb", "x", "", "", "", "_e{3,1}:a b|x|s:aki-game")
+DD_GOLDEN_EVENT("", "", "", "", "", "_e{0,0}:||s:aki-game")
diff --git a/librecomp/tests/wcw/entry_prologue_tests.cpp b/librecomp/tests/wcw/entry_prologue_tests.cpp
new file mode 100644
index 0000000..5bb1640
--- /dev/null
+++ b/librecomp/tests/wcw/entry_prologue_tests.cpp
@@ -0,0 +1,76 @@
+//
+// librecomp
+//
+
+// [wcw fullconv] Unit tests for librecomp/entry_prologue_rules (aki-roadmap#76): the port's hand-added prologues reach
+// the live recompiler's entry hooks, with or without a mod's own hook on the same function. Built and run as part of
+// every librecomp build (LIBRECOMP_WCW_TESTS); a failure fails the build.
+
+#include "librecomp/entry_prologue_rules.hpp"
+
+#include <vector>
+
+#include "wcw_test.h"
+
+using namespace recomp::mods::entry_prologues;
+
+namespace {
+    int stock_a, stock_b, stock_c;
+}
+
+TEST_CASE("entry prologues: a plain mod hook slot decodes as a slot, not a prologue") {
+    Decoded d = decode(7);
+    CHECK(!d.is_prologue);
+    CHECK(d.has_slot && d.slot == 7);
+}
+
+TEST_CASE("entry prologues: encode and decode round-trip, with and without a slot") {
+    Decoded alone = decode(encode(3, false, 0));
+    CHECK(alone.is_prologue && alone.prologue == 3 && !alone.has_slot);
+
+    Decoded both = decode(encode(5, true, 0));
+    CHECK(both.is_prologue && both.prologue == 5 && both.has_slot && both.slot == 0);
+
+    Decoded big = decode(encode(MaxPrologues - 1, true, 0xFFFFFFFEu));
+    CHECK(big.is_prologue && big.prologue == MaxPrologues - 1 && big.has_slot && big.slot == 0xFFFFFFFEu);
+}
+
+TEST_CASE("entry prologues: only functions with a prologue get one") {
+    const void* funcs[] = { &stock_a, &stock_b, &stock_c };
+    std::unordered_map<const void*, size_t> prologue_of{ { &stock_b, 0 } };
+    std::unordered_map<size_t, size_t> hooks{};
+    CHECK(add_to_entry_hooks(funcs, prologue_of, hooks) == 1);
+    CHECK(hooks.size() == 1);
+    CHECK(hooks.count(1) == 1);
+    Decoded d = decode(hooks[1]);
+    CHECK(d.is_prologue && d.prologue == 0 && !d.has_slot);
+}
+
+TEST_CASE("entry prologues: a mod's entry hook on the same function is kept alongside the prologue") {
+    const void* funcs[] = { &stock_a, &stock_b };
+    std::unordered_map<const void*, size_t> prologue_of{ { &stock_a, 2 }, { &stock_b, 1 } };
+    std::unordered_map<size_t, size_t> hooks{ { 0, 9 } };
+    CHECK(add_to_entry_hooks(funcs, prologue_of, hooks) == 2);
+    Decoded a = decode(hooks[0]);
+    CHECK(a.is_prologue && a.prologue == 2 && a.has_slot && a.slot == 9);
+    Decoded b = decode(hooks[1]);
+    CHECK(b.is_prologue && b.prologue == 1 && !b.has_slot);
+}
+
+TEST_CASE("entry prologues: adding twice doesn't stack or lose the mod slot") {
+    const void* funcs[] = { &stock_a };
+    std::unordered_map<const void*, size_t> prologue_of{ { &stock_a, 4 } };
+    std::unordered_map<size_t, size_t> hooks{ { 0, 3 } };
+    CHECK(add_to_entry_hooks(funcs, prologue_of, hooks) == 1);
+    CHECK(add_to_entry_hooks(funcs, prologue_of, hooks) == 0);
+    Decoded d = decode(hooks[0]);
+    CHECK(d.is_prologue && d.prologue == 4 && d.has_slot && d.slot == 3);
+}
+
+TEST_CASE("entry prologues: no prologues registered leaves the hooks untouched") {
+    const void* funcs[] = { &stock_a, &stock_b };
+    std::unordered_map<const void*, size_t> prologue_of{};
+    std::unordered_map<size_t, size_t> hooks{ { 1, 0 } };
+    CHECK(add_to_entry_hooks(funcs, prologue_of, hooks) == 0);
+    CHECK(hooks.size() == 1 && hooks[1] == 0);
+}
diff --git a/librecomp/tests/wcw/external_message_pump_tests.cpp b/librecomp/tests/wcw/external_message_pump_tests.cpp
new file mode 100644
index 0000000..d4bccf3
--- /dev/null
+++ b/librecomp/tests/wcw/external_message_pump_tests.cpp
@@ -0,0 +1,257 @@
+//
+// N64ModernRuntime (ultramodern)
+//
+
+// [wcw] Unit tests for ultramodern/external_message_pump.hpp: the idle thread's wait for external messages while
+// undeliverable completions are queued (aki-roadmap#90). Built and run with librecomp_wcw_tests; a failure fails the
+// build.
+
+#include "ultramodern/external_message_pump.hpp"
+
+#include <atomic>
+#include <chrono>
+#include <deque>
+#include <thread>
+#include <vector>
+
+#include "blockingconcurrentqueue.h"
+
+#include "wcw_test.h"
+
+using namespace ultramodern::external_message_pump;
+using namespace std::chrono_literals;
+
+namespace {
+    struct Msg {
+        int id = 0;
+        bool deliverable = false;
+        bool requeue = true;
+    };
+
+    // A scripted queue: `queued` is what is already waiting; each wait_dequeue_timed call takes the next entry of
+    // `arrivals` (a message posted while the waiter blocks), or times out when there is none.
+    struct FakeQueue {
+        std::deque<Msg> queued;
+        std::deque<Msg> arrivals;
+        int timed_waits = 0;
+        int queued_at_timed_wait = 0; // messages already queued when a timed wait started (must stay 0)
+        std::chrono::microseconds last_timeout{ 0 };
+
+        void wait_dequeue(Msg& m) {
+            if (queued.empty()) {
+                CHECK(!arrivals.empty()); // a real queue would block forever
+                queued.push_back(arrivals.front());
+                arrivals.pop_front();
+            }
+            m = queued.front();
+            queued.pop_front();
+        }
+
+        bool wait_dequeue_timed(Msg& m, std::chrono::microseconds timeout) {
+            timed_waits++;
+            last_timeout = timeout;
+            queued_at_timed_wait += static_cast<int>(queued.size());
+            if (!queued.empty()) { // re-enqueued backlog: the wait returns at once (the old busy cycle)
+                m = queued.front();
+                queued.pop_front();
+                return true;
+            }
+            if (arrivals.empty()) {
+                return false;
+            }
+            m = arrivals.front();
+            arrivals.pop_front();
+            return true;
+        }
+
+        bool try_dequeue(Msg& m) {
+            if (queued.empty()) {
+                return false;
+            }
+            m = queued.front();
+            queued.pop_front();
+            return true;
+        }
+
+        void enqueue(const Msg& m) {
+            queued.push_back(m);
+        }
+    };
+
+    Msg backlog_msg(int id) {
+        return Msg{ id, false, true };
+    }
+
+    Msg new_msg(int id) {
+        return Msg{ id, true, false };
+    }
+
+    struct Run {
+        WaitResult result;
+        std::vector<int> delivered_ids;
+        int wakes = 0;
+    };
+
+    Run run(FakeQueue& q, std::chrono::microseconds backlog_wait = 16ms) {
+        Run r;
+        std::vector<Msg> scratch;
+        r.result = wait_and_deliver(q, scratch, backlog_wait,
+            [&](Msg& m) {
+                if (m.deliverable) {
+                    r.delivered_ids.push_back(m.id);
+                    return Delivery::Delivered;
+                }
+                return m.requeue ? Delivery::Retry : Delivery::Drop;
+            },
+            [&] { r.wakes++; });
+        return r;
+    }
+
+    std::vector<int> ids(const std::deque<Msg>& q) {
+        std::vector<int> out;
+        for (const Msg& m : q) {
+            out.push_back(m.id);
+        }
+        return out;
+    }
+}
+
+// Waiting with only the backlog queued
+
+TEST_CASE("backlog: a message posted while only the backlog is queued is delivered by the same wait (#90 latency)") {
+    // World Tour / VPW64: a standing backlog of fire-and-forget DMA completions, all game threads idle, then the VI
+    // retrace arrives. The old wait delivered nothing, re-enqueued the backlog and slept 1 ms, and the retrace sat in
+    // the queue for that sleep. Now the wait blocks on the queue and the retrace is delivered when it arrives.
+    FakeQueue q;
+    q.queued = { backlog_msg(1), backlog_msg(2) };
+    q.arrivals = { new_msg(10) };
+    const Run r = run(q);
+    CHECK_EQ(r.result.delivered, 1);
+    CHECK(r.delivered_ids == std::vector<int>{ 10 });
+    CHECK_EQ(r.result.backlog_waits, 1);
+    CHECK_EQ(q.timed_waits, 1);
+}
+
+TEST_CASE("backlog: it is held aside during the wait, not re-enqueued (that woke the wait at once, ~550 times a second)") {
+    FakeQueue q;
+    q.queued = { backlog_msg(1), backlog_msg(2), backlog_msg(3) };
+    q.arrivals = { new_msg(10) };
+    run(q);
+    CHECK_EQ(q.queued_at_timed_wait, 0);
+}
+
+TEST_CASE("backlog: it goes back on the queue in order afterwards, for the game threads' drains") {
+    FakeQueue q;
+    q.queued = { backlog_msg(1), backlog_msg(2), backlog_msg(3) };
+    q.arrivals = { new_msg(10) };
+    const Run r = run(q);
+    CHECK_EQ(r.result.requeued, 3);
+    CHECK(ids(q.queued) == (std::vector<int>{ 1, 2, 3 }));
+}
+
+TEST_CASE("backlog: with no new message the wait gives up after backlog_wait and keeps the backlog") {
+    FakeQueue q;
+    q.queued = { backlog_msg(1), backlog_msg(2) };
+    const Run r = run(q, 16ms);
+    CHECK_EQ(r.result.delivered, 0);
+    CHECK_EQ(r.result.requeued, 2);
+    CHECK_EQ(q.timed_waits, 1);
+    CHECK(q.last_timeout == std::chrono::microseconds{ 16ms });
+    CHECK(ids(q.queued) == (std::vector<int>{ 1, 2 }));
+}
+
+TEST_CASE("backlog: a new message that is also undeliverable joins the backlog and the wait goes on") {
+    FakeQueue q;
+    q.queued = { backlog_msg(1) };
+    q.arrivals = { backlog_msg(2), new_msg(10) };
+    const Run r = run(q);
+    CHECK_EQ(r.result.delivered, 1);
+    CHECK_EQ(r.result.backlog_waits, 2);
+    CHECK(ids(q.queued) == (std::vector<int>{ 1, 2 }));
+}
+
+TEST_CASE("backlog: the shutdown check runs after every wake, including wakes inside the backlog wait") {
+    FakeQueue q;
+    q.queued = { backlog_msg(1) };
+    q.arrivals = { backlog_msg(2), new_msg(10) };
+    const Run r = run(q);
+    CHECK_EQ(r.wakes, 3);
+}
+
+// Nothing to hold
+
+TEST_CASE("no backlog: a deliverable message returns at once, without a timed wait") {
+    FakeQueue q;
+    q.queued = { new_msg(10) };
+    const Run r = run(q);
+    CHECK_EQ(r.result.delivered, 1);
+    CHECK_EQ(q.timed_waits, 0);
+    CHECK_EQ(r.wakes, 1);
+}
+
+TEST_CASE("no backlog: everything available is drained in one wake, and an undeliverable one is kept") {
+    FakeQueue q;
+    q.queued = { backlog_msg(1), new_msg(10), new_msg(11) };
+    const Run r = run(q);
+    CHECK(r.delivered_ids == (std::vector<int>{ 10, 11 }));
+    CHECK_EQ(r.result.requeued, 1);
+    CHECK_EQ(q.timed_waits, 0);
+    CHECK(ids(q.queued) == std::vector<int>{ 1 });
+}
+
+TEST_CASE("no backlog: a dropped message counts as dropped and the wait returns") {
+    FakeQueue q;
+    q.queued = { Msg{ 5, false, false } };
+    const Run r = run(q);
+    CHECK_EQ(r.result.delivered, 0);
+    CHECK_EQ(r.result.dropped, 1);
+    CHECK_EQ(q.timed_waits, 0);
+    CHECK(q.queued.empty());
+}
+
+// Grace window
+
+TEST_CASE("grace: a requeue_if_blocked message is retried up to grace_ms after it was posted, then dropped") {
+    CHECK(undeliverable(true, 1000, 0, 1000) == Delivery::Retry);
+    CHECK(undeliverable(true, 500, 0, 1000) == Delivery::Retry);
+    CHECK(undeliverable(true, 1001, 0, 1000) == Delivery::Drop);
+}
+
+TEST_CASE("grace: a message without requeue_if_blocked is dropped when its queue is full (hardware NOBLOCK)") {
+    CHECK(undeliverable(false, 0, 0, 1000) == Delivery::Drop);
+}
+
+// With the runtime's real queue
+
+TEST_CASE("real queue: a message posted from another thread wakes the backlog wait at once, not at its timeout") {
+    moodycamel::BlockingConcurrentQueue<Msg> q;
+    for (int i = 0; i < 50; i++) {
+        q.enqueue(backlog_msg(i));
+    }
+    std::atomic<int64_t> posted_us{ 0 };
+    auto now_us = [] {
+        return std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    };
+    std::thread producer{ [&] {
+        std::this_thread::sleep_for(20ms);
+        posted_us.store(now_us());
+        q.enqueue(new_msg(1000));
+    } };
+    std::vector<Msg> scratch;
+    int64_t delivered_us = 0;
+    // A 2 s safety bound: a wait that only polled or timed out would take that long; waking on the post takes ~us.
+    const WaitResult r = wait_and_deliver(q, scratch, std::chrono::microseconds{ 2s },
+        [&](Msg& m) {
+            if (m.deliverable) {
+                delivered_us = now_us();
+                return Delivery::Delivered;
+            }
+            return Delivery::Retry;
+        },
+        [] {});
+    producer.join();
+    CHECK_EQ(r.delivered, 1);
+    CHECK_EQ(r.requeued, 50);
+    CHECK_EQ(static_cast<int>(q.size_approx()), 50);
+    CHECK(delivered_us - posted_us.load() < 500000);
+}
