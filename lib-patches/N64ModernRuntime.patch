@@ -0,0 +1,59 @@
+#ifndef __RECOMP_SAVE_BACKUP_RULES_HPP__
+#define __RECOMP_SAVE_BACKUP_RULES_HPP__
+
+// [wcw saves] Pure rules for automatic save backups (aki-roadmap#50): backup file names, which backups to keep, when a
+// backup is due. No file I/O here (that is save_backups.cpp), so they are unit tested
+// (librecomp/tests/save_backup_rules_tests.cpp, run on every build).
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace recomp {
+    namespace save_backups {
+        // How many backups are kept per save file (the oldest beyond this are deleted).
+        constexpr size_t MaxBackupsPerFile = 10;
+        // A change-triggered backup is taken at most this often per save file (a launch backup always is).
+        constexpr int64_t MinChangeBackupIntervalSeconds = 10 * 60;
+
+        // A local date and time to the second, as written in backup names.
+        struct Timestamp {
+            int year = 0, month = 0, day = 0, hour = 0, minute = 0, second = 0;
+            bool operator==(const Timestamp &other) const = default;
+            // Seconds since 1970-01-01 00:00:00 of the same (local) clock, proleptic Gregorian: orders timestamps and
+            // gives exact differences.
+            int64_t sort_key() const;
+        };
+
+        // Seconds between two timestamps (b - a), exact for any two dates.
+        int64_t seconds_between(const Timestamp &a, const Timestamp &b);
+
+        // "wwf.nomercy.us.bin" + 2026-10-14 03:15:02 -> "wwf.nomercy.us.20261014-031502.bin"; the stem is the save
+        // file name without its final ".bin" (".pak.bin" files keep ".pak" in the stem, so they never collide with the
+        // main save's backups).
+        std::string backup_file_name(const std::string &save_file_name, const Timestamp &when);
+
+        // The timestamp of a backup of save_file_name, if candidate is one; nullopt for anything else (another save
+        // file's backups, the pak file's backups, stray files, malformed dates).
+        std::optional<Timestamp> parse_backup_file_name(const std::string &save_file_name, const std::string &candidate);
+
+        // Backups to delete so at most keep remain: the oldest first. names are backup file names of one save file.
+        std::vector<std::string> backups_to_delete(const std::string &save_file_name, const std::vector<std::string> &names, size_t keep);
+
+        // Backups of one save file, newest first (what the restore menu lists).
+        std::vector<std::string> backups_newest_first(const std::string &save_file_name, const std::vector<std::string> &names);
+
+        enum class BackupReason { Launch, Change, BeforeRestore };
+
+        // Whether a backup is due now. Launch and BeforeRestore: always (when the save file exists). Change: when there
+        // is no backup yet, or the newest one is at least MinChangeBackupIntervalSeconds old (a game that saves
+        // constantly would otherwise rotate every backup out within minutes).
+        bool backup_due(BackupReason reason, const std::optional<Timestamp> &newest_backup, const Timestamp &now);
+
+        // "2026-10-14 03:15:02" for menus.
+        std::string display_time(const Timestamp &when);
+    }
+}
+
+#endif
diff --git a/librecomp/include/librecomp/save_backups.hpp b/librecomp/include/librecomp/save_backups.hpp
new file mode 100644
index 0000000..5d33cc4
--- /dev/null
+++ b/librecomp/include/librecomp/save_backups.hpp
@@ -0,0 +1,60 @@
+#ifndef __RECOMP_SAVE_BACKUPS_HPP__
+#define __RECOMP_SAVE_BACKUPS_HPP__
+
+// [wcw saves] Automatic save backups (aki-roadmap#50). Timestamped copies of the game's save files (the cartridge
+// save <game>.bin and the Controller Pak image <game>.pak.bin) go to a backups/ folder next to them:
+// - at launch, before the game touches them;
+// - when the game writes them, at most every MinChangeBackupIntervalSeconds per file;
+// - before a restore replaces one (so a restore can be undone).
+// The newest MaxBackupsPerFile per file are kept. A restore picked in the menu is applied the next time the game
+// starts, before it reads its saves, so the running game can't overwrite it. Rules: save_backup_rules.hpp.
+
+#include <filesystem>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "librecomp/save_backup_rules.hpp"
+
+namespace recomp {
+    namespace save_backups {
+        struct BackupEntry {
+            std::filesystem::path save_file;   // the file it restores (e.g. saves/wwf.nomercy.us.bin)
+            std::filesystem::path backup_file; // saves/backups/wwf.nomercy.us.20261014-031502.bin
+            Timestamp when;
+            bool controller_pak = false;       // a .pak.bin (Controller Pak) backup
+        };
+
+        // The game's main save file: the running game's (ultramodern::get_save_file_path) once it has started, else
+        // the registered game's default location (the stock saves folder). Empty if neither is known.
+        std::filesystem::path main_save_file();
+
+        // Back up save_file now if it exists and the rules say a backup is due; then delete the oldest beyond
+        // MaxBackupsPerFile. Returns whether a backup was written. Errors are logged, never thrown.
+        bool backup_save_file(const std::filesystem::path &save_file, BackupReason reason);
+
+        // At game start: apply a pending restore, then take the launch backups of the main save and its pak file.
+        void on_game_start(const std::filesystem::path &main_save);
+
+        // The backups of the main save and its .pak.bin, newest first.
+        std::vector<BackupEntry> list_backups(const std::filesystem::path &main_save);
+
+        // When save_file was last written, or nullopt if it doesn't exist.
+        std::optional<Timestamp> last_write_time(const std::filesystem::path &save_file);
+
+        // Schedule entry to replace its save file the next time the game starts (one pending restore at a time; a new
+        // request replaces it). Returns false if it couldn't be recorded.
+        bool request_restore(const BackupEntry &entry);
+
+        // The pending restore for main_save's folder, if any.
+        std::optional<BackupEntry> pending_restore(const std::filesystem::path &main_save);
+
+        // Cancel a pending restore.
+        void cancel_restore(const std::filesystem::path &main_save);
+
+        // Now, on the local clock.
+        Timestamp now();
+    }
+}
+
+#endif
diff --git a/librecomp/include/librecomp/startup_shutdown.hpp b/librecomp/include/librecomp/startup_shutdown.hpp
new file mode 100644
index 0000000..3bc006b
--- /dev/null
+++ b/librecomp/include/librecomp/startup_shutdown.hpp
@@ -0,0 +1,26 @@
+#ifndef __LIBRECOMP_STARTUP_SHUTDOWN_HPP__
+#define __LIBRECOMP_STARTUP_SHUTDOWN_HPP__
+
+#include <atomic>
+
+namespace recomp {
+    // [wcw fix] jessetbh/aki-roadmap#73. A quit (WCW_QUIT_AFTER, or closing the window
+    // before a game is picked) can land while the game start thread is still in
+    // ultramodern::preinit, which waits for the gfx thread to create the renderer. On
+    // Windows that creation touches the main thread's window (RT64's
+    // ApplicationWindow::setFullScreen calls SetWindowLongPtr), which only completes once
+    // the main thread processes window messages. recomp::start used to stop pumping as
+    // soon as `exited` was set and then block joining the game thread: a deadlock.
+    //
+    // Keep calling pump() until startup_done is true, then return. Shutdown proceeds as
+    // before afterwards, so a quit after startup behaves exactly as it used to.
+    template <typename Pump, typename Sleep>
+    void pump_until_startup_done(const std::atomic_bool& startup_done, Pump&& pump, Sleep&& sleep) {
+        while (!startup_done.load()) {
+            sleep();
+            pump();
+        }
+    }
+}
+
+#endif
diff --git a/librecomp/src/ai.cpp b/librecomp/src/ai.cpp
index 0195f2b..f5c4a50 100644
--- a/librecomp/src/ai.cpp
+++ b/librecomp/src/ai.cpp
@@ -6,24 +6,49 @@
 
 #define VI_NTSC_CLOCK 48681812
 
+// [wcw2k] Hardware-accurate osAiSetFrequency return, opt-in per project (default off =
+// WT/Revenge unchanged). On console the AI quantizes the rate through the DAC divisor
+// and osAiSetFrequency RETURNS the actual rate (28800 -> dacRate 1690 -> 28805); AKI
+// audio init sizes its heap allocations from that return value. Returning the requested
+// rate unquantized shrinks WM2000's audio DMA buffers by a few samples each, shifting
+// every subsequent audio-heap allocation ~0xA0-0x140 LOW — low enough that the audio
+// manager's scheduler-client node lands INSIDE thread 6's linker-fixed boot stack
+// (top 0x800839A0). The scheduler then writes message values over the stack slot
+// where the transition chain saved s0 -> thread 6 restores s0=1 -> deterministic crash
+// in func_800222D8 entering gameplay (boots 48-54, session-5 part 5).
+bool wcw_ai_accurate_freq = false;
+
 extern "C" void osAiSetFrequency_recomp(uint8_t* rdram, recomp_context* ctx) {
     uint32_t freq = ctx->r4;
-    // This makes actual audio frequency more accurate to console, but may not be desirable
-    //uint32_t dacRate = (uint32_t)(((float)VI_NTSC_CLOCK / freq) + 0.5f);
-    //freq = VI_NTSC_CLOCK / dacRate;
+    if (wcw_ai_accurate_freq) {
+        uint32_t dacRate = (uint32_t)(((float)VI_NTSC_CLOCK / freq) + 0.5f);
+        freq = VI_NTSC_CLOCK / dacRate;
+        fprintf(stderr, "[wcw][ai] osAiSetFrequency(%u) -> %u (dacRate %u)\n", (unsigned)ctx->r4, freq, dacRate);
+    }
     ctx->r2 = freq;
     ultramodern::set_audio_frequency(freq);
 }
 
 extern "C" void osAiSetNextBuffer_recomp(uint8_t* rdram, recomp_context* ctx) {
+    // [wcw] totals every 64 calls to see whether the audio driver still feeds buffers late in a run
+    { static int n = 0; static const bool wcwTrace = getenv("WCW_TRACE") != nullptr; if (wcwTrace && (n++ % 64) == 0) fprintf(stderr, "[wcw][ai] osAiSetNextBuffer #%d len=0x%X\n", n - 1, (unsigned)ctx->r5); }
     ultramodern::queue_audio_buffer(rdram, ctx->r4, ctx->r5);
     ctx->r2 = 0;
 }
 
 extern "C" void osAiGetLength_recomp(uint8_t* rdram, recomp_context* ctx) {
     ctx->r2 = ultramodern::get_remaining_audio_bytes();
+    { static int n = 0; static const bool wcwTrace = getenv("WCW_TRACE") != nullptr; if (wcwTrace && (n++ % 256) == 0) fprintf(stderr, "[wcw][ai] osAiGetLength #%d -> 0x%X\n", n - 1, (unsigned)ctx->r2); }
 }
 
 extern "C" void osAiGetStatus_recomp(uint8_t* rdram, recomp_context* ctx) {
-    ctx->r2 = 0x00000000; // Pretend the audio DMAs finish instantly
+    // [wcw2k] Report AI_STATUS_FULL|AI_STATUS_DMA_BUSY while the host queue is backlogged
+    // so the game's own FULL-wait loop paces generation (it blocks on its frame message, so
+    // this never spins). Previously hardcoded 0 ("DMAs finish instantly"), which disabled
+    // WM2000's only audio throttle.
+    bool full = ultramodern::is_audio_backlogged();
+    ctx->r2 = full ? 0xC0000000 : 0x00000000;
+    { static int n = 0, fulls = 0; if (full) fulls++;
+      static const bool wcwTrace = getenv("WCW_TRACE") != nullptr;
+      if (wcwTrace && (n++ % 4096) == 0) fprintf(stderr, "[wcw][ai] osAiGetStatus #%d fulls=%d\n", n - 1, fulls); }
 }
diff --git a/librecomp/src/math_routines.cpp b/librecomp/src/math_routines.cpp
index 4d6a01d..9e2dc24 100644
--- a/librecomp/src/math_routines.cpp
+++ b/librecomp/src/math_routines.cpp
@@ -112,3 +112,35 @@ extern "C" void __ll_lshift_recomp(uint8_t * rdram, recomp_context * ctx) {
     ctx->r2 = (int32_t)(ret >> 32);
     ctx->r3 = (int32_t)(ret >> 0);
 }
+
+// [wcw] The remaining IDO softfloat conversions used by WCW (math_routines didn't ship these
+// four). N64Recomp can't emit trunc.l.*/cvt.*.l, so the game's func_XXXX are named to these in
+// tools/gen_symbols.py and routed here. FP arg in f12, int64 result in r2(hi)/r3(lo) and vice
+// versa, matching the existing helpers above.
+extern "C" void __d_to_ll_recomp(uint8_t * rdram, recomp_context * ctx) {
+    int64_t ret = (int64_t)ctx->f12.d;
+
+    ctx->r2 = (int32_t)(ret >> 32);
+    ctx->r3 = (int32_t)(ret >> 0);
+}
+
+extern "C" void __d_to_ull_recomp(uint8_t * rdram, recomp_context * ctx) {
+    uint64_t ret = (uint64_t)ctx->f12.d;
+
+    ctx->r2 = (int32_t)(ret >> 32);
+    ctx->r3 = (int32_t)(ret >> 0);
+}
+
+extern "C" void __f_to_ull_recomp(uint8_t * rdram, recomp_context * ctx) {
+    uint64_t ret = (uint64_t)ctx->f12.fl;
+
+    ctx->r2 = (int32_t)(ret >> 32);
+    ctx->r3 = (int32_t)(ret >> 0);
+}
+
+extern "C" void __ll_to_d_recomp(uint8_t * rdram, recomp_context * ctx) {
+    int64_t a = (ctx->r4 << 32) | ((ctx->r5 << 0) & 0xFFFFFFFFu);
+    double ret = (double)a;
+
+    ctx->f0.d = ret;
+}
