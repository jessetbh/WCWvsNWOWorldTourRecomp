+
+        // Undoes the swaps (newest first). Returns the paths it couldn't put back, for the message.
+        std::vector<std::string> roll_back(const fs::path &data_dir, std::vector<Swap> &swaps) {
+            std::vector<std::string> stuck;
+            for (auto it = swaps.rbegin(); it != swaps.rend(); ++it) {
+                std::error_code ec;
+                const fs::path dst = data_dir / u8path(it->dst);
+                if (it->placed) {
+                    fs::remove_all(dst, ec);
+                }
+                if (it->moved_aside) {
+                    ec.clear();
+                    fs::rename(data_dir / u8path(it->aside), dst, ec);
+                    if (ec) {
+                        stuck.push_back(it->dst + " (it's at " + it->aside + ")");
+                    }
+                }
+                fs::remove_all(data_dir / u8path(it->staged), ec);
+            }
+            return stuck;
+        }
+
+        InstallResult install_impl(const fs::path &package, const fs::path &data_dir, const InstallOptions &options_in) {
+            InstallResult result;
+            InstallOptions options = options_in;
+            if (options.date.empty()) {
+                options.date = today_local();
+            }
+            if (options.now.empty()) {
+                options.now = now_utc();
+            }
+            auto finish = [&](Outcome outcome, const std::string &message) {
+                result.outcome = outcome;
+                result.message = message;
+                return result;
+            };
+            std::error_code ec;
+            if (const std::string recovered = recover_interrupted_install(data_dir); !recovered.empty()) {
+                std::printf("[wcw] packages: %s\n", recovered.c_str());
+                if (fs::exists(data_dir / WorkFolder / JournalFile, ec)) {
+                    return finish(Outcome::Failed, "an earlier interrupted install couldn't be undone yet (a file is in use); "
+                        "close other programs and start the game again");
+                }
+            }
+
+            // 1. The package folder (a zip is unpacked into a working folder first).
+            struct Cleanup {
+                fs::path p;
+                ~Cleanup() {
+                    if (!p.empty()) {
+                        std::error_code e;
+                        fs::remove_all(p, e);
+                        fs::remove(p.parent_path(), e);   // .aki-work, when nothing else is in it
+                    }
+                }
+            } cleanup;
+            fs::path folder = package;
+            if (fs::is_regular_file(package, ec)) {
+                if (lower(u8str(package.extension())) != ".zip") {
+                    return finish(Outcome::Refused, "not a package: expected a folder or a .zip with aki-package.json");
+                }
+                const fs::path unpacked = work_folder(data_dir, "unpack");
+                cleanup.p = unpacked;
+                fs::create_directories(unpacked, ec);
+                if (ec) {
+                    return finish(Outcome::Failed, "can't unpack it: " + ec.message());
+                }
+                if (const std::string why = extract_zip(package, unpacked); !why.empty()) {
+                    return finish(Outcome::Refused, "can't unpack it: " + why);
+                }
+                folder = unpacked;
+            }
+            else if (!fs::is_directory(package, ec)) {
+                return finish(Outcome::Refused, "not found");
+            }
+            const std::optional<fs::path> root = package_root(folder);
+            if (!root) {
+                return finish(Outcome::Refused, "not a package: no aki-package.json at its root");
+            }
+
+            // 2. The manifest.
+            Manifest m;
+            if (!parse_manifest(read_small_file(*root / ManifestFile), m, result.problems)) {
+                return finish(Outcome::Refused, "its aki-package.json has errors");
+            }
+            result.id = m.id;
+            result.display_name = m.display_name;
+            result.version = m.version;
+            result.kind = m.kind;
+
+            // 3. The registry and the plan.
+            Registry registry;
+            const RegistryStatus status = load_registry(data_dir, registry);
+            if (!may_save(status)) {
+                return finish(Outcome::Refused, status == RegistryStatus::Newer ?
+                    "packages.json was written by a newer version; update the game first" :
+                    "packages.json can't be read; nothing was changed");
+            }
+            const Plan plan = plan_install(registry, m, options);
+            result.old_version = plan.old_version;
+            result.problems.insert(result.problems.end(), plan.notes.begin(), plan.notes.end());
+            if (plan.action == Action::Refuse) {
+                return finish(Outcome::Refused, plan.reason);
+            }
+            if (plan.action == Action::AlreadyInstalled) {
+                return finish(Outcome::AlreadyInstalled, plan.reason);
+            }
+            for (const Placement &p : plan.places) {
+                const fs::path src = *root / u8path(p.from);
+                if (p.folder ? !fs::is_directory(src, ec) : !fs::is_regular_file(src, ec)) {
+                    return finish(Outcome::Refused, "it names " + p.from + ", which isn't in the package");
+                }
+                if (has_link(src)) {
+                    return finish(Outcome::Refused, p.from + " holds a link to somewhere else; packages can't contain links");
+                }
+            }
+
+            // 4. Decide every swap up front (where the current content goes), then stage the new parts.
+            const Entry *old = find(registry, m.id);
+            std::vector<const Entry *> replaced;
+            for (const std::string &r : plan.replaced) {
+                replaced.push_back(find(registry, r));
+            }
+            auto owner_record = [&](const std::string &to) -> const InstalledFile * {
+                if (const InstalledFile *f = record_for(old, to)) {
+                    return f;
+                }
+                for (const Entry *e : replaced) {
+                    if (const InstalledFile *f = record_for(e, to)) {
+                        return f;
+                    }
+                }
+                return nullptr;
+            };
+            std::vector<std::string> reserved;   // kept names chosen in this install
+            std::vector<Swap> swaps;
+            for (const Placement &p : plan.places) {
+                Swap s;
+                s.dst = normal_path(p.to);
+                s.staged = s.dst + ".installing";
+                const fs::path dst = data_dir / u8path(s.dst);
+                if (fs::exists(dst, ec)) {
+                    const InstalledFile *rec = owner_record(p.to);
+                    if (rec && file_state(*rec, hash_path(dst)) == FileState::Unchanged) {
+                        s.aside = s.dst + ".replaced";
+                        fs::remove_all(data_dir / u8path(s.aside), ec);   // a stale one must never be put back
+                    }
+                    else {
+                        // Edited by the player, or put there by hand: kept, never overwritten.
+                        s.aside = std::string(KeptFolder) + "/" + edited_name(s.dst, options.date, [&](const std::string &n) {
+                            const std::string k = std::string(KeptFolder) + "/" + n;
+                            std::error_code e;
+                            return fs::exists(data_dir / u8path(k), e) || std::find(reserved.begin(), reserved.end(), k) != reserved.end();
+                        });
+                        reserved.push_back(s.aside);
+                        s.keep_aside = true;
+                    }
+                }
+                swaps.push_back(s);
+            }
+            for (size_t i = 0; i < swaps.size(); i++) {
+                const fs::path staged = data_dir / u8path(swaps[i].staged);
+                fs::remove_all(staged, ec);
+                fs::create_directories(staged.parent_path(), ec);
+                ec.clear();
+                if (plan.places[i].folder) {
+                    fs::copy(*root / u8path(plan.places[i].from), staged, fs::copy_options::recursive, ec);
+                }
+                else {
+                    fs::copy_file(*root / u8path(plan.places[i].from), staged, ec);
+                }
+                if (ec) {
+                    const std::string why = ec.message();
+                    roll_back(data_dir, swaps);
+                    return finish(Outcome::Failed, "can't copy " + plan.places[i].from + ": " + why);
+                }
+            }
+
+            // 5. The journal, then the swaps. A crash from here on is finished or undone at the next start: the
+            //    install's token goes into its registry entry, so a saved registry says "committed" by itself.
+            fs::create_directories(data_dir / WorkFolder, ec);
+            const fs::path journal = data_dir / WorkFolder / JournalFile;
+            char token_buf[32];
+            {
+                static std::mt19937_64 rng{ std::random_device{}() ^ uint64_t(std::chrono::steady_clock::now().time_since_epoch().count()) };
+                std::snprintf(token_buf, sizeof(token_buf), "%016llx", static_cast<unsigned long long>(rng()));
+            }
+            const std::string token = token_buf;
+            if (!write_replacing(journal, dump(journal_json(m.id, token, swaps, {}, false)))) {
+                roll_back(data_dir, swaps);
+                return finish(Outcome::Failed, "can't write the install journal; nothing was changed");
+            }
+            auto fail = [&](const std::string &why) {
+                const std::vector<std::string> stuck = roll_back(data_dir, swaps);
+                std::error_code e;
+                fs::remove(journal, e);
+                fs::remove(data_dir / WorkFolder, e);
+                std::string message = why;
+                if (!stuck.empty()) {
+                    message += "; couldn't put back:";
+                    for (const std::string &s : stuck) {
+                        message += " " + s;
+                    }
+                }
+                return finish(Outcome::Failed, message);
+            };
+            for (Swap &s : swaps) {
+                const fs::path dst = data_dir / u8path(s.dst);
+                if (!s.aside.empty()) {
+                    const fs::path aside = data_dir / u8path(s.aside);
+                    fs::remove_all(aside, ec);   // a stale .replaced from before (kept names are always fresh)
+                    fs::create_directories(aside.parent_path(), ec);
+                    ec.clear();
+                    fs::rename(dst, aside, ec);
+                    if (ec) {
+                        return fail("can't move " + s.dst + " aside: " + ec.message());
+                    }
+                    s.moved_aside = true;
+                }
+                ec.clear();
+                fs::rename(data_dir / u8path(s.staged), dst, ec);
+                if (ec) {
+                    return fail("can't install " + s.dst + ": " + ec.message());
+                }
+                s.placed = true;
+            }
+
+            // 6. The new registry entry (hashes of what was installed).
+            Entry entry;
+            entry.id = m.id;
+            entry.kind = m.kind;
+            entry.version = m.version;
+            entry.display_name = m.display_name;
+            entry.source = options.source;
+            entry.installed = options.now;
+            entry.extra = json{ { "install_token", token } }.dump();
+            for (const Swap &s : swaps) {
+                const std::optional<uint64_t> h = hash_path(data_dir / u8path(s.dst));
+                if (!h) {
+                    return fail("can't read back " + s.dst);
+                }
+                entry.files.push_back({ s.dst, *h });
+            }
+
+            // 7. The old version's and the replaced packages' files the new one doesn't use: unedited ones go, edited
+            //    ones stay where they are (now the player's own).
+            std::vector<std::string> to_delete;
+            auto retire = [&](const Entry *e) {
+                if (!e) {
+                    return;
+                }
+                for (const InstalledFile &f : e->files) {
+                    const bool reused = std::any_of(entry.files.begin(), entry.files.end(),
+                        [&](const InstalledFile &n) { return lower(n.path) == lower(normal_path(f.path)); });
+                    if (reused) {
+                        continue;
+                    }
+                    switch (file_state(f, hash_path(data_dir / u8path(f.path)))) {
+                        case FileState::Unchanged: to_delete.push_back(normal_path(f.path)); break;
+                        case FileState::Edited: result.kept.push_back(normal_path(f.path)); break;
+                        case FileState::Missing: break;
+                    }
+                }
+            };
+            retire(old);
+            for (const Entry *e : replaced) {
+                retire(e);
+            }
+
+            Registry updated = registry;
+            for (const std::string &r : plan.replaced) {
+                remove(updated, r);
+            }
+            upsert(updated, entry);
+            // The journal gets the delete list first: a crash right after the registry save is then finished with it.
+            write_replacing(journal, dump(journal_json(m.id, token, swaps, to_delete, false)));
+            if (!save_registry(data_dir, updated)) {
+                return fail("can't write packages.json; nothing was changed");
+            }
+
+            // 8. Committed: the cleanup can't be undone any more, so the journal says to finish it after a crash.
+            write_replacing(journal, dump(journal_json(m.id, token, swaps, to_delete, true)));
+            for (const Swap &s : swaps) {
+                if (s.keep_aside) {
+                    result.kept.push_back(s.aside);
+                }
+                else if (!s.aside.empty()) {
+                    remove_path(data_dir / u8path(s.aside));
+                }
+            }
+            for (const std::string &p : to_delete) {
+                remove_path(data_dir / u8path(p));
+            }
+            fs::remove(journal, ec);
+            fs::remove(data_dir / WorkFolder, ec);
+
+            const std::string name = m.display_name + " " + m.version;
+            std::string kept_note;
+            if (!result.kept.empty()) {
+                kept_note = " (" + std::to_string(result.kept.size()) + " of your edited files kept)";
+            }
+            switch (plan.action) {
+                case Action::Upgrade: return finish(Outcome::Upgraded, "updated " + m.display_name + " " + plan.old_version + " -> " + m.version + kept_note);
+                case Action::Reinstall: return finish(Outcome::Reinstalled, "reinstalled " + name + kept_note);
+                case Action::Downgrade: return finish(Outcome::Downgraded, "went back to " + name + " (from " + plan.old_version + ")" + kept_note);
+                default: return finish(Outcome::Installed, std::string("installed ") + name + " (" + kind_name(m.kind) + ")" + kept_note);
+            }
+        }
+    }
+
+    std::string recover_interrupted_install(const fs::path &data_dir) {
+        const fs::path journal = data_dir / WorkFolder / JournalFile;
+        std::error_code ec;
+        if (!fs::exists(journal, ec)) {
+            // Unpack folders a crash left behind (they can be large); no install is running while this is called.
+            bool cleared = false;
+            for (fs::directory_iterator it(data_dir / WorkFolder, ec), end; !ec && it != end; it.increment(ec)) {
+                std::error_code e;
+                if (u8str(it->path().filename()).rfind("unpack-", 0) == 0) {
+                    fs::remove_all(it->path(), e);
+                    cleared = true;
+                }
+            }
+            ec.clear();
+            fs::remove(data_dir / WorkFolder, ec);
+            return cleared ? "removed what an interrupted unpack left behind" : std::string();
+        }
+        const json j = json::parse(read_small_file(journal), nullptr, false);
+        if (j.is_discarded() || !j.is_object() || !j.contains("swaps") || !j["swaps"].is_array()) {
+            fs::remove(journal, ec);
+            return "an unreadable install journal was removed";
+        }
+        auto path_of = [&](const json &s, const char *key) {
+            const std::string p = (s.contains(key) && s[key].is_string()) ? s[key].get<std::string>() : std::string();
+            return (!p.empty() && safe_relative_path(p)) ? p : std::string();
+        };
+        bool committed = j.value("committed", false);
+        if (!committed) {
+            // The registry may have been saved just before the crash, ahead of the journal's "committed".
+            Registry registry;
+            const std::string id = j.value("id", std::string()), token = j.value("token", std::string());
+            if (!token.empty() && may_save(load_registry(data_dir, registry))) {
+                if (const Entry *e = find(registry, id); e && !e->extra.empty()) {
+                    const json extra = json::parse(e->extra, nullptr, false);
+                    committed = extra.is_object() && extra.value("install_token", std::string()) == token;
+                }
+            }
+        }
+        bool stuck = false;
+        std::vector<json> swaps(j["swaps"].begin(), j["swaps"].end());
+        if (committed) {
+            // The registry has the new version: finish the cleanup.
+            for (const json &s : swaps) {
+                const std::string aside = path_of(s, "aside"), staged = path_of(s, "staged");
+                if (!aside.empty() && !s.value("keep_aside", false)) {
+                    fs::remove_all(data_dir / u8path(aside), ec);
+                }
+                if (!staged.empty()) {
+                    fs::remove_all(data_dir / u8path(staged), ec);
+                }
+            }
+            if (j.contains("delete") && j["delete"].is_array()) {
+                for (const json &d : j["delete"]) {
+                    if (d.is_string() && safe_relative_path(d.get<std::string>())) {
+                        fs::remove_all(data_dir / u8path(d.get<std::string>()), ec);
+                    }
+                }
+            }
+        }
+        else {
+            // The registry still has the old version: put back what was there (newest swap first).
+            for (auto it = swaps.rbegin(); it != swaps.rend(); ++it) {
+                const std::string dst = path_of(*it, "dst"), staged = path_of(*it, "staged"), aside = path_of(*it, "aside");
+                if (dst.empty()) {
+                    continue;
+                }
+                const fs::path d = data_dir / u8path(dst);
+                const bool staged_left = !staged.empty() && fs::exists(data_dir / u8path(staged), ec);
+                if (!aside.empty() && fs::exists(data_dir / u8path(aside), ec)) {
+                    fs::remove_all(d, ec);              // the new copy, if it got placed
+                    ec.clear();
+                    fs::rename(data_dir / u8path(aside), d, ec);
+                    if (ec) {
+                        stuck = true;
+                    }
+                }
+                else if (aside.empty() && !staged_left) {
+                    fs::remove_all(d, ec);              // nothing was there before: the new copy goes
+                }
+                if (staged_left) {
+                    fs::remove_all(data_dir / u8path(staged), ec);
+                }
+            }
+        }
+        if (stuck) {
+            // Keep the journal: the next start tries again (a file was locked by another program).
+            return "couldn't fully undo an install a crash interrupted; will try again at the next start";
+        }
+        fs::remove(journal, ec);
+        // Unpack folders a crash left behind (they can be large).
+        for (fs::directory_iterator it(data_dir / WorkFolder, ec), end; !ec && it != end; it.increment(ec)) {
+            std::error_code e;
+            if (u8str(it->path().filename()).rfind("unpack-", 0) == 0) {
+                fs::remove_all(it->path(), e);
+            }
+        }
+        ec.clear();
+        fs::remove(data_dir / WorkFolder, ec);
+        return committed ? "finished an install a crash interrupted" : "undid an install a crash interrupted";
+    }
+
+    InstallResult install(const fs::path &package, const fs::path &data_dir, const InstallOptions &options) {
+        try {
+            return install_impl(package, data_dir, options);
+        }
+        catch (const std::exception &e) {
+            InstallResult r;
+            r.outcome = Outcome::Failed;
+            r.message = std::string("unexpected error: ") + e.what();
+            return r;
+        }
+    }
+
+    RemoveResult uninstall(const std::string &id, const fs::path &data_dir) {
+        RemoveResult result;
+        try {
+            Registry registry;
+            const RegistryStatus status = load_registry(data_dir, registry);
+            if (!may_save(status)) {
+                result.message = "packages.json can't be read; nothing was removed";
+                return result;
+            }
+            const std::optional<Entry> entry = remove(registry, id);
+            if (!entry) {
+                result.message = "\"" + id + "\" isn't an installed package";
+                return result;
+            }
+            std::vector<fs::path> to_delete;
+            for (const InstalledFile &f : entry->files) {
+                const fs::path p = data_dir / u8path(f.path);
+                switch (file_state(f, hash_path(p))) {
+                    case FileState::Unchanged: to_delete.push_back(p); break;
+                    case FileState::Edited: result.kept.push_back(f.path); break;
+                    case FileState::Missing: break;
+                }
+            }
+            if (!save_registry(data_dir, registry)) {
+                result.message = "can't write packages.json; nothing was removed";
+                return result;
+            }
+            for (const fs::path &p : to_delete) {
+                remove_path(p);
+            }
+            result.removed = true;
+            result.message = "removed " + (entry->display_name.empty() ? entry->id : entry->display_name) +
+                (result.kept.empty() ? std::string() : " (" + std::to_string(result.kept.size()) + " edited files kept)");
+        }
+        catch (const std::exception &e) {
+            result.removed = false;
+            result.message = std::string("unexpected error: ") + e.what();
+        }
+        return result;
+    }
+
+    bool looks_like_package(const fs::path &path) {
+        try {
+            std::error_code ec;
+            if (fs::is_directory(path, ec)) {
+                return package_root(path).has_value();
+            }
+            if (!fs::is_regular_file(path, ec) || lower(u8str(path.extension())) != ".zip") {
+                return false;
+            }
+            FILE *zf = open_file(path, L"rb", "rb");
+            if (!zf) {
+                return false;
+            }
+            mz_zip_archive archive{};
+            bool found = false;
+            if (mz_zip_reader_init_cfile(&archive, zf, 0, 0)) {
+                std::vector<std::string> tops;
+                bool root_manifest = false, nested_manifest = false;
+                const mz_uint count = mz_zip_reader_get_num_files(&archive);
+                for (mz_uint i = 0; i < count; i++) {
+                    mz_zip_archive_file_stat st;
+                    if (!mz_zip_reader_file_stat(&archive, i, &st)) {
+                        continue;
+                    }
+                    std::string name = st.m_filename;
+                    std::replace(name.begin(), name.end(), '\\', '/');
+                    const std::string top = name.substr(0, name.find('/'));
+                    if (ignorable(top)) {
+                        continue;
+                    }
+                    if (std::find(tops.begin(), tops.end(), top) == tops.end()) {
+                        tops.push_back(top);
+                    }
+                    root_manifest |= name == ManifestFile;
+                    nested_manifest |= name == top + "/" + ManifestFile;
+                }
+                found = root_manifest || (nested_manifest && tops.size() == 1);
+                mz_zip_reader_end(&archive);
+            }
+            std::fclose(zf);
+            return found;
+        }
+        catch (const std::exception &) {
+            return false;
+        }
+    }
+
+    std::vector<InstallResult> process_import_folder(const fs::path &data_dir, const InstallOptions &options_in) {
+        std::vector<InstallResult> results;
+        try {
+            if (const std::string recovered = recover_interrupted_install(data_dir); !recovered.empty()) {
+                std::printf("[wcw] packages: %s\n", recovered.c_str());
+            }
+            const fs::path dir = data_dir / ImportFolder;
+            std::error_code ec;
+            if (!fs::is_directory(dir, ec)) {
+                return results;
+            }
+            InstallOptions options = options_in;
+            options.source = "dropped";
+            if (options.date.empty()) {
+                options.date = today_local();
+            }
+            std::vector<fs::path> items;
+            for (fs::directory_iterator it(dir, ec), end; !ec && it != end; it.increment(ec)) {
+                const std::string name = u8str(it->path().filename());
+                if (name.empty() || name[0] == '.' || name == "not-installed" || name == "last-import.json") {
+                    continue;
+                }
+                items.push_back(it->path());
+            }
+            if (items.empty()) {
+                return results;
+            }
+            std::sort(items.begin(), items.end());
+            const fs::path rejected = dir / "not-installed";
+            json report = json::array();
+            for (const fs::path &item : items) {
+                InstallResult r = install(item, data_dir, options);
+                const std::string name = u8str(item.filename());
+                const bool done = r.outcome != Outcome::Refused && r.outcome != Outcome::Failed;
+                if (done) {
+                    remove_path(item);
+                }
+                else {
+                    fs::create_directories(rejected, ec);
+                    const std::string target_name = edited_name(name, options.date, [&](const std::string &n) {
+                        std::error_code e;
+                        return fs::exists(rejected / u8path(n), e);
+                    });
+                    const fs::path target = fs::exists(rejected / item.filename(), ec) ? rejected / u8path(target_name) : rejected / item.filename();
+                    fs::rename(item, target, ec);
+                    std::string why = r.message + "\n";
+                    for (const Problem &p : r.problems) {
+                        why += std::string(p.error ? "error " : "warning ") + (p.field.empty() ? "" : p.field + ": ") + p.message + "\n";
+                    }
+                    write_small_file(target.parent_path() / u8path(u8str(target.filename()) + ".txt"), why);
+                }
+                json problems = json::array();
+                for (const Problem &p : r.problems) {
+                    problems.push_back({ { "error", p.error }, { "field", p.field }, { "message", p.message } });
+                }
+                report.push_back({ { "file", name }, { "outcome", outcome_name(r.outcome) }, { "id", r.id },
+                    { "name", r.display_name }, { "version", r.version }, { "message", r.message }, { "problems", problems } });
+                std::printf("[wcw] import %s: %s (%s)\n", name.c_str(), outcome_name(r.outcome), r.message.c_str());
+                results.push_back(std::move(r));
+            }
+            write_small_file(dir / "last-import.json", dump(json{ { "format", 1 }, { "results", report } }));
+        }
+        catch (const std::exception &e) {
+            std::printf("[wcw] import: unexpected error: %s\n", e.what());
+        }
+        return results;
+    }
+}
diff --git a/librecomp/src/packages_migrate.cpp b/librecomp/src/packages_migrate.cpp
new file mode 100644
index 0000000..d56615c
--- /dev/null
+++ b/librecomp/src/packages_migrate.cpp
@@ -0,0 +1,489 @@
+// [wcw] Migration to the package registry (aki-roadmap#154 step 3): the first start with packages.json records what
+// is installed and turns patch-mod ROM hacks into conversions (see packages.hpp).
+
+#include "librecomp/packages.hpp"
+
+#include <algorithm>
+#include <cstdio>
+#include <ctime>
+#include <exception>
+#include <set>
+#include <system_error>
+
+#include "librecomp/bundled_packs.hpp"
+#include "json/json.hpp"
+#include "miniz.h"
+#include "miniz_zip.h"
+
+namespace recomp::packages {
+    namespace fs = std::filesystem;
+    using json = nlohmann::json;
+
+    namespace {
+        fs::path u8path(const std::string &s) {
+            return fs::path(std::u8string(s.begin(), s.end()));
+        }
+
+        std::string u8str(const fs::path &p) {
+            const std::u8string s = p.generic_u8string();
+            return std::string(s.begin(), s.end());
+        }
+
+        std::string lower(std::string s) {
+            std::transform(s.begin(), s.end(), s.begin(), [](unsigned char c) { return char(std::tolower(c)); });
+            return s;
+        }
+
+        std::string now_utc() {
+            const std::time_t t = std::time(nullptr);
+            std::tm tm{};
+#ifdef _WIN32
+            gmtime_s(&tm, &t);
+#else
+            gmtime_r(&t, &tm);
+#endif
+            char buf[32];
+            std::strftime(buf, sizeof(buf), "%Y-%m-%dT%H:%M:%SZ", &tm);
+            return buf;
+        }
+
+        FILE *open_file(const fs::path &path, const wchar_t *wmode, const char *mode) {
+            FILE *f = nullptr;
+#ifdef _WIN32
+            (void)mode;
+            if (_wfopen_s(&f, path.c_str(), wmode) != 0) {
+                f = nullptr;
+            }
+#else
+            (void)wmode;
+            f = std::fopen(path.c_str(), mode);
+#endif
+            return f;
+        }
+
+        std::string read_text(const fs::path &path) {
+            FILE *f = open_file(path, L"rb", "rb");
+            if (!f) {
+                return {};
+            }
+            std::string out;
+            char buf[65536];
+            size_t n;
+            while ((n = std::fread(buf, 1, sizeof(buf), f)) > 0) {
+                out.append(buf, n);
+            }
+            std::fclose(f);
+            return out;
+        }
+
+        bool write_text(const fs::path &path, const std::string &text) {
+            FILE *f = open_file(path, L"wb", "wb");
+            if (!f) {
+                return false;
+            }
+            const bool ok = std::fwrite(text.data(), 1, text.size(), f) == text.size();
+            return (std::fclose(f) == 0) && ok;
+        }
+
+        // What an .nrm / .rtz zip holds: its mod.json (text, "" if none) and whether it has patch.bps / a code binary.
+        struct ZipInfo {
+            bool ok = false;
+            std::string mod_json;
+            bool patch = false;
+            bool binary = false;
+        };
+        ZipInfo inspect_zip(const fs::path &path) {
+            ZipInfo info;
+            FILE *f = open_file(path, L"rb", "rb");
+            if (!f) {
+                return info;
+            }
+            mz_zip_archive a{};
+            if (mz_zip_reader_init_cfile(&a, f, 0, 0)) {
+                info.ok = true;
+                mz_uint index;
+                // Case-sensitive, as the runtime's mod loader looks them up (mod_manifest.cpp).
+                info.patch = mz_zip_reader_locate_file_v2(&a, "patch.bps", nullptr, MZ_ZIP_FLAG_CASE_SENSITIVE, &index);
+                info.binary = mz_zip_reader_locate_file_v2(&a, "mod_binary.bin", nullptr, MZ_ZIP_FLAG_CASE_SENSITIVE, &index);
+                if (mz_zip_reader_locate_file_v2(&a, "mod.json", nullptr, MZ_ZIP_FLAG_CASE_SENSITIVE, &index)) {
+                    mz_zip_archive_file_stat st;
+                    if (mz_zip_reader_file_stat(&a, index, &st) && st.m_uncomp_size < (1u << 20)) {
+                        std::string text(size_t(st.m_uncomp_size), '\0');
+                        if (mz_zip_reader_extract_to_mem(&a, index, text.data(), text.size(), 0)) {
+                            info.mod_json = std::move(text);
+                        }
+                    }
+                }
+                mz_zip_reader_end(&a);
+            }
+            std::fclose(f);
+            return info;
+        }
+
+        // A string field, or fallback when it's missing or not a string (json::value throws on a wrong type).
+        std::string str(const json &j, const char *key, const std::string &fallback = std::string()) {
+            if (!j.is_object()) {
+                return fallback;
+            }
+            const auto it = j.find(key);
+            return (it != j.end() && it->is_string()) ? it->get<std::string>() : fallback;
+        }
+
+        struct ModFields {
+            std::string id, name, version;
+            std::vector<std::string> authors;
+        };
+        ModFields mod_fields(const std::string &mod_json) {
+            ModFields m;
+            const json j = json::parse(mod_json, nullptr, false);
+            if (j.is_discarded() || !j.is_object()) {
+                return m;
+            }
+            m.id = str(j, "id");
+            m.name = str(j, "display_name", m.id);
+            m.version = str(j, "version");
+            if (const auto a = j.find("authors"); a != j.end() && a->is_array()) {
+                for (const json &v : *a) {
+                    if (v.is_string()) {
+                        m.authors.push_back(v.get<std::string>());
+                    }
+                }
+            }
+            return m;
+        }
+
+        std::string version_or_zero(const std::string &v) {
+            return valid_version(v) ? v : std::string("0.0.0");
+        }
+
+        // Names migration never records: work folders, kept copies, staging leftovers, hidden or shared folders.
+        bool internal_name(const std::string &name) {
+            return name.empty() || name[0] == '.' || name[0] == '_' || name == KeptFolder || name == "models" ||
+                name.find(".edited-") != std::string::npos || name.ends_with(".installing") || name.ends_with(".replaced") ||
+                name.ends_with(".tmp");
+        }
+
+        // mods.json: the enabled mod ids in mod order (enabled ones not in the order list go last, sorted).
+        std::vector<std::string> enabled_in_order(const fs::path &data_dir) {
+            std::vector<std::string> out;
+            const json j = json::parse(read_text(data_dir / "mods.json"), nullptr, false);
+            if (j.is_discarded() || !j.is_object()) {
+                return out;
+            }
+            std::set<std::string> enabled;
+            if (const auto e = j.find("enabled_mods"); e != j.end() && e->is_array()) {
+                for (const json &v : *e) {
+                    if (v.is_string()) {
+                        enabled.insert(v.get<std::string>());
+                    }
+                }
+            }
+            if (const auto o = j.find("mod_order"); o != j.end() && o->is_array()) {
+                for (const json &v : *o) {
+                    if (v.is_string() && enabled.erase(v.get<std::string>())) {
+                        out.push_back(v.get<std::string>());
+                    }
+                }
+            }
+            out.insert(out.end(), enabled.begin(), enabled.end());
+            return out;
+        }
+
+        MigrateReport migrate_impl(const fs::path &data_dir, const MigrateOptions &options) {
+            MigrateReport report;
+            auto log = [&](const std::string &line) { report.lines.push_back(line); };
+            std::error_code ec;
+            if (migration_done(data_dir)) {
+                return report;
+            }
+            Registry registry;
+            const RegistryStatus status = load_registry(data_dir, registry);
+            if (!may_save(status)) {
+                log("packages.json can't be written safely (newer or unreadable); migration skipped");
+                return report;
+            }
+            report.ran = true;
+            const std::string now = options.now.empty() ? now_utc() : options.now;
+            const std::string game_key = key_for_game_id(options.game_id);
+            const fs::path mods = data_dir / "mods";
+            const fs::path conversions = data_dir / "conversions";
+
+            // 1. Patch-mod hacks become conversions.
+            std::vector<std::string> moved_enabled_order;
+            const std::vector<std::string> enabled = enabled_in_order(data_dir);
+            std::vector<fs::path> nrms;
+            for (fs::directory_iterator it(mods, ec), end; !ec && it != end; it.increment(ec)) {
+                std::error_code e;
+                if (it->is_regular_file(e) && lower(u8str(it->path().extension())) == ".nrm" && !internal_name(u8str(it->path().filename()))) {
+                    nrms.push_back(it->path());
+                }
+            }
+            ec.clear();
+            std::sort(nrms.begin(), nrms.end());
+            for (const fs::path &nrm : nrms) try {
+                const ZipInfo z = inspect_zip(nrm);
+                if (!z.ok || !z.patch || z.binary) {
+                    continue;
+                }
+                const std::string file = u8str(nrm.filename());
+                const ModFields f = mod_fields(z.mod_json);
+                if (!valid_id(f.id)) {
+                    log("left " + file + " in mods: its mod id \"" + f.id + "\" can't name a conversion");
+                    continue;
+                }
+                const fs::path target = conversions / u8path(f.id);
+                if (fs::exists(target, ec) || find(registry, f.id)) {
+                    log("left " + file + " in mods: conversions/" + f.id + " or the id \"" + f.id + "\" is already taken");
+                    continue;
+                }
+                json aki = {
+                    { "format", "aki-conversion" }, { "format_version", 1 }, { "id", f.id },
+                    { "name", f.name.empty() ? f.id : f.name }, { "version", version_or_zero(f.version) },
+                    { "authors", f.authors.empty() ? std::vector<std::string>{ "unknown" } : f.authors },
+                    { "game", game_key },
+                    { "description", "Moved from mods/" + file + " when ROM hacks became conversions (one at a time, own saves)." },
+                    { "components", { { "patch", { { "file", "patch.nrm" }, { "mod_id", f.id } } } } },
+                    { "source", { { "mode", "migrated" } } },
+                };
+                if (!options.rom_sha1.empty()) {
+                    std::string upper = options.rom_sha1;
+                    std::transform(upper.begin(), upper.end(), upper.begin(), [](unsigned char c) { return char(std::toupper(c)); });
+                    aki["base_rom"] = { { "sha1", upper } };
+                }
+                log("moved mods/" + file + " -> conversions/" + f.id + "/patch.nrm (a ROM hack is a conversion now; saves stay in saves/" + f.id + ")");
+                report.moved.push_back(f.id);
+                if (std::find(enabled.begin(), enabled.end(), f.id) != enabled.end()) {
+                    moved_enabled_order.push_back(f.id);
+                }
+                if (options.dry_run) {
+                    continue;
+                }
+                fs::create_directories(target, ec);
+                ec.clear();
+                const bool written = write_text(target / "aki.json", aki.dump(2, ' ', false, json::error_handler_t::replace) + "\n");
+                if (written) {
+                    fs::rename(nrm, target / "patch.nrm", ec);
+                }
+                if (!written || ec) {
+                    log("  couldn't move it (" + (written ? ec.message() : std::string("can't write aki.json")) + "); left in mods");
+                    std::error_code e;
+                    fs::remove_all(target, e);
+                    report.moved.pop_back();
+                    std::erase(moved_enabled_order, f.id);
+                    continue;
+                }
+            }
+            catch (const std::exception &e) {
+                log("skipped " + u8str(nrm.filename()) + ": " + e.what());
+            }
+            // The order the hacks had in mods.json decides which one runs next; enabled ones keep running.
+            std::sort(moved_enabled_order.begin(), moved_enabled_order.end(), [&](const std::string &a, const std::string &b) {
+                return std::find(enabled.begin(), enabled.end(), a) < std::find(enabled.begin(), enabled.end(), b);
+            });
+            if (!moved_enabled_order.empty()) {
+                const fs::path choice = conversions / "active.txt";
+                if (fs::exists(choice, ec)) {
+                    log("a conversion is already chosen; the enabled hack(s) are installed as conversions to pick in the Mods menu");
+                    report.also_enabled = moved_enabled_order;
+                }
+                else {
+                    report.chosen = moved_enabled_order.front();
+                    report.also_enabled.assign(moved_enabled_order.begin() + 1, moved_enabled_order.end());
+                    log("the next start plays " + report.chosen + " (it was enabled); while a conversion plays, your other "
+                        "add-ons stay off for now");
+                    if (!report.also_enabled.empty()) {
+                        std::string rest;
+                        for (const std::string &id : report.also_enabled) {
+                            rest += " " + id;
+                        }
+                        log("also enabled before (only one hack runs at a time now; pick it in the Mods menu):" + rest);
+                    }
+                    if (!options.dry_run) {
+                        fs::create_directories(conversions, ec);
+                        write_text(choice, report.chosen + "\n");
+                    }
+                }
+            }
+
+            // 2. Record what is installed.
+            const std::set<std::string> bundled_names(options.bundled_names.begin(), options.bundled_names.end());
+            const std::set<std::string> bundled_packs = recomp::mods::bundled_packs::parse_record(
+                read_text(mods / "models" / recomp::mods::bundled_packs::RecordFile));
+            auto record = [&](const std::string &id, Kind kind, const std::string &version, const std::string &name,
+                const std::string &rel, const std::string &source) { try {
+                if (!valid_id(id)) {
+                    log("not recorded (stays a manual install): " + rel + " (id \"" + id + "\" isn't a package id)");
+                    return;
+                }
+                if (const std::string why = conflict(registry, id, kind, { rel }); !why.empty()) {
+                    log("not recorded (stays a manual install): " + rel + " (" + why + ")");
+                    return;
+                }
+                if (find(registry, id)) {
+                    log("not recorded (stays a manual install): " + rel + " (the id \"" + id + "\" is already recorded)");
+                    return;
+                }
+                std::optional<uint64_t> h = hash_path(data_dir / u8path(rel));
+                if (!h && options.dry_run && kind == Kind::Conversion &&
+                    std::find(report.moved.begin(), report.moved.end(), id) != report.moved.end()) {
+                    h = 0;   // a hack that would have moved here
+                }
+                if (!h) {
+                    log("not recorded: " + rel + " (can't be read)");
+                    return;
+                }
+                Entry e;
+                e.id = id;
+                e.kind = kind;
+                e.version = version_or_zero(version);
+                e.display_name = name.empty() ? id : name;
+                e.source = source;
+                e.installed = now;
+                e.files.push_back({ rel, *h });
+                upsert(registry, e);
+                report.recorded.push_back(id);
+                log("recorded " + std::string(kind_name(kind)) + " " + id + " " + e.version + " (" + rel + ")");
+            }
+            catch (const std::exception &e) {
+                log("not recorded: " + rel + " (" + e.what() + ")");
+            } };
+            auto owned = [&](const std::string &rel) { return !owner_of(registry, rel).empty(); };
+
+            // Conversions (the moved hacks included).
+            std::vector<fs::path> conv_dirs;
+            for (fs::directory_iterator it(conversions, ec), end; !ec && it != end; it.increment(ec)) {
+                std::error_code e;
+                if (it->is_directory(e) && !internal_name(u8str(it->path().filename()))) {
+                    conv_dirs.push_back(it->path());
+                }
+            }
+            ec.clear();
+            for (const std::string &id : report.moved) {
+                if (options.dry_run) {
+                    conv_dirs.push_back(conversions / u8path(id));
+                }
+            }
+            std::sort(conv_dirs.begin(), conv_dirs.end());
+            conv_dirs.erase(std::unique(conv_dirs.begin(), conv_dirs.end()), conv_dirs.end());
+            for (const fs::path &dir : conv_dirs) {
+                const std::string id = u8str(dir.filename());
+                const std::string rel = "conversions/" + id;
+                if (owned(rel)) {
+                    continue;
+                }
+                const json aki = json::parse(read_text(dir / "aki.json"), nullptr, false);
+                const bool moved = std::find(report.moved.begin(), report.moved.end(), id) != report.moved.end();
+                if (!moved && str(aki, "format") != "aki-conversion") {
+                    continue;   // not a conversion folder
+                }
+                const std::string version = str(aki, "version");
+                const std::string name = str(aki, "name", id);
+                record(id, Kind::Conversion, version, name, rel, "migrated");
+            }
+
+            // Add-ons, texture packs.
+            std::vector<fs::path> mod_items;
+            for (fs::directory_iterator it(mods, ec), end; !ec && it != end; it.increment(ec)) {
+                if (!internal_name(u8str(it->path().filename()))) {
+                    mod_items.push_back(it->path());
+                }
+            }
+            ec.clear();
+            std::sort(mod_items.begin(), mod_items.end());
+            for (const fs::path &item : mod_items) {
+                const std::string file = u8str(item.filename());
+                const std::string rel = "mods/" + file;
+                if (owned(rel) || bundled_names.count(file)) {
+                    continue;   // bundled: the game's own copy, rewritten on update
+                }
+                std::error_code e;
+                const std::string ext = lower(u8str(item.extension()));
+                if (options.dry_run && ext == ".nrm") {
+                    const ZipInfo z = inspect_zip(item);
+                    if (std::find(report.moved.begin(), report.moved.end(), mod_fields(z.mod_json).id) != report.moved.end()) {
+                        continue;   // the dry run's moved hack: it wouldn't be in mods any more
+                    }
+                }
+                if (fs::is_regular_file(item, e) && ext == ".nrm") {
+                    const ZipInfo z = inspect_zip(item);
+                    if (!z.ok) {
+                        continue;
+                    }
+                    const ModFields f = mod_fields(z.mod_json);
+                    record(f.id, Kind::Addon, f.version, f.name, rel, "migrated");
+                }
+                else if (fs::is_regular_file(item, e) && ext == ".rtz") {
+                    const ZipInfo z = inspect_zip(item);
+                    const ModFields f = mod_fields(z.mod_json);
+                    const std::string id = f.id.empty() ? u8str(item.stem()) : f.id;
+                    record(id, Kind::TexturePack, f.version, f.name, rel, "migrated");
+                }
+                else if (fs::is_directory(item, e) && fs::is_regular_file(item / "rt64.json", e)) {
+                    const ModFields f = mod_fields(read_text(item / "mod.json"));
+                    record(f.id.empty() ? file : f.id, Kind::TexturePack, f.version, f.name, rel, "migrated");
+                }
+            }
+
+            // Model packs.
+            std::vector<fs::path> packs;
+            for (fs::directory_iterator it(mods / "models", ec), end; !ec && it != end; it.increment(ec)) {
+                std::error_code e;
+                if (it->is_directory(e) && lower(u8str(it->path().extension())) == ".akimodel" && !internal_name(u8str(it->path().filename()))) {
+                    packs.push_back(it->path());
+                }
+            }
+            ec.clear();
+            std::sort(packs.begin(), packs.end());
+            for (const fs::path &pack : packs) {
+                const std::string file = u8str(pack.filename());
+                const std::string rel = "mods/models/" + file;
+                if (owned(rel)) {
+                    continue;
+                }
+                const json pj = json::parse(read_text(pack / "pack.json"), nullptr, false);
+                const std::string stem = u8str(pack.stem());
+                if (bundled_packs.count(file)) {
+                    continue;   // the game's own starter pack (bundled_packs keeps it up to date)
+                }
+                const std::string id = str(pj, "id", stem);
+                record(id, Kind::ModelPack, str(pj, "version"), str(pj, "name", id), rel, "migrated");
+            }
+
+            // 3. Save, log, mark.
+            if (options.dry_run) {
+                log("(dry run: nothing was changed)");
+                return report;
+            }
+            const bool saved = save_registry(data_dir, registry);
+            if (!saved) {
+                log("couldn't write packages.json; migration will run again at the next start");
+            }
+            std::string text = read_text(data_dir / MigrationLog);   // appended: a rerun keeps what moved before
+            text += "[" + now + "] package migration\n";
+            for (const std::string &line : report.lines) {
+                text += line + "\n";
+            }
+            write_text(data_dir / MigrationLog, text);
+            if (saved) {
+                write_text(data_dir / MigrationMarker, "1\n");
+            }
+            return report;
+        }
+    }
+
+    bool migration_done(const fs::path &data_dir) {
+        std::error_code ec;
+        return fs::exists(data_dir / MigrationMarker, ec);
+    }
+
+    MigrateReport migrate(const fs::path &data_dir, const MigrateOptions &options) {
+        try {
+            return migrate_impl(data_dir, options);
+        }
+        catch (const std::exception &e) {
+            MigrateReport r;
+            r.lines.push_back(std::string("migration stopped: ") + e.what());
+            return r;
+        }
+    }
+}
diff --git a/librecomp/src/packages_rules.cpp b/librecomp/src/packages_rules.cpp
new file mode 100644
index 0000000..fb40a42
--- /dev/null
+++ b/librecomp/src/packages_rules.cpp
@@ -0,0 +1,831 @@
+#include "librecomp/packages.hpp"
+
+#include <algorithm>
+#include <cctype>
+
+#include "librecomp/bundled_packs.hpp"
+#include "json/json.hpp"
+
+using json = nlohmann::json;
+
+namespace recomp::packages {
+    namespace {
+        struct GameKey {
+            const char *key;
+            const char *game_id;
+        };
+        constexpr GameKey Games[] = {
+            { "wt", "wcwnwoworldtour" }, { "revenge", "wcwnworevenge" }, { "wm2k", "wwfwm2k" },
+            { "vpw64", "vpw64" }, { "nomercy", "wwfnomercy" }, { "vpw2", "vpw2" },
+        };
+
+        constexpr size_t MaxIdLength = 48;
+
+        bool is_hex(const std::string &s, size_t n) {
+            return s.size() == n && s.find_first_not_of("0123456789abcdefABCDEF") == std::string::npos;
+        }
+
+        std::string lower(std::string s) {
+            std::transform(s.begin(), s.end(), s.begin(), [](unsigned char c) { return char(std::tolower(c)); });
+            return s;
+        }
+
+        bool is_blank(const std::string &s) {
+            return std::all_of(s.begin(), s.end(), [](unsigned char c) { return std::isspace(c); });
+        }
+
+        // Windows device names, matched on the stem before the first '.' ("nul.txt" and "aux.tar.gz" are devices too).
+        bool is_device_name(const std::string &part) {
+            const std::string stem = lower(part.substr(0, part.find('.')));
+            if (stem == "con" || stem == "prn" || stem == "aux" || stem == "nul" || stem == "conin$" || stem == "conout$" ||
+                stem == "clock$") {
+                return true;
+            }
+            return stem.size() == 4 && (stem.compare(0, 3, "com") == 0 || stem.compare(0, 3, "lpt") == 0) &&
+                stem[3] >= '1' && stem[3] <= '9';
+        }
+
+        // Path prefix test on '/' boundaries, ignoring ASCII case: "mods/a" owns "mods/a" and "mods/A/b", not "mods/ab".
+        bool covers(const std::string &owner_path, const std::string &path) {
+            const std::string owner = lower(normal_path(owner_path));
+            const std::string p = lower(normal_path(path));
+            if (p.size() < owner.size() || p.compare(0, owner.size(), owner) != 0) {
+                return false;
+            }
+            return p.size() == owner.size() || p[owner.size()] == '/';
+        }
+
+        // Decimal digit strings of any length, as numbers.
+        int compare_numbers(const std::string &a, const std::string &b) {
+            const size_t za = std::min(a.find_first_not_of('0'), a.size());
+            const size_t zb = std::min(b.find_first_not_of('0'), b.size());
+            const size_t la = a.size() - za, lb = b.size() - zb;
+            if (la != lb) {
+                return (la < lb) ? -1 : 1;
+            }
+            const int c = a.compare(za, la, b, zb, lb);
+            return (c < 0) ? -1 : (c > 0) ? 1 : 0;
+        }
+
+        bool all_digits(const std::string &s) {
+            return !s.empty() && s.find_first_not_of("0123456789") == std::string::npos;
+        }
+
+        std::vector<std::string> split(const std::string &s, char sep) {
+            std::vector<std::string> out;
+            size_t start = 0;
+            while (true) {
+                const size_t end = s.find(sep, start);
+                out.push_back(s.substr(start, end == std::string::npos ? std::string::npos : end - start));
+                if (end == std::string::npos) {
+                    return out;
+                }
+                start = end + 1;
+            }
+        }
+    }
+
+    const char *kind_name(Kind kind) {
+        switch (kind) {
+            case Kind::Addon: return "addon";
+            case Kind::TexturePack: return "texture-pack";
+            case Kind::ModelPack: return "model-pack";
+            case Kind::Conversion: return "conversion";
+            case Kind::Unknown: return "unknown";
+        }
+        return "unknown";
+    }
+
+    std::optional<Kind> parse_kind(const std::string &name) {
+        for (Kind k : { Kind::Addon, Kind::TexturePack, Kind::ModelPack, Kind::Conversion }) {
+            if (name == kind_name(k)) {
+                return k;
+            }
+        }
+        return std::nullopt;
+    }
+
+    bool valid_id(const std::string &id) {
+        if (id.empty() || id.size() > MaxIdLength || id.back() == '.' || is_device_name(id)) {
+            return false;
+        }
+        for (size_t i = 0; i < id.size(); i++) {
+            const char c = id[i];
+            const bool alnum = (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9');
+            if (!alnum && (i == 0 || (c != '_' && c != '.' && c != '-'))) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    bool valid_version(const std::string &version) {
+        const size_t dash = version.find('-');
+        const std::vector<std::string> core = split(version.substr(0, dash), '.');
+        if (core.size() != 3 || !std::all_of(core.begin(), core.end(), all_digits)) {
+            return false;
+        }
+        if (dash == std::string::npos) {
+            return true;
+        }
+        const std::string pre = version.substr(dash + 1);
+        if (pre.empty()) {
+            return false;
+        }
+        for (const std::string &id : split(pre, '.')) {
+            if (id.empty() || !std::all_of(id.begin(), id.end(), [](unsigned char c) { return std::isalnum(c) || c == '-'; })) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    int compare_versions(const std::string &a, const std::string &b) {
+        const size_t da = a.find('-'), db = b.find('-');
+        const std::vector<std::string> ca = split(a.substr(0, da), '.'), cb = split(b.substr(0, db), '.');
+        for (size_t i = 0; i < std::max(ca.size(), cb.size()); i++) {
+            const std::string x = (i < ca.size() && all_digits(ca[i])) ? ca[i] : "0";
+            const std::string y = (i < cb.size() && all_digits(cb[i])) ? cb[i] : "0";
+            if (const int c = compare_numbers(x, y)) {
+                return c;
+            }
+        }
+        const bool pre_a = da != std::string::npos, pre_b = db != std::string::npos;
+        if (!pre_a || !pre_b) {
+            return (pre_a == pre_b) ? 0 : (pre_a ? -1 : 1);   // a release sorts after its prereleases
+        }
+        const std::vector<std::string> pa = split(a.substr(da + 1), '.'), pb = split(b.substr(db + 1), '.');
+        for (size_t i = 0; i < std::min(pa.size(), pb.size()); i++) {
+            const bool na = all_digits(pa[i]), nb = all_digits(pb[i]);
+            int c;
+            if (na && nb) {
+                c = compare_numbers(pa[i], pb[i]);
+            }
+            else if (na != nb) {
+                c = na ? -1 : 1;   // a number sorts before text
+            }
+            else {
+                c = pa[i].compare(pb[i]);
+                c = (c < 0) ? -1 : (c > 0) ? 1 : 0;
+            }
+            if (c) {
+                return c;
+            }
+        }
+        return (pa.size() == pb.size()) ? 0 : (pa.size() < pb.size() ? -1 : 1);
+    }
+
+    std::string game_id_for_key(const std::string &short_key) {
+        for (const GameKey &g : Games) {
+            if (short_key == g.key) {
+                return g.game_id;
+            }
+        }
+        return {};
+    }
+
+    std::string key_for_game_id(const std::string &game_id) {
+        for (const GameKey &g : Games) {
+            if (game_id == g.game_id) {
+                return g.key;
+            }
+        }
+        return {};
+    }
+
+    bool safe_relative_path(const std::string &path) {
+        if (path.empty() || path.front() == '/') {
+            return false;
+        }
+        for (unsigned char c : path) {
+            if (c < 0x20 || c == 0x7F || std::string("\\:*?\"<>|").find(char(c)) != std::string::npos) {
+                return false;
+            }
+        }
+        const std::string body = (path.back() == '/') ? path.substr(0, path.size() - 1) : path;
+        if (body.empty()) {
+            return false;
+        }
+        for (const std::string &part : split(body, '/')) {
+            if (part.empty() || part == "." || part == ".." || part.back() == '.' || part.back() == ' ' || is_device_name(part)) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    std::string normal_path(const std::string &path) {
+        std::string p = path;
+        while (!p.empty() && p.back() == '/') {
+            p.pop_back();
+        }
+        return p;
+    }
+
+    bool parse_manifest(const std::string &json_text, Manifest &out, std::vector<Problem> &problems) {
+        out = Manifest{};
+        const size_t before = problems.size();
+        auto error = [&](const std::string &field, const std::string &message) { problems.push_back({ true, field, message }); };
+        auto warn = [&](const std::string &field, const std::string &message) { problems.push_back({ false, field, message }); };
+
+        const json root = json::parse(json_text, nullptr, false);
+        if (root.is_discarded() || !root.is_object()) {
+            error("", "aki-package.json isn't a JSON object");
+            return false;
+        }
+        auto text = [&](const json &obj, const char *key, std::string &dst, bool required, const std::string &field) {
+            const auto it = obj.find(key);
+            if (it == obj.end()) {
+                if (required) {
+                    error(field, "missing");
+                }
+                return;
+            }
+            if (!it->is_string()) {
+                error(field, "must be a string");
+                return;
+            }
+            dst = it->get<std::string>();
+        };
+        auto list = [&](const json &obj, const char *key, std::vector<std::string> &dst, const std::string &field) {
+            const auto it = obj.find(key);
+            if (it == obj.end()) {
+                return;
+            }
+            if (!it->is_array()) {
+                error(field, "must be a list of strings");
+                return;
+            }
+            for (const json &v : *it) {
+                if (!v.is_string()) {
+                    error(field, "must be a list of strings");
+                    return;
+                }
+                dst.push_back(v.get<std::string>());
+            }
+        };
+
+        // format
+        const auto fmt = root.find("format");
+        if (fmt == root.end() || !fmt->is_number_integer()) {
+            error("format", "missing (must be 1)");
+        }
+        else {
+            const int64_t f = fmt->get<int64_t>();
+            out.format = (f >= 0 && f <= 1000000) ? int(f) : -1;
+            if (f != ManifestFormat) {
+                error("format", "format " + std::to_string(f) + " isn't supported by this version (1 is)");
+            }
+        }
+
+        // kind
+        std::string kind;
+        text(root, "kind", kind, true, "kind");
+        bool kind_ok = false;
+        if (!kind.empty()) {
+            if (auto k = parse_kind(kind)) {
+                out.kind = *k;
+                kind_ok = true;
+            }
+            else {
+                error("kind", "\"" + kind + "\" isn't one of addon, texture-pack, model-pack, conversion");
+            }
+        }
+
+        text(root, "id", out.id, true, "id");
+        if (!out.id.empty() && !valid_id(out.id)) {
+            error("id", "\"" + out.id + "\" must be lower-case letters, digits, '_', '.' or '-', start with a letter or digit, "
+                "not end in '.', not be a Windows device name, at most 48 characters");
+        }
+        text(root, "version", out.version, true, "version");
+        if (!out.version.empty() && !valid_version(out.version)) {
+            error("version", "\"" + out.version + "\" must be major.minor.patch (e.g. 1.2.0)");
+        }
+        text(root, "game_id", out.game_id, true, "game_id");
+        if (!out.game_id.empty() && key_for_game_id(out.game_id).empty()) {
+            const std::string mapped = game_id_for_key(out.game_id);
+            error("game_id", "\"" + out.game_id + "\" isn't a game id" + (mapped.empty() ? std::string() : " (use \"" + mapped + "\")"));
+        }
+        text(root, "display_name", out.display_name, true, "display_name");
+        if (root.contains("display_name") && root["display_name"].is_string() && is_blank(out.display_name)) {
+            error("display_name", "is empty");
+        }
+        if (!root.contains("authors")) {
+            error("authors", "missing");
+        }
+        else {
+            list(root, "authors", out.authors, "authors");
+            if (out.authors.empty() || std::any_of(out.authors.begin(), out.authors.end(), is_blank)) {
+                error("authors", "needs at least one non-empty name");
+            }
+        }
+        text(root, "short_description", out.short_description, false, "short_description");
+        text(root, "description", out.description, false, "description");
+        text(root, "thumb", out.thumb, false, "thumb");
+        if (!out.thumb.empty() && !safe_relative_path(out.thumb)) {
+            error("thumb", "isn't a safe relative path");
+        }
+        text(root, "license", out.license, false, "license");
+        text(root, "source", out.source, false, "source");
+
+        if (const auto perm = root.find("permission"); perm != root.end()) {
+            if (!perm->is_object()) {
+                error("permission", "must be an object");
+            }
+            else {
+                text(*perm, "redistribute", out.permission.redistribute, false, "permission.redistribute");
+                text(*perm, "modify", out.permission.modify, false, "permission.modify");
+                text(*perm, "statement", out.permission.statement, false, "permission.statement");
+                text(*perm, "url", out.permission.url, false, "permission.url");
+                for (auto [field, value] : { std::pair{ "permission.redistribute", &out.permission.redistribute },
+                                             std::pair{ "permission.modify", &out.permission.modify } }) {
+                    if (!value->empty() && *value != "yes" && *value != "no" && *value != "ask" && *value != "unknown") {
+                        warn(field, "\"" + *value + "\" isn't yes, no, ask or unknown");
+                    }
+                }
+            }
+        }
+
+        if (const auto rom = root.find("base_rom"); rom != root.end()) {
+            if (!rom->is_object()) {
+                error("base_rom", "must be an object");
+            }
+            else {
+                list(*rom, "sha1", out.base_rom_sha1, "base_rom.sha1");
+                for (std::string &h : out.base_rom_sha1) {
+                    if (!is_hex(h, 40)) {
+                        error("base_rom.sha1", "\"" + h + "\" isn't a 40-digit SHA-1");
+                    }
+                    h = lower(h);
+                }
+                text(*rom, "name", out.base_rom_name, false, "base_rom.name");
+            }
+        }
+        if (kind_ok && out.kind == Kind::Conversion && out.base_rom_sha1.empty()) {
+            error("base_rom.sha1", "a conversion must name the ROM(s) it is made for");
+        }
+
+        if (const auto req = root.find("requires"); req != root.end()) {
+            if (!req->is_object()) {
+                error("requires", "must be an object");
+            }
+            else {
+                text(*req, "launcher", out.requires_launcher, false, "requires.launcher");
+                text(*req, "minimum_recomp_version", out.requires_recomp, false, "requires.minimum_recomp_version");
+                list(*req, "packages", out.requires_packages, "requires.packages");
+                for (const std::string &p : out.requires_packages) {
+                    if (!valid_id(p)) {
+                        error("requires.packages", "\"" + p + "\" isn't a package id");
+                    }
+                }
+            }
+        }
+        list(root, "replaces", out.replaces, "replaces");
+        for (const std::string &r : out.replaces) {
+            if (!valid_id(r)) {
+                error("replaces", "\"" + r + "\" isn't a package id");
+            }
+            else if (r == out.id) {
+                error("replaces", "a package can't replace itself");
+            }
+        }
+
+        // payload, by kind
+        const auto payload = root.find("payload");
+        if (payload == root.end() || !payload->is_object()) {
+            error("payload", payload == root.end() ? "missing" : "must be an object");
+        }
+        else if (kind_ok) {
+            auto path_field = [&](const char *key, std::string &dst, bool required) {
+                const std::string field = std::string("payload.") + key;
+                text(*payload, key, dst, required, field);
+                if (!dst.empty() && !safe_relative_path(dst)) {
+                    error(field, "\"" + dst + "\" isn't a safe relative path");
+                }
+            };
+            auto path_list = [&](const char *key, std::vector<std::string> &dst) {
+                const std::string field = std::string("payload.") + key;
+                list(*payload, key, dst, field);
+                for (const std::string &p : dst) {
+                    if (!safe_relative_path(p)) {
+                        error(field, "\"" + p + "\" isn't a safe relative path");
+                    }
+                }
+            };
+            auto ends_with = [](const std::string &s, const char *suffix) {
+                const std::string sl = lower(normal_path(s)), x = suffix;
+                return sl.size() >= x.size() && sl.compare(sl.size() - x.size(), x.size(), x) == 0;
+            };
+            switch (out.kind) {
+                case Kind::Addon:
+                    path_field("nrm", out.nrm, true);
+                    if (!out.nrm.empty() && !ends_with(out.nrm, ".nrm")) {
+                        error("payload.nrm", "must be an .nrm file");
+                    }
+                    break;
+                case Kind::TexturePack:
+                    path_field("rtz", out.rtz, false);
+                    path_field("folder", out.folder, false);
+                    if (out.rtz.empty() == out.folder.empty()) {
+                        error("payload", "a texture pack needs exactly one of rtz or folder");
+                    }
+                    if (!out.rtz.empty() && !ends_with(out.rtz, ".rtz")) {
+                        error("payload.rtz", "must be an .rtz file");
+                    }
+                    break;
+                case Kind::ModelPack:
+                    path_list("packs", out.packs);
+                    path_list("hd", out.hd);
+                    if (out.packs.empty()) {
+                        error("payload.packs", "a model pack needs at least one .akimodel folder");
+                    }
+                    for (const std::string &p : out.packs) {
+                        if (!ends_with(p, ".akimodel")) {
+                            error("payload.packs", "\"" + p + "\" must be an .akimodel folder");
+                        }
+                    }
+                    for (const std::string &p : out.hd) {
+                        if (!ends_with(p, ".rtz")) {
+                            error("payload.hd", "\"" + p + "\" must be an .rtz file");
+                        }
+                    }
+                    break;
+                case Kind::Conversion:
+                    path_field("folder", out.folder, true);
+                    path_list("addons", out.addons);
+                    for (const std::string &p : out.addons) {
+                        if (!ends_with(p, ".rtz")) {
+                            error("payload.addons", "\"" + p + "\" must be an .rtz texture pack");
+                        }
+                    }
+                    break;
+                case Kind::Unknown:
+                    break;
+            }
+            // Every payload part installs on its own: no path twice, none inside another.
+            const std::vector<std::string> paths = payload_paths(out);
+            for (size_t i = 0; i < paths.size(); i++) {
+                for (size_t j = i + 1; j < paths.size(); j++) {
+                    if (covers(paths[i], paths[j]) || covers(paths[j], paths[i])) {
+                        error("payload", "\"" + paths[i] + "\" and \"" + paths[j] + "\" overlap");
+                    }
+                }
+            }
+        }
+
+        return std::none_of(problems.begin() + before, problems.end(), [](const Problem &p) { return p.error; });
+    }
+
+    std::vector<std::string> payload_paths(const Manifest &m) {
+        std::vector<std::string> out;
+        auto add = [&](const std::string &p) {
+            if (!p.empty()) {
+                out.push_back(p);
+            }
+        };
+        add(m.nrm);
+        add(m.rtz);
+        add(m.folder);
+        for (const auto &p : m.packs) add(p);
+        for (const auto &p : m.hd) add(p);
+        for (const auto &p : m.addons) add(p);
+        return out;
+    }
+
+    bool may_save(RegistryStatus status) {
+        return status == RegistryStatus::Ok || status == RegistryStatus::Damaged;
+    }
+
+    RegistryStatus parse_registry(const std::string &json_text, Registry &out) {
+        out = Registry{};
+        const json root = json::parse(json_text, nullptr, false);
+        if (root.is_discarded() || !root.is_object() || !root.contains("format") || !root["format"].is_number_integer()) {
+            return RegistryStatus::Corrupt;
+        }
+        const int64_t format = root["format"].get<int64_t>();
+        if (format > RegistryFormat) {
+            return RegistryStatus::Newer;
+        }
+        const auto list = root.find("packages");
+        if (format != RegistryFormat || list == root.end() || !list->is_array()) {
+            return RegistryStatus::Corrupt;
+        }
+        static const char *Known[] = { "id", "kind", "version", "display_name", "source", "installed", "parent", "files" };
+        bool clean = true;
+        for (const json &p : *list) {
+            if (!p.is_object() || !p.contains("id") || !p["id"].is_string() || !p.contains("kind") || !p["kind"].is_string()) {
+                clean = false;
+                continue;
+            }
+            Entry e;
+            e.id = p["id"].get<std::string>();
+            e.kind_text = p["kind"].get<std::string>();
+            e.kind = parse_kind(e.kind_text).value_or(Kind::Unknown);
+            if (!valid_id(e.id) || e.kind_text.empty() || find(out, e.id)) {
+                clean = false;
+                continue;
+            }
+            auto str = [&](const char *key) {
+                const auto it = p.find(key);
+                return (it != p.end() && it->is_string()) ? it->get<std::string>() : std::string();
+            };
+            e.version = str("version");
+            e.display_name = str("display_name");
+            e.source = str("source");
+            e.installed = str("installed");
+            e.parent = str("parent");
+            if (!e.parent.empty() && !valid_id(e.parent)) {
+                e.parent.clear();
+                clean = false;
+            }
+            bool files_ok = true;
+            if (const auto files = p.find("files"); files != p.end()) {
+                if (!files->is_array()) {
+                    files_ok = false;
+                }
+                else {
+                    for (const json &f : *files) {
+                        const std::string path = (f.is_object() && f.contains("path") && f["path"].is_string()) ? f["path"].get<std::string>() : std::string();
+                        const std::string hash = (f.is_object() && f.contains("hash") && f["hash"].is_string()) ? f["hash"].get<std::string>() : std::string();
+                        if (!safe_relative_path(path) || !is_hex(hash, 16)) {
+                            files_ok = false;
+                            break;
+                        }
+                        e.files.push_back({ normal_path(path), std::stoull(hash, nullptr, 16) });
+                    }
+                }
+            }
+            // A path already claimed by an entry read before this one: keep the first owner.
+            for (const InstalledFile &f : e.files) {
+                for (const Entry &other : out.packages) {
+                    for (const InstalledFile &g : other.files) {
+                        if (covers(g.path, f.path) || covers(f.path, g.path)) {
+                            files_ok = false;
+                        }
+                    }
+                }
+            }
+            if (!files_ok) {
+                clean = false;
+                continue;
+            }
+            json extra = json::object();
+            for (const auto &[key, value] : p.items()) {
+                if (std::find(std::begin(Known), std::end(Known), key) == std::end(Known)) {
+                    extra[key] = value;
+                }
+            }
+            if (!extra.empty()) {
+                e.extra = extra.dump();
+            }
+            upsert(out, std::move(e));
+        }
+        return clean ? RegistryStatus::Ok : RegistryStatus::Damaged;
+    }
+
+    std::string format_registry(const Registry &registry) {
+        json list = json::array();
+        for (const Entry &e : registry.packages) {
+            json files = json::array();
+            for (const InstalledFile &f : e.files) {
+                files.push_back({ { "path", normal_path(f.path) }, { "hash", recomp::mods::bundled_packs::hash_hex(f.hash) } });
+            }
+            const std::string kind = (e.kind != Kind::Unknown) ? std::string(kind_name(e.kind)) :
+                (e.kind_text.empty() ? std::string("unknown") : e.kind_text);
+            json p = { { "id", e.id }, { "kind", kind }, { "version", e.version }, { "display_name", e.display_name },
+                       { "source", e.source }, { "installed", e.installed } };
+            if (!e.parent.empty()) {
+                p["parent"] = e.parent;
+            }
+            p["files"] = files;
+            if (!e.extra.empty()) {
+                const json extra = json::parse(e.extra, nullptr, false);
+                if (extra.is_object()) {
+                    for (const auto &[key, value] : extra.items()) {
+                        if (!p.contains(key)) {
+                            p[key] = value;
+                        }
+                    }
+                }
+            }
+            list.push_back(p);
+        }
+        return json{ { "format", RegistryFormat }, { "packages", list } }.dump(2) + "\n";
+    }
+
+    const Entry *find(const Registry &registry, const std::string &id) {
+        for (const Entry &e : registry.packages) {
+            if (e.id == id) {
+                return &e;
+            }
+        }
+        return nullptr;
+    }
+
+    void upsert(Registry &registry, Entry entry) {
+        for (InstalledFile &f : entry.files) {
+            f.path = normal_path(f.path);
+        }
+        auto &list = registry.packages;
+        const auto it = std::lower_bound(list.begin(), list.end(), entry.id, [](const Entry &e, const std::string &id) { return e.id < id; });
+        if (it != list.end() && it->id == entry.id) {
+            *it = std::move(entry);
+        }
+        else {
+            list.insert(it, std::move(entry));
+        }
+    }
+
+    std::optional<Entry> remove(Registry &registry, const std::string &id) {
+        auto &list = registry.packages;
+        const auto it = std::find_if(list.begin(), list.end(), [&](const Entry &e) { return e.id == id; });
+        if (it == list.end()) {
+            return std::nullopt;
+        }
+        Entry e = std::move(*it);
+        list.erase(it);
+        return e;
+    }
+
+    std::string owner_of(const Registry &registry, const std::string &path) {
+        for (const Entry &e : registry.packages) {
+            for (const InstalledFile &f : e.files) {
+                if (covers(f.path, path)) {
+                    return e.id;
+                }
+            }
+        }
+        return {};
+    }
+
+    std::string conflict(const Registry &registry, const std::string &id, Kind kind, const std::vector<std::string> &paths,
+        const std::vector<std::string> &replacing) {
+        auto skipped = [&](const std::string &other) {
+            return other == id || std::find(replacing.begin(), replacing.end(), other) != replacing.end();
+        };
+        if (const Entry *e = find(registry, id); e && e->kind != kind) {
+            return "the id \"" + id + "\" is already used by the " + (e->kind == Kind::Unknown ? e->kind_text : kind_name(e->kind)) +
+                " \"" + (e->display_name.empty() ? e->id : e->display_name) + "\"";
+        }
+        for (const std::string &p : paths) {
+            for (const Entry &e : registry.packages) {
+                if (skipped(e.id)) {
+                    continue;   // its own files (an upgrade), or a package this one replaces
+                }
+                for (const InstalledFile &f : e.files) {
+                    if (covers(f.path, p) || covers(p, f.path)) {
+                        return p + " belongs to \"" + (e.display_name.empty() ? e.id : e.display_name) + "\"";
+                    }
+                }
+            }
+        }
+        return {};
+    }
+
+    FileState file_state(const InstalledFile &file, std::optional<uint64_t> current_hash) {
+        if (!current_hash) {
+            return FileState::Missing;
+        }
+        return (*current_hash == file.hash) ? FileState::Unchanged : FileState::Edited;
+    }
+
+    uint64_t hash_bytes(const std::string &file_name, const std::string &data) {
+        return recomp::mods::bundled_packs::pack_hash({ { file_name, data } });
+    }
+
+    // ---- Installing (aki-roadmap#154 step 2): the pure parts ----
+
+    std::vector<Placement> placements(const Manifest &m) {
+        auto base = [](const std::string &p) {
+            const std::string n = normal_path(p);
+            const size_t slash = n.find_last_of('/');
+            return (slash == std::string::npos) ? n : n.substr(slash + 1);
+        };
+        std::vector<Placement> out;
+        switch (m.kind) {
+            case Kind::Addon:
+                out.push_back({ normal_path(m.nrm), "mods/" + base(m.nrm), false });
+                break;
+            case Kind::TexturePack:
+                if (!m.rtz.empty()) {
+                    out.push_back({ normal_path(m.rtz), "mods/" + base(m.rtz), false });
+                }
+                else {
+                    out.push_back({ normal_path(m.folder), "mods/" + m.id, true });
+                }
+                break;
+            case Kind::ModelPack:
+                for (const std::string &p : m.packs) {
+                    out.push_back({ normal_path(p), "mods/models/" + base(p), true });
+                }
+                for (const std::string &p : m.hd) {
+                    out.push_back({ normal_path(p), "mods/" + base(p), false });
+                }
+                break;
+            case Kind::Conversion:
+                out.push_back({ normal_path(m.folder), "conversions/" + m.id, true });
+                for (const std::string &p : m.addons) {
+                    out.push_back({ normal_path(p), "mods/" + base(p), false });
+                }
+                break;
+            case Kind::Unknown:
+                break;
+        }
+        return out;
+    }
+
+    Plan plan_install(const Registry &registry, const Manifest &m, const InstallOptions &options) {
+        Plan plan;
+        plan.places = placements(m);
+        auto refuse = [&](const std::string &why) {
+            plan.action = Action::Refuse;
+            plan.reason = why;
+            return plan;
+        };
+        if (m.game_id != options.game_id) {
+            const std::string key = key_for_game_id(m.game_id);
+            return refuse("it's for another game (" + (key.empty() ? m.game_id : key) + ")");
+        }
+        if (!options.recomp_version.empty() && !m.requires_recomp.empty() &&
+            compare_versions(options.recomp_version, m.requires_recomp) < 0) {
+            return refuse("it needs game build " + m.requires_recomp + " or newer (this is " + options.recomp_version + ")");
+        }
+        if (!m.base_rom_sha1.empty()) {
+            const std::string rom = m.base_rom_name.empty() ? std::string("a different ROM") : m.base_rom_name;
+            if (options.rom_sha1.empty()) {
+                if (m.kind == Kind::Conversion) {
+                    return refuse("it needs " + rom + ", and your ROM can't be checked (import it in the game first)");
+                }
+            }
+            else if (std::find(m.base_rom_sha1.begin(), m.base_rom_sha1.end(), lower(options.rom_sha1)) == m.base_rom_sha1.end()) {
+                if (m.kind == Kind::Conversion) {
+                    return refuse("it needs " + rom + "; your ROM is a different one");
+                }
+                plan.notes.push_back({ false, "base_rom", "made for " + rom + "; it may not work with your ROM" });
+            }
+        }
+        for (size_t i = 0; i < plan.places.size(); i++) {
+            for (size_t j = i + 1; j < plan.places.size(); j++) {
+                if (covers(plan.places[i].to, plan.places[j].to) || covers(plan.places[j].to, plan.places[i].to)) {
+                    return refuse(plan.places[i].from + " and " + plan.places[j].from + " would both install to " + plan.places[j].to);
+                }
+            }
+        }
+        if (m.permission.redistribute == "no") {
+            plan.notes.push_back({ false, "permission", "for your own use: the authors don't allow sharing it" });
+        }
+        for (const std::string &dep : m.requires_packages) {
+            if (!find(registry, dep)) {
+                plan.notes.push_back({ false, "requires.packages", "it needs \"" + dep + "\", which isn't installed" });
+            }
+        }
+        for (const std::string &r : m.replaces) {
+            if (find(registry, r)) {
+                plan.replaced.push_back(r);
+            }
+        }
+        std::vector<std::string> tos;
+        for (const Placement &p : plan.places) {
+            tos.push_back(p.to);
+        }
+        if (const std::string why = conflict(registry, m.id, m.kind, tos, plan.replaced); !why.empty()) {
+            return refuse(why);
+        }
+        const Entry *old = find(registry, m.id);
+        if (!old) {
+            plan.action = Action::Install;
+            return plan;
+        }
+        plan.old_version = old->version;
+        const int c = compare_versions(m.version, old->version);
+        if (c > 0) {
+            plan.action = Action::Upgrade;
+        }
+        else if (c == 0) {
+            plan.action = options.reinstall ? Action::Reinstall : Action::AlreadyInstalled;
+            if (!options.reinstall) {
+                plan.reason = "version " + m.version + " is already installed";
+            }
+        }
+        else if (options.allow_downgrade) {
+            plan.action = Action::Downgrade;
+        }
+        else {
+            return refuse("version " + old->version + " is installed, which is newer than " + m.version);
+        }
+        return plan;
+    }
+
+    const char *outcome_name(Outcome outcome) {
+        switch (outcome) {
+            case Outcome::Installed: return "installed";
+            case Outcome::Upgraded: return "upgraded";
+            case Outcome::Reinstalled: return "reinstalled";
+            case Outcome::Downgraded: return "downgraded";
+            case Outcome::AlreadyInstalled: return "already-installed";
+            case Outcome::Refused: return "refused";
+            case Outcome::Failed: return "failed";
+        }
+        return "failed";
+    }
+}
