+        const SectionTableEntry& s = sections_info.code_sections[i];
+        if (s.rom_addr < boot_rom || s.rom_addr + s.size > boot_rom + boot_size) continue;
+        if ((int32_t)(s.rom_addr - boot_rom) + boot_ram == s.ram_addr) continue;
