diff --git a/librecomp/include/librecomp/bundled_packs.hpp b/librecomp/include/librecomp/bundled_packs.hpp
new file mode 100644
index 0000000..e1c8dbf
--- /dev/null
+++ b/librecomp/include/librecomp/bundled_packs.hpp
@@ -0,0 +1,69 @@
+#ifndef __RECOMP_BUNDLED_PACKS_HPP__
+#define __RECOMP_BUNDLED_PACKS_HPP__
+
+// [wcw] The model packs a game ships for aki_modelimport (assets/mods/models, aki-roadmap#145) and how a later bundle
+// updates them (aki-roadmap#149). A bundled pack is installed into the player's mods/models once; mods/models/.bundled
+// records it, so a pack the player deleted stays deleted. A newer bundle replaces an installed copy only when that copy
+// is an earlier bundled version the player hasn't edited: its contents hash to one of the pack's earlier versions in
+// bundled-history.json (written by AkiMods mods/modelimport/tools/pack_history.py) and its pack.json version is older.
+// A pack the player made or changed is never touched. The rules are pure and unit tested
+// (tests/wcw/bundled_packs_tests.cpp); install() does the file work.
+
+#include <cstdint>
+#include <filesystem>
+#include <map>
+#include <set>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace recomp {
+    namespace mods {
+        namespace bundled_packs {
+            constexpr const char *RecordFile = ".bundled";
+            constexpr const char *HistoryFile = "bundled-history.json";
+
+            // FNV-1a 64 over a pack's files ('/'-separated paths relative to the pack, contents), sorted by path, each
+            // as path bytes, 0x00, contents, 0x00. Text files (.json, .md, .txt) count CRLF as LF, so the line endings
+            // a checkout gave them don't change the hash. Must match pack_history.py.
+            uint64_t pack_hash(std::vector<std::pair<std::string, std::string>> files);
+            std::string hash_hex(uint64_t hash);   // 16 lower-case hex digits
+            // Whether pack_hash treats a file as text (CRLF counts as LF): .json, .md, .txt, by the extension Python's
+            // os.path.splitext sees (leading dots of the file name don't start one).
+            bool is_text_file(const std::string &path);
+
+            // Dotted versions compared part by part as numbers ("1.10.0" > "1.9.0"); a missing part or one that isn't a
+            // number counts as 0. Negative: a < b.
+            int compare_versions(const std::string &a, const std::string &b);
+            // pack.json's "version" ("" when it has none or isn't JSON).
+            std::string pack_version(const std::string &pack_json_text);
+
+            enum class Action {
+                Install,  // not there and never installed: copy it in
+                Replace,  // an earlier bundled version, unedited: replace it with this one
+                Keep,     // up to date, edited, or the player's own pack of that name: leave it
+                Skip      // installed before and since deleted by the player: don't bring it back
+            };
+            struct Installed {
+                bool recorded = false;     // named in .bundled
+                bool present = false;      // a folder of that name is in mods/models
+                uint64_t hash = 0;         // its pack_hash, when present
+                std::string version;       // its pack.json version, when present
+            };
+            Action decide(const Installed &installed, uint64_t bundled_hash, const std::string &bundled_version,
+                const std::vector<uint64_t> &earlier_hashes);
+
+            // .bundled: one pack folder name per line (CR and trailing spaces ignored).
+            std::set<std::string> parse_record(const std::string &text);
+            std::string format_record(const std::set<std::string> &names);
+            // bundled-history.json: {"previous": {"<id>": ["<16 hex>", ...]}} -> id -> earlier hashes. Bad input: empty.
+            std::map<std::string, std::vector<uint64_t>> parse_history(const std::string &json_text);
+
+            // Installs/updates the packs in src (assets/mods/models) into dst (the player's mods/models) by the rules
+            // above, copies CREDITS.md when it differs, and prints what it did ("[wcw] bundled model pack ...").
+            void install(const std::filesystem::path &src, const std::filesystem::path &dst);
+        }
+    }
+}
+
+#endif
diff --git a/librecomp/include/librecomp/conversion.hpp b/librecomp/include/librecomp/conversion.hpp
new file mode 100644
index 0000000..2433114
--- /dev/null
+++ b/librecomp/include/librecomp/conversion.hpp
@@ -0,0 +1,236 @@
+#ifndef __RECOMP_CONVERSION_HPP__
+#define __RECOMP_CONVERSION_HPP__
+
+// [wcw fullconv] Conversions: one package per full-conversion mod (a ROM patch, GameShark codes, saves, a texture pack
+// and ray-tracing data, in any mix), installed in <config>/conversions/<id>/ with an aki.json manifest
+// (plans/fullconv-manifest.md). AKI_CONVERSION=<id> (set by AKI Launcher) runs the game with exactly that conversion:
+// its mods on, every other mod off for the session, its saves in saves/<id>/. The parsing and the enable rule are pure
+// and unit tested (tests/wcw/conversion_tests.cpp).
+
+#include <cstdint>
+#include <filesystem>
+#include <string>
+#include <unordered_set>
+#include <vector>
+
+namespace recomp {
+    namespace mods {
+        namespace conversion {
+            // The env var AKI Launcher sets.
+            constexpr const char *EnvVar = "AKI_CONVERSION";
+            // Install folder under the config folder, and the shared folder for dependency packages (texture packs).
+            constexpr const char *Folder = "conversions";
+            constexpr const char *PackagesFolder = "_packages";
+            constexpr const char *ManifestFile = "aki.json";
+            // The conversion picked in the game's Mods menu, for the next starts (aki-roadmap#57): one id in
+            // <config>/conversions/active.txt. AKI_CONVERSION (the launcher) wins over it.
+            constexpr const char *ChoiceFile = "active.txt";
+            // The player's own add-on choices for one conversion (aki-roadmap#154): conversions/<id>/addons.json.
+            constexpr const char *AddonsFile = "addons.json";
+
+            // Which of the player's add-ons a conversion lets run beside it (aki.json "addons", aki-roadmap#154).
+            enum class AddonsAllow {
+                None,   // only the conversion's own mods
+                Data,   // data packs the player has enabled (texture packs); code add-ons only when listed (default)
+                All     // everything the player has enabled
+            };
+
+            struct Conversion {
+                std::string id;
+                std::string name;
+                std::string game;
+                bool has_patch = false;
+                bool has_codes = false;
+                bool has_saves = false;
+                bool has_textures = false;
+                bool has_rt = false;
+                // Relative to the conversion folder.
+                std::string codes_file;
+                // "nomercy-rev0" / "nomercy-rev1" / "" (unknown): codes only run when they match the port.
+                std::string codes_rom;
+                // Texture dependency package ("Team-Name"), when the pack isn't inline.
+                std::string textures_package;
+                // Inline pack: a folder in the conversion ("textures"), and how its files are named ("rice" / "rt64").
+                std::string textures_dir;
+                std::string textures_naming;
+                std::string rt_lights_file;
+                std::string rt_materials_file;
+                // saves[] entries the game seeds (aki-roadmap#242): "mode": "seed" or no mode, relative to the conversion
+                // folder, in the port's on-disk format and file name.
+                std::vector<std::string> seed_saves;
+                // aki.json "models" (aki-roadmap#226): the conversion's own model packs, which replace the player's
+                // while it runs. {"dir": "models", "format": 2, "roster": "models/roster.json",
+                //  "slots": [{"wrestler": "0x0404", "name": "Kenny Omega", "costume": 0, "pack": "kenny"}]}
+                // dir: a folder in the conversion with the packs (<pack>.akimodel/) and any -hd.rtz is beside them in the
+                // conversion folder. format: the AKP1 version the packs were built for (ModelsFormat at most). slots:
+                // who each pack replaces, by the hack's own wrestler ids (roster: the hack's roster, for the tools and
+                // the launcher); the game's model host serves them as models.txt. Without slots, dir/models.txt is read.
+                // An optional v1 component: older builds ignore it and run the conversion without models.
+                struct ModelSlot {
+                    uint32_t wrestler = 0;
+                    int costume = -1;           // -1: every costume
+                    std::string name;           // for people (the launcher, the log)
+                    std::string pack;           // <pack>.akimodel in dir
+                };
+                bool has_models = false;
+                std::string models_dir;
+                int models_format = 0;
+                std::string models_roster;
+                std::vector<ModelSlot> models_slots;
+                bool models_has_slots = false;  // "slots" given (even empty: then no wrestler changes)
+                // Why this session runs without the conversion's models, "" when it runs with them: a bad models
+                // component (from parse), or the patch's memory use (models_refusal, at the mod scan).
+                std::string models_refusal;
+                // aki.json "addons": {"allow": "none" | "data" | "all", "mods": ["aki_camera", ...]}. Listed code add-ons
+                // run under "data" too (the conversion's allow-list).
+                AddonsAllow addons_allow = AddonsAllow::Data;
+                std::vector<std::string> addons_mods;
+            };
+
+            // The model import mod (AkiMods aki_modelimport), on for a session whose conversion has usable models.
+            constexpr const char *ModelsModId = "aki_modelimport";
+            // Model packs load into the N64's Expansion RAM window, physical 0x00400000-0x00800000 (AkiMods
+            // mods/modelimport/mod.psd1: MI_MEM_BASE .. MI_SCRATCH + 256 KB). A relinked hack whose relink.json puts
+            // code, data, preloads or zeroed ranges there owns that memory (Born to be Wired, No Mercy Plus, Legends).
+            // The newest model pack format (AKP1 header version) this build reads; AkiMods modelimport AKP1_VERSION.
+            constexpr int ModelsFormat = 2;
+            // The models.txt the model host serves for slots: one "<pack> wrestler 0x<id> [costume <n>]" line each.
+            std::string models_txt(const std::vector<Conversion::ModelSlot> &slots);
+            constexpr uint32_t ModelsWindowStart = 0x00400000;
+            constexpr uint32_t ModelsWindowEnd = 0x00800000;
+            // Why a conversion's models can't load beside its patch, "" when they can (aki-roadmap#226). relink_json:
+            // the text of the patch's relink.json, "" when it has none (a plain patch: always fine). Refused: any
+            // code_ranges / data_ranges / preload / zero range overlapping the models window, or a relink.json that
+            // doesn't parse. Moving the packs above 8 MB (aki-roadmap#156) lifts this.
+            std::string models_refusal(const std::string &relink_json);
+
+            // [a-z0-9_.-]{1,48}, not starting with '.' or '_': ids are folder names (and '_packages' is reserved).
+            bool valid_id(const std::string &id);
+
+            // Parses aki.json. Returns false with error set when it isn't a valid v1 manifest, or when its id doesn't
+            // match expected_id (the folder it was found in; empty to skip the check).
+            bool parse(const std::string &json_text, const std::string &expected_id, Conversion &out, std::string &error);
+
+            // The mods a session with this conversion enables: every mod found in its folders, plus the cheats
+            // engine when it has codes that can run (codes_runnable). Every other mod is off for the session.
+            std::unordered_set<std::string> session_enabled_mods(const std::vector<std::string> &conversion_mod_ids,
+                bool codes_runnable, const std::string &cheats_mod_id);
+
+            // A mod from the player's mods folder, as a session sees it.
+            struct PlayerMod {
+                std::string id;
+                bool code = false;              // a code add-on; false (and not a ROM patch): a data pack (texture pack)
+                bool rom_patch = false;         // another ROM hack's patch: never beside the conversion's own
+                bool enabled = false;           // enabled in the player's mod configuration
+            };
+            // conversions/<id>/addons.json: {"enabled": [ids], "disabled": [ids]}. The player's word wins over the
+            // conversion's: enabled runs even a code add-on the conversion doesn't list, disabled turns one off (an id
+            // in both lists is off). It can't turn off the conversion's own mods or turn on another ROM hack.
+            struct PlayerAddons {
+                std::vector<std::string> enabled, disabled;
+            };
+            PlayerAddons parse_player_addons(const std::string &json_text);   // bad input: none
+            // The session rule with add-ons (aki-roadmap#154 step 4): the conversion's own mods and the cheats engine
+            // (as above), plus each of the player's mods that the player overrides on, or that the player has
+            // enabled and the conversion allows: data packs unless addons.allow is none, code add-ons when
+            // addons.allow is all or the conversion lists them. Never: another ROM hack's patch (two patches can't
+            // load together), and the cheats engine without runnable conversion codes unless the player turned it
+            // on here (the player's stock-game codes would poke a hack's memory). why (optional) gets one line per
+            // player mod. A mod enabled here can still pull in its dependencies when it loads (dependency auto-enable).
+            std::unordered_set<std::string> session_enabled_mods(const std::vector<std::string> &conversion_mod_ids,
+                bool codes_runnable, const std::string &cheats_mod_id, const std::vector<PlayerMod> &player_mods,
+                const Conversion &conversion, const PlayerAddons &player, std::vector<std::string> *why = nullptr);
+
+            // The save subfolder (saves/<subfolder>/): a conversion (AKI_CONVERSION, env_value) wins over the ROM-patch
+            // mod's id; "" = the normal saves. Returns false for an invalid conversion id: the game must not start
+            // then (falling back to the normal saves would let a conversion overwrite the player's progress).
+            bool resolve_save_subfolder(const char *env_value, const std::string &patch_mod_id, std::string &out);
+
+            // Which conversion a session starts with (aki-roadmap#57). The launcher's AKI_CONVERSION (env_value) wins and is
+            // strict: an id that can't run refuses to start, as before. Otherwise the Mods-menu choice (choice_file_text, the
+            // text of conversions/active.txt; its first line, trimmed) is lenient: if it can't run the game starts
+            // normally instead (see lenient). Both empty: no conversion.
+            struct StartupChoice {
+                std::string id;
+                bool from_launcher = false;
+                bool lenient() const { return !from_launcher && !id.empty(); }
+            };
+            StartupChoice choose_startup(const char *env_value, const std::string &choice_file_text);
+
+            // Why a lenient (Mods-menu) choice can't run, "" when it can (out is then its parsed aki.json). manifest_text:
+            // the text of <config>/conversions/<id>/aki.json, "" when it isn't installed.
+            std::string check_choice(const std::string &id, const std::string &manifest_text, Conversion &out);
+
+            // aki-roadmap#241: the WCW_RT_LIGHTS_FILE a session with this conversion sets before rt64 reads its presets
+            // (at the first ray-traced frame): <folder>/<rt.lights>. Empty: leave the variable alone (no rig, or it is
+            // already set, by AKI Launcher or a test run).
+            std::filesystem::path rt_lights_path(const Conversion &c, const std::filesystem::path &folder, const char *env_value);
+
+            // aki-roadmap#242: copies each seed save from the conversion folder into saves_folder (saves/<id>/) under its
+            // file name, only when that file doesn't exist yet: never over the player's progress. The launcher's Install
+            // does the same, so either may run first. A missing seed file is logged and skipped. One line per save.
+            struct SeedReport {
+                int seeded = 0, kept = 0, failed = 0;
+                std::vector<std::string> lines;
+            };
+            SeedReport seed_saves(const Conversion &c, const std::filesystem::path &folder, const std::filesystem::path &saves_folder);
+
+            // Whether codes written for codes_rom may run on this port: the same game (the cheats engine translates another
+            // revision's addresses itself); "" (unknown) and other games are refused.
+            bool codes_runnable(const std::string &codes_rom, const std::string &port_rom);
+        }
+
+        // The conversion this session runs (AKI_CONVERSION or the Mods-menu choice), or nullptr. Set by scan_mods.
+        const conversion::Conversion *active_conversion();
+        // Its id ("" = none), decided once per session (conversion::choose_startup); the save folder follows it.
+        std::string session_conversion_id();
+        // Whether AKI Launcher picked it (AKI_CONVERSION): a restart from the launcher passes the same id again, so a
+        // Mods-menu choice only applies to starts without it.
+        bool session_conversion_from_launcher();
+
+        // The Mods menu's conversion picker (aki-roadmap#57). An installed conversion: its parsed aki.json, or error set
+        // (id and name are then the folder name).
+        struct InstalledConversion {
+            conversion::Conversion conversion;
+            std::filesystem::path folder;
+            std::string error;
+        };
+        // The conversions installed in <config>/conversions/, by name.
+        std::vector<InstalledConversion> list_installed_conversions();
+        // The id in conversions/active.txt ("" = none): the conversion the next start runs when the launcher sets none.
+        std::string chosen_conversion();
+        // Writes (or, for "", removes) conversions/active.txt. False for an invalid id or a failed write.
+        bool set_chosen_conversion(const std::string &id);
+        // Why this session's Mods-menu choice couldn't run and was cleared ("" = it ran, or there was none).
+        std::string conversion_choice_notice();
+        // The active conversion's codes file text, or "" (no conversion, no codes, or codes for another revision).
+        std::string active_conversion_codes();
+        // aki-roadmap#226: records why the active conversion's models can't load (conversion::models_refusal), "" when
+        // they can. Called at the mod scan, before the session's mods are decided. No-op without a conversion.
+        void set_active_conversion_models_refusal(const std::string &reason);
+        // The folder the game's model host reads while the active conversion runs: <conversion>/<models dir>. Empty
+        // when there is no conversion, it has no models component, or its models are refused (then the host must
+        // read nothing at all, not the player's own packs, which would land in the same memory).
+        std::filesystem::path active_conversion_models_dir();
+        // The models.txt for the active conversion's slots (conversion::models_txt), or false when the model host
+        // should read dir/models.txt itself (no slots, or no usable models).
+        bool active_conversion_models_txt(std::string &out);
+        // The ROM revision tag codes must have to run on this port (e.g. "nomercy-rev1"); set by the game.
+        void set_port_rom_revision(const std::string &tag);
+        // The cheats engine's mod id (AkiMods cheats), enabled with a conversion that has codes; set by the game.
+        void set_cheats_mod_id(const std::string &mod_id);
+        // The active conversion's codes as a native table (librecomp/conversion_codes.hpp), parsed on the first call:
+        // true when its codes file is written for this port's revision (or untagged). Those codes then run from
+        // apply_active_native_codes, every frame, with no size cap; the game hands the cheats mod no text for them.
+        // False: no codes, or codes for another revision, which stay with the cheats mod (it translates them).
+        bool active_native_codes_ready();
+        // Runs the native table once over RDRAM (rdram_size bytes from 0x80000000). No-op when there is none.
+        void apply_active_native_codes(uint8_t *rdram, uint32_t rdram_size);
+    }
+
+    // The save subfolder the game uses (conversion::resolve_save_subfolder): the active conversion's id, else the
+    // ROM-patch mod's id, else "" (saves/ itself). Also used for the save backups before the game starts.
+    std::u8string get_save_subfolder();
+}
+
+#endif
diff --git a/librecomp/include/librecomp/conversion_codes.hpp b/librecomp/include/librecomp/conversion_codes.hpp
new file mode 100644
index 0000000..2a8785b
--- /dev/null
+++ b/librecomp/include/librecomp/conversion_codes.hpp
@@ -0,0 +1,60 @@
+#ifndef __RECOMP_CONVERSION_CODES_HPP__
+#define __RECOMP_CONVERSION_CODES_HPP__
+
+// [wcw fullconv] A conversion's GameShark codes run natively by the runtime, as one compact table applied once per
+// game frame (the host export aki_conversion_apply, called from the AkiMods cheats mod's frame hook).
+//
+// Why per frame and not a one-time RAM init: a code that writes a constant can't be told apart, statically, from one
+// the game overwrites later (Project64 re-applies every cheat continuously, and big legacy sets like Showdown 64's
+// rely on that). So nothing is compiled away; what changes is where the codes run: natively, from a table with no
+// size cap, instead of the mod's 4096-entry list.
+//
+// The grammar and the unit rules are the AkiMods cheats engine's (mods/cheats/src/codes_engine.h, README "Codes
+// files"), so a file behaves the same on either path:
+//   80/A0 8-bit write, 81/A1 16-bit write, D0/D1 run the next unit if the 8/16-bit value equals, D2/D3 if it differs,
+//   50 00NNSS IIII repeat the next write NN times (address += SS, value += IIII). Enablers (F0 F1 F6 FF EE DE 2A 3C)
+//   and button codes (88/89) are ignored. "The next unit" is a repeater with its write, or a conditional with the unit
+//   it governs, so stacked conditionals all have to hold.
+// Unlike the mod, this path doesn't translate revisions: a file tagged for another revision of the game is left to
+// the mod (which translates No Mercy Rev 0), and aki-conv translates big sets before packaging.
+
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace recomp::mods::conversion::codes {
+    struct Code {
+        uint32_t addr;   // N64 virtual address (0x80xxxxxx; A0/A1 map to the same RAM)
+        uint16_t value;
+        uint8_t type;    // 0x80 0x81 0xA0 0xA1 0xD0-0xD3 0x50
+        uint8_t pad = 0;
+    };
+
+    struct Report {
+        int added = 0;
+        int writes = 0;
+        int conditionals = 0;
+        int repeaters = 0;
+        int enablers = 0;
+        int buttons = 0;
+        int unknown = 0;
+        int malformed = 0;
+        int first_bad_line = 0;
+        bool rom_mismatch = false; // the "# rom:" tag names another game or revision
+        int rom_rev = -1;          // from the tag; -1 none
+    };
+
+    // "nomercy-rev1" -> ("nomercy", 1); "wt-rev0" -> ("wt", 0); "vpw2" -> ("vpw2", 0).
+    void split_rom_tag(const std::string &tag, std::string &game_key, int &rev);
+
+    // Parses a codes file for game_key at revision native_rev into 'out' (cleared first). False (and nothing in 'out')
+    // when the tag names another game or revision.
+    bool parse_file(std::string_view text, const std::string &game_key, int native_rev, std::vector<Code> &out, Report &report);
+
+    // Runs the table once over the recomp's RDRAM (32-bit words in host order: byte a lives at (a ^ 3)), rdram_size
+    // bytes from 0x80000000. Writes and reads outside it are skipped.
+    void apply(const std::vector<Code> &codes, uint8_t *rdram, uint32_t rdram_size);
+}
+
+#endif
diff --git a/librecomp/include/librecomp/dd_breadcrumb.hpp b/librecomp/include/librecomp/dd_breadcrumb.hpp
new file mode 100644
index 0000000..e0bdfb6
--- /dev/null
+++ b/librecomp/include/librecomp/dd_breadcrumb.hpp
@@ -0,0 +1,53 @@
+#ifndef __RECOMP_DD_BREADCRUMB_HPP__
+#define __RECOMP_DD_BREADCRUMB_HPP__
+
+// [wcw] A last event to the local Datadog Agent when the game dies (aki-roadmap#125): a switch-case out of bounds, a
+// break, a fatal error box. Only with WCW_DD_METRICS=1, the same switch as rt64's aki.game.* metrics, and only to
+// 127.0.0.1 (WCW_DD_PORT, default 8125), so nothing leaves the PC except through the owner's own Agent. The event uses
+// rt64's DogStatsD format and source (aki-game), so it lands in the same event stream as the play sessions. The
+// formatting is pure and unit tested in tests/wcw/dd_breadcrumb_tests.cpp.
+
+#include <string>
+#include <vector>
+
+namespace recomp {
+    namespace dd {
+        // Whether an environment value turns a switch on: set, not empty and not "0" (rt64's envSwitchOn).
+        bool switch_on(const char* value);
+
+        // One tag as rt64's ddTag: key and value lower case, other characters as '_' (key: a-z 0-9 _ - . /, value
+        // also ':'), a key not starting with a letter gets "t_", at most 200 characters; empty for an empty value.
+        std::string tag(const std::string& key, const std::string& value);
+
+        // Tags from WCW_DD_TAGS ("a:b,c:d") as rt64's ddParseTags: entries without ':' dropped, each through tag(),
+        // exact duplicates once.
+        std::vector<std::string> parse_tags(const char* value);
+
+        // The game name as rt64's ddGameFromExe: the exe's file name, lower case, without .exe and "recompiled"
+        // (NoMercyRecompiled.exe: nomercy; WCWRecompiled.exe: wt).
+        std::string game_from_exe(const std::string& exe_name);
+
+        // WCW_DD_GAME when set and not empty, else game_from_exe (rt64's rule).
+        std::string fatal_game(const char* env_game, const std::string& exe_name);
+
+        // A DogStatsD event: _e{title length,text length}:title|text|k:key|s:aki-game|t:alert|#tags. A newline in the
+        // title becomes a space, in the text \n; carriage returns go.
+        std::string event_line(const std::string& title, const std::string& text, const std::vector<std::string>& tags,
+            const std::string& alert_type, const std::string& aggregation_key);
+
+        // The tags of a fatal event: game:<game>, kind:fatal, then WCW_DD_TAGS (not game or kind).
+        std::vector<std::string> fatal_tags(const std::string& game, const char* extra_tags);
+
+        // The event title as rt64 writes its play-session events: "aki-game <game>: <what>" ("aki-game: <what>" without
+        // a game), so the breadcrumb sorts with the session in the event stream.
+        std::string fatal_title(const std::string& game, const std::string& what);
+
+        // Sends one error event "aki-game <game>: <title>" with text to the local Agent, if WCW_DD_METRICS is on. Never
+        // throws (it runs on the way out of the process, from extern "C" code), never blocks for long (one UDP
+        // datagram), and reads nothing the shutdown may have reset (the game name comes from the exe, not the
+        // running game).
+        void fatal(const std::string& title, const std::string& text) noexcept;
+    }
+}
+
+#endif
diff --git a/librecomp/include/librecomp/entry_prologue_rules.hpp b/librecomp/include/librecomp/entry_prologue_rules.hpp
new file mode 100644
index 0000000..80689cc
--- /dev/null
+++ b/librecomp/include/librecomp/entry_prologue_rules.hpp
@@ -0,0 +1,48 @@
+#ifndef __RECOMP_ENTRY_PROLOGUE_RULES_HPP__
+#define __RECOMP_ENTRY_PROLOGUE_RULES_HPP__
+
+// [wcw fullconv] Entry prologues (aki-roadmap#76): code a port hand-adds at the start of a recompiled function (No
+// Mercy's 60 fps matrix capture and RT camera latch in func_80001E08) lives only in the static function. When the live
+// recompiler replaces that function (a ROM patch changed it, or a mod hooks it), the port's registered prologue is
+// called at the entry of the replacement, so the hand-edit survives. A prologue observes: the registers are restored
+// after it runs, and it can't skip the function.
+//
+// The live generator's entry hook passes one index per function. A prologue index is tagged (top bit) and may carry a
+// mod's hook slot as well (the mod's hook runs first, then the prologue, as at the start of the static function).
+// Pure rules, unit tested in tests/wcw/entry_prologue_tests.cpp.
+
+#include <cstddef>
+#include <cstdint>
+#include <span>
+#include <unordered_map>
+
+namespace recomp {
+    namespace mods {
+        namespace entry_prologues {
+            static_assert(sizeof(size_t) == 8, "entry hook indices pack a prologue and a hook slot into 64 bits");
+
+            constexpr size_t Tag = size_t(1) << 63;
+            constexpr size_t HasSlot = size_t(1) << 62;
+            constexpr size_t MaxPrologues = size_t(1) << 30;
+
+            // The entry hook index for a prologue, alone or with a mod's hook slot.
+            size_t encode(size_t prologue, bool has_slot, size_t slot);
+
+            struct Decoded {
+                bool is_prologue = false;   // false: a plain mod hook slot (slot holds it)
+                size_t prologue = 0;
+                bool has_slot = false;
+                size_t slot = 0;
+            };
+            Decoded decode(size_t hook_index);
+
+            // Adds the prologues to a regenerated list's entry hooks. func_ptrs[i] is the static function that function i
+            // replaces; prologue_of maps a static function to its prologue's index. A function a mod already entry-hooks
+            // keeps that slot alongside its prologue. Returns how many prologues were added.
+            size_t add_to_entry_hooks(std::span<const void* const> func_ptrs, const std::unordered_map<const void*, size_t> &prologue_of,
+                std::unordered_map<size_t, size_t> &entry_hooks);
+        }
+    }
+}
+
+#endif
diff --git a/librecomp/include/librecomp/live_code_rules.hpp b/librecomp/include/librecomp/live_code_rules.hpp
new file mode 100644
index 0000000..c95e494
--- /dev/null
+++ b/librecomp/include/librecomp/live_code_rules.hpp
@@ -0,0 +1,136 @@
+#ifndef __RECOMP_LIVE_CODE_RULES_HPP__
+#define __RECOMP_LIVE_CODE_RULES_HPP__
+
+// [wcw fullconv] GameShark codes that rewrite game instructions while the game runs (aki-roadmap#187). Recompiled code
+// never reads its instructions back, so such a write would do nothing. After each pass of the native codes table the
+// runtime compares the words the table can write inside known functions with the ROM. A function that differs is
+// recompiled from RDRAM, cached by the values of those words, and the static function's entry jumps to that version
+// until the words match the ROM again.
+//
+// This file holds the decisions and the arithmetic, unit tested in tests/wcw/live_code_rules_tests.cpp. The runtime
+// half (compiling, patching entries) is in mods.cpp.
+
+#include <cstddef>
+#include <cstdint>
+#include <span>
+#include <unordered_set>
+#include <vector>
+
+#include "librecomp/conversion_codes.hpp"
+
+namespace recomp::mods::live_codes {
+    struct FunctionSpan {
+        uint32_t vram;
+        uint32_t rom;
+        uint32_t size;
+        size_t id;       // the caller's handle for this function
+    };
+
+    struct Watch {
+        FunctionSpan func;
+        std::vector<uint32_t> words; // addresses of the words the table can write, sorted
+    };
+
+    // Every word address a table can write, repeaters expanded: sorted, no duplicates. Conditions aren't evaluated, so
+    // this is what the table could ever write.
+    std::vector<uint32_t> written_words(const std::vector<conversion::codes::Code> &codes);
+
+    // The functions those words fall in. Overlays share addresses, so one word can land in one function per overlay.
+    // Functions with no ROM code (size 0) and no written word are left out.
+    std::vector<Watch> build_watches(const std::vector<uint32_t> &words, std::span<const FunctionSpan> functions);
+
+    // Do the watched words in RDRAM (host-order words) equal the big-endian ROM? False if any is out of range.
+    bool watched_match_rom(const Watch &watch, const uint8_t *rdram, uint32_t rdram_size, std::span<const uint8_t> rom);
+
+    // Does every word of the function the table can't write equal the ROM? False means something other than this
+    // function's code is there, so compiling it would be wrong.
+    bool others_match_rom(const Watch &watch, const uint8_t *rdram, uint32_t rdram_size, std::span<const uint8_t> rom);
+
+    // A range of addresses holding known code: [start, end).
+    struct CodeRange {
+        uint32_t start;
+        uint32_t end;
+    };
+
+    bool in_code_ranges(uint32_t addr, std::span<const CodeRange> code);
+
+    // The words a codes table can write as ranges, for checking a hook's target. Unsorted, repeats are fine.
+    std::vector<CodeRange> ranges_of_words(const std::vector<uint32_t> &words);
+
+    // Is this word a conditional or relative branch (beq/bne/blez/bgtz and their likely forms, the regimm branches, and
+    // bc1f/bc1t/bc1fl/bc1tl)? Used to trace the extent of code in RAM; j/jal/jr aren't branches here.
+    bool is_branch_word(uint32_t w);
+
+    // The units of a table (conditionals with the write they govern, a repeater with its write) that write into range,
+    // in table order. Running just these refreshes a pack's code in RAM without touching anything else the table writes.
+    std::vector<conversion::codes::Code> units_writing(const std::vector<conversion::codes::Code> &codes, CodeRange range);
+
+    // Does a watched word now leave the function in a way the ROM's word didn't: a j or jal outside these ranges, a
+    // branch outside the function, or a jr or jalr through a register other than ra? Such a word hooks into code the
+    // pack puts in RAM. A j or jal into `pack_writes` (what the table can write) is that code, as long as something is
+    // there: a hook can go live before its code does. Anywhere else nothing says it's code, and a hook with old-revision
+    // addresses lands there (aki-roadmap#205), so the version isn't used. A jr built from lui/ori is caught by its jr only
+    // if the pack writes the jr.
+    bool hooks_outside_code(const Watch &watch, const uint8_t *rdram, uint32_t rdram_size, std::span<const uint8_t> rom, std::span<const CodeRange> code,
+        std::span<const CodeRange> pack_writes = {});
+
+    // What to do about a version's exits, given every section's code (all) and what's in memory now (loaded).
+    enum class ExitCheck {
+        Fine,     // run it
+        NotNow,   // it jumps to an overlay that isn't loaded: not now, but this content may run later
+        Never,    // it jumps outside all known code: this content can't run
+    };
+
+    // A jump into pack_writes with nothing there yet is NotNow: the table may write it later.
+    ExitCheck check_exits(const Watch &watch, const uint8_t *rdram, uint32_t rdram_size, std::span<const uint8_t> rom,
+        std::span<const CodeRange> all, std::span<const CodeRange> loaded, std::span<const CodeRange> pack_writes = {});
+
+    // A key for the current values of the watched words. Never 0 (0 means "the static function").
+    uint64_t content_key(const Watch &watch, const uint8_t *rdram, uint32_t rdram_size);
+
+    struct FunctionState {
+        uint64_t current = 0;                  // the key of the version running; 0 = static
+        std::unordered_set<uint64_t> compiled; // keys with a compiled version
+        std::unordered_set<uint64_t> failed;   // keys that can't run (a hook, or it won't compile): not tried again
+        bool refused = false;                  // never switched (mod hook, entry prologue, repaired under Refuse...)
+    };
+
+    constexpr size_t MaxVersionsPerFunction = 256;
+    constexpr int MaxCompilesPerPass = 8;
+
+    enum class Action {
+        None,          // already right, or nothing may be done
+        ToStatic,      // the words match the ROM, the section isn't loaded, or this content can't run: back to static
+        UseCompiled,   // a compiled version exists for this content
+        Compile,       // new content, compile it
+        Deferred,      // new content, but this pass has used its compile budget: try on the next pass
+        AtCap,         // new content, but MaxVersionsPerFunction contents were tried: stay on the current one
+    };
+
+    Action decide(const FunctionState &state, bool section_loaded, bool at_rom, uint64_t key, int compiles_left);
+
+    // x86-64: entry patch and stub. The patch is 5 bytes so it can't cover a suspended caller's return address: the
+    // shortest call as a function's first instruction returns just past it.
+    constexpr size_t EntryPatchSize = 5;
+    constexpr size_t StubSize = 16;
+    constexpr size_t StubTargetOffset = 8;
+
+    // jmp rel32 at 'from' reaching 'to'. False if out of range.
+    bool encode_entry_jump(uintptr_t from, uintptr_t to, uint8_t out[EntryPatchSize]);
+
+    // jmp qword ptr [rip+2], two int3, the target: the target is 8-byte aligned when the stub is, so it can be swapped
+    // with one store.
+    void encode_stub(uint64_t target, uint8_t out[StubSize]);
+
+    // Runtime half (mods.cpp): call after each pass of the table, on the game thread that ran it.
+    void after_apply(const std::vector<conversion::codes::Code> &codes, uint8_t *rdram, uint32_t rdram_size);
+
+    // For the stall watchdog (WCW_STALL_DUMP). version_at: the function whose compiled version holds this native address.
+    // version_bounds: the address range the compiled versions span, 0 if there are none. Neither locks: they're
+    // for the watchdog's capture, with the game threads suspended, so they read a fixed-size table.
+    bool version_at(uint64_t addr, uint32_t &vram);
+    void version_bounds(uintptr_t &low, uintptr_t &high);
+    void print_stall_state();
+}
+
+#endif
diff --git a/librecomp/include/librecomp/mod_enable_rules.hpp b/librecomp/include/librecomp/mod_enable_rules.hpp
new file mode 100644
index 0000000..0553947
--- /dev/null
+++ b/librecomp/include/librecomp/mod_enable_rules.hpp
@@ -0,0 +1,32 @@
+#ifndef __RECOMP_MOD_ENABLE_RULES_HPP__
+#define __RECOMP_MOD_ENABLE_RULES_HPP__
+
+// [wcw] Pure rule for the mods that enabling a mod auto-enables (its dependencies, aki-roadmap#100). Unit tested in
+// tests/wcw/mod_enable_rules_tests.cpp.
+
+#include <functional>
+#include <string>
+#include <unordered_set>
+#include <vector>
+
+namespace recomp {
+    namespace mods {
+        namespace enable_rules {
+            // A dependency as the walk sees it: the mod it names, and whether it's skipped (optional, or deprecated
+            // at the version asked for).
+            struct Dependency {
+                std::string mod_id;
+                bool skipped = false;
+            };
+
+            // The mods that enabling mod_id auto-enables, in the order they're found: its dependencies that aren't
+            // skipped, then theirs, leaving out any already in auto_enabled (each one found is added to it).
+            // dependencies_of(id) is empty for a mod that isn't opened. on_enabled fires for each mod returned, with
+            // that mod's own handle: it used to fire with the handle of the mod that depends on it.
+            std::vector<std::string> newly_auto_enabled(const std::string &mod_id,
+                const std::function<std::vector<Dependency>(const std::string &)> &dependencies_of, std::unordered_set<std::string> &auto_enabled);
+        }
+    }
+}
+
+#endif
diff --git a/librecomp/include/librecomp/mod_folder_rules.hpp b/librecomp/include/librecomp/mod_folder_rules.hpp
new file mode 100644
index 0000000..84f67bb
--- /dev/null
+++ b/librecomp/include/librecomp/mod_folder_rules.hpp
@@ -0,0 +1,37 @@
+#ifndef __RECOMP_MOD_FOLDER_RULES_HPP__
+#define __RECOMP_MOD_FOLDER_RULES_HPP__
+
+// [wcw] Pure rule for folders in the mods folder that have no mod.json (aki-roadmap#48): a folder holding the content
+// file of a container type that needs no manifest (a texture pack's rt64.json, the .rtz container) opens as that kind
+// of mod, named after the folder, exactly as the zipped container would. Unit tested in tests/wcw/mod_folder_rules_tests.cpp.
+
+#include <cstddef>
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace recomp {
+    namespace mods {
+        namespace folder_rules {
+            // A registered container type: the content types it may hold (empty = any) and whether it needs a mod.json.
+            struct Container {
+                std::vector<size_t> content_types;
+                bool requires_manifest = true;
+            };
+
+            // The content types a folder without a mod.json opens with: every type allowed by a manifest-less container
+            // whose content file (content_filenames[type]) the folder holds. Empty = the folder isn't such a mod (it
+            // then needs a mod.json, as before). Containers that allow any content don't count (no content file to
+            // look for), and each type appears once, in registration order.
+            std::vector<size_t> manifestless_folder_types(const std::vector<Container> &containers,
+                const std::vector<std::string> &content_filenames, const std::function<bool(const std::string &)> &has_file);
+
+            // The mod id (and display name) of a mod without a mod.json, from its file or folder name: a folder keeps
+            // its whole name ("pack.v2"), a container file drops its extension ("pack.v2.rtz" is "pack.v2"). Folders
+            // used to lose everything after their last dot (aki-roadmap#100).
+            std::string manifestless_mod_id(const std::string &file_name, bool is_directory);
+        }
+    }
+}
+
+#endif
