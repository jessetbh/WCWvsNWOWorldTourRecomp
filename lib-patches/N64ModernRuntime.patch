+            return true;
+        }
+        if (std::chrono::steady_clock::now() >= deadline) {
+            fprintf(stderr, "[wcw] shutdown: %d of %d game threads stopped; keeping rdram mapped\n", parked, live);
+            return false;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(5));
+    }
+}
