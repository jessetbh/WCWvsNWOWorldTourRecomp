@@ -0,0 +1,10 @@
+// How the provider's opaque key maps to the Rice and Jabo names (aki-roadmap#93), for the provider and its tests.
+
+#pragma once
+
+#include "common/rt64_texture_names.h"
+#include "wcw_rice.h"
+
+namespace wcw_texnames {
+    WcwRice::TextureKey decodeKey(const RT64::TextureNameKey &key);
+};
diff --git a/texnames/src/wcw_rice.cpp b/texnames/src/wcw_rice.cpp
new file mode 100644
index 0000000..8c08484
--- /dev/null
+++ b/texnames/src/wcw_rice.cpp
@@ -0,0 +1,485 @@
+// Rice / GLideN64 texture pack names (aki-roadmap#93). See wcw_rice.h. The hashing follows GLideN64 (GPL; upstream
+// RT64's texture_hasher carries the same code and licence note).
+
+#include "wcw_rice.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace wcw_texnames {
+    namespace WcwRice {
+        static std::string toLower(std::string str) {
+            std::transform(str.begin(), str.end(), str.begin(), [](unsigned char ch) { return char(std::tolower(ch)); });
+            return str;
+        }
+
+        static bool parseHex(const std::string &str, size_t digits, uint32_t &value) {
+            if ((digits == 0) || (str.size() != digits)) {
+                return false;
+            }
+
+            value = 0;
+            for (char ch : str) {
+                const int c = std::tolower((unsigned char)(ch));
+                uint32_t d;
+                if ((c >= '0') && (c <= '9')) {
+                    d = uint32_t(c - '0');
+                }
+                else if ((c >= 'a') && (c <= 'f')) {
+                    d = uint32_t(c - 'a' + 10);
+                }
+                else {
+                    return false;
+                }
+
+                value = (value << 4) | d;
+            }
+
+            return true;
+        }
+
+        bool parseFileName(const std::string &fileName, ParsedName &parsed) {
+            const std::string lower = toLower(fileName);
+            const size_t dot = lower.find_last_of('.');
+            if (dot == std::string::npos) {
+                return false;
+            }
+
+            const std::string extension = lower.substr(dot);
+            if ((extension != ".png") && (extension != ".bmp") && (extension != ".dds")) {
+                return false;
+            }
+
+            const size_t firstHash = lower.find('#');
+            const size_t underscore = lower.find_last_of('_');
+            if ((firstHash == std::string::npos) || (underscore == std::string::npos) || (underscore < firstHash) || (underscore > dot)) {
+                return false;
+            }
+
+            const std::string suffix = lower.substr(underscore + 1, dot - underscore - 1);
+            if (suffix == "all") parsed.suffix = Suffix::All;
+            else if (suffix == "cibyrgba") parsed.suffix = Suffix::CiByRGBA;
+            else if (suffix == "allcibyrgba") parsed.suffix = Suffix::AllCiByRGBA;
+            else if (suffix == "rgb") parsed.suffix = Suffix::Rgb;
+            else if (suffix == "a") parsed.suffix = Suffix::Alpha;
+            else if (suffix == "ci") parsed.suffix = Suffix::Ci;
+            else return false;
+
+            // Fields between the first '#' and the suffix: crc, fmt, siz and the optional palette crc.
+            std::vector<std::string> fields;
+            size_t start = firstHash + 1;
+            const std::string body = lower.substr(0, underscore);
+            while (true) {
+                const size_t next = body.find('#', start);
+                if (next == std::string::npos) {
+                    fields.emplace_back(body.substr(start));
+                    break;
+                }
+
+                fields.emplace_back(body.substr(start, next - start));
+                start = next + 1;
+            }
+
+            if ((fields.size() != 3) && (fields.size() != 4)) {
+                return false;
+            }
+
+            Key key;
+            if ((fields[1] == "$") && (fields[2] == "$")) {
+                // crc#$#$[#palcrc]: any format and size.
+                if (!parseHex(fields[0], 8, key.crc) || (key.crc == 0)) {
+                    return false;
+                }
+
+                if (fields.size() == 3) {
+                    key.kind = KeyAnyFormat;
+                }
+                else if (parseHex(fields[3], 8, key.paletteCrc)) {
+                    key.kind = KeyAnyFormatPalette;
+                }
+                else {
+                    return false;
+                }
+
+                parsed.romName = fileName.substr(0, firstHash);
+                parsed.key = key;
+                return true;
+            }
+
+            uint32_t fmt = 0, siz = 0;
+            if (!parseHex(fields[1], 1, fmt) || !parseHex(fields[2], 1, siz) || (siz > 3)) {
+                return false;
+            }
+
+            key.fmt = uint8_t(fmt);
+            key.siz = uint8_t(siz);
+            const bool crcWildcard = (fields[0] == "$");
+            if (crcWildcard) {
+                // Only "$#fmt#siz#palcrc".
+                if ((fields.size() != 4) || !parseHex(fields[3], 8, key.paletteCrc)) {
+                    return false;
+                }
+
+                key.kind = KeyAnyTexture;
+            }
+            else {
+                if (!parseHex(fields[0], 8, key.crc) || (key.crc == 0)) {
+                    return false;
+                }
+
+                if (fields.size() == 3) {
+                    key.kind = KeyNoPalette;
+                }
+                else if (fields[3] == "$") {
+                    key.kind = KeyAnyPalette;
+                }
+                else if (parseHex(fields[3], 8, key.paletteCrc)) {
+                    key.kind = KeyPalette;
+                }
+                else {
+                    return false;
+                }
+            }
+
+            parsed.romName = fileName.substr(0, firstHash);
+            parsed.key = key;
+            return true;
+        }
+
+        std::string keyToString(const Key &key) {
+            char buf[48];
+            switch (key.kind) {
+            case KeyPalette:
+                snprintf(buf, sizeof(buf), "%08x#%u#%u#%08x", key.crc, key.fmt, key.siz, key.paletteCrc);
+                break;
+            case KeyAnyPalette:
+                snprintf(buf, sizeof(buf), "%08x#%u#%u#$", key.crc, key.fmt, key.siz);
+                break;
+            case KeyAnyTexture:
+                snprintf(buf, sizeof(buf), "$#%u#%u#%08x", key.fmt, key.siz, key.paletteCrc);
+                break;
+            case KeyAnyFormat:
+                snprintf(buf, sizeof(buf), "%08x#$#$", key.crc);
+                break;
+            case KeyAnyFormatPalette:
+                snprintf(buf, sizeof(buf), "%08x#$#$#%08x", key.crc, key.paletteCrc);
+                break;
+            default:
+                snprintf(buf, sizeof(buf), "%08x#%u#%u", key.crc, key.fmt, key.siz);
+                break;
+            }
+
+            return std::string(buf);
+        }
+
+        std::string textureKeyToString(const TextureKey &textureKey) {
+            Key key;
+            key.crc = textureKey.crc;
+            key.paletteCrc = textureKey.paletteCrc;
+            key.fmt = textureKey.fmt;
+            key.siz = textureKey.siz;
+            key.kind = textureKey.hasPalette ? KeyPalette : KeyNoPalette;
+            return keyToString(key);
+        }
+
+        bool pathLess(const std::string &a, const std::string &b) {
+            return std::lexicographical_compare(a.begin(), a.end(), b.begin(), b.end(), [](unsigned char x, unsigned char y) {
+                return std::tolower(x) < std::tolower(y);
+            });
+        }
+
+        bool logEnabled() {
+            static const bool enabled = []() {
+                const char *value = getenv("WCW_RICE_LOG");
+                return (value != nullptr) && (value[0] != '\0') && (value[0] != '0');
+            }();
+
+            return enabled;
+        }
+
+        bool Index::add(const std::string &relativePath) {
+            const size_t slash = relativePath.find_last_of("/\\");
+            const std::string fileName = (slash == std::string::npos) ? relativePath : relativePath.substr(slash + 1);
+            ParsedName parsed;
+            if (!parseFileName(fileName, parsed)) {
+                return false;
+            }
+
+            const std::string lowerPath = toLower(relativePath);
+            const bool bmpFile = (lowerPath.size() >= 4) && (lowerPath.compare(lowerPath.size() - 4, 4, ".bmp") == 0);
+            // Rice _ci.bmp files are 8-bit colour indices meant for the game's TLUT; decoding them through the BMP's own
+            // palette (no alpha) would draw wrong or opaque texels, so they stay unindexed and the game's texture shows.
+            if ((parsed.suffix == Suffix::Ci) && bmpFile) {
+                return true;
+            }
+
+            if (parsed.suffix == Suffix::Alpha) {
+                const std::string &lower = lowerPath;
+                const size_t suffix = lower.rfind("_a.");
+                if ((suffix != std::string::npos) && ((lower.compare(lower.size() - 4, 4, ".png") == 0) || bmpFile)) {
+                    alphaTwins.emplace(lower.substr(0, suffix), relativePath);
+                }
+
+                return true;
+            }
+
+            auto it = entries.find(parsed.key);
+            if (it == entries.end()) {
+                entries.emplace(parsed.key, Entry{ relativePath, parsed.suffix });
+            }
+            else if ((it->second.suffix == Suffix::Rgb) && (parsed.suffix != Suffix::Rgb)) {
+                // A whole-texture file beats an _rgb file without its alpha.
+                it->second = Entry{ relativePath, parsed.suffix };
+            }
+
+            return true;
+        }
+
+        const std::string *Index::alphaFor(const std::string &rgbPath) const {
+            if (!isRgbFile(rgbPath)) {
+                return nullptr;
+            }
+
+            const std::string lower = toLower(rgbPath);
+            auto it = alphaTwins.find(lower.substr(0, lower.rfind("_rgb.")));
+            return (it != alphaTwins.end()) ? &it->second : nullptr;
+        }
+
+        bool isRgbFile(const std::string &relativePath) {
+            const size_t slash = relativePath.find_last_of("/\\");
+            ParsedName parsed;
+            return parseFileName((slash == std::string::npos) ? relativePath : relativePath.substr(slash + 1), parsed) && (parsed.suffix == Suffix::Rgb);
+        }
+
+        void mergeAlpha(uint8_t *rgba, const uint8_t *alphaRgba, size_t pixelCount) {
+            for (size_t i = 0; i < pixelCount; i++) {
+                rgba[i * 4 + 3] = alphaRgba[i * 4];
+            }
+        }
+
+        void makeOpaque(uint8_t *rgba, size_t pixelCount) {
+            for (size_t i = 0; i < pixelCount; i++) {
+                rgba[i * 4 + 3] = 0xFF;
+            }
+        }
+
+        const std::string *Index::find(uint32_t crc, uint32_t paletteCrc, uint8_t fmt, uint8_t siz, bool hasPalette) const {
+            auto lookup = [&](uint32_t c, uint32_t p, uint8_t kind) -> const std::string * {
+                Key key;
+                key.crc = c;
+                key.paletteCrc = p;
+                const bool anyFormat = (kind == KeyAnyFormat) || (kind == KeyAnyFormatPalette);
+                key.fmt = anyFormat ? 0 : fmt;
+                key.siz = anyFormat ? 0 : siz;
+                key.kind = kind;
+                auto it = entries.find(key);
+                return (it != entries.end()) ? &it->second.path : nullptr;
+            };
+
+            const std::string *path = nullptr;
+            if (hasPalette) {
+                if ((path = lookup(crc, paletteCrc, KeyPalette)) != nullptr) return path;
+                // Packs dumped with Rice Video name TLUT textures in non-CI formats (IA8 + TLUT in No Mercy) with a
+                // zero palette CRC (TNA vs ROH: all 29 such files).
+                if ((paletteCrc != 0) && (path = lookup(crc, 0, KeyPalette)) != nullptr) return path;
+                if ((path = lookup(crc, 0, KeyAnyPalette)) != nullptr) return path;
+                if ((path = lookup(crc, 0, KeyNoPalette)) != nullptr) return path;
+                if ((path = lookup(0, paletteCrc, KeyAnyTexture)) != nullptr) return path;
+                if ((path = lookup(crc, paletteCrc, KeyAnyFormatPalette)) != nullptr) return path;
+                if ((path = lookup(crc, 0, KeyAnyFormat)) != nullptr) return path;
+            }
+            else {
+                if ((path = lookup(crc, 0, KeyNoPalette)) != nullptr) return path;
+                if ((path = lookup(crc, 0, KeyAnyPalette)) != nullptr) return path;
+                if ((path = lookup(crc, 0, KeyAnyFormat)) != nullptr) return path;
+            }
+
+            return nullptr;
+        }
+
+        uint32_t riceCRC32(const uint8_t *src, int width, int height, int size, int rowStride) {
+            uint32_t crc = 0;
+            const int bytesPerLine = int(uint32_t(width) << size >> 1);
+            int y = height - 1;
+            do {
+                uint32_t esi = 0;
+                int x = bytesPerLine - 4;
+                do {
+                    memcpy(&esi, src + x, sizeof(esi));
+                    esi ^= uint32_t(x);
+                    crc = (crc << 4) + ((crc >> 28) & 15);
+                    crc += esi;
+                    x -= 4;
+                } while (x >= 0);
+
+                esi ^= uint32_t(y);
+                crc += esi;
+                src += rowStride;
+                --y;
+            } while (y >= 0);
+
+            return crc;
+        }
+
+        uint8_t maxCI8(const uint8_t *src, uint32_t width, uint32_t height, uint32_t rowStride) {
+            uint8_t val = 0;
+            for (uint32_t y = 0; y < height; ++y) {
+                const uint8_t *buf = src + rowStride * y;
+                for (uint32_t x = 0; x < width; ++x) {
+                    val = std::max(val, buf[x]);
+                    if (val == 0xFF) {
+                        return val;
+                    }
+                }
+            }
+
+            return val;
+        }
+
+        uint8_t maxCI4(const uint8_t *src, uint32_t width, uint32_t height, uint32_t rowStride) {
+            uint8_t val = 0;
+            width >>= 1;
+            for (uint32_t y = 0; y < height; ++y) {
+                const uint8_t *buf = src + rowStride * y;
+                for (uint32_t x = 0; x < width; ++x) {
+                    val = std::max(val, uint8_t(buf[x] >> 4));
+                    val = std::max(val, uint8_t(buf[x] & 0xF));
+                    if (val == 0xF) {
+                        return val;
+                    }
+                }
+            }
+
+            return val;
+        }
+
+        static uint32_t calculateDXT(uint32_t txl2words) {
+            return (txl2words == 0) ? 1U : (2048 + txl2words - 1) / txl2words;
+        }
+
+        static uint32_t txl2Words(uint32_t width, uint32_t size) {
+            static const uint32_t sizeBytes[4] = { 0, 1, 2, 4 };
+            return (size == 0) ? std::max(1U, width / 16) : std::max(1U, width * sizeBytes[size & 3] / 8);
+        }
+
+        static uint32_t reverseDXT(uint32_t val, uint32_t width, uint32_t size) {
+            if (val == 0x800) {
+                return 1;
+            }
+
+            int low = 2047 / int(val);
+            if (calculateDXT(uint32_t(low)) > val) {
+                low++;
+            }
+
+            const int high = 2047 / int(val - 1);
+            if (low == high) {
+                return uint32_t(low);
+            }
+
+            for (int i = low; i <= high; i++) {
+                if (txl2Words(width, size) == uint32_t(i)) {
+                    return uint32_t(i);
+                }
+            }
+
+            return uint32_t((low + high) / 2);
+        }
+
+        bool computeGeometry(const Load &load, const DrawTile &drawTile, Geometry &geometry) {
+            int width = 0, height = 0, bpl = 0;
+            uint32_t start = 0;
+            const uint32_t bytesOffset = uint32_t(load.uls >> 2) << load.textureSiz >> 1;
+            const uint32_t bytesPerRow = uint32_t(load.textureWidth) << load.textureSiz >> 1;
+            if (load.type == LoadType::Tile) {
+                // Rice's width is ((lrs - uls) >> 2) + 1, not (lrs >> 2) - (uls >> 2) + 1: they differ by one when the load
+                // starts on a half texel (aki-roadmap#204: No Mercy's string textures load 64-px chunks from uls 31.5, and
+                // Legends' blanking art for the Rumble Pak text is named by the 33-wide key). The height keeps the per-edge
+                // rounding: no pack has shown a half-texel ult yet.
+                int tileWidth = (std::max((load.lrs - load.uls) >> 2, 0) + 1) & 0x03FF;
+                const int tileHeight = (std::max((load.lrt >> 2) - (load.ult >> 2), 0) + 1) & 0x03FF;
+                if (load.masks != 0) {
+                    tileWidth = std::min(tileWidth, 1 << load.masks);
+                }
+
+                bpl = int(bytesPerRow);
+                width = std::min(tileWidth, int(load.textureWidth));
+                if (load.siz > drawTile.siz) {
+                    width <<= (load.siz - drawTile.siz);
+                }
+
+                height = (load.maskt != 0) ? std::min(tileHeight, 1 << load.maskt) : tileHeight;
+                start = load.address + bytesOffset + bytesPerRow * uint32_t(load.ult >> 2);
+            }
+            else if (load.type == LoadType::Block) {
+                const int tileWidth = std::max((drawTile.lrs >> 2) - (drawTile.uls >> 2), 0) + 1;
+                const int tileHeight = std::max((drawTile.lrt >> 2) - (drawTile.ult >> 2), 0) + 1;
+                const int maskWidth = (drawTile.masks == 0) ? tileWidth : (1 << drawTile.masks);
+                const int maskHeight = (drawTile.maskt == 0) ? tileHeight : (1 << drawTile.maskt);
+                const bool clampS = (drawTile.masks == 0) || (drawTile.cms & 2);
+                const bool clampT = (drawTile.maskt == 0) || (drawTile.cmt & 2);
+                width = (clampS && (tileWidth <= 256)) ? std::min(maskWidth, tileWidth) : maskWidth;
+                height = ((clampT && (tileHeight <= 256)) || (maskHeight > 256)) ? std::min(maskHeight, tileHeight) : maskHeight;
+                if (drawTile.siz == 3) {
+                    bpl = int(drawTile.line) << 4;
+                }
+                else if (load.lrt == 0) {
+                    bpl = int(drawTile.line) << 3;
+                }
+                else {
+                    uint32_t dxt = load.lrt;
+                    if (dxt > 1) {
+                        dxt = reverseDXT(dxt, load.textureWidth, load.textureSiz);
+                    }
+
+                    bpl = int(dxt << 3);
+                }
+
+                start = load.address + bytesOffset + bytesPerRow * uint32_t(load.ult);
+            }
+            else {
+                return false;
+            }
+
+            if ((width <= 0) || (height <= 0) || (bpl <= 0)) {
+                return false;
+            }
+
+            geometry.width = width;
+            geometry.height = height;
+            geometry.bytesPerRow = bpl;
+            geometry.rdramStart = start;
+            geometry.bytesRead = uint64_t(height - 1) * uint64_t(bpl) + (uint64_t(width) << drawTile.siz >> 1);
+            return true;
+        }
+
+        bool usesPalette(uint8_t fmt, uint8_t siz, bool tlutEnabled) {
+            return (siz < 2) && (tlutEnabled || (fmt == 2));
+        }
+
+        bool paletteEntryAddress(const std::vector<PaletteLoad> &loads, uint32_t entry, uint32_t &address) {
+            const PaletteLoad *best = nullptr;
+            for (const PaletteLoad &load : loads) {
+                if ((entry >= load.firstEntry) && (entry < (load.firstEntry + load.count))) {
+                    if ((best == nullptr) || (load.sequence > best->sequence)) {
+                        best = &load;
+                    }
+                }
+            }
+
+            if (best == nullptr) {
+                return false;
+            }
+
+            address = best->address + (entry - best->firstEntry) * 2;
+            return true;
+        }
+
+        uint32_t paletteCRC(const uint8_t *paletteWithGuard, uint32_t firstEntry, uint32_t entryCount, bool ci4) {
+            return riceCRC32(paletteWithGuard + 4 + firstEntry * 2, int(entryCount), 1, 2, ci4 ? 32 : 512);
+        }
+    };
+};
diff --git a/texnames/src/wcw_rice.h b/texnames/src/wcw_rice.h
new file mode 100644
index 0000000..9e98844
--- /dev/null
+++ b/texnames/src/wcw_rice.h
@@ -0,0 +1,219 @@
+// Rice / GLideN64 hi-res texture pack names, matched at runtime (aki-roadmap#93). Legacy N64 texture packs name
+// each PNG after the texture's "Rice CRC": <rom name>#<crc32>#<fmt>#<siz>[#<palette crc32>]_<suffix>.png. This file
+// holds the pure parts, unit tested in tests/wcw_rice_tests.cpp:
+//   - parsing those file names (and GLideN64's '$' wildcards);
+//   - an index of a pack's files by key, with GLideN64's lookup and duplicate rules;
+//   - the Rice CRC itself over a byte buffer, the CI max index scan, and the texture geometry (width, height, bytes per
+//     row, RDRAM start) Rice derives from the last load into the tile's TMEM address;
+//   - which TLUT load supplies each palette entry (GLideN64 keeps a 256-entry copy of every palette loaded).
+// wcw_provider.cpp computes a texture's key from the inputs rt64 gathers, and calls these.
+//
+// The hashing follows GLideN64 (src/GLideNHQ/TxUtil.cpp RiceCRC32 / checksum64, src/Textures.cpp _loadHiresTexture,
+// src/GLideNHQ/TxHiResLoader.cpp checkFileName), which cites Rice Video. Upstream RT64 already ships the same
+// computation in src/tools/texture_hasher (GPL, see GLIDEN64-LICENSE there).
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace wcw_texnames {
+    namespace WcwRice {
+        // A pack file's key. Flags say which parts are present or wildcards ('$' in the name).
+        enum KeyKind : uint8_t {
+            KeyNoPalette = 0,      // crc#fmt#siz
+            KeyPalette = 1,        // crc#fmt#siz#palcrc
+            KeyAnyPalette = 2,     // crc#fmt#siz#$
+            KeyAnyTexture = 3,     // $#fmt#siz#palcrc
+            // Any format and size: GLideN64's older texture caches (.hts without the N64 format/size) only keep the
+            // CRCs, so packs exported from them name files crc#$#$[#palcrc]. Tried after every exact form.
+            KeyAnyFormat = 4,          // crc#$#$
+            KeyAnyFormatPalette = 5,   // crc#$#$#palcrc
+        };
+
+        struct Key {
+            uint32_t crc = 0;
+            uint32_t paletteCrc = 0;
+            uint8_t fmt = 0;
+            uint8_t siz = 0;
+            uint8_t kind = KeyNoPalette;
+
+            bool operator==(const Key &other) const {
+                return (crc == other.crc) && (paletteCrc == other.paletteCrc) && (fmt == other.fmt) && (siz == other.siz) && (kind == other.kind);
+            }
+        };
+
+        struct KeyHasher {
+            size_t operator()(const Key &key) const {
+                uint64_t v = (uint64_t(key.crc) << 32) ^ uint64_t(key.paletteCrc) ^ (uint64_t(key.fmt) << 8) ^ (uint64_t(key.siz) << 4) ^ uint64_t(key.kind);
+                v ^= v >> 33;
+                v *= 0xff51afd7ed558ccdULL;
+                v ^= v >> 33;
+                return size_t(v);
+            }
+        };
+
+        // File name suffixes (GLideN64 TxHiResLoader): _all / _ciByRGBA / _allciByRGBA hold the whole texture; _rgb
+        // the color with an optional _a alpha twin; _ci is a paletted BMP.
+        enum class Suffix : uint8_t {
+            All,
+            CiByRGBA,
+            AllCiByRGBA,
+            Rgb,
+            Alpha,
+            Ci,
+        };
+
+        // The Rice key computed for a texture at upload time (wcw_provider.cpp), kept with the texture so packs
+        // enabled later can match it too.
+        struct TextureKey {
+            bool valid = false;
+            bool hasPalette = false;
+            uint8_t fmt = 0;
+            uint8_t siz = 0;
+            uint32_t crc = 0;
+            uint32_t paletteCrc = 0;
+            // The Jabo Direct3D8 name of the same texture (wcw_jabo.h): MD5, 16 bytes.
+            bool jaboValid = false;
+            uint8_t jabo[16] = {};
+        };
+
+        struct ParsedName {
+            std::string romName;   // The part before the first '#' (the ROM's internal name, e.g. "WWF No Mercy").
+            Key key;
+            Suffix suffix = Suffix::All;
+        };
+
+        // Parses a file name (no directory) in Rice's convention, case-insensitively, with a .png/.bmp/.dds
+        // extension. Returns false for anything else, and, like GLideN64, for a zero CRC without a wildcard.
+        bool parseFileName(const std::string &fileName, ParsedName &parsed);
+
+        // "crc#fmt#siz[#palcrc]" in lowercase hex (wildcards as '$'), for logs.
+        std::string keyToString(const Key &key);
+        std::string textureKeyToString(const TextureKey &key);
+
+        // Case-insensitive path order (the order GLideN64 meets files in on Windows).
+        bool pathLess(const std::string &a, const std::string &b);
+
+        // WCW_RICE_LOG=1 logs every Rice match and every texture's computed key (otherwise only the first matches).
+        bool logEnabled();
+
+        // A texture pack's Rice-named files. Feed it the pack's relative paths; like GLideN64, the first file added for
+        // a key wins (add them in case-insensitive path order) and a whole-texture file beats an _rgb one for the same
+        // key. An _rgb file's alpha comes from its _a twin (same folder and name, "_a" for "_rgb"), see alphaFor.
+        class Index {
+        public:
+            // Returns true when the path was a Rice name (whether or not it won its key).
+            bool add(const std::string &relativePath);
+            bool empty() const { return entries.empty(); }
+            size_t size() const { return entries.size(); }
+
+            // For an _rgb file: its _a twin's path, or nullptr when the pack has none (GLideN64 then treats the
+            // texture as opaque). PNG and BMP twins count. nullptr for any other file.
+            const std::string *alphaFor(const std::string &rgbPath) const;
+
+            // The best file for a texture: exact key with palette, crc#fmt#siz#00000000 (Rice Video names TLUT textures
+            // in non-CI formats with a zero palette CRC), crc#fmt#siz#$, crc#fmt#siz (packs that name CI
+            // textures without a palette CRC), then $#fmt#siz#palcrc. hasPalette = the texture is paletted (CI4/CI8 or
+            // TLUT on). Returns nullptr when nothing matches.
+            const std::string *find(uint32_t crc, uint32_t paletteCrc, uint8_t fmt, uint8_t siz, bool hasPalette) const;
+
+        private:
+            struct Entry {
+                std::string path;
+                Suffix suffix;
+            };
+
+            std::unordered_map<Key, Entry, KeyHasher> entries;
+            // Lowercase path up to the suffix ("dir/name#...#..") -> the _a file's path.
+            std::unordered_map<std::string, std::string> alphaTwins;
+        };
+
+        // Whether a path names a Rice _rgb file (the color half of an _rgb + _a pair).
+        bool isRgbFile(const std::string &relativePath);
+
+        // GLideN64's _rgb + _a merge (TxHiResLoader.cpp: "use R comp for alpha. this is what Rice uses"): every pixel
+        // of 'rgba' (RGBA8) takes the R component of the same pixel of 'alphaRgba' (RGBA8) as its alpha. Both hold
+        // 'pixelCount' pixels; the caller rejects the pair when their sizes differ, as GLideN64 does.
+        void mergeAlpha(uint8_t *rgba, const uint8_t *alphaRgba, size_t pixelCount);
+
+        // An _rgb file without its _a twin is drawn opaque (GLideN64: "treat as opaque texture").
+        void makeOpaque(uint8_t *rgba, size_t pixelCount);
+
+        // Rice Video packs ship _all.bmp / _rgb.bmp / _a.bmp / ciByRGBA.bmp files, which rt64 loads. _ci.bmp files (colour
+        // indices for the game's TLUT) are not indexed (Index::add).
+
+        // Rice's CRC (RiceCRC32 in GLideN64's TxUtil.cpp, Rice Video's CalculateRDRAMCRC): rows from the last to the first,
+        // 32-bit words from the end of the row to its start, each XORed with its byte offset, rotated in; the row's
+        // last word XOR its row index is added again. Words are read in host order from the emulator's
+        // byte-swapped RDRAM (the recomp keeps RDRAM in the same layout). Like the original do-while loop, a row
+        // shorter than 4 bytes still reads one word, at a negative offset: src must stay readable 4 bytes before.
+        uint32_t riceCRC32(const uint8_t *src, int width, int height, int size, int rowStride);
+
+        // Highest palette index a CI4 / CI8 texture uses (GLideN64 CalculateMaxCI4b / CalculateMaxCI8b), over raw
+        // RDRAM bytes as stored.
+        uint8_t maxCI4(const uint8_t *src, uint32_t width, uint32_t height, uint32_t rowStride);
+        uint8_t maxCI8(const uint8_t *src, uint32_t width, uint32_t height, uint32_t rowStride);
+
+        // The last load into the tile's TMEM address, reduced to what Rice uses.
+        enum class LoadType : uint8_t { None, Tile, Block, TLUT };
+        struct Load {
+            LoadType type = LoadType::None;
+            // Load tile (10.2 fixed point coordinates as the RDP gets them; a block load's lrt holds dxt).
+            uint8_t siz = 0;
+            uint8_t masks = 0;
+            uint8_t maskt = 0;
+            uint16_t uls = 0, ult = 0, lrs = 0, lrt = 0;
+            // Texture image (SetTextureImage).
+            uint32_t address = 0;
+            uint8_t textureSiz = 0;
+            uint16_t textureWidth = 0;
+        };
+
+        // The tile the texture is drawn with.
+        struct DrawTile {
+            uint8_t fmt = 0;
+            uint8_t siz = 0;
+            uint16_t line = 0;
+            uint8_t palette = 0;
+            uint8_t cms = 0, cmt = 0;
+            uint8_t masks = 0, maskt = 0;
+            uint16_t uls = 0, ult = 0, lrs = 0, lrt = 0;
+        };
+
+        struct Geometry {
+            int width = 0;
+            int height = 0;
+            int bytesPerRow = 0;
+            uint32_t rdramStart = 0;
+            // Bytes from rdramStart that the CRC reads: (height - 1) rows plus one row of the texture.
+            uint64_t bytesRead = 0;
+        };
+
+        // The rectangle Rice hashes (GLideN64 _loadHiresTexture). False for no load, a TLUT load or empty sizes.
+        bool computeGeometry(const Load &load, const DrawTile &drawTile, Geometry &geometry);
+
+        // Whether a texture's key carries a palette CRC: 4/8-bit texels with a TLUT or the CI format (GLideN64).
+        bool usesPalette(uint8_t fmt, uint8_t siz, bool tlutEnabled);
+
+        // A TLUT load seen at palette TMEM entry 'firstEntry' (TMEM word - 256): 'count' 16-bit entries from
+        // RDRAM 'address', loaded in order 'sequence' (higher = newer).
+        struct PaletteLoad {
+            uint32_t firstEntry = 0;
+            uint32_t count = 0;
+            uint32_t address = 0;
+            uint64_t sequence = 0;
+        };
+
+        // GLideN64 copies every TLUT load into a 256-entry palette (gDP.TexFilterPalette) and hashes from there. For
+        // an entry index, the newest load covering it gives its RDRAM byte address. False when no load covers it.
+        bool paletteEntryAddress(const std::vector<PaletteLoad> &loads, uint32_t entry, uint32_t &address);
+
+        // Palette CRC over entries [first, first + count) of that palette (copied into 'palette', 2 bytes each, raw
+        // RDRAM byte order): RiceCRC32(palette + first, cimax + 1, 1, 2, stride) as GLideN64 does. 'palette' is the
+        // full 256-entry copy plus a 4-byte zero guard in front (see riceCRC32), so pass 4 + 512 bytes.
+        uint32_t paletteCRC(const uint8_t *paletteWithGuard, uint32_t firstEntry, uint32_t entryCount, bool ci4);
+    };
+};
