@@ -0,0 +1,77 @@
+//
+// librecomp
+//
+
+// [wcw] Unit tests for librecomp/stall_rules (aki-roadmap#187): when the stall watchdog dumps.
+
+#include "librecomp/stall_rules.hpp"
+
+#include "wcw_test.h"
+
+using namespace recomp::stall;
+
+TEST_CASE("stall: boot waits before the first frame don't count") {
+    Detector d{ 5.0 };
+    CHECK(d.update(0.0, 0) == Event::None);
+    CHECK(d.update(100.0, 0) == Event::None);
+    CHECK(d.stalled_for() == 0.0);
+}
+
+TEST_CASE("stall: dumps at 1x, 3x and 12x the threshold, then stays quiet") {
+    Detector d{ 5.0 };
+    d.update(0.0, 1);
+    d.update(1.0, 2);
+    CHECK(d.update(5.9, 2) == Event::None);
+    CHECK(d.update(6.0, 2) == Event::Dump);
+    CHECK(d.update(6.5, 2) == Event::None);
+    CHECK(d.update(16.0, 2) == Event::Dump);
+    CHECK(d.update(61.0, 2) == Event::Dump);
+    CHECK(d.dumps_this_stall() == 3);
+    CHECK(d.update(1000.0, 2) == Event::None);
+    CHECK_NEAR(d.stalled_for(), 999.0, 0.001);
+}
+
+TEST_CASE("stall: frames coming back after a dump report the stall's length, and the next stall dumps again") {
+    Detector d{ 5.0 };
+    d.update(0.0, 1);
+    CHECK(d.update(5.0, 1) == Event::Dump);
+    CHECK(d.update(7.0, 2) == Event::Resumed);
+    CHECK_NEAR(d.stalled_for(), 5.0, 0.001);
+    CHECK(d.dumps_this_stall() == 0);
+    CHECK(d.update(8.0, 3) == Event::None);
+    CHECK(d.stalled_for() == 0.0);
+    CHECK(d.update(13.0, 3) == Event::Dump);
+}
+
+TEST_CASE("stall: a short wait with no dump isn't reported as resumed") {
+    Detector d{ 5.0 };
+    d.update(0.0, 1);
+    CHECK(d.update(4.0, 1) == Event::None);
+    CHECK(d.update(4.5, 2) == Event::None);
+}
+
+TEST_CASE("stall: a run's dumps are capped") {
+    Detector d{ 1.0 };
+    d.update(0.0, 1);
+    double now = 0;
+    uint64_t frames = 1;
+    int dumps = 0;
+    for (int stall = 0; stall < 20; stall++) {
+        now += 1.0;
+        if (d.update(now, frames) == Event::Dump) dumps++;
+        frames++;
+        now += 0.01;
+        d.update(now, frames);
+    }
+    CHECK(dumps == MaxDumpsPerRun);
+}
+
+TEST_CASE("stall: threshold parsing") {
+    CHECK(parse_threshold(nullptr) == 0.0);
+    CHECK(parse_threshold("") == 0.0);
+    CHECK(parse_threshold("junk") == 0.0);
+    CHECK(parse_threshold("0") == 0.0);
+    CHECK(parse_threshold("-3") == 0.0);
+    CHECK_NEAR(parse_threshold("5"), 5.0, 0.001);
+    CHECK_NEAR(parse_threshold("0.25"), 0.25, 0.001);
+}
diff --git a/librecomp/tests/wcw/startup_shutdown_tests.cpp b/librecomp/tests/wcw/startup_shutdown_tests.cpp
new file mode 100644
index 0000000..eeb55c9
--- /dev/null
+++ b/librecomp/tests/wcw/startup_shutdown_tests.cpp
@@ -0,0 +1,120 @@
+//
+// N64ModernRuntime (librecomp)
+//
+
+// [wcw] Unit tests for librecomp/startup_shutdown.hpp (quitting while the game is still starting up). Built and run
+// as part of every librecomp build (LIBRECOMP_WCW_TESTS); a failure fails the build. Each test names the bug it
+// guards against where there was one.
+
+#include "librecomp/startup_shutdown.hpp"
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <mutex>
+#include <thread>
+
+#include "wcw_test.h"
+
+using namespace std::chrono_literals;
+
+namespace {
+    // A cross-thread call that only completes once the owner thread services it, like a Win32 SendMessage to a
+    // window owned by the main thread: the caller blocks until the owner pumps its messages.
+    struct OwnerThreadCall {
+        std::mutex mutex;
+        std::condition_variable cv;
+        bool pending = false;
+        bool serviced = false;
+
+        void call() {
+            std::unique_lock lock{ mutex };
+            pending = true;
+            cv.wait(lock, [this] { return serviced; });
+        }
+
+        void service() {
+            std::lock_guard lock{ mutex };
+            if (pending && !serviced) {
+                serviced = true;
+                cv.notify_all();
+            }
+        }
+    };
+
+    void sleep_1ms() {
+        std::this_thread::sleep_for(1ms);
+    }
+}
+
+TEST_CASE("quit during startup: shutdown completes while the renderer still needs the window (#73 hang)") {
+    // The game start thread (preinit) waits on the gfx thread, which makes a window call that only the main thread
+    // can service. Quit has already been requested, so the main thread has left its normal pump loop: it must keep
+    // pumping until startup is done, then join. The old code went straight to the join and hung forever.
+    OwnerThreadCall window_call;
+    std::atomic_bool startup_done = false;
+    std::thread game_start_thread{ [&] {
+        window_call.call();          // RT64 ApplicationWindow::setFullScreen -> SetWindowLongPtr
+        startup_done.store(true);    // ultramodern::preinit returned
+    } };
+
+    std::atomic_bool shutdown_finished = false;
+    std::thread main_thread{ [&] {
+        recomp::pump_until_startup_done(startup_done, [&] { window_call.service(); }, sleep_1ms);
+        game_start_thread.join();
+        shutdown_finished.store(true);
+    } };
+
+    const auto deadline = std::chrono::steady_clock::now() + 5s;
+    while (!shutdown_finished.load() && std::chrono::steady_clock::now() < deadline) {
+        std::this_thread::sleep_for(1ms);
+    }
+    CHECK(shutdown_finished.load());
+
+    // On failure, break the deadlock ourselves so the test binary still exits and reports.
+    window_call.service();
+    main_thread.join();
+}
+
+TEST_CASE("quit after startup: no extra pumping, shutdown goes straight on as before") {
+    std::atomic_bool startup_done = true;
+    int pumps = 0;
+    int sleeps = 0;
+    recomp::pump_until_startup_done(startup_done, [&] { pumps++; }, [&] { sleeps++; });
+    CHECK_EQ(pumps, 0);
+    CHECK_EQ(sleeps, 0);
+}
+
+TEST_CASE("quit during startup: pumping stops as soon as startup is done") {
+    std::atomic_bool startup_done = false;
+    int pumps = 0;
+    recomp::pump_until_startup_done(startup_done, [&] {
+        pumps++;
+        if (pumps == 3) {
+            startup_done.store(true);
+        }
+    }, [] {});
+    CHECK_EQ(pumps, 3);
+}
+
+TEST_CASE("shutdown with every game thread parked: rdram is freed and start returns to main") {
+    int frees = 0;
+    int ends = 0;
+    recomp::finish_shutdown(true, [&] { frees++; }, [&] { ends++; });
+    CHECK_EQ(frees, 1);
+    CHECK_EQ(ends, 0);
+}
+
+TEST_CASE("shutdown with a game thread still running: the process ends before main's static destructors (#252)") {
+    // A hung conversion's busy loop never parks; returning to main used to run static destructors under it and it
+    // faulted on freed state after "recomp::start returned".
+    int frees = 0;
+    int ends = 0;
+    recomp::finish_shutdown(false, [&] { frees++; }, [&] { ends++; });
+    CHECK_EQ(ends, 1);
+    CHECK_EQ(frees, 0);   // rdram stays mapped: the running thread may still read it
+}
+
+int main() {
+    return WcwTest::runAll("librecomp wcw tests");
+}
diff --git a/librecomp/tests/wcw/wcw_test.h b/librecomp/tests/wcw/wcw_test.h
new file mode 100644
index 0000000..0db070c
--- /dev/null
+++ b/librecomp/tests/wcw/wcw_test.h
@@ -0,0 +1,75 @@
+//
+// N64ModernRuntime (librecomp)
+//
+
+// [wcw] Minimal unit test harness for the wcw tests: TEST_CASE registers a test, CHECK / CHECK_NEAR record failures
+// without stopping the test, and runAll() runs everything and returns the process exit code.
+
+#pragma once
+
+#include <cmath>
+#include <cstdio>
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace WcwTest {
+    struct Case {
+        const char *name;
+        std::function<void()> body;
+    };
+
+    inline std::vector<Case> &cases() {
+        static std::vector<Case> list;
+        return list;
+    }
+
+    inline int &failures() {
+        static int count = 0;
+        return count;
+    }
+
+    struct Registrar {
+        Registrar(const char *name, std::function<void()> body) {
+            cases().push_back({ name, std::move(body) });
+        }
+    };
+
+    inline void fail(const char *file, int line, const std::string &message) {
+        fprintf(stderr, "  FAILED %s:%d: %s\n", file, line, message.c_str());
+        failures()++;
+    }
+
+    inline int runAll(const char *suite) {
+        int failedCases = 0;
+        for (const Case &c : cases()) {
+            const int before = failures();
+            c.body();
+            if (failures() != before) {
+                fprintf(stderr, "[%s] FAIL %s\n", suite, c.name);
+                failedCases++;
+            }
+        }
+
+        fprintf(stderr, "[%s] %zu tests, %d failed\n", suite, cases().size(), failedCases);
+        return (failedCases == 0) ? 0 : 1;
+    }
+};
+
+#define WCW_TEST_CONCAT2(a, b) a##b
+#define WCW_TEST_CONCAT(a, b) WCW_TEST_CONCAT2(a, b)
+#define TEST_CASE(name) \
+    static void WCW_TEST_CONCAT(wcwTest_, __LINE__)(); \
+    static WcwTest::Registrar WCW_TEST_CONCAT(wcwTestRegistrar_, __LINE__)(name, WCW_TEST_CONCAT(wcwTest_, __LINE__)); \
+    static void WCW_TEST_CONCAT(wcwTest_, __LINE__)()
+
+#define CHECK(expr) \
+    do { if (!(expr)) { WcwTest::fail(__FILE__, __LINE__, #expr); } } while (0)
+
+#define CHECK_EQ(a, b) \
+    do { const auto wcwA = (a); const auto wcwB = (b); if (!(wcwA == wcwB)) { \
+        WcwTest::fail(__FILE__, __LINE__, std::string(#a " == " #b " (") + std::to_string(wcwA) + " vs " + std::to_string(wcwB) + ")"); } } while (0)
+
+#define CHECK_NEAR(a, b, eps) \
+    do { const double wcwA = double(a); const double wcwB = double(b); if (!(std::fabs(wcwA - wcwB) <= double(eps))) { \
+        WcwTest::fail(__FILE__, __LINE__, std::string(#a " ~= " #b " (") + std::to_string(wcwA) + " vs " + std::to_string(wcwB) + ")"); } } while (0)
