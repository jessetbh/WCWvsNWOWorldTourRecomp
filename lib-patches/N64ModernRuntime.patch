+TEST_CASE("rice: geometry of a tile load") {
+    // 64x32 CI8 texture image, load tile (0,0)-(63,31) in 10.2 fixed point.
+    Load load;
+    load.type = LoadType::Tile;
+    load.siz = 1;
+    load.uls = 0; load.ult = 0; load.lrs = 63 << 2; load.lrt = 31 << 2;
+    load.address = 0x1000;
+    load.textureSiz = 1;
+    load.textureWidth = 64;
+    DrawTile draw;
+    draw.fmt = 2; draw.siz = 1;
+    Geometry g;
+    CHECK(computeGeometry(load, draw, g));
+    CHECK_EQ(g.width, 64);
+    CHECK_EQ(g.height, 32);
+    CHECK_EQ(g.bytesPerRow, 64);
+    CHECK_EQ(g.rdramStart, 0x1000u);
+    CHECK_EQ(g.bytesRead, uint64_t(31 * 64 + 64));
+
+    // Offset rectangle (8,4)-(39,19) of a 128-wide image: start at row 4, byte 8; mask clamps the width.
+    load.uls = 8 << 2; load.ult = 4 << 2; load.lrs = 39 << 2; load.lrt = 19 << 2;
+    load.textureWidth = 128;
+    load.masks = 4;
+    CHECK(computeGeometry(load, draw, g));
+    CHECK_EQ(g.width, 16);
+    CHECK_EQ(g.height, 16);
+    CHECK_EQ(g.bytesPerRow, 128);
+    CHECK_EQ(g.rdramStart, 0x1000u + 4 * 128 + 8);
+
+    // Loaded as 16-bit, drawn as 8-bit: the width doubles.
+    load.masks = 0;
+    load.siz = 2; load.textureSiz = 2;
+    load.uls = 0; load.ult = 0; load.lrs = 15 << 2; load.lrt = 7 << 2;
+    load.textureWidth = 16;
+    CHECK(computeGeometry(load, draw, g));
+    CHECK_EQ(g.width, 32);
+    CHECK_EQ(g.height, 8);
+
+    // aki-roadmap#204: a load that starts on a half texel. No Mercy draws a string texture in 64-px chunks; the second
+    // chunk loads (31.5,0)-(64,16) as 16-bit from an 88-byte-wide 8-bit image. Rice: ((lrs - uls) >> 2) + 1 = 33
+    // 16-bit texels (66 drawn), starting at byte 31; per-edge rounding gave 34 (68) and missed the pack's key.
+    load.siz = 2; load.textureSiz = 1;
+    load.uls = 0x07E; load.ult = 0; load.lrs = 0x100; load.lrt = 0x040;
+    load.textureWidth = 88;
+    CHECK(computeGeometry(load, draw, g));
+    CHECK_EQ(g.width, 66);
+    CHECK_EQ(g.height, 17);
+    CHECK_EQ(g.bytesPerRow, 88);
+    CHECK_EQ(g.rdramStart, 0x1000u + 31);
+    // Whole-texel edges are unchanged: the first chunk, (0,0)-(32,16), is 33 wide either way.
+    load.uls = 0; load.lrs = 0x080;
+    CHECK(computeGeometry(load, draw, g));
+    CHECK_EQ(g.width, 66);
+}
