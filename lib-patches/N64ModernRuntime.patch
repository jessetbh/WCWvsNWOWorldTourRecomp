+        bool feed_file(StreamHash &hash, const fs::path &path, bool text, size_t chunk_size) {
+            FILE *f = open_file(path, "rb");
+            if (!f) {
+                return false;
+            }
+            std::vector<unsigned char> buf(std::max<size_t>(chunk_size, 1));
+            bool pending_cr = false;
+            bool ok = true;
+            while (true) {
+                const size_t n = std::fread(buf.data(), 1, buf.size(), f);
+                for (size_t i = 0; i < n; i++) {
+                    const unsigned char c = buf[i];
+                    if (pending_cr) {
+                        pending_cr = false;
+                        if (c != '\n') {
+                            hash.byte('\r');
+                        }
+                    }
+                    if (text && c == '\r') {
+                        pending_cr = true;
+                        continue;
+                    }
+                    hash.byte(c);
+                }
+                if (n < buf.size()) {
+                    ok = !std::ferror(f);
+                    break;
+                }
+            }
+            if (pending_cr) {
+                hash.byte('\r');
+            }
+            std::fclose(f);
+            return ok;
+        }
+
+        bool read_text(const fs::path &path, std::string &out) {
+            FILE *f = open_file(path, "rb");
+            if (!f) {
+                return false;
+            }
+            out.clear();
+            char buf[65536];
+            size_t n;
+            while ((n = std::fread(buf, 1, sizeof(buf), f)) > 0) {
+                out.append(buf, n);
+            }
+            const bool ok = !std::ferror(f);
+            std::fclose(f);
+            return ok;
+        }
+    }
+
+    std::optional<uint64_t> hash_path(const fs::path &path, size_t chunk_size) {
+        std::error_code ec;
+        const fs::file_status st = fs::status(path, ec);
+        if (ec || !fs::exists(st)) {
+            return std::nullopt;
+        }
+        // (relative '/' path, file) pairs, sorted by path like pack_hash sorts them.
+        std::vector<std::pair<std::string, fs::path>> files;
+        if (fs::is_regular_file(st)) {
+            const std::u8string name = path.filename().generic_u8string();
+            files.emplace_back(std::string(name.begin(), name.end()), path);
+        }
+        else if (fs::is_directory(st)) {
+            for (fs::recursive_directory_iterator it(path, ec), end; it != end; it.increment(ec)) {
+                if (ec) {
+                    return std::nullopt;   // a folder we can't walk can't be judged unedited
+                }
+                std::error_code file_ec;
+                if (!it->is_regular_file(file_ec)) {
+                    continue;
+                }
+                const std::u8string rel = it->path().lexically_relative(path).generic_u8string();
+                files.emplace_back(std::string(rel.begin(), rel.end()), it->path());
+            }
+            if (ec) {
+                return std::nullopt;
+            }
+        }
+        else {
+            return std::nullopt;
+        }
+        std::sort(files.begin(), files.end(), [](const auto &a, const auto &b) { return a.first < b.first; });
+        StreamHash hash;
+        for (const auto &[rel, file] : files) {
+            for (unsigned char c : rel) {
+                hash.byte(c);
+            }
+            hash.byte(0);
+            if (!feed_file(hash, file, recomp::mods::bundled_packs::is_text_file(rel), chunk_size)) {
+                return std::nullopt;
+            }
+            hash.byte(0);
+        }
+        return hash.h;
+    }
+
+    std::optional<std::string> sha1_file(const fs::path &path) {
+        FILE *f = open_file(path, "rb");
+        if (!f) {
+            return std::nullopt;
+        }
+        uint32_t h[5] = { 0x67452301u, 0xEFCDAB89u, 0x98BADCFEu, 0x10325476u, 0xC3D2E1F0u };
+        auto rol = [](uint32_t x, int n) { return (x << n) | (x >> (32 - n)); };
+        auto block = [&](const unsigned char *p) {
+            uint32_t w[80];
+            for (int i = 0; i < 16; i++) {
+                w[i] = (uint32_t(p[4 * i]) << 24) | (uint32_t(p[4 * i + 1]) << 16) | (uint32_t(p[4 * i + 2]) << 8) | uint32_t(p[4 * i + 3]);
+            }
+            for (int i = 16; i < 80; i++) {
+                w[i] = rol(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1);
+            }
+            uint32_t a = h[0], b = h[1], c = h[2], d = h[3], e = h[4];
+            for (int i = 0; i < 80; i++) {
+                uint32_t fn, k;
+                if (i < 20) { fn = (b & c) | (~b & d); k = 0x5A827999u; }
+                else if (i < 40) { fn = b ^ c ^ d; k = 0x6ED9EBA1u; }
+                else if (i < 60) { fn = (b & c) | (b & d) | (c & d); k = 0x8F1BBCDCu; }
+                else { fn = b ^ c ^ d; k = 0xCA62C1D6u; }
+                const uint32_t t = rol(a, 5) + fn + e + k + w[i];
+                e = d; d = c; c = rol(b, 30); b = a; a = t;
+            }
+            h[0] += a; h[1] += b; h[2] += c; h[3] += d; h[4] += e;
+        };
+        std::vector<unsigned char> buf(size_t(1) << 20);
+        uint64_t total = 0;
+        unsigned char tail[128];
+        size_t tail_len = 0;
+        bool ok = true;
+        while (true) {
+            const size_t n = std::fread(buf.data(), 1, buf.size(), f);
+            total += n;
+            size_t i = 0;
+            if (tail_len > 0) {
+                while (tail_len < 64 && i < n) {
+                    tail[tail_len++] = buf[i++];
+                }
+                if (tail_len == 64) {
+                    block(tail);
+                    tail_len = 0;
+                }
+            }
+            for (; i + 64 <= n; i += 64) {
+                block(buf.data() + i);
+            }
+            while (i < n) {
+                tail[tail_len++] = buf[i++];
+            }
+            if (n < buf.size()) {
+                ok = !std::ferror(f);
+                break;
+            }
+        }
+        std::fclose(f);
+        if (!ok) {
+            return std::nullopt;
+        }
+        tail[tail_len++] = 0x80;
+        if (tail_len > 56) {
+            while (tail_len < 64) tail[tail_len++] = 0;
+            block(tail);
+            tail_len = 0;
+        }
+        while (tail_len < 56) tail[tail_len++] = 0;
+        const uint64_t bits = total * 8;
+        for (int i = 7; i >= 0; i--) {
+            tail[tail_len++] = static_cast<unsigned char>(bits >> (8 * i));
+        }
+        block(tail);
+        char hex[41];
+        for (int i = 0; i < 5; i++) {
+            std::snprintf(hex + 8 * i, 9, "%08x", h[i]);
+        }
+        return std::string(hex, 40);
+    }
+
+    RegistryStatus load_registry(const fs::path &data_dir, Registry &out) {
+        out = Registry{};
+        const fs::path file = data_dir / RegistryFile;
+        std::error_code ec;
+        const bool present = fs::exists(file, ec);
+        if (ec) {
+            return RegistryStatus::IoError;
+        }
+        if (!present) {
+            return RegistryStatus::Ok;
+        }
+        std::string text;
+        if (!read_text(file, text)) {
+            return RegistryStatus::IoError;
+        }
+        return parse_registry(text, out);
+    }
+
+    bool save_registry(const fs::path &data_dir, const Registry &registry) {
+        const fs::path file = data_dir / RegistryFile;
+        fs::path temp = file;
+        temp += ".tmp";
+        const std::string text = format_registry(registry);
+        FILE *f = open_file(temp, "wb");
+        if (!f) {
+            return false;
+        }
+        bool ok = std::fwrite(text.data(), 1, text.size(), f) == text.size() && std::fflush(f) == 0;
+#ifdef _WIN32
+        ok = ok && _commit(_fileno(f)) == 0;   // on disk before the rename makes it the registry
+#else
+        ok = ok && fsync(fileno(f)) == 0;
+#endif
+        ok = (std::fclose(f) == 0) && ok;
+        std::error_code ec;
+        if (ok) {
+            // fs::rename replaces an existing file (MoveFileExW with REPLACE_EXISTING on Windows). Another program
+            // reading the registry at that moment makes it fail with a sharing violation: try again briefly.
+            for (int attempt = 0; attempt < 10; attempt++) {
+                ec.clear();
+                fs::rename(temp, file, ec);
+                if (!ec) {
+                    return true;
+                }
+                std::this_thread::sleep_for(std::chrono::milliseconds(50));
+            }
+        }
+        std::error_code cleanup;
+        fs::remove(temp, cleanup);
+        return false;
+    }
+}
