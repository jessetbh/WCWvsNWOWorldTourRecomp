+++ b/recompui/src/config/dd_metrics_rules.h
@@ -0,0 +1,16 @@
+#pragma once
+
+// [wcw dd] The Datadog metrics switch (aki-roadmap#148). rt64's aki.game.* metrics and N64ModernRuntime's fatal
+// breadcrumb read the environment variable WCW_DD_METRICS; the General tab's Datadog Metrics setting turns them on
+// for a normal launch by setting it for the process at startup, before rt64 starts. Kept free of the config and the
+// environment so it can be unit tested (recompui/tests).
+namespace recompui::dd_metrics_rules {
+    // The value to give WCW_DD_METRICS, or nullptr to leave it alone. env_value is the variable as the process got it
+    // (nullptr when unset). A set, non-empty variable always wins, "0" included, so a launcher or script can force the
+    // metrics on or off whatever the setting says; otherwise the setting turns them on with "1".
+    const char *env_value_to_set(const char *env_value, bool setting_on);
+
+    // Whether the metrics end up on, by the rule rt64 and the runtime read the variable with: set, not empty, not "0"
+    // (rt64 WcwLogic::envSwitchOn, N64ModernRuntime recomp::dd::switch_on; keep the three the same).
+    bool metrics_on(const char *env_value, bool setting_on);
+}
diff --git a/recompui/src/config/framerate_rules.cpp b/recompui/src/config/framerate_rules.cpp
new file mode 100644
index 0000000..00234ae
--- /dev/null
+++ b/recompui/src/config/framerate_rules.cpp
@@ -0,0 +1,37 @@
+#include "framerate_rules.h"
+
+namespace recompui::framerate {
+    using ultramodern::renderer::RefreshRate;
+
+    RefreshRate parse_saved_option(const nlohmann::json &saved, uint32_t smooth_rate) {
+        if (smooth_rate == 0) {
+            return RefreshRate::Original;
+        }
+
+        const bool manual = saved.is_string() ? (saved.get<std::string>() == "Manual") :
+            (saved.is_number() && (saved.get<uint32_t>() == static_cast<uint32_t>(RefreshRate::Manual)));
+        if (manual) {
+            return RefreshRate::Manual;
+        }
+
+        if (saved.is_string() && (saved.get<std::string>() == "Smooth2x")) {
+            return RefreshRate::Display;
+        }
+
+        return RefreshRate::Original;
+    }
+
+    void apply_choice(RefreshRate &option, int &manual_value, uint32_t smooth_rate) {
+        if (smooth_rate == 0) {
+            option = RefreshRate::Original;
+        }
+        else if (option == RefreshRate::Display) {
+            // The doubled smooth rate (Smooth2x).
+            option = RefreshRate::Manual;
+            manual_value = int(smooth_rate * 2);
+        }
+        else if (option == RefreshRate::Manual) {
+            manual_value = int(smooth_rate);
+        }
+    }
+};
diff --git a/recompui/src/config/framerate_rules.h b/recompui/src/config/framerate_rules.h
