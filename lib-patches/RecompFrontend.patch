--- /dev/null
+++ b/recompinput/include/recompinput/input_rules.h
@@ -0,0 +1,38 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+// [wcw fix] Rules for turning host input into N64 input, kept free of SDL so they can be unit tested
+// (recompui/tests/input_rules_tests.cpp, aki-roadmap#305; the code is in recompinput/src/input_rules.cpp). input_state.cpp
+// calls these; a change to the rules belongs here, with a test.
+namespace recompinput::input_rules {
+    // A stick or trigger bound to a button (the family's default puts the left stick on the N64 d-pad) presses at
+    // analog_press_threshold and lets go only below analog_release_threshold. With one threshold a stick held near it,
+    // or wobbling as it springs back, crossed it more than once per push: the game saw press, release, press, and menus
+    // moved two rows (#305).
+    constexpr float analog_press_threshold = 0.5f;
+    constexpr float analog_release_threshold = 0.35f;
+
+    // Whether the bound button is down now, given whether it was down at the last read and the axis value (0..1, the
+    // bound direction).
+    bool analog_as_digital(bool was_pressed, float value);
+
+    // [wcw fix] Which player slot a newly connected pad takes (aki-roadmap#304). players.cpp keeps one SlotView per
+    // assigned player. A slot whose pad was unplugged stays assigned and remembers that pad (left_by = its controls
+    // profile key hash, 0 if unknown), so the pad gets the same player back when it reconnects, even if other pads come
+    // back before it. Before #304 a returning pad took the first empty slot: two pads that dropped out together (a
+    // hub, wireless sleep) came back swapped, and each player's pad drove the other player.
+    struct SlotView {
+        bool has_controller = false;  // a pad is connected in this slot
+        bool keyboard = false;        // a keyboard player (never given to a pad)
+        uint64_t left_by = 0;         // the pad that last left this slot (0 = none or unknown)
+    };
+    constexpr int slot_append = -1;  // add a new player slot
+    constexpr int slot_none = -2;    // every slot is taken
+    // pad_id = the connecting pad's profile key hash (0 = unknown). Order: the empty slot this pad left; else the first
+    // empty slot (a new or different pad, so a player who swaps pads keeps their player); else a new slot if
+    // slots.size() < max_slots; else slot_none.
+    int slot_for_connected_pad(const std::vector<SlotView> &slots, size_t max_slots, uint64_t pad_id);
+}
