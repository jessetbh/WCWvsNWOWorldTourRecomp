@@ -0,0 +1,43 @@
+// [wcw] Unit tests for how radio options look and behave (src/elements/radio_rules). Built and run as part of every
+// recompui build (RECOMPUI_WCW_TESTS); a failure fails the build.
+
+#include "radio_rules.h"
+
+#include "wcw_test.h"
+
+using namespace recompui::radio_rules;
+
+TEST_CASE("a normal option is pickable whether or not it is current") {
+    for (bool checked : { false, true }) {
+        const OptionState s = option_state(true, false, checked);
+        CHECK(!s.looks_disabled);
+        CHECK(s.focusable);
+        CHECK(s.pickable);
+    }
+}
+
+TEST_CASE("a disabled option looks disabled and can't be focused, even when current") {
+    for (bool locked : { false, true }) {
+        for (bool checked : { false, true }) {
+            const OptionState s = option_state(false, locked, checked);
+            CHECK(s.looks_disabled);
+            CHECK(!s.focusable);
+            CHECK(!s.pickable);
+        }
+    }
+}
+
+TEST_CASE("a locked value that is current looks selected and takes focus, but can't be picked") {
+    // The graphics preset's Custom: it was drawn greyed out while current, and controller focus landed on Authentic.
+    const OptionState s = option_state(true, true, true);
+    CHECK(!s.looks_disabled);
+    CHECK(s.focusable);
+    CHECK(!s.pickable);
+}
+
+TEST_CASE("a locked value that isn't current looks disabled and is skipped") {
+    const OptionState s = option_state(true, true, false);
+    CHECK(s.looks_disabled);
+    CHECK(!s.focusable);
+    CHECK(!s.pickable);
+}
diff --git a/recompui/tests/save_backup_menu_tests.cpp b/recompui/tests/save_backup_menu_tests.cpp
new file mode 100644
index 0000000..6324a6b
--- /dev/null
+++ b/recompui/tests/save_backup_menu_tests.cpp
@@ -0,0 +1,84 @@
+// [wcw] Unit tests for the save backup list (src/config/save_backup_menu). Built and run as part of every recompui
+// build (RECOMPUI_WCW_TESTS); a failure fails the build.
+
+#include "save_backup_menu.h"
+
+#include "wcw_test.h"
+
+using namespace recompui::config::save_backup_menu;
+
+static Timestamp at(int year, int month, int day, int hour, int minute, int second = 0) {
+    Timestamp t;
+    t.year = year; t.month = month; t.day = day; t.hour = hour; t.minute = minute; t.second = second;
+    return t;
+}
+
+static const Timestamp now = at(2026, 10, 15, 21, 0);
+
+TEST_CASE("dates read like Oct 15, 8:54 PM") {
+    CHECK(display_time(at(2026, 10, 15, 20, 54, 7), now) == "Oct 15, 8:54 PM");
+    CHECK(display_time(at(2026, 1, 3, 9, 5), now) == "Jan 3, 9:05 AM");
+    CHECK(display_time(at(2026, 12, 31, 23, 59), now) == "Dec 31, 11:59 PM");
+}
+
+TEST_CASE("midnight and noon are 12, not 0") {
+    CHECK(display_time(at(2026, 10, 15, 0, 0), now) == "Oct 15, 12:00 AM");
+    CHECK(display_time(at(2026, 10, 15, 12, 30), now) == "Oct 15, 12:30 PM");
+}
+
+TEST_CASE("another year's date shows the year") {
+    CHECK(display_time(at(2025, 12, 31, 23, 5), now) == "Dec 31, 2025, 11:05 PM");
+}
+
+TEST_CASE("seconds when asked") {
+    CHECK(display_time(at(2026, 10, 15, 20, 54, 7), now, true) == "Oct 15, 8:54:07 PM");
+}
+
+TEST_CASE("rows keep the order and say nothing about the file when all backups are of the game save") {
+    const std::vector<Row> r = rows({ { at(2026, 10, 15, 20, 54) }, { at(2026, 10, 14, 8, 1) } }, now);
+    CHECK_EQ(r.size(), size_t(2));
+    CHECK(r[0].time == "Oct 15, 8:54 PM");
+    CHECK(r[1].time == "Oct 14, 8:01 AM");
+    CHECK(r[0].file.empty());
+    CHECK(r[1].file.empty());
+    CHECK(r[0].note.empty());
+}
+
+TEST_CASE("with game save and Controller Pak backups each row says which file") {
+    // A launch backs up both files in the same second; the file tells them apart, so no seconds are needed.
+    const std::vector<Row> r = rows({
+        { at(2026, 10, 15, 20, 54, 3), false },
+        { at(2026, 10, 15, 20, 54, 3), true },
+    }, now);
+    CHECK(r[0].file == "Game save");
+    CHECK(r[1].file == "Controller Pak");
+    CHECK(r[0].time == "Oct 15, 8:54 PM");
+    CHECK(r[1].time == "Oct 15, 8:54 PM");
+}
+
+TEST_CASE("two backups of the same file in the same minute get their seconds") {
+    const std::vector<Row> r = rows({
+        { at(2026, 10, 15, 20, 54, 40) },
+        { at(2026, 10, 15, 20, 54, 2) },
+        { at(2026, 10, 15, 20, 40, 0) },
+    }, now);
+    CHECK(r[0].time == "Oct 15, 8:54:40 PM");
+    CHECK(r[1].time == "Oct 15, 8:54:02 PM");
+    CHECK(r[2].time == "Oct 15, 8:40 PM");
+}
+
+TEST_CASE("the pending restore is marked") {
+    const std::vector<Row> r = rows({ { at(2026, 10, 15, 20, 54), false, false }, { at(2026, 10, 14, 8, 1), false, true } }, now);
+    CHECK(r[0].note.empty());
+    CHECK(r[1].note == "Restores at next start");
+}
+
+TEST_CASE("no backups, no rows") {
+    CHECK(rows({}, now).empty());
+}
+
+TEST_CASE("the confirmation names the file and the date") {
+    CHECK(confirm_text({ at(2026, 10, 15, 20, 54) }, now) ==
+        "Restore the game save backup from Oct 15, 8:54 PM? It's restored the next time the game starts, and your current save is backed up first.");
+    CHECK(confirm_text({ at(2026, 10, 15, 20, 54), true }, now).find("Controller Pak backup from Oct 15, 8:54 PM?") != std::string::npos);
+}
diff --git a/recompui/tests/wcw_test.h b/recompui/tests/wcw_test.h
new file mode 100644
index 0000000..abb2b85
--- /dev/null
+++ b/recompui/tests/wcw_test.h
@@ -0,0 +1,75 @@
+//
+// RecompFrontend
+//
+
+// [wcw] Minimal unit test harness for the wcw tests: TEST_CASE registers a test, CHECK / CHECK_NEAR record failures
+// without stopping the test, and runAll() runs everything and returns the process exit code.
+
+#pragma once
+
+#include <cmath>
+#include <cstdio>
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace WcwTest {
+    struct Case {
+        const char *name;
+        std::function<void()> body;
+    };
+
+    inline std::vector<Case> &cases() {
+        static std::vector<Case> list;
+        return list;
+    }
+
+    inline int &failures() {
+        static int count = 0;
+        return count;
+    }
+
+    struct Registrar {
+        Registrar(const char *name, std::function<void()> body) {
+            cases().push_back({ name, std::move(body) });
+        }
+    };
+
+    inline void fail(const char *file, int line, const std::string &message) {
+        fprintf(stderr, "  FAILED %s:%d: %s\n", file, line, message.c_str());
+        failures()++;
+    }
+
+    inline int runAll(const char *suite) {
+        int failedCases = 0;
+        for (const Case &c : cases()) {
+            const int before = failures();
+            c.body();
+            if (failures() != before) {
+                fprintf(stderr, "[%s] FAIL %s\n", suite, c.name);
+                failedCases++;
+            }
+        }
+
+        fprintf(stderr, "[%s] %zu tests, %d failed\n", suite, cases().size(), failedCases);
+        return (failedCases == 0) ? 0 : 1;
+    }
+};
+
+#define WCW_TEST_CONCAT2(a, b) a##b
+#define WCW_TEST_CONCAT(a, b) WCW_TEST_CONCAT2(a, b)
+#define TEST_CASE(name) \
+    static void WCW_TEST_CONCAT(wcwTest_, __LINE__)(); \
+    static WcwTest::Registrar WCW_TEST_CONCAT(wcwTestRegistrar_, __LINE__)(name, WCW_TEST_CONCAT(wcwTest_, __LINE__)); \
+    static void WCW_TEST_CONCAT(wcwTest_, __LINE__)()
+
+#define CHECK(expr) \
+    do { if (!(expr)) { WcwTest::fail(__FILE__, __LINE__, #expr); } } while (0)
+
+#define CHECK_EQ(a, b) \
+    do { const auto wcwA = (a); const auto wcwB = (b); if (!(wcwA == wcwB)) { \
+        WcwTest::fail(__FILE__, __LINE__, std::string(#a " == " #b " (") + std::to_string(wcwA) + " vs " + std::to_string(wcwB) + ")"); } } while (0)
+
+#define CHECK_NEAR(a, b, eps) \
+    do { const double wcwA = double(a); const double wcwB = double(b); if (!(std::fabs(wcwA - wcwB) <= double(eps))) { \
+        WcwTest::fail(__FILE__, __LINE__, std::string(#a " ~= " #b " (") + std::to_string(wcwA) + " vs " + std::to_string(wcwB) + ")"); } } while (0)
