diff --git a/recompui/src/config/framerate_rules.cpp b/recompui/src/config/framerate_rules.cpp
new file mode 100644
index 0000000..00234ae
--- /dev/null
+++ b/recompui/src/config/framerate_rules.cpp
@@ -0,0 +1,37 @@
+#include "framerate_rules.h"
+
+namespace recompui::framerate {
+    using ultramodern::renderer::RefreshRate;
+
+    RefreshRate parse_saved_option(const nlohmann::json &saved, uint32_t smooth_rate) {
+        if (smooth_rate == 0) {
+            return RefreshRate::Original;
+        }
+
+        const bool manual = saved.is_string() ? (saved.get<std::string>() == "Manual") :
+            (saved.is_number() && (saved.get<uint32_t>() == static_cast<uint32_t>(RefreshRate::Manual)));
+        if (manual) {
+            return RefreshRate::Manual;
+        }
+
+        if (saved.is_string() && (saved.get<std::string>() == "Smooth2x")) {
+            return RefreshRate::Display;
+        }
+
+        return RefreshRate::Original;
+    }
+
+    void apply_choice(RefreshRate &option, int &manual_value, uint32_t smooth_rate) {
+        if (smooth_rate == 0) {
+            option = RefreshRate::Original;
+        }
+        else if (option == RefreshRate::Display) {
+            // The doubled smooth rate (Smooth2x).
+            option = RefreshRate::Manual;
+            manual_value = int(smooth_rate * 2);
+        }
+        else if (option == RefreshRate::Manual) {
+            manual_value = int(smooth_rate);
+        }
+    }
+};
diff --git a/recompui/src/config/framerate_rules.h b/recompui/src/config/framerate_rules.h
new file mode 100644
index 0000000..80cf16b
--- /dev/null
+++ b/recompui/src/config/framerate_rules.h
@@ -0,0 +1,19 @@
+#pragma once
+
+#include <cstdint>
+
+#include "ultramodern/config.hpp"
+
+// [wcw hfr] The Framerate option's rules, kept free of UI state so they can be unit tested (recompui/tests). The menu
+// offers 30 (Original), the game's smooth rate (stored as "Manual") and twice the smooth rate (stored as "Smooth2x",
+// held in the Display slot while the menu is open). The graphics tab calls these; a change to the rules belongs
+// here, with a test.
+namespace recompui::framerate {
+    // The value a saved rr_option loads as. Only a saved Smooth (Manual) or Smooth2x choice survives, and only when the
+    // game has a smooth rate; everything else, including a stale Display from older builds, loads as Original.
+    ultramodern::renderer::RefreshRate parse_saved_option(const nlohmann::json &saved, uint32_t smooth_rate);
+
+    // Turns the menu's choice into what the renderer gets: Smooth runs at smooth_rate and the doubled choice at
+    // 2 x smooth_rate, both as a Manual rate; without a smooth rate the framerate stays Original.
+    void apply_choice(ultramodern::renderer::RefreshRate &option, int &manual_value, uint32_t smooth_rate);
+};
diff --git a/recompui/src/config/graphics_presets.cpp b/recompui/src/config/graphics_presets.cpp
new file mode 100644
index 0000000..9ece40b
--- /dev/null
+++ b/recompui/src/config/graphics_presets.cpp
@@ -0,0 +1,102 @@
+#include "graphics_presets.h"
+
+#include <algorithm>
+
+namespace recompui::config::presets {
+    using ultramodern::renderer::Antialiasing;
+    using ultramodern::renderer::AspectRatio;
+    using ultramodern::renderer::RefreshRate;
+
+    static Antialiasing capped_msaa(Antialiasing msaa, const Limits &limits) {
+        return std::min(msaa, limits.max_msaa);
+    }
+
+    // Twice the smooth rate needs a display that fast (a 119.88 Hz display reports 119).
+    static bool display_allows_smooth2x(const Limits &limits) {
+        return (limits.display_rate == 0) || (limits.display_rate + 2 >= limits.smooth_rate * 2);
+    }
+
+    std::optional<Settings> settings_for(Preset preset, const Limits &limits) {
+        const bool smooth = limits.smooth_rate > 0;
+        Settings settings;
+        switch (preset) {
+        case Preset::Authentic:
+            // The game as it shipped, on a period TV.
+            settings.aspect_ratio = AspectRatio::Original;
+            settings.framerate = RefreshRate::Original;
+            settings.msaa = Antialiasing::None;
+            settings.crt = CrtFilterOption::On;
+            settings.crt_signal = CrtSignalOption::Composite;
+            break;
+        case Preset::Enhanced:
+        case Preset::EnhancedRayTracing:
+            // The default. Enhanced Ray Tracing is the same with ray tracing on.
+            settings.aspect_ratio = AspectRatio::Expand;
+            settings.framerate = smooth ? RefreshRate::Manual : RefreshRate::Original;
+            settings.msaa = Antialiasing::MSAA4X;
+            settings.rt = (preset == Preset::EnhancedRayTracing) ? RayTracingOption::On : RayTracingOption::Off;
+            settings.rt_quality = RayTracingQuality::Balanced;
+            break;
+        case Preset::Max:
+            settings.aspect_ratio = AspectRatio::Expand;
+            settings.framerate = !smooth ? RefreshRate::Original :
+                (display_allows_smooth2x(limits) ? RefreshRate::Display : RefreshRate::Manual);
+            settings.msaa = Antialiasing::MSAA4X;
+            settings.rt = RayTracingOption::On;
+            settings.rt_quality = RayTracingQuality::Ultra;
+            settings.hdr = HdrOption::On;
+            settings.hdr_picture = HdrPictureOption::Auto;
+            break;
+        case Preset::Custom:
+        default:
+            return std::nullopt;
+        }
+
+        settings.msaa = capped_msaa(settings.msaa, limits);
+        return settings;
+    }
+
+    bool matches(Preset preset, const Settings &current, const Limits &limits) {
+        const std::optional<Settings> wanted = settings_for(preset, limits);
+        if (!wanted) {
+            return false;
+        }
+
+        return (current.aspect_ratio == wanted->aspect_ratio) &&
+            ((limits.smooth_rate == 0) || (current.framerate == wanted->framerate)) &&
+            (capped_msaa(current.msaa, limits) == wanted->msaa) &&
+            (current.crt == wanted->crt) &&
+            ((current.crt == CrtFilterOption::Off) || (current.crt_signal == wanted->crt_signal)) &&
+            (current.rt == wanted->rt) &&
+            ((current.rt == RayTracingOption::Off) || (current.rt_quality == wanted->rt_quality)) &&
+            (current.hdr == wanted->hdr) &&
+            ((current.hdr == HdrOption::Off) || (current.hdr_picture == wanted->hdr_picture));
+    }
+
+    Preset matching_preset(const Settings &current, const Limits &limits) {
+        // Enhanced and Enhanced Ray Tracing differ only in ray tracing, so at most one of them matches.
+        for (Preset preset : { Preset::Authentic, Preset::Enhanced, Preset::EnhancedRayTracing, Preset::Max }) {
+            if (matches(preset, current, limits)) {
+                return preset;
+            }
+        }
+
+        return Preset::Custom;
+    }
+
+    const char *label(Preset preset) {
+        switch (preset) {
+        case Preset::Authentic:
+            return "Authentic";
+        case Preset::Enhanced:
+            return "Enhanced";
+        case Preset::EnhancedRayTracing:
+            return "Enhanced RT";
+        case Preset::Max:
+            return "Max";
+        case Preset::Custom:
+        default:
+            return "Custom";
+        }
+    }
+};
diff --git a/recompui/src/config/graphics_presets.h b/recompui/src/config/graphics_presets.h
new file mode 100644
index 0000000..77778ab
--- /dev/null
+++ b/recompui/src/config/graphics_presets.h
@@ -0,0 +1,105 @@
+#pragma once
+
+#include <cstdint>
+#include <optional>
+
+#include "ultramodern/config.hpp"
+
+namespace recompui::config {
+    // [wcw rt] Experimental hybrid ray tracing.
+    enum class RayTracingOption {
+        Off = 0,
+        On = 1
+    };
+
+    // Matches RT64::WcwLogic::RtQuality. Ambient occlusion comes with the level (none on Performance, Subtle on
+    // Balanced, Strong on Quality and Ultra), so there is no separate AO option.
+    enum class RayTracingQuality {
+        Performance = 0,
+        Balanced = 1,
+        Quality = 2,
+        Ultra = 3
+    };
+
+    // [wcw crt] CRT filter: on/off, the video signal (a preset in crt/presets/ next to the
+    // executable) and the TV's color standard.
+    enum class CrtFilterOption {
+        Off = 0,
+        On = 1
+    };
+
+    enum class CrtSignalOption {
+        Composite = 0,
+        SVideo = 1,
+        RF = 2,
+        RGB = 3
+    };
+
+    // [wcw hdr] HDR output.
+    enum class HdrOption {
+        Off = 0,
+        On = 1
+    };
+
+    // Same values as RT64::WcwLogic::HdrPicture.
+    enum class HdrPictureOption {
+        Auto = 0,
+        Brighter = 1,
+        Balanced = 2,
+        CrtDetail = 3,
+        Custom = 4
+    };
+};
+
+// [wcw] Graphics presets (Graphics > Preset): what each preset sets, and which preset a set of options matches. Kept
+// free of UI state so it can be unit tested (recompui/tests); the graphics tab calls these. A change to a preset
+// belongs here, with a test.
+namespace recompui::config::presets {
+    // Stored values of the Preset option. Custom is never picked: the menu shows it when the options match no preset.
+    enum class Preset {
+        Authentic = 0,
+        Enhanced = 1,
+        EnhancedRayTracing = 2,
+        Max = 3,
+        Custom = 4
+    };
+
+    // The options a preset sets. The CRT signal only counts with the CRT filter on, the ray tracing quality only with
+    // ray tracing on and the HDR picture only with HDR on (the menu hides them otherwise).
+    struct Settings {
+        ultramodern::renderer::AspectRatio aspect_ratio = ultramodern::renderer::AspectRatio::Expand;
+        // The Framerate menu's stored choice (framerate_rules.h): Original, Manual = Smooth, Display = Smooth2x.
+        ultramodern::renderer::RefreshRate framerate = ultramodern::renderer::RefreshRate::Original;
+        ultramodern::renderer::Antialiasing msaa = ultramodern::renderer::Antialiasing::None;
+        CrtFilterOption crt = CrtFilterOption::Off;
+        CrtSignalOption crt_signal = CrtSignalOption::Composite;
+        RayTracingOption rt = RayTracingOption::Off;
+        RayTracingQuality rt_quality = RayTracingQuality::Balanced;
+        HdrOption hdr = HdrOption::Off;
+        HdrPictureOption hdr_picture = HdrPictureOption::Auto;
+    };
+
+    // What the game and the machine allow.
+    struct Limits {
+        // The game's smooth rate (programconfig::get_frame_interpolation); 0 = the framerate is locked to Original.
+        uint32_t smooth_rate = 0;
+        // The display's refresh rate in Hz; 0 = not known yet (taken as fast enough).
+        uint32_t display_rate = 0;
+        // The highest MSAA level the GPU offers.
+        ultramodern::renderer::Antialiasing max_msaa = ultramodern::renderer::Antialiasing::MSAA4X;
+    };
+
+    // The settings a preset applies on this machine; nothing for Custom.
+    std::optional<Settings> settings_for(Preset preset, const Limits &limits);
+
+    // Whether the options are what the preset sets. MSAA is compared as the GPU runs it (capped at max_msaa) and the
+    // framerate is ignored when the game locks it.
+    bool matches(Preset preset, const Settings &current, const Limits &limits);
+
+    // The first preset the options match, or Custom.
+    Preset matching_preset(const Settings &current, const Limits &limits);
+
+    // The preset's name in the menu, short enough for all five to fit on one row: Authentic / Enhanced / Enhanced RT /
+    // Max / Custom.
+    const char *label(Preset preset);
+};
diff --git a/recompui/src/config/graphics_rules.cpp b/recompui/src/config/graphics_rules.cpp
new file mode 100644
index 0000000..625382c
--- /dev/null
+++ b/recompui/src/config/graphics_rules.cpp
@@ -0,0 +1,24 @@
+#include "graphics_rules.h"
+
+#include <algorithm>
+
+namespace recompui::graphics_rules {
+    using ultramodern::renderer::Antialiasing;
+    using ultramodern::renderer::Resolution;
+
+    int downsample_multiplier(Resolution resolution, int ds_option, int ss_option) {
+        switch (resolution) {
+        case Resolution::Original:
+        case Resolution::Original2x:
+            return std::max(ds_option, 1);
+        case Resolution::Auto:
+        default:
+            // Only 2x: Auto already renders at the window's size, so 4x would be 16 times its pixels.
+            return (ss_option >= 2) ? 2 : 1;
+        }
+    }
+
+    bool msaa_level_supported(Antialiasing level, Antialiasing device_max) {
+        return static_cast<int>(level) <= static_cast<int>(device_max);
+    }
+};
diff --git a/recompui/src/config/graphics_rules.h b/recompui/src/config/graphics_rules.h
new file mode 100644
index 0000000..f3b6c66
--- /dev/null
+++ b/recompui/src/config/graphics_rules.h
@@ -0,0 +1,15 @@
+#pragma once
+
+#include "ultramodern/config.hpp"
+
+// [wcw] The Resolution / Downsampling / Supersampling and MSAA options' rules, kept free of UI state so they can be
+// unit tested (recompui/tests). The graphics tab calls these; a change to the rules belongs here, with a test.
+namespace recompui::graphics_rules {
+    // How many times larger than the output the game renders before RT64 box-filters it down (1 = no downsampling).
+    // Original and Original 2x take it from Downsampling Quality (ds_option: Off, 2x, 4x); Auto takes it from
+    // Supersampling (ss_option: Off, 2x), which renders at twice the window's scale. Both options store Off as 0.
+    int downsample_multiplier(ultramodern::renderer::Resolution resolution, int ds_option, int ss_option);
+
+    // Whether an MSAA level can be picked on a device whose highest supported level is device_max.
+    bool msaa_level_supported(ultramodern::renderer::Antialiasing level, ultramodern::renderer::Antialiasing device_max);
+};
diff --git a/recompui/src/config/save_backup_menu.cpp b/recompui/src/config/save_backup_menu.cpp
new file mode 100644
index 0000000..589e5d5
--- /dev/null
+++ b/recompui/src/config/save_backup_menu.cpp
@@ -0,0 +1,80 @@
+#include "save_backup_menu.h"
+
+#include <cstdio>
+
+namespace recompui::config::save_backup_menu {
+    static const char *month_name(int month) {
+        static const char *names[] = { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
+        return (month >= 1 && month <= 12) ? names[month - 1] : "???";
+    }
+
+    std::string display_time(const Timestamp &when, const Timestamp &now, bool with_seconds) {
+        const int hour12 = (when.hour % 12 == 0) ? 12 : (when.hour % 12);
+        const char *am_pm = (when.hour < 12) ? "AM" : "PM";
+
+        char date[32];
+        if (when.year == now.year) {
+            snprintf(date, sizeof(date), "%s %d", month_name(when.month), when.day);
+        }
+        else {
+            snprintf(date, sizeof(date), "%s %d, %d", month_name(when.month), when.day, when.year);
+        }
+
+        char time[32];
+        if (with_seconds) {
+            snprintf(time, sizeof(time), "%d:%02d:%02d %s", hour12, when.minute, when.second, am_pm);
+        }
+        else {
+            snprintf(time, sizeof(time), "%d:%02d %s", hour12, when.minute, am_pm);
+        }
+
+        return std::string(date) + ", " + time;
+    }
+
+    static std::string file_label(bool controller_pak) {
+        return controller_pak ? "Controller Pak" : "Game save";
+    }
+
+    std::vector<Row> rows(const std::vector<Entry> &entries, const Timestamp &now) {
+        bool any_pak = false;
+        bool any_main = false;
+        for (const Entry &entry : entries) {
+            (entry.controller_pak ? any_pak : any_main) = true;
+        }
+        const bool show_file = any_pak && any_main;
+
+        std::vector<Row> out;
+        out.reserve(entries.size());
+        for (size_t i = 0; i < entries.size(); i++) {
+            const Entry &entry = entries[i];
+            // Two backups of the same file in the same minute (a launch backup right after a restore's) would read the
+            // same; the seconds tell them apart.
+            bool same_minute = false;
+            for (size_t j = 0; j < entries.size(); j++) {
+                const Entry &other = entries[j];
+                if (j != i && (!show_file || other.controller_pak == entry.controller_pak) &&
+                    display_time(other.when, now) == display_time(entry.when, now)) {
+                    same_minute = true;
+                    break;
+                }
+            }
+
+            Row row;
+            row.time = display_time(entry.when, now, same_minute);
+            row.file = show_file ? file_label(entry.controller_pak) : "";
+            row.note = entry.pending ? "Restores at next start" : "";
+            out.push_back(row);
+        }
+
+        return out;
+    }
+
+    std::string file_name_in_text(bool controller_pak) {
+        return controller_pak ? "Controller Pak" : "game save";
+    }
+
+    std::string confirm_text(const Entry &entry, const Timestamp &now) {
+        return "Restore the " + file_name_in_text(entry.controller_pak) + " backup from " + display_time(entry.when, now) +
+            "? It's restored the next time the game starts, and your current save is backed up first.";
+    }
+}
diff --git a/recompui/src/config/save_backup_menu.h b/recompui/src/config/save_backup_menu.h
new file mode 100644
index 0000000..9ac0413
--- /dev/null
+++ b/recompui/src/config/save_backup_menu.h
@@ -0,0 +1,38 @@
+#pragma once
+
+#include <string>
+#include <vector>
+
+#include "librecomp/save_backup_rules.hpp"
+
+// [wcw saves] What General > Restore a Backup lists (aki-roadmap#50): one row per backup with its date and time in
+// words, and which file it covers when that matters. Kept free of UI and file I/O so it can be unit tested
+// (recompui/tests); the backup list itself comes from librecomp save_backups.hpp, newest first.
+namespace recompui::config::save_backup_menu {
+    using recomp::save_backups::Timestamp;
+
+    // "Oct 15, 8:54 PM". The year is added when it isn't now's year ("Dec 31, 2025, 11:05 PM"), and the seconds when
+    // with_seconds is set ("Oct 15, 8:54:07 PM").
+    std::string display_time(const Timestamp &when, const Timestamp &now, bool with_seconds = false);
+
+    struct Entry {
+        Timestamp when;
+        bool controller_pak = false;
+        bool pending = false; // the restore already scheduled for the next start
+    };
+
+    struct Row {
+        std::string time; // display_time, with seconds only where two rows would otherwise read the same
+        std::string file; // "Game save" / "Controller Pak"; empty when every backup is of the same file
+        std::string note; // "Restores at next start" for the pending one, else empty
+    };
+
+    // One row per entry, in the same order.
+    std::vector<Row> rows(const std::vector<Entry> &entries, const Timestamp &now);
+
+    // "game save" / "Controller Pak", for sentences.
+    std::string file_name_in_text(bool controller_pak);
+
+    // The confirmation question for restoring entry.
+    std::string confirm_text(const Entry &entry, const Timestamp &now);
+}
