diff --git a/recompui/src/config/conversion_menu.cpp b/recompui/src/config/conversion_menu.cpp
new file mode 100644
index 0000000..da72efc
--- /dev/null
+++ b/recompui/src/config/conversion_menu.cpp
@@ -0,0 +1,83 @@
+#include "conversion_menu.h"
+
+namespace recompui::config::conversion_menu {
+    std::string components_summary(const Entry &entry) {
+        std::string out;
+        auto add = [&out](bool has, const char *name) {
+            if (!has) {
+                return;
+            }
+            if (!out.empty()) {
+                out += ", ";
+            }
+            out += name;
+        };
+        add(entry.patch, "ROM patch");
+        add(entry.codes, "codes");
+        add(entry.saves, "saves");
+        add(entry.textures, "textures");
+        add(entry.rt, "ray tracing");
+        return out;
+    }
+
+    static std::string display_name(const std::vector<Entry> &entries, const std::string &id) {
+        if (id.empty()) {
+            return "the normal game";
+        }
+        for (const Entry &entry : entries) {
+            if (entry.id == id) {
+                return entry.name.empty() ? id : entry.name;
+            }
+        }
+        return id;
+    }
+
+    std::vector<Row> rows(const std::vector<Entry> &entries, const std::string &chosen_id, const std::string &running_id,
+        bool from_launcher) {
+        std::vector<Row> out;
+        Row off;
+        off.entry.name = "Off";
+        off.chosen = chosen_id.empty();
+        off.running = running_id.empty();
+        out.push_back(off);
+
+        for (const Entry &entry : entries) {
+            Row row;
+            row.entry = entry;
+            row.chosen = !chosen_id.empty() && (entry.id == chosen_id);
+            row.running = !running_id.empty() && (entry.id == running_id);
+            row.selectable = entry.error.empty();
+            out.push_back(row);
+        }
+
+        for (Row &row : out) {
+            if (!row.selectable) {
+                row.note = "Can't be played: " + row.entry.error;
+            }
+            else if (row.running && row.chosen) {
+                // The normal game running as chosen needs no note (the status line says it).
+                row.note = row.entry.id.empty() ? std::string() : std::string("Running now");
+            }
+            else if (row.running) {
+                row.note = from_launcher ? std::string("Running now (picked by AKI Launcher)") :
+                    ("Running now; the next start runs " + display_name(entries, chosen_id));
+            }
+            else if (row.chosen) {
+                row.note = from_launcher ? "For starts without AKI Launcher" : "From the next start";
+            }
+        }
+        return out;
+    }
+
+    std::string status_line(const std::vector<Entry> &entries, const std::string &chosen_id, const std::string &running_id,
+        bool from_launcher) {
+        if (chosen_id == running_id) {
+            return running_id.empty() ? "Playing the normal game." : ("Playing " + display_name(entries, running_id) + ".");
+        }
+        if (from_launcher) {
+            return "AKI Launcher started " + display_name(entries, running_id) + ". Starts without the launcher run " +
+                display_name(entries, chosen_id) + ".";
+        }
+        return "Restart the game to switch to " + display_name(entries, chosen_id) + ".";
+    }
+}
diff --git a/recompui/src/config/conversion_menu.h b/recompui/src/config/conversion_menu.h
new file mode 100644
index 0000000..801e7ab
--- /dev/null
+++ b/recompui/src/config/conversion_menu.h
@@ -0,0 +1,39 @@
+#pragma once
+
+#include <string>
+#include <vector>
+
+// [wcw fullconv] The Mods menu's Conversions dialog (aki-roadmap#57): the conversions installed in <config>/conversions
+// and which one the next start runs (conversions/active.txt, read and written by librecomp's conversion picker API).
+// A choice applies from the next start: a conversion is set up when the game starts (its mods, its save folder).
+// AKI Launcher's own choice (AKI_CONVERSION) still wins over this one for the launches it starts. Kept free of UI and
+// librecomp types so it can be unit tested (recompui/tests).
+namespace recompui::config::conversion_menu {
+    struct Entry {
+        std::string id;
+        std::string name;
+        bool patch = false, codes = false, saves = false, textures = false, rt = false;
+        std::string error;   // why its aki.json can't be read ("" = fine); such an entry can't be chosen
+    };
+
+    // "ROM patch, codes, saves, textures, ray tracing" for the components it has, "" for none.
+    std::string components_summary(const Entry &entry);
+
+    struct Row {
+        Entry entry;           // empty id: the "Off" row (no conversion, the normal game)
+        bool chosen = false;   // what conversions/active.txt names (Off when it names none)
+        bool running = false;  // what this session runs (Off when it runs none)
+        bool selectable = true;
+        std::string note;      // shown under the name
+    };
+
+    // The rows: "Off" first, then the entries in the given order. chosen_id / running_id: "" = none. from_launcher: AKI
+    // Launcher picked what runs now (AKI_CONVERSION); its restarts pick it again, so the choice here only applies to
+    // starts without the launcher.
+    std::vector<Row> rows(const std::vector<Entry> &entries, const std::string &chosen_id, const std::string &running_id,
+        bool from_launcher);
+
+    // The line above the list: what changes at the next start, if anything.
+    std::string status_line(const std::vector<Entry> &entries, const std::string &chosen_id, const std::string &running_id,
+        bool from_launcher);
+}
diff --git a/recompui/src/config/dd_metrics_rules.cpp b/recompui/src/config/dd_metrics_rules.cpp
