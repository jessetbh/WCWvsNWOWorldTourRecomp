+            RT64::wcwSetInterpolationProfile(interpolation.hookless_objects, interpolation.prime_generated_frames,
+                interpolation.skip_clear_only_targets, interpolation.even_pacing);
+        }
+
+        const FrameInterpolation &get_frame_interpolation() {
+            return frame_interpolation;
+        }
+
         const std::u8string &get_program_id() {
             if (program_id.empty()) {
                 throw std::runtime_error("Program ID has not been set. Run recompui::programconfig::set_program_id(...) first.");
diff --git a/recompui/tests/check_file_local_types.cmake b/recompui/tests/check_file_local_types.cmake
new file mode 100644
index 0000000..a47ec8f
--- /dev/null
+++ b/recompui/tests/check_file_local_types.cmake
@@ -0,0 +1,38 @@
+# [wcw] One-definition-rule guard for recompui's .cpp files (cmake -DSOURCE_DIR=<recompui/src> -P this file).
+#
+# A struct or class written straight inside a named namespace (four spaces in, the recompui style) has external
+# linkage even when the file only uses it locally. If two files each define their own type of the same name that way,
+# the program breaks the one-definition rule without any compiler or linker error: the linker keeps one copy of each
+# template member (std::vector<T>::push_back and so on) and both files run it. That crashed the Conversions dialog
+# in 0.3.0/0.3.1: it ran the Model packs dialog's push_back for its own, smaller RowWidgets (WWFNoMercyRecomp#24,
+# WWFWrestleMania2000Recomp#10).
+#
+# File-local types go in an anonymous namespace (eight spaces in, so this check skips them). This fails the build
+# when two .cpp files define a type of the same name at namespace level. It reads struct, class, union and enum
+# definitions (templates too) written four spaces in with the { on the same line; other layouts aren't seen.
+if (NOT SOURCE_DIR)
+    message(FATAL_ERROR "check_file_local_types: SOURCE_DIR is not set")
+endif()
+
+set(type_regex "^    (template *<[^>]*> *)?(struct|class|union|enum class|enum struct|enum) ([A-Za-z_][A-Za-z0-9_]*)")
+file(GLOB_RECURSE sources "${SOURCE_DIR}/*.cpp")
+foreach (source IN LISTS sources)
+    file(STRINGS "${source}" lines REGEX "${type_regex}[^;]*{")
+    foreach (line IN LISTS lines)
+        string(REGEX REPLACE "${type_regex}.*" "\\3" name "${line}")
+        file(RELATIVE_PATH relative "${SOURCE_DIR}" "${source}")
+        if (DEFINED "seen_${name}" AND NOT "${seen_${name}}" STREQUAL "${relative}")
+            list(APPEND clashes "${name}: ${seen_${name}} and ${relative}")
+        else()
+            set("seen_${name}" "${relative}")
+        endif()
+    endforeach()
+endforeach()
+
+if (clashes)
+    list(JOIN clashes "\n  " clash_text)
+    message(FATAL_ERROR "check_file_local_types: these types are defined at namespace level in more than one .cpp file "
+        "(a one-definition-rule break; put file-local types in an anonymous namespace). The check takes a definition "
+        "written four spaces in as namespace level:\n  ${clash_text}")
+endif()
+message(STATUS "check_file_local_types: no namespace-level type defined in two recompui .cpp files")
diff --git a/recompui/tests/controls_rules_tests.cpp b/recompui/tests/controls_rules_tests.cpp
new file mode 100644
index 0000000..3115582
--- /dev/null
+++ b/recompui/tests/controls_rules_tests.cpp
@@ -0,0 +1,83 @@
+// [wcw fix] Unit tests for the controls save/load rules (recompinput/src/controls_rules, aki-roadmap#303). Built and
+// run as part of every recompui build (RECOMPUI_WCW_TESTS); a failure fails the build.
+
+#include "recompinput/controls_rules.h"
+
+#include "wcw_test.h"
+
+using namespace recompinput::controls_rules;
+
+TEST_CASE("controls: a GUID hash is never 0 and is rebuilt the same from the saved fields") {
+    // Regression for #303: a GUID read back from controls.json kept hash 0, so every saved pad shared one map entry.
+    const uint64_t pad360 = controller_guid_hash("", 1118, 654, 0, 6554);
+    const uint64_t padOne = controller_guid_hash("", 1118, 767, 0, 36243);
+    CHECK(pad360 != 0);
+    CHECK(padOne != 0);
+    CHECK(pad360 != padOne);
+    CHECK(controller_guid_hash("", 1118, 654, 0, 6554) == pad360);
+    CHECK(controller_guid_hash("", 0, 0, 0, 0) != 0);
+}
+
+TEST_CASE("controls: each field changes the hash") {
+    const uint64_t base = controller_guid_hash("", 1, 2, 3, 4);
+    CHECK(controller_guid_hash("", 9, 2, 3, 4) != base);
+    CHECK(controller_guid_hash("", 1, 9, 3, 4) != base);
+    CHECK(controller_guid_hash("", 1, 2, 9, 4) != base);
+    CHECK(controller_guid_hash("", 1, 2, 3, 9) != base);
+    // Fields don't swap into each other.
+    CHECK(controller_guid_hash("", 2, 1, 3, 4) != base);
+}
+
+TEST_CASE("controls: a saved pad keeps the link to its own profile") {
+    const std::string a = "SERIAL__VID_1118_PID_654_VERSION_0_CRC16_6554";
+    CHECK(saved_controller_profile_key(a, a, true, false, true) == a);
+}
+
+TEST_CASE("controls: a pre-#303 cross link goes back to the pad's own profile") {
+    // The owner's files: pad 654 saved as linked to pad 767's profile.
+    const std::string a = "SERIAL__VID_1118_PID_654_VERSION_0_CRC16_6554";
+    const std::string b = "SERIAL__VID_1118_PID_767_VERSION_0_CRC16_36243";
+    CHECK(saved_controller_profile_key(a, b, true, false, true) == a);
+    // Without its own profile the entry is skipped; the pad gets its profile when it is plugged in.
+    CHECK(saved_controller_profile_key(a, b, true, false, false).empty());
+    // The single-player controller profile is not a pad's profile either.
+    CHECK(saved_controller_profile_key(a, "controller_sp", true, false, true) == a);
+}
+
+TEST_CASE("controls: custom profiles keep their link, missing profiles don't") {
+    const std::string a = "SERIAL__VID_1118_PID_654_VERSION_0_CRC16_6554";
+    CHECK(saved_controller_profile_key(a, "my_layout", true, true, true) == "my_layout");
+    CHECK(saved_controller_profile_key(a, "my_layout", false, true, true) == a);
+    CHECK(saved_controller_profile_key(a, a, false, false, false).empty());
+}
+
+TEST_CASE("controls: changes are saved right away, but not mid-bind") {
+    CHECK(!controls_need_save(0, 0, false));
+    CHECK(controls_need_save(1, 0, false));
+    CHECK(!controls_need_save(1, 0, true));   // waiting for the new input: save when the bind finishes
+    CHECK(!controls_need_save(7, 7, true));
+    CHECK(controls_need_save(3, 7, false));   // any difference counts, not only "newer"
+}
+
+TEST_CASE("controls: a GUID read from controls.json gets its hash back") {
+    // Regression for #303: from_json left the hash at 0, so saved pads collapsed onto one controllers entry.
+    const nlohmann::json saved = { {"serial", ""}, {"vendor", 1118}, {"product", 654}, {"version", 0}, {"crc16", 6554} };
+    const recompinput::ControllerGUID guid = saved.get<recompinput::ControllerGUID>();
+    CHECK(guid.hash != 0);
+    CHECK(guid.hash == controller_guid_hash("", 1118, 654, 0, 6554));
+    nlohmann::json other = saved;
+    other["product"] = 767;
+    other["crc16"] = 36243;
+    CHECK(other.get<recompinput::ControllerGUID>().hash != guid.hash);
+}
+
+TEST_CASE("controls: two pads of one model with different serials get different hashes") {
+    // Review of #303: the serial is in the profile key, so it must be in the hash too, or the second pad's link
+    // overwrote the first's on load.
+    const uint64_t a = controller_guid_hash("a4:53:85:00:00:01", 1356, 2508, 0x8111, 4660);
+    const uint64_t b = controller_guid_hash("a4:53:85:00:00:02", 1356, 2508, 0x8111, 4660);
+    CHECK(a != b);
+    CHECK(controller_guid_hash("", 1356, 2508, 0x8111, 4660) != a);
+    nlohmann::json saved = { {"serial", "a4:53:85:00:00:02"}, {"vendor", 1356}, {"product", 2508}, {"version", 0x8111}, {"crc16", 4660} };
+    CHECK(saved.get<recompinput::ControllerGUID>().hash == b);
+}
diff --git a/recompui/tests/conversion_menu_tests.cpp b/recompui/tests/conversion_menu_tests.cpp
new file mode 100644
index 0000000..bed97d7
--- /dev/null
+++ b/recompui/tests/conversion_menu_tests.cpp
@@ -0,0 +1,87 @@
+// [wcw fullconv] Unit tests for the Conversions dialog's rows and status line (src/config/conversion_menu). Built and
+// run as part of every recompui build (RECOMPUI_WCW_TESTS); a failure fails the build.
+
+#include "conversion_menu.h"
+
+#include "wcw_test.h"
+
+using namespace recompui::config::conversion_menu;
+
+namespace {
+    std::vector<Entry> installed() {
+        Entry aew;
+        aew.id = "aew64";
+        aew.name = "AEW 64";
+        aew.codes = aew.saves = aew.textures = true;
+        Entry revse;
+        revse.id = "revse";
+        revse.name = "Starrcade Edition 2.0";
+        revse.patch = true;
+        Entry broken;
+        broken.id = "broken";
+        broken.name = "broken";
+        broken.error = "aki.json: missing \"components\"";
+        return { aew, revse, broken };
+    }
+}
+
+TEST_CASE("conversions: components read as a short list") {
+    const std::vector<Entry> e = installed();
+    CHECK(components_summary(e[0]) == "codes, saves, textures");
+    CHECK(components_summary(e[1]) == "ROM patch");
+    Entry all;
+    all.patch = all.codes = all.saves = all.textures = all.rt = true;
+    CHECK(components_summary(all) == "ROM patch, codes, saves, textures, ray tracing");
+    CHECK(components_summary(Entry{}).empty());
+}
+
+TEST_CASE("conversions: Off comes first and is chosen and running when nothing is") {
+    const std::vector<Row> r = rows(installed(), "", "", false);
+    CHECK(r.size() == 4);
+    CHECK(r[0].entry.id.empty());
+    CHECK(r[0].entry.name == "Off");
+    CHECK(r[0].chosen);
+    CHECK(r[0].running);
+    CHECK(r[0].note.empty());
+    CHECK(!r[1].chosen && !r[1].running);
+    CHECK(status_line(installed(), "", "", false) == "Playing the normal game.");
+}
+
+TEST_CASE("conversions: a choice for the next start says so until the game restarts (#57)") {
+    const std::vector<Row> r = rows(installed(), "aew64", "", false);
+    CHECK(!r[0].chosen);
+    CHECK(r[0].running);
+    CHECK(r[0].note == "Running now; the next start runs AEW 64");
+    CHECK(r[1].chosen);
+    CHECK(r[1].note == "From the next start");
+    CHECK(status_line(installed(), "aew64", "", false) == "Restart the game to switch to AEW 64.");
+    // After the restart the same choice is running.
+    const std::vector<Row> after = rows(installed(), "aew64", "aew64", false);
+    CHECK(after[1].running && after[1].chosen);
+    CHECK(after[1].note == "Running now");
+    CHECK(status_line(installed(), "aew64", "aew64", false) == "Playing AEW 64.");
+    // And back to Off.
+    CHECK(status_line(installed(), "", "aew64", false) == "Restart the game to switch to the normal game.");
+}
+
+TEST_CASE("conversions: an unreadable conversion is listed but can't be chosen") {
+    const std::vector<Row> r = rows(installed(), "", "", false);
+    CHECK(!r[3].selectable);
+    CHECK(r[3].note == "Can't be played: aki.json: missing \"components\"");
+    CHECK(r[1].selectable && r[2].selectable && r[0].selectable);
+}
+
+TEST_CASE("conversions: a launcher run doesn't promise a restart switches (the launcher picks again) (#57 review)") {
+    // AKI Launcher started revse; the Mods menu's choice (for starts without the launcher) is aew64.
+    const std::vector<Row> r = rows(installed(), "aew64", "revse", true);
+    CHECK(r[2].running && !r[2].chosen);
+    CHECK(r[2].note == "Running now (picked by AKI Launcher)");
+    CHECK(r[1].chosen && r[1].note == "For starts without AKI Launcher");
+    CHECK(status_line(installed(), "aew64", "revse", true) ==
+        "AKI Launcher started Starrcade Edition 2.0. Starts without the launcher run AEW 64.");
+    CHECK(status_line(installed(), "", "revse", true) ==
+        "AKI Launcher started Starrcade Edition 2.0. Starts without the launcher run the normal game.");
+    // The launcher's pick and the choice agree: nothing to explain.
+    CHECK(status_line(installed(), "revse", "revse", true) == "Playing Starrcade Edition 2.0.");
+    CHECK(rows(installed(), "revse", "revse", true)[2].note == "Running now");
+}
diff --git a/recompui/tests/dd_metrics_rules_tests.cpp b/recompui/tests/dd_metrics_rules_tests.cpp
