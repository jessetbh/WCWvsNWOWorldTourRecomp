+++ b/recompui/tests/dd_metrics_rules_tests.cpp
@@ -0,0 +1,34 @@
+// [wcw dd] Unit tests for the Datadog metrics switch (src/config/dd_metrics_rules, aki-roadmap#148). Built and run as
+// part of every recompui build (RECOMPUI_WCW_TESTS); a failure fails the build.
+
+#include "dd_metrics_rules.h"
+
+#include <cstring>
+
+#include "wcw_test.h"
+
+using namespace recompui::dd_metrics_rules;
+
+TEST_CASE("dd metrics: off by default (no variable, setting off)") {
+    CHECK(env_value_to_set(nullptr, false) == nullptr);
+    CHECK(!metrics_on(nullptr, false));
+}
+
+TEST_CASE("dd metrics: the setting turns them on when the variable isn't set") {
+    CHECK(std::strcmp(env_value_to_set(nullptr, true), "1") == 0);
+    CHECK(metrics_on(nullptr, true));
+    // An empty variable counts as unset (rt64 reads it as off), so the setting still applies.
+    CHECK(std::strcmp(env_value_to_set("", true), "1") == 0);
+    CHECK(metrics_on("", true));
+    CHECK(!metrics_on("", false));
+}
+
+TEST_CASE("dd metrics: a set variable wins over the setting, both ways") {
+    for (bool setting : { false, true }) {
+        CHECK(env_value_to_set("1", setting) == nullptr);
+        CHECK(env_value_to_set("0", setting) == nullptr);
+        CHECK(metrics_on("1", setting));
+        CHECK(metrics_on("yes", setting));
+        CHECK(!metrics_on("0", setting));     // WCW_DD_METRICS=0 forces them off even with the setting on
+    }
+}
diff --git a/recompui/tests/framerate_rules_tests.cpp b/recompui/tests/framerate_rules_tests.cpp
new file mode 100644
index 0000000..4047081
--- /dev/null
+++ b/recompui/tests/framerate_rules_tests.cpp
@@ -0,0 +1,93 @@
+// [wcw] Unit tests for the Framerate option's rules (src/config/framerate_rules). Built and run as part of every
+// recompui build (RECOMPUI_WCW_TESTS); a failure fails the build.
+
+#include "framerate_rules.h"
+
+#include "wcw_test.h"
+
+using ultramodern::renderer::RefreshRate;
+using namespace recompui::framerate;
+
+static int rateOf(RefreshRate option) {
+    return static_cast<int>(option);
+}
+
+// What the renderer runs at for a saved choice: load it, then apply it as the menu does.
+static void loadAndApply(const nlohmann::json &saved, uint32_t smooth_rate, RefreshRate &option, int &manual_value) {
+    option = parse_saved_option(saved, smooth_rate);
+    manual_value = 0;
+    apply_choice(option, manual_value, smooth_rate);
+}
+
+TEST_CASE("a saved 120 (Smooth2x) loads and runs at 120") {
+    RefreshRate option;
+    int value;
+    loadAndApply("Smooth2x", 60, option, value);
+    CHECK_EQ(rateOf(option), rateOf(RefreshRate::Manual));
+    CHECK_EQ(value, 120);
+}
+
+TEST_CASE("a saved Manual always runs at the smooth rate, whatever rr_manual_value says (120 was really 60)") {
+    // "Manual" is the stored name of the 60 (Smooth) choice: writing rr_option = Manual with rr_manual_value = 120
+    // into graphics.json gives 60, not 120. 120 is stored as "Smooth2x".
+    RefreshRate option;
+    int value;
+    loadAndApply("Manual", 60, option, value);
+    CHECK_EQ(rateOf(option), rateOf(RefreshRate::Manual));
+    CHECK_EQ(value, 60);
+    loadAndApply(static_cast<uint32_t>(RefreshRate::Manual), 60, option, value);
+    CHECK_EQ(rateOf(option), rateOf(RefreshRate::Manual));
+    CHECK_EQ(value, 60);
+}
+
+TEST_CASE("Original stays 30 (Original)") {
+    RefreshRate option;
+    int value;
+    loadAndApply("Original", 60, option, value);
+    CHECK_EQ(rateOf(option), rateOf(RefreshRate::Original));
+}
+
+TEST_CASE("a stale Display from older builds loads as Original") {
+    CHECK_EQ(rateOf(parse_saved_option("Display", 60)), rateOf(RefreshRate::Original));
+    CHECK_EQ(rateOf(parse_saved_option(static_cast<uint32_t>(RefreshRate::Display), 60)), rateOf(RefreshRate::Original));
+}
+
+TEST_CASE("unknown or malformed values load as Original") {
+    CHECK_EQ(rateOf(parse_saved_option("Bogus", 60)), rateOf(RefreshRate::Original));
+    CHECK_EQ(rateOf(parse_saved_option(nlohmann::json(), 60)), rateOf(RefreshRate::Original));
+    CHECK_EQ(rateOf(parse_saved_option(true, 60)), rateOf(RefreshRate::Original));
+}
+
+TEST_CASE("games without frame interpolation always run at Original") {
+    RefreshRate option;
+    int value;
+    for (const char *saved : { "Manual", "Smooth2x", "Display", "Original" }) {
+        loadAndApply(saved, 0, option, value);
+        CHECK_EQ(rateOf(option), rateOf(RefreshRate::Original));
+    }
+
+    option = RefreshRate::Manual;
+    value = 0;
+    apply_choice(option, value, 0);
+    CHECK_EQ(rateOf(option), rateOf(RefreshRate::Original));
+}
+
+TEST_CASE("the menu's choices map to the renderer's rate") {
+    RefreshRate option = RefreshRate::Manual;
+    int value = 999;
+    apply_choice(option, value, 60);
+    CHECK_EQ(value, 60);
+    option = RefreshRate::Display;
+    apply_choice(option, value, 60);
+    CHECK_EQ(rateOf(option), rateOf(RefreshRate::Manual));
+    CHECK_EQ(value, 120);
+    option = RefreshRate::Original;
+    value = 7;
+    apply_choice(option, value, 60);
+    CHECK_EQ(rateOf(option), rateOf(RefreshRate::Original));
+    CHECK_EQ(value, 7);
+}
+
+int main() {
+    return WcwTest::runAll("recompui wcw tests");
+}
diff --git a/recompui/tests/graphics_presets_tests.cpp b/recompui/tests/graphics_presets_tests.cpp
new file mode 100644
index 0000000..26b6b5a
--- /dev/null
+++ b/recompui/tests/graphics_presets_tests.cpp
@@ -0,0 +1,276 @@
+// [wcw] Unit tests for the graphics presets (src/config/graphics_presets). Built and run as part of every recompui
+// build (RECOMPUI_WCW_TESTS); a failure fails the build.
+
+#include "graphics_presets.h"
+
+#include "wcw_test.h"
+
+using ultramodern::renderer::Antialiasing;
+using ultramodern::renderer::AspectRatio;
+using ultramodern::renderer::RefreshRate;
+using namespace recompui::config;
+using namespace recompui::config::presets;
+
+template <typename T>
+static int val(T value) {
+    return static_cast<int>(value);
+}
+
+// A game with frame interpolation (smooth rate 60) on a 144 Hz display with an MSAA 4x GPU.
+static Limits interpolating() {
+    Limits limits;
+    limits.smooth_rate = 60;
+    limits.display_rate = 144;
+    limits.max_msaa = Antialiasing::MSAA4X;
+    return limits;
+}
+
+static Settings preset(Preset p, const Limits &limits = interpolating()) {
+    return settings_for(p, limits).value();
+}
+
+TEST_CASE("Authentic is the game as it shipped on a composite TV") {
+    const Settings s = preset(Preset::Authentic);
+    CHECK_EQ(val(s.aspect_ratio), val(AspectRatio::Original));
+    CHECK_EQ(val(s.framerate), val(RefreshRate::Original));
+    CHECK_EQ(val(s.msaa), val(Antialiasing::None));
+    CHECK_EQ(val(s.crt), val(CrtFilterOption::On));
+    CHECK_EQ(val(s.crt_signal), val(CrtSignalOption::Composite));
+    CHECK_EQ(val(s.rt), val(RayTracingOption::Off));
+    CHECK_EQ(val(s.hdr), val(HdrOption::Off));
+}
+
+TEST_CASE("Enhanced is Expand, 60 fps (Smooth), MSAA 4x, no ray tracing, CRT or HDR") {
+    const Settings s = preset(Preset::Enhanced);
+    CHECK_EQ(val(s.aspect_ratio), val(AspectRatio::Expand));
+    CHECK_EQ(val(s.framerate), val(RefreshRate::Manual));
+    CHECK_EQ(val(s.msaa), val(Antialiasing::MSAA4X));
+    CHECK_EQ(val(s.crt), val(CrtFilterOption::Off));
+    CHECK_EQ(val(s.rt), val(RayTracingOption::Off));
+    CHECK_EQ(val(s.hdr), val(HdrOption::Off));
+}
+
+TEST_CASE("Enhanced Ray Tracing is Expand, 60 fps (Smooth), MSAA 4x, RT Balanced, no CRT or HDR") {
+    const Settings s = preset(Preset::EnhancedRayTracing);
+    CHECK_EQ(val(s.aspect_ratio), val(AspectRatio::Expand));
+    CHECK_EQ(val(s.framerate), val(RefreshRate::Manual));
+    CHECK_EQ(val(s.msaa), val(Antialiasing::MSAA4X));
+    CHECK_EQ(val(s.crt), val(CrtFilterOption::Off));
+    CHECK_EQ(val(s.rt), val(RayTracingOption::On));
+    CHECK_EQ(val(s.rt_quality), val(RayTracingQuality::Balanced));
+    CHECK_EQ(val(s.hdr), val(HdrOption::Off));
+}
+
+TEST_CASE("Enhanced and Enhanced Ray Tracing differ only in ray tracing") {
+    const Settings plain = preset(Preset::Enhanced);
+    Settings s = preset(Preset::EnhancedRayTracing);
+    s.rt = RayTracingOption::Off;
+    CHECK_EQ(val(s.aspect_ratio), val(plain.aspect_ratio));
+    CHECK_EQ(val(s.framerate), val(plain.framerate));
+    CHECK_EQ(val(s.msaa), val(plain.msaa));
+    CHECK_EQ(val(s.crt), val(plain.crt));
+    CHECK_EQ(val(s.hdr), val(plain.hdr));
+    CHECK_EQ(val(matching_preset(s, interpolating())), val(Preset::Enhanced));
+}
+
+TEST_CASE("the default is Enhanced, with ray tracing off") {
+    // The tab builds the options' defaults from settings_for(Enhanced) and the Preset option defaults to Enhanced, so a
+    // fresh config is these settings.
+    const Settings defaults = preset(Preset::Enhanced);
+    CHECK_EQ(val(defaults.rt), val(RayTracingOption::Off));
+    CHECK_EQ(val(matching_preset(defaults, interpolating())), val(Preset::Enhanced));
+
+    // The default Settings (Expand, Original framerate, no MSAA) match nothing; only Enhanced's do.
+    CHECK_EQ(val(matching_preset(Settings{}, interpolating())), val(Preset::Custom));
+}
+
+TEST_CASE("the old Enhanced (RT Balanced) now matches Enhanced Ray Tracing") {
+    Settings s;
+    s.aspect_ratio = AspectRatio::Expand;
+    s.framerate = RefreshRate::Manual;
+    s.msaa = Antialiasing::MSAA4X;
+    s.rt = RayTracingOption::On;
+    s.rt_quality = RayTracingQuality::Balanced;
+    CHECK_EQ(val(matching_preset(s, interpolating())), val(Preset::EnhancedRayTracing));
+    CHECK(!matches(Preset::Enhanced, s, interpolating()));
+}
+
+TEST_CASE("stored preset values follow the menu order") {
+    CHECK_EQ(val(Preset::Authentic), 0);
+    CHECK_EQ(val(Preset::Enhanced), 1);
+    CHECK_EQ(val(Preset::EnhancedRayTracing), 2);
+    CHECK_EQ(val(Preset::Max), 3);
+    CHECK_EQ(val(Preset::Custom), 4);
+}
+
+TEST_CASE("Max is 60 fps (Smooth), MSAA 4x, RT Ultra, HDR Auto") {
+    const Settings s = preset(Preset::Max);
+    CHECK_EQ(val(s.aspect_ratio), val(AspectRatio::Expand));
+    CHECK_EQ(val(s.framerate), val(RefreshRate::Manual));
+    CHECK_EQ(val(s.msaa), val(Antialiasing::MSAA4X));
+    CHECK_EQ(val(s.crt), val(CrtFilterOption::Off));
+    CHECK_EQ(val(s.rt), val(RayTracingOption::On));
+    CHECK_EQ(val(s.rt_quality), val(RayTracingQuality::Ultra));
+    CHECK_EQ(val(s.hdr), val(HdrOption::On));
+    CHECK_EQ(val(s.hdr_picture), val(HdrPictureOption::Auto));
+}
+
+TEST_CASE("Max never pairs RT Ultra with 120 fps, whatever the display (aki-roadmap#165)") {
+    Limits limits = interpolating();
+    for (uint32_t rate : { 0u, 60u, 100u, 119u, 120u, 144u, 165u, 240u }) {
+        limits.display_rate = rate;
+        const Settings s = preset(Preset::Max, limits);
+        CHECK_EQ(val(s.rt_quality), val(RayTracingQuality::Ultra));
+        CHECK_EQ(val(s.framerate), val(RefreshRate::Manual));
+    }
+}
+
+TEST_CASE("Max with 120 fps chosen by hand is Custom (aki-roadmap#165)") {
+    Limits limits = interpolating();
+    limits.display_rate = 165;
+    Settings s = preset(Preset::Max, limits);
+    CHECK_EQ(val(matching_preset(s, limits)), val(Preset::Max));
+    s.framerate = RefreshRate::Display;
+    CHECK_EQ(val(matching_preset(s, limits)), val(Preset::Custom));
+}
+
+TEST_CASE("a game with a locked framerate stays at Original in every preset") {
+    Limits limits = interpolating();
+    limits.smooth_rate = 0;
+    for (Preset p : { Preset::Authentic, Preset::Enhanced, Preset::EnhancedRayTracing, Preset::Max }) {
+        CHECK_EQ(val(preset(p, limits).framerate), val(RefreshRate::Original));
+    }
+}
+
+TEST_CASE("MSAA is capped at what the GPU offers") {
+    Limits limits = interpolating();
+    limits.max_msaa = Antialiasing::MSAA2X;
+    CHECK_EQ(val(preset(Preset::Enhanced, limits).msaa), val(Antialiasing::MSAA2X));
+    CHECK_EQ(val(preset(Preset::EnhancedRayTracing, limits).msaa), val(Antialiasing::MSAA2X));
+    CHECK_EQ(val(preset(Preset::Max, limits).msaa), val(Antialiasing::MSAA2X));
+    limits.max_msaa = Antialiasing::None;
+    CHECK_EQ(val(preset(Preset::Max, limits).msaa), val(Antialiasing::None));
+}
+
+TEST_CASE("Custom sets nothing") {
+    CHECK(!settings_for(Preset::Custom, interpolating()).has_value());
+    CHECK(!matches(Preset::Custom, preset(Preset::Enhanced), interpolating()));
+    CHECK(!matches(Preset::Custom, preset(Preset::EnhancedRayTracing), interpolating()));
+}
+
+TEST_CASE("each preset's settings match that preset") {
+    for (Preset p : { Preset::Authentic, Preset::Enhanced, Preset::EnhancedRayTracing, Preset::Max }) {
+        CHECK_EQ(val(matching_preset(preset(p), interpolating())), val(p));
+    }
+
+    Limits locked = interpolating();
+    locked.smooth_rate = 0;
+    locked.max_msaa = Antialiasing::None;
+    for (Preset p : { Preset::Authentic, Preset::Enhanced, Preset::EnhancedRayTracing, Preset::Max }) {
+        CHECK_EQ(val(matching_preset(preset(p, locked), locked)), val(p));
+    }
+}
+
+TEST_CASE("changing any one option a preset sets makes it Custom") {
+    for (Preset p : { Preset::Authentic, Preset::Enhanced, Preset::EnhancedRayTracing, Preset::Max }) {
+        const Settings base = preset(p);
+        Settings s;
+
+        s = base;
+        s.aspect_ratio = (base.aspect_ratio == AspectRatio::Expand) ? AspectRatio::Original : AspectRatio::Expand;
+        CHECK_EQ(val(matching_preset(s, interpolating())), val(Preset::Custom));
+
+        s = base;
+        s.framerate = (base.framerate == RefreshRate::Original) ? RefreshRate::Manual : RefreshRate::Original;
+        CHECK_EQ(val(matching_preset(s, interpolating())), val(Preset::Custom));
+
+        s = base;
+        s.msaa = (base.msaa == Antialiasing::MSAA2X) ? Antialiasing::None : Antialiasing::MSAA2X;
+        CHECK_EQ(val(matching_preset(s, interpolating())), val(Preset::Custom));
+
+        s = base;
+        s.crt = (base.crt == CrtFilterOption::On) ? CrtFilterOption::Off : CrtFilterOption::On;
+        CHECK_EQ(val(matching_preset(s, interpolating())), val(Preset::Custom));
+
+        s = base;
+        s.rt = (base.rt == RayTracingOption::On) ? RayTracingOption::Off : RayTracingOption::On;
+        // Ray tracing is the one difference between Enhanced and Enhanced Ray Tracing.
+        const Preset rt_toggled = (p == Preset::Enhanced) ? Preset::EnhancedRayTracing :
+            (p == Preset::EnhancedRayTracing) ? Preset::Enhanced : Preset::Custom;
+        CHECK_EQ(val(matching_preset(s, interpolating())), val(rt_toggled));
+
+        s = base;
+        s.hdr = (base.hdr == HdrOption::On) ? HdrOption::Off : HdrOption::On;
+        CHECK_EQ(val(matching_preset(s, interpolating())), val(Preset::Custom));
+    }
+
+    Settings s = preset(Preset::Authentic);
+    s.crt_signal = CrtSignalOption::RGB;
+    CHECK_EQ(val(matching_preset(s, interpolating())), val(Preset::Custom));
+
+    s = preset(Preset::EnhancedRayTracing);
+    s.rt_quality = RayTracingQuality::Quality;
+    CHECK_EQ(val(matching_preset(s, interpolating())), val(Preset::Custom));
+
+    s = preset(Preset::Max);
+    s.hdr_picture = HdrPictureOption::Brighter;
+    CHECK_EQ(val(matching_preset(s, interpolating())), val(Preset::Custom));
+}
+
+TEST_CASE("hidden sub-options don't count: CRT signal with CRT off, RT quality with RT off, HDR picture with HDR off") {
+    Settings s = preset(Preset::Enhanced);
+    s.crt_signal = CrtSignalOption::RF;
+    s.hdr_picture = HdrPictureOption::CrtDetail;
+    CHECK_EQ(val(matching_preset(s, interpolating())), val(Preset::Enhanced));
+
+    s = preset(Preset::Authentic);
+    s.rt_quality = RayTracingQuality::Ultra;
+    CHECK_EQ(val(matching_preset(s, interpolating())), val(Preset::Authentic));
+
+    s = preset(Preset::Enhanced);
+    s.rt_quality = RayTracingQuality::Performance;
+    CHECK_EQ(val(matching_preset(s, interpolating())), val(Preset::Enhanced));
+}
+
+TEST_CASE("options the presets leave alone don't count") {
+    // Window mode, resolution, HUD placement, CRT colors and beam simulator aren't part of Settings at all; a framerate
+    // the game locks doesn't count either.
+    Limits locked = interpolating();
+    locked.smooth_rate = 0;
+    Settings s = preset(Preset::Enhanced, locked);
+    s.framerate = RefreshRate::Manual;
+    CHECK_EQ(val(matching_preset(s, locked)), val(Preset::Enhanced));
+}
+
+TEST_CASE("MSAA above what the GPU offers counts as the GPU's highest level") {
+    // A saved MSAA 4x on a 2x-only GPU runs as 2x, which is what Enhanced asks for there.
+    Limits limits = interpolating();
+    limits.max_msaa = Antialiasing::MSAA2X;
+    Settings s = preset(Preset::Enhanced, interpolating());
+    CHECK_EQ(val(s.msaa), val(Antialiasing::MSAA4X));
+    CHECK_EQ(val(matching_preset(s, limits)), val(Preset::Enhanced));
+}
+
+TEST_CASE("Max on a 60 Hz display matches at the smooth rate, not at 120") {
+    Limits limits = interpolating();
+    limits.display_rate = 60;
+    Settings s = preset(Preset::Max, limits);
+    CHECK_EQ(val(matching_preset(s, limits)), val(Preset::Max));
+    s.framerate = RefreshRate::Display;
+    CHECK_EQ(val(matching_preset(s, limits)), val(Preset::Custom));
+}
+
+TEST_CASE("the preset labels are the short ones, so the row fits on one line") {
+    CHECK(std::string(label(Preset::Authentic)) == "Authentic");
+    CHECK(std::string(label(Preset::Enhanced)) == "Enhanced");
+    CHECK(std::string(label(Preset::EnhancedRayTracing)) == "Enhanced RT");
+    CHECK(std::string(label(Preset::Max)) == "Max");
+    CHECK(std::string(label(Preset::Custom)) == "Custom");
+    // "Enhanced Ray Tracing" wrapped onto two lines in the menu.
+    size_t total = 0;
+    for (Preset p : { Preset::Authentic, Preset::Enhanced, Preset::EnhancedRayTracing, Preset::Max, Preset::Custom }) {
+        CHECK(std::string(label(p)).size() <= 11);
+        total += std::string(label(p)).size();
+    }
+    CHECK(total <= 40);
+}
diff --git a/recompui/tests/graphics_rules_tests.cpp b/recompui/tests/graphics_rules_tests.cpp
new file mode 100644
index 0000000..d617ed0
--- /dev/null
+++ b/recompui/tests/graphics_rules_tests.cpp
@@ -0,0 +1,44 @@
+// [wcw] Unit tests for the Resolution / Downsampling / Supersampling and MSAA rules (src/config/graphics_rules).
+// Built and run as part of every recompui build (RECOMPUI_WCW_TESTS); a failure fails the build.
+
+#include "graphics_rules.h"
+
+#include "wcw_test.h"
+
+using ultramodern::renderer::Antialiasing;
+using ultramodern::renderer::Resolution;
+using namespace recompui::graphics_rules;
+
+TEST_CASE("supersampling: Auto renders at twice the window's scale with Supersampling 2x") {
+    CHECK_EQ(downsample_multiplier(Resolution::Auto, 0, 2), 2);
+    CHECK_EQ(downsample_multiplier(Resolution::Auto, 0, 0), 1);
+    // Downsampling Quality is for Original and Original 2x; at Auto it no longer forces 1x (it used to), but it
+    // doesn't apply either: a saved 4x there doesn't turn on supersampling.
+    CHECK_EQ(downsample_multiplier(Resolution::Auto, 4, 0), 1);
+    CHECK_EQ(downsample_multiplier(Resolution::Auto, 4, 2), 2);
+}
+
+TEST_CASE("supersampling: Auto caps at 2x whatever the saved value") {
+    CHECK_EQ(downsample_multiplier(Resolution::Auto, 0, 4), 2);
+    CHECK_EQ(downsample_multiplier(Resolution::Auto, 0, 1), 1);
+    CHECK_EQ(downsample_multiplier(Resolution::Auto, 0, -3), 1);
+}
+
+TEST_CASE("supersampling: Original and Original 2x keep Downsampling Quality and ignore Supersampling") {
+    for (Resolution resolution : { Resolution::Original, Resolution::Original2x }) {
+        CHECK_EQ(downsample_multiplier(resolution, 0, 2), 1);
+        CHECK_EQ(downsample_multiplier(resolution, 2, 0), 2);
+        CHECK_EQ(downsample_multiplier(resolution, 4, 2), 4);
+    }
+}
+
+TEST_CASE("msaa: 8x is offered only on devices that support it") {
+    CHECK(msaa_level_supported(Antialiasing::MSAA8X, Antialiasing::MSAA8X));
+    CHECK(!msaa_level_supported(Antialiasing::MSAA8X, Antialiasing::MSAA4X));
+    CHECK(!msaa_level_supported(Antialiasing::MSAA8X, Antialiasing::None));
+    CHECK(msaa_level_supported(Antialiasing::MSAA4X, Antialiasing::MSAA8X));
+    CHECK(!msaa_level_supported(Antialiasing::MSAA4X, Antialiasing::MSAA2X));
+    CHECK(msaa_level_supported(Antialiasing::MSAA2X, Antialiasing::MSAA2X));
+    CHECK(!msaa_level_supported(Antialiasing::MSAA2X, Antialiasing::None));
+    CHECK(msaa_level_supported(Antialiasing::None, Antialiasing::None));
+}
diff --git a/recompui/tests/input_rules_tests.cpp b/recompui/tests/input_rules_tests.cpp
new file mode 100644
index 0000000..75539ea
--- /dev/null
+++ b/recompui/tests/input_rules_tests.cpp
@@ -0,0 +1,94 @@
+// [wcw fix] Unit tests for the host-to-N64 input rules (recompinput/src/input_rules, aki-roadmap#305). Built and run as
+// part of every recompui build (RECOMPUI_WCW_TESTS); a failure fails the build.
+
+#include "recompinput/input_rules.h"
+
+#include <vector>
+
+#include "wcw_test.h"
+
+using namespace recompinput::input_rules;
+
+// Feeds a run of axis values through the rule, as the game's reads would, and counts the presses it sees.
+static int count_presses(const std::vector<float> &values) {
+    bool down = false;
+    int presses = 0;
+    for (float v : values) {
+        const bool now = analog_as_digital(down, v);
+        if (now && !down) {
+            presses++;
+        }
+        down = now;
+    }
+    return presses;
+}
+
+TEST_CASE("input: a stick press goes down at the press threshold and up below the release threshold") {
+    CHECK(!analog_as_digital(false, 0.0f));
+    CHECK(!analog_as_digital(false, 0.49f));
+    CHECK(analog_as_digital(false, 0.5f));
+    CHECK(analog_as_digital(true, 0.49f));
+    CHECK(analog_as_digital(true, analog_release_threshold));
+    CHECK(!analog_as_digital(true, 0.34f));
+    CHECK(!analog_as_digital(true, 0.0f));
+    CHECK(analog_release_threshold < analog_press_threshold);
+}
+
+TEST_CASE("input: a stick wobbling around the threshold is one press, not several") {
+    // Regression for #305: a push that settles near 0.5 (or wobbles back through it on release) was press, release,
+    // press with the old single threshold.
+    CHECK_EQ(count_presses({ 0.0f, 0.3f, 0.52f, 0.47f, 0.53f, 0.48f, 0.51f, 0.2f, 0.0f }), 1);
+    CHECK_EQ(count_presses({ 0.0f, 1.0f, 1.0f, 0.45f, 0.55f, 0.4f, 0.0f }), 1);
+}
+
+TEST_CASE("input: separate pushes still count") {
+    CHECK_EQ(count_presses({ 0.0f, 1.0f, 0.0f, 1.0f, 0.1f, 0.9f, 0.0f }), 3);
+    // Coming back only to 0.3 is a release, so a second push from there is a second press.
+    CHECK_EQ(count_presses({ 0.0f, 0.8f, 0.3f, 0.8f, 0.0f }), 2);
+}
+
+// --- Player slots for connected pads (aki-roadmap#304) ---
+
+static SlotView pad_slot() { return SlotView{ true, false, 0 }; }
+static SlotView left_slot(uint64_t by) { return SlotView{ false, false, by }; }
+static SlotView keyboard_slot() { return SlotView{ false, true, 0 }; }
+
+TEST_CASE("slots: a new pad joins as the next player while there is room") {
+    CHECK_EQ(slot_for_connected_pad({}, 4, 11), slot_append);
+    CHECK_EQ(slot_for_connected_pad({ pad_slot() }, 4, 11), slot_append);
+    CHECK_EQ(slot_for_connected_pad({ pad_slot(), pad_slot(), pad_slot(), pad_slot() }, 4, 11), slot_none);
+    CHECK_EQ(slot_for_connected_pad({ pad_slot() }, 1, 11), slot_none);
+}
+
+TEST_CASE("slots: two pads that drop out together come back to their own players") {
+    // Regression for #304: player 2's pad reconnected first and took player 1 (ch0 carried pad 2's presses).
+    const std::vector<SlotView> both_left = { left_slot(11), left_slot(22) };
+    CHECK_EQ(slot_for_connected_pad(both_left, 4, 22), 1);
+    CHECK_EQ(slot_for_connected_pad({ left_slot(11), pad_slot() }, 4, 11), 0);
+    CHECK_EQ(slot_for_connected_pad(both_left, 4, 11), 0);
+}
+
+TEST_CASE("slots: a pad that left takes its slot back over an earlier empty one") {
+    CHECK_EQ(slot_for_connected_pad({ pad_slot(), left_slot(11), left_slot(33) }, 4, 33), 2);
+}
+
+TEST_CASE("slots: a different pad takes the first empty slot, so a player who swaps pads keeps their player") {
+    // One player, pad unplugged, another pad picked up: it must drive player 1, not join as player 2.
+    CHECK_EQ(slot_for_connected_pad({ left_slot(11) }, 4, 99), 0);
+    CHECK_EQ(slot_for_connected_pad({ pad_slot(), left_slot(11), left_slot(22) }, 4, 99), 1);
+}
+
+TEST_CASE("slots: two identical pads (same key) fall back to the first empty slot") {
+    CHECK_EQ(slot_for_connected_pad({ left_slot(11), left_slot(11) }, 4, 11), 0);
+}
+
+TEST_CASE("slots: an unknown pad (key 0) never matches a slot left by an unknown pad") {
+    CHECK_EQ(slot_for_connected_pad({ pad_slot(), left_slot(0), left_slot(0) }, 4, 0), 1);
+    CHECK_EQ(slot_for_connected_pad({ left_slot(55), left_slot(0) }, 4, 0), 0);
+}
+
+TEST_CASE("slots: a keyboard player's slot is never given to a pad") {
+    CHECK_EQ(slot_for_connected_pad({ keyboard_slot() }, 4, 11), slot_append);
+    CHECK_EQ(slot_for_connected_pad({ keyboard_slot(), left_slot(11) }, 4, 11), 1);
+    CHECK_EQ(slot_for_connected_pad({ keyboard_slot() }, 1, 11), slot_none);
+}
