diff --git a/recompinput/src/input_rules.cpp b/recompinput/src/input_rules.cpp
new file mode 100644
index 0000000..af0ad8e
--- /dev/null
+++ b/recompinput/src/input_rules.cpp
@@ -0,0 +1,24 @@
+#include "recompinput/input_rules.h"
+
+namespace recompinput::input_rules {
+    bool analog_as_digital(bool was_pressed, float value) {
+        return value >= (was_pressed ? analog_release_threshold : analog_press_threshold);
+    }
+
+    int slot_for_connected_pad(const std::vector<SlotView> &slots, size_t max_slots, uint64_t pad_id) {
+        auto empty = [](const SlotView &slot) { return !slot.has_controller && !slot.keyboard; };
+        if (pad_id != 0) {
+            for (size_t i = 0; i < slots.size(); i++) {
+                if (empty(slots[i]) && slots[i].left_by == pad_id) {
+                    return (int)i;
+                }
+            }
+        }
+        for (size_t i = 0; i < slots.size(); i++) {
+            if (empty(slots[i])) {
+                return (int)i;
+            }
+        }
+        return slots.size() < max_slots ? slot_append : slot_none;
+    }
+}
