+// [wcw fix] Plug-and-play multiplayer assignment (see players.h). The slot comes from
+// input_rules::slot_for_connected_pad (aki-roadmap#304): a pad that was unplugged gets its own player back.
+void players::auto_assign_controller(SDL_GameController* controller) {
+    if (controller == nullptr || PlayerState.single_player_mode || PlayerState.is_assigning) {
+        return;
+    }
+
+    std::vector<input_rules::SlotView> slots;
+    for (size_t i = 0; i < PlayerState.players.get_count(); i++) {
+        const Player& player = PlayerState.players[i];
+        if (player.controller == controller) {
+            return; // already assigned
+        }
+        slots.push_back({ player.controller != nullptr, player.keyboard_enabled, player.left_by });
+    }
+
+    const uint64_t pad_id = profiles::get_guid_from_sdl_controller(controller).hash;
+    int slot = input_rules::slot_for_connected_pad(slots, players::get_max_number_of_players(), pad_id);
+    if (slot == input_rules::slot_none) {
+        return; // all player slots taken
+    }
+    if (slot == input_rules::slot_append) {
+        PlayerState.players.add_controller_player(controller);
+        slot = (int)PlayerState.players.get_count() - 1;
+    }
+    else {
+        PlayerState.players[slot].controller = controller;
+        PlayerState.players[slot].left_by = 0;
+        PlayerState.players[slot].button_pressed();
+    }
+
+    int cont_profile_index = profiles::get_controller_profile_index_from_sdl_controller(controller);
+    if (cont_profile_index >= 0) {
+        profiles::set_input_profile_for_player(slot, cont_profile_index, InputDevice::Controller);
+    }
+    printf("Auto-assigned controller to player %d\n", slot + 1);
+}
+
+// [wcw fix] See players.h.
+void players::handle_controller_removed(SDL_GameController* controller) {
+    if (controller == nullptr) {
+        return;
+    }
+    // The pad's key, so it gets this slot back when it reconnects (#304). The controller is still open here.
+    const uint64_t pad_id = profiles::get_guid_from_sdl_controller(controller).hash;
+    for (size_t i = 0; i < PlayerState.players.get_count(); i++) {
+        if (PlayerState.players[i].controller == controller) {
+            PlayerState.players[i].controller = nullptr;
+            PlayerState.players[i].left_by = pad_id;
+        }
+    }
+    for (size_t i = 0; i < PlayerState.temp_players.get_count(); i++) {
+        if (PlayerState.temp_players[i].controller == controller) {
+            PlayerState.temp_players[i].controller = nullptr;
+        }
+    }
+}
