+++ b/recompui/src/config/mod_tabs.h
@@ -0,0 +1,28 @@
+#pragma once
+
+#include <string>
+#include <vector>
+
+// [wcw] The Mods menu's kind tabs and its package Install (aki-roadmap#154 step 5). All lists every opened mod in mod
+// order (and is the only tab that can reorder them); Add-ons lists those that carry code or a ROM patch; Texture
+// packs lists the data packs. Model packs and Conversions open their own dialogs. Kept free of UI and librecomp types
+// so it can be unit tested (recompui/tests).
+namespace recompui::config::mod_tabs {
+    enum class Tab { All, Addons, TexturePacks };
+
+    // Whether a mod with these contents is listed on that tab.
+    bool shows(Tab tab, bool code, bool rom_patch);
+    // The first index whose flag is set, or -1.
+    int first_visible(const std::vector<bool> &visible);
+
+    // One installed or refused package, for the summary shown after Install.
+    struct Outcome {
+        std::string name;       // display name, or the file name when the package couldn't be read
+        std::string outcome;    // librecomp's outcome_name: installed, upgraded, ..., refused, failed
+        std::string message;    // librecomp's one line for the player
+        std::vector<std::string> kept;   // edited files kept aside
+    };
+    // "Installed: A 1.0.0 ...\nNot installed: B (why)\n..." with the kept copies listed; true when anything failed
+    // (the summary is then shown as an error).
+    bool summarize(const std::vector<Outcome> &outcomes, std::string &text);
+}
diff --git a/recompui/src/config/model_pack_menu.cpp b/recompui/src/config/model_pack_menu.cpp
new file mode 100644
index 0000000..ef1fbf1
--- /dev/null
+++ b/recompui/src/config/model_pack_menu.cpp
@@ -0,0 +1,222 @@
+#include "model_pack_menu.h"
+
+#include <algorithm>
+
+#include "json/json.hpp"
+
+namespace recompui::config::model_pack_menu {
+    bool valid_pack_id(std::string_view id) {
+        if (id.empty() || id.size() > 31 || id == "off") {   // "off" starts the mod's off lines
+            return false;
+        }
+        for (char c : id) {
+            if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_' || c == '-')) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    // models.txt as lines (without their line ends), a UTF-8 BOM dropped. "\r\n", "\n" and "\r" all end a line, as
+    // in the mod's reader.
+    static std::vector<std::string> split_lines(const std::string &text) {
+        std::vector<std::string> lines;
+        size_t start = (text.compare(0, 3, "\xEF\xBB\xBF") == 0) ? 3 : 0;
+        std::string cur;
+        for (size_t i = start; i < text.size(); i++) {
+            const char c = text[i];
+            if (c == '\n' || c == '\r') {
+                lines.push_back(cur);
+                cur.clear();
+                if (c == '\r' && i + 1 < text.size() && text[i + 1] == '\n') {
+                    i++;
+                }
+            }
+            else {
+                cur.push_back(c);
+            }
+        }
+        if (!cur.empty()) {
+            lines.push_back(cur);
+        }
+        return lines;
+    }
+
+    // A line's words up to a '#' comment, split on spaces and tabs (the mod's reader).
+    static std::vector<std::string> words(const std::string &line) {
+        std::vector<std::string> out;
+        std::string cur;
+        for (char c : line) {
+            if (c == '#') {
+                break;
+            }
+            if (c == ' ' || c == '\t') {
+                if (!cur.empty()) {
+                    out.push_back(cur);
+                    cur.clear();
+                }
+            }
+            else {
+                cur.push_back(c);
+            }
+        }
+        if (!cur.empty()) {
+            out.push_back(cur);
+        }
+        return out;
+    }
+
+    // A number as the mod's parse_int reads it: decimal, or hex after 0x; -1 when it isn't one (or is out of range).
+    static long parse_number(const std::string &s) {
+        size_t i = 0;
+        bool neg = false;
+        if (i < s.size() && s[i] == '-') {
+            neg = true;
+            i++;
+        }
+        int base = 10;
+        if (i + 1 < s.size() && s[i] == '0' && (s[i + 1] == 'x' || s[i + 1] == 'X')) {
+            base = 16;
+            i += 2;
+        }
+        if (i >= s.size()) {
+            return -1;
+        }
+        long v = 0;
+        for (; i < s.size(); i++) {
+            const char c = s[i];
+            int d = (c >= '0' && c <= '9') ? c - '0' : (base == 16 && c >= 'a' && c <= 'f') ? c - 'a' + 10
+                  : (base == 16 && c >= 'A' && c <= 'F') ? c - 'A' + 10 : -1;
+            if (d < 0 || d >= base || v > 0xFFFFFF) {
+                return -1;
+            }
+            v = v * base + d;
+        }
+        return neg ? -v : v;
+    }
+
+    // "<pack> slot N" with N 1-4 (as the mod reads N): N, else 0.
+    static int slot_of_line(const std::vector<std::string> &w, std::string *pack = nullptr) {
+        if (w.size() != 3 || w[1] != "slot" || !valid_pack_id(w[0])) {
+            return 0;
+        }
+        const long n = parse_number(w[2]);
+        if (n < 1 || n > slot_count) {
+            return 0;
+        }
+        if (pack != nullptr) {
+            *pack = w[0];
+        }
+        return int(n);
+    }
+
+    static bool is_off_line(const std::vector<std::string> &w, std::string_view pack_id) {
+        return w.size() == 2 && w[0] == "off" && w[1] == pack_id;
+    }
+
+    static bool pack_is_off(const std::vector<std::string> &lines, std::string_view pack_id) {
+        for (const std::string &line : lines) {
+            if (is_off_line(words(line), pack_id)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    // The mod's pack_for_slot for slot lines: the first line for the slot decides; if its pack is off, the slot is
+    // empty (the mod doesn't look further).
+    static std::string slot_pack_of(const std::vector<std::string> &lines, int slot) {
+        for (const std::string &line : lines) {
+            std::string pack;
+            if (slot_of_line(words(line), &pack) == slot) {
+                return pack_is_off(lines, pack) ? std::string() : pack;
+            }
+        }
+        return "";
+    }
+
+    std::string slot_pack(const std::string &text, int slot) {
+        return slot_pack_of(split_lines(text), slot);
+    }
+
+    int pack_slot(const std::string &text, std::string_view pack_id) {
+        const std::vector<std::string> lines = split_lines(text);
+        for (int slot = 1; slot <= slot_count; slot++) {
+            if (slot_pack_of(lines, slot) == pack_id) {
+                return slot;
+            }
+        }
+        return 0;
+    }
+
+    std::string assign(const std::string &text, std::string_view pack_id, int slot) {
+        const std::string line_for_pack = std::string(pack_id) + " slot " + std::to_string(slot) + "\n";
+        std::string out;
+        bool placed = (slot == 0);
+        for (const std::string &line : split_lines(text)) {
+            const std::vector<std::string> w = words(line);
+            std::string pack;
+            const int line_slot = slot_of_line(w, &pack);
+            const bool slot_line = line_slot != 0 && (pack == pack_id || (slot != 0 && line_slot == slot));
+            if (slot_line && !placed) {
+                out += line_for_pack;   // where the line it replaces was
+                placed = true;
+            }
+            if (!slot_line && !(slot != 0 && is_off_line(w, pack_id))) {
+                out += line;
+                out += "\n";
+            }
+        }
+        if (!placed) {
+            out += line_for_pack;
+        }
+        return out;
+    }
+
+    Pack parse_pack_json(std::string_view id, const std::string &pack_json) {
+        Pack pack;
+        pack.id = std::string(id);
+        pack.name = pack.id;
+        const nlohmann::json j = nlohmann::json::parse(pack_json, nullptr, false);
+        if (!j.is_object()) {
+            return pack;
+        }
+        auto text = [&j](const char *key) -> std::string {
+            auto it = j.find(key);
+            return (it != j.end() && it->is_string()) ? it->get<std::string>() : std::string();
+        };
+        if (!text("name").empty()) {
+            pack.name = text("name");
+        }
+        pack.author = text("author");
+        pack.game = text("game");
+        return pack;
+    }
+
+    std::vector<Row> rows(const std::vector<Pack> &packs, const std::string &text) {
+        const std::vector<std::string> lines = split_lines(text);
+        std::vector<Row> out;
+        for (const Pack &pack : packs) {
+            Row row;
+            row.pack = pack;
+            row.slot = pack_slot(text, pack.id);
+            if (pack_is_off(lines, pack.id)) {
+                row.note = "Off in models.txt";
+            }
+            else {
+                for (const std::string &line : lines) {
+                    const std::vector<std::string> w = words(line);
+                    if (w.size() >= 3 && w[0] == pack.id && w[1] == "wrestler") {
+                        row.note = "Also replaces wrestlers by id (models.txt)";
+                        break;
+                    }
+                }
+            }
+            out.push_back(row);
+        }
+        std::stable_sort(out.begin(), out.end(), [](const Row &a, const Row &b) {
+            return (a.pack.name != b.pack.name) ? (a.pack.name < b.pack.name) : (a.pack.id < b.pack.id);
+        });
+        return out;
+    }
+}
diff --git a/recompui/src/config/model_pack_menu.h b/recompui/src/config/model_pack_menu.h
new file mode 100644
index 0000000..d8f7b80
--- /dev/null
+++ b/recompui/src/config/model_pack_menu.h
@@ -0,0 +1,49 @@
+#pragma once
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+// [wcw model import] The Mods menu's Model packs dialog (aki-roadmap#130): the packs in <mods>/models and which wrestler
+// slot each one replaces, read from and written to <mods>/models/models.txt (the aki_modelimport mod's assignments
+// file; its rules: AkiMods mods/modelimport/README.md). Kept free of UI and file I/O so it can be unit tested
+// (recompui/tests).
+//
+// The dialog only manages "<pack> slot N" lines: picking a slot for a pack drops every other line that gives that slot
+// to a pack or this pack to a slot, and an "off <pack>" line for it; picking Off drops the pack's slot lines. Comments,
+// wrestler / costume lines and everything else stay as they are.
+namespace recompui::config::model_pack_menu {
+    constexpr int slot_count = 4;
+
+    // A pack id as the mod accepts it: a-z 0-9 _ -, 1 to 31 characters.
+    bool valid_pack_id(std::string_view id);
+
+    // The slot (1-4) a models.txt gives the pack with a "slot" line (the first such line), or 0. A pack turned off
+    // ("off <pack>") has none.
+    int pack_slot(const std::string &text, std::string_view pack_id);
+
+    // The pack a models.txt's "slot" lines give a slot (1-4) - the first line for it whose pack isn't turned off - or "".
+    std::string slot_pack(const std::string &text, int slot);
+
+    // models.txt with the pack on slot (1-4), or on none (slot 0). Lines end in "\n"; a UTF-8 BOM is dropped.
+    std::string assign(const std::string &text, std::string_view pack_id, int slot);
+
+    struct Pack {
+        std::string id;
+        std::string name;    // pack.json "name", else the id
+        std::string author;  // pack.json "author", else ""
+        std::string game;    // pack.json "game", else ""
+    };
+
+    // A pack's display fields from its pack.json text (empty or invalid JSON: the id only).
+    Pack parse_pack_json(std::string_view id, const std::string &pack_json);
+
+    struct Row {
+        Pack pack;
+        int slot = 0;          // pack_slot
+        std::string note;      // "Off in models.txt" / "Also replaces wrestlers by id" / ""
+    };
+
+    // One row per pack, sorted by name (then id).
+    std::vector<Row> rows(const std::vector<Pack> &packs, const std::string &text);
+}
diff --git a/recompui/src/config/save_backup_menu.cpp b/recompui/src/config/save_backup_menu.cpp
new file mode 100644
index 0000000..589e5d5
--- /dev/null
+++ b/recompui/src/config/save_backup_menu.cpp
@@ -0,0 +1,80 @@
+#include "save_backup_menu.h"
+
+#include <cstdio>
+
+namespace recompui::config::save_backup_menu {
+    static const char *month_name(int month) {
+        static const char *names[] = { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
+        return (month >= 1 && month <= 12) ? names[month - 1] : "???";
+    }
+
+    std::string display_time(const Timestamp &when, const Timestamp &now, bool with_seconds) {
+        const int hour12 = (when.hour % 12 == 0) ? 12 : (when.hour % 12);
+        const char *am_pm = (when.hour < 12) ? "AM" : "PM";
+
+        char date[32];
+        if (when.year == now.year) {
+            snprintf(date, sizeof(date), "%s %d", month_name(when.month), when.day);
+        }
+        else {
+            snprintf(date, sizeof(date), "%s %d, %d", month_name(when.month), when.day, when.year);
+        }
+
+        char time[32];
+        if (with_seconds) {
+            snprintf(time, sizeof(time), "%d:%02d:%02d %s", hour12, when.minute, when.second, am_pm);
+        }
+        else {
+            snprintf(time, sizeof(time), "%d:%02d %s", hour12, when.minute, am_pm);
+        }
+
+        return std::string(date) + ", " + time;
+    }
+
+    static std::string file_label(bool controller_pak) {
+        return controller_pak ? "Controller Pak" : "Game save";
+    }
+
+    std::vector<Row> rows(const std::vector<Entry> &entries, const Timestamp &now) {
+        bool any_pak = false;
+        bool any_main = false;
+        for (const Entry &entry : entries) {
+            (entry.controller_pak ? any_pak : any_main) = true;
+        }
+        const bool show_file = any_pak && any_main;
+
+        std::vector<Row> out;
+        out.reserve(entries.size());
+        for (size_t i = 0; i < entries.size(); i++) {
+            const Entry &entry = entries[i];
+            // Two backups of the same file in the same minute (a launch backup right after a restore's) would read the
+            // same; the seconds tell them apart.
+            bool same_minute = false;
+            for (size_t j = 0; j < entries.size(); j++) {
+                const Entry &other = entries[j];
+                if (j != i && (!show_file || other.controller_pak == entry.controller_pak) &&
+                    display_time(other.when, now) == display_time(entry.when, now)) {
+                    same_minute = true;
+                    break;
+                }
+            }
+
+            Row row;
+            row.time = display_time(entry.when, now, same_minute);
+            row.file = show_file ? file_label(entry.controller_pak) : "";
+            row.note = entry.pending ? "Restores at next start" : "";
+            out.push_back(row);
+        }
+
+        return out;
+    }
+
+    std::string file_name_in_text(bool controller_pak) {
+        return controller_pak ? "Controller Pak" : "game save";
+    }
+
+    std::string confirm_text(const Entry &entry, const Timestamp &now) {
+        return "Restore the " + file_name_in_text(entry.controller_pak) + " backup from " + display_time(entry.when, now) +
+            "? It's restored the next time the game starts, and your current save is backed up first.";
+    }
+}
