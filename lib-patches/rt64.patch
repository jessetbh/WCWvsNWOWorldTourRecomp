+layout(push_constant) uniform Push
+{
+	vec4 LinearizePassSize;
+	vec4 OriginalSize;
+	vec4 OutputSize;
+	uint FrameCount;
+	float SIZEHB;
+	float SIGMA_HB;
+	float FINE_BLOOM;
