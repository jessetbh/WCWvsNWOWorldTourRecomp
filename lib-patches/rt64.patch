+		if      (pos.x < 0.3) mask.r = maskLight;
+		else if (pos.x < 0.6) mask.g = maskLight;
+		else                  mask.b = maskLight;
+	}
+	
+	// Trinitron mask 5
+	else if (shadowMask == 5.0)
+	{
+		mask = vec3(0.0);		
+		pos.x = fract(pos.x/2.0);
+		if  (pos.x < 0.49)
+		{	mask.r  = 1.0;
+			mask.b  = 1.0;
+		}
+		else     mask.g = 1.0;
+		mask = clamp(mix( mix(one, mask, mcut), mix(one, mask, maskstr), mx), 0.0, 1.0);
+	}    
