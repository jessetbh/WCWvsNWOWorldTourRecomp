+        return supported && active() && !sceneActive;
+    }
+
+    bool WcwRaytracer::replacesBlobShadows() const {
+        static const bool keepBlobs = getenv("WCW_RT_KEEP_BLOBS") != nullptr;
+        return supported && active() && (mode == WCW_RT_MODE_SHADOW) && !keepBlobs;
