+
+    void WcwRaytracer::beginScene(const hlslpp::float4x4 &view, const hlslpp::float4x4 &proj, const RenderViewport &viewport,
+        const RenderBuffer *worldPosBuffer, uint64_t worldPosSize, const RenderBuffer *faceIndicesBuffer, uint64_t faceIndicesSize,
+        const RenderBuffer *rdpTilesBuffer, const RenderBuffer *gpuTilesBuffer, const RenderBuffer *texCoordBuffer)
+    {
+        boundsViewProj = hlslpp::mul(view, proj);
+        boundsMin[0] = boundsMin[1] = FLT_MAX;
+        boundsMax[0] = boundsMax[1] = -FLT_MAX;
+        boundsFullScreen = false;
+        receiverRadius = std::max(envFloat(getenv("WCW_RT_RADIUS"), 750.0f), 0.0f);
+        receiverCenter[0] = envFloat(getenv("WCW_RT_LIGHT_X"), 0.0f);
+        receiverCenter[1] = envFloat(getenv("WCW_RT_LIGHT_Z"), 0.0f);
+        for (uint32_t i = 0; i < 3; i++) {
+            worldMin[i] = FLT_MAX;
+            worldMax[i] = -FLT_MAX;
+        }
+
+        this->rdpTilesBuffer = rdpTilesBuffer;
+        this->gpuTilesBuffer = gpuTilesBuffer;
+        this->texCoordBuffer = texCoordBuffer;
+        sceneActive = true;
+        viewMatrix = view;
+        projMatrix = proj;
+        this->viewport = viewport;
+        this->worldPosBuffer = worldPosBuffer;
+        this->worldPosSize = worldPosSize;
+        this->faceIndicesBuffer = faceIndicesBuffer;
+        this->faceIndicesSize = faceIndicesSize;
+    }
+
+    void WcwRaytracer::addMesh(uint32_t faceIndicesStart, uint32_t triangleCount, uint32_t vertexCount, bool culled, bool character,
+        bool alphaTest, uint32_t tileIndex, bool uvCorrection)
+    {
+        // Without tile data the alpha test can't be evaluated: keep the draw opaque.
+        alphaTest = alphaTest && (rdpTilesBuffer != nullptr) && (gpuTilesBuffer != nullptr) && (texCoordBuffer != nullptr);
+        const uint32_t IndexStride = sizeof(uint32_t);
+        const uint32_t PosStride = sizeof(float) * 4;
+        meshes.emplace_back(RenderBufferReference(faceIndicesBuffer, faceIndicesStart * IndexStride), RenderBufferReference(worldPosBuffer, 0),
+            RenderFormat::R32_UINT, RenderFormat::R32G32B32_FLOAT, triangleCount * 3, vertexCount, PosStride, !culled && !alphaTest);
+
+        // Culled draws are non-opaque so the trace shader sees their candidates; the top bits
+        // carry the culled/character flags.
+        meshIndexStarts.emplace_back(faceIndicesStart | (culled ? WCW_RT_MESH_CULLED : 0u) | (character ? WCW_RT_MESH_CHARACTER : 0u));
+        meshTiles.emplace_back((tileIndex & WCW_RT_TILE_INDEX_MASK) | (alphaTest ? WCW_RT_TILE_ALPHA_TEST : 0u) | (uvCorrection ? WCW_RT_TILE_UV_CORRECTION : 0u));
+    }
+
+    void WcwRaytracer::extendBounds(const float *positions) {
+        for (uint32_t i = 0; i < 9; i++) {
+            worldMin[i % 3] = std::min(worldMin[i % 3], positions[i]);
+            worldMax[i % 3] = std::max(worldMax[i % 3], positions[i]);
+        }
+
+        if (boundsFullScreen) {
+            return;
+        }
+
+        // Triangles entirely outside the receiver radius only need primary rays where other
+        // geometry is traced anyway: they don't widen the rect.
+        if (receiverRadius > 0.0f) {
+            float minX = FLT_MAX, maxX = -FLT_MAX, minZ = FLT_MAX, maxZ = -FLT_MAX;
+            for (uint32_t i = 0; i < 3; i++) {
+                minX = std::min(minX, positions[i * 3 + 0]);
+                maxX = std::max(maxX, positions[i * 3 + 0]);
+                minZ = std::min(minZ, positions[i * 3 + 2]);
+                maxZ = std::max(maxZ, positions[i * 3 + 2]);
+            }
+
+            const float dx = std::max({ minX - receiverCenter[0], 0.0f, receiverCenter[0] - maxX });
+            const float dz = std::max({ minZ - receiverCenter[1], 0.0f, receiverCenter[1] - maxZ });
+            if ((dx * dx + dz * dz) > (receiverRadius * receiverRadius)) {
+                return;
+            }
+        }
+
+        // Clip the triangle against the near plane (w > NearW) so vertices behind the camera
+        // (crowd and set pieces around it) don't blow the footprint up to the whole screen.
+        const float NearW = 1e-2f;
+        hlslpp::float4 clip[3];
+        bool inside[3];
+        uint32_t insideCount = 0;
+        for (uint32_t i = 0; i < 3; i++) {
+            clip[i] = hlslpp::mul(hlslpp::float4(positions[i * 3 + 0], positions[i * 3 + 1], positions[i * 3 + 2], 1.0f), boundsViewProj);
+            inside[i] = float(clip[i].w) > NearW;
+            insideCount += inside[i] ? 1 : 0;
+        }
+
+        if (insideCount == 0) {
+            return;
+        }
+
+        auto extend = [&](const hlslpp::float4 &c) {
+            const float w = c.w;
+            const float px = viewport.x + (float(c.x) / w * 0.5f + 0.5f) * viewport.width;
+            const float py = viewport.y + (0.5f - float(c.y) / w * 0.5f) * viewport.height;
+            boundsMin[0] = std::min(boundsMin[0], px);
+            boundsMin[1] = std::min(boundsMin[1], py);
+            boundsMax[0] = std::max(boundsMax[0], px);
+            boundsMax[1] = std::max(boundsMax[1], py);
+        };
+
+        for (uint32_t i = 0; i < 3; i++) {
+            const uint32_t j = (i + 1) % 3;
+            if (inside[i]) {
+                extend(clip[i]);
+            }
+
+            if (inside[i] != inside[j]) {
+                const float t = (NearW - float(clip[i].w)) / (float(clip[j].w) - float(clip[i].w));
+                extend(clip[i] + (clip[j] - clip[i]) * t);
+            }
+        }
+    }
+
+    void WcwRaytracer::recordBuild(RenderWorker *worker) {
+        structuresBuilt = false;
+        if (!sceneActive || meshes.empty()) {
+            return;
+        }
+
+        currentSlot = chooseSlot();
+        Slot &slot = slots[currentSlot];
+        if (!slot.valid) {
+            slot.historyValid = false;
+        }
+
+        // Bottom level: every gathered draw call is one geometry over the shared world position buffer.
+        device->setBottomLevelASBuildInfo(blasInfo, meshes.data(), uint32_t(meshes.size()), true, false);
+        if (blasInfo.accelerationStructureSize > slot.blasBufferSize) {
+            slot.blasBufferSize = alignUp((blasInfo.accelerationStructureSize * 3) / 2, 256);
+            slot.blasBuffer = device->createBuffer(RenderBufferDesc::AccelerationStructureBuffer(slot.blasBufferSize));
+            slot.blas = device->createAccelerationStructure(RenderAccelerationStructureDesc(RenderAccelerationStructureType::BOTTOM_LEVEL, RenderBufferReference(slot.blasBuffer.get()), slot.blasBufferSize));
+        }
+
+        slot.valid = true;
+        slot.builtWorkload = workloadCounter;
+        slot.meshCount = uint32_t(meshes.size());
+        for (uint32_t i = 0; i < 3; i++) {
+            slot.boundsMin[i] = worldMin[i];
+            slot.boundsMax[i] = worldMax[i];
+        }
+        if (timingPool != nullptr) {
+            worker->commandList->resetQueryPool(timingPool.get(), 0, StampCount);
+            worker->commandList->writeTimestamp(timingPool.get(), StampBuildBegin);
+            timingWritten = (1u << StampBuildBegin);
+            timingMeshes = uint32_t(meshes.size());
+            timingTriangles = 0;
+            timingAlphaMeshes = 0;
+            timingPixels = 0;
+            for (size_t m = 0; m < meshes.size(); m++) {
+                timingTriangles += meshes[m].indexCount / 3;
+                timingAlphaMeshes += (meshTiles[m] & WCW_RT_TILE_ALPHA_TEST) ? 1 : 0;
+            }
+        }
+
+        // Top level: this workload's geometry (mask 0x1: primary and shadow rays) plus the other
+        // scenes built recently (mask 0x2: shadow rays only). Scenes the game stopped drawing
+        // age out after a few workloads.
+        instances.clear();
+        instances.emplace_back(RenderBufferReference(slot.blasBuffer.get()), 0, 0x1, 0, true, RenderAffineTransform());
+        for (uint32_t s = 0; s < MaxSlots; s++) {
+            const Slot &other = slots[s];
+            if ((s != currentSlot) && other.valid && ((workloadCounter - other.builtWorkload) <= StaleWorkloads)) {
+                instances.emplace_back(RenderBufferReference(other.blasBuffer.get()), s + 1, 0x2, 0, true, RenderAffineTransform());
+            }
+        }
+
+        device->setTopLevelASBuildInfo(tlasInfo, instances.data(), uint32_t(instances.size()), true, false);
+        if (tlasInfo.accelerationStructureSize > tlasBufferSize) {
+            tlasBufferSize = alignUp((tlasInfo.accelerationStructureSize * 3) / 2, 256);
+            tlasBuffer = device->createBuffer(RenderBufferDesc::AccelerationStructureBuffer(tlasBufferSize));
+            tlas = device->createAccelerationStructure(RenderAccelerationStructureDesc(RenderAccelerationStructureType::TOP_LEVEL, RenderBufferReference(tlasBuffer.get()), tlasBufferSize));
+        }
+
+        const uint64_t blasScratch = alignUp(blasInfo.scratchSize, 256);
+        const uint64_t requiredScratch = blasScratch + alignUp(tlasInfo.scratchSize, 256);
+        if (requiredScratch > scratchBufferSize) {
+            scratchBufferSize = alignUp((requiredScratch * 3) / 2, 256);
+            scratchBuffer = device->createBuffer(RenderBufferDesc::DefaultBuffer(scratchBufferSize, RenderBufferFlag::ACCELERATION_STRUCTURE_SCRATCH | RenderBufferFlag::UNORDERED_ACCESS));
+        }
+
+        const uint64_t instancesSize = tlasInfo.instancesBufferData.size();
+        if (instancesSize > instancesBufferSize) {
+            instancesBufferSize = alignUp(instancesSize, 256);
+            instancesBuffer = device->createBuffer(RenderBufferDesc::UploadBuffer(instancesBufferSize, RenderBufferFlag::ACCELERATION_STRUCTURE_INPUT));
+        }
+
+        void *instancesBytes = instancesBuffer->map();
+        memcpy(instancesBytes, tlasInfo.instancesBufferData.data(), instancesSize);
+        instancesBuffer->unmap();
+
+        const uint64_t meshStartsSize = meshIndexStarts.size() * sizeof(uint32_t);
+        if (meshStartsSize > meshStartsBufferSize) {
+            meshStartsBufferSize = alignUp((meshStartsSize * 3) / 2, 256);
+            meshStartsBuffer = device->createBuffer(RenderBufferDesc::UploadBuffer(meshStartsBufferSize, RenderBufferFlag::STORAGE));
+        }
+
+        void *meshStartsBytes = meshStartsBuffer->map();
+        memcpy(meshStartsBytes, meshIndexStarts.data(), meshStartsSize);
+        meshStartsBuffer->unmap();
+
+        const uint64_t meshTilesSize = meshTiles.size() * sizeof(uint32_t);
+        if (meshTilesSize > meshTilesBufferSize) {
+            meshTilesBufferSize = alignUp((meshTilesSize * 3) / 2, 256);
+            meshTilesBuffer = device->createBuffer(RenderBufferDesc::UploadBuffer(meshTilesBufferSize, RenderBufferFlag::STORAGE));
+        }
+
+        void *meshTilesBytes = meshTilesBuffer->map();
+        memcpy(meshTilesBytes, meshTiles.data(), meshTilesSize);
+        meshTilesBuffer->unmap();
+
+        worker->commandList->buildBottomLevelAS(slot.blas.get(), RenderBufferReference(scratchBuffer.get(), 0), blasInfo);
+        worker->commandList->barriers(RenderBarrierStage::COMPUTE, RenderBufferBarrier(slot.blasBuffer.get(), RenderBufferAccess::READ));
+        worker->commandList->buildTopLevelAS(tlas.get(), RenderBufferReference(scratchBuffer.get(), blasScratch), RenderBufferReference(instancesBuffer.get()), tlasInfo);
+        worker->commandList->barriers(RenderBarrierStage::COMPUTE, RenderBufferBarrier(tlasBuffer.get(), RenderBufferAccess::READ));
+        structuresBuilt = true;
+        if (timingPool != nullptr) {
+            worker->commandList->writeTimestamp(timingPool.get(), StampBuildEnd);
+            timingWritten |= (1u << StampBuildEnd);
+        }
+
+        static const bool wcwRtLog = getenv("WCW_RT_LOG") != nullptr;
+        if (wcwRtLog) {
+            static uint32_t buildCount = 0;
+            if ((buildCount++ % 300) == 0) {
+                uint32_t triangleCount = 0;
+                for (const RenderBottomLevelASMesh &mesh : meshes) {
+                    triangleCount += mesh.indexCount / 3;
+                }
+
+                fprintf(stderr, "[wcw rt] build #%u slot %u (+%zu other): %zu meshes, %u triangles, blas=%llu tlas=%llu scratch=%llu vp=(%.0f,%.0f %.0fx%.0f)\n",
+                    buildCount, currentSlot, instances.size() - 1, meshes.size(), triangleCount, (unsigned long long)blasInfo.accelerationStructureSize,
+                    (unsigned long long)tlasInfo.accelerationStructureSize, (unsigned long long)requiredScratch,
+                    viewport.x, viewport.y, viewport.width, viewport.height);
+            }
+        }
+    }
+
+    void WcwRaytracer::recordTrace(RenderWorker *worker, RenderTarget *colorTarget, RenderDescriptorSet *textureSet) {
+        if (!structuresBuilt || (colorTarget == nullptr)) {
+            return;
+        }
+
+        // Output texture at the color target's resolution.
+        // Quality preset (or env overrides) for this frame.
+        const uint32_t quality = userQuality();
+        // Soft, temporally resolved shadows don't need the full internal resolution: the presets
+        // also cap the trace height (Performance 720 lines, Balanced 1080), so 4K+ targets don't
+        // multiply the ray count. WCW_RT_MAX_LINES overrides the cap, WCW_RT_SCALE the whole scale.
+        const float presetLines = envFloat(getenv("WCW_RT_MAX_LINES"), (quality == 0) ? 720.0f : ((quality == 1) ? 1080.0f : 0.0f));
+        float presetScale = (quality >= 2) ? 1.0f : 0.5f;
+        if ((presetLines > 0.0f) && (colorTarget->height > 0)) {
+            presetScale = std::min(presetScale, presetLines / float(colorTarget->height));
+        }
+
+        const float frameScale = std::clamp(envFloat(getenv("WCW_RT_SCALE"), presetScale), 0.1f, 1.0f);
+        const uint32_t presetSamples = (quality == 0) ? 1u : 2u;
+
+        // Re-enabled after being off: the histories are stale.
+        if (!wasActive) {
+            for (Slot &s : slots) {
+                s.historyValid = false;
+            }
+        }
+
+        wasActive = true;
+
+        // Trace-resolution textures (traceScale of the color target).
+        if ((outputTexture == nullptr) || (outputWidth != colorTarget->width) || (outputHeight != colorTarget->height) || (frameScale != traceScale)) {
+            traceScale = frameScale;
+            outputWidth = colorTarget->width;
+            outputHeight = colorTarget->height;
+            traceWidth = std::max(uint32_t(std::ceil(outputWidth * traceScale)), 1u);
+            traceHeight = std::max(uint32_t(std::ceil(outputHeight * traceScale)), 1u);
+            outputTexture = device->createTexture(RenderTextureDesc::Texture2D(traceWidth, traceHeight, 1, RenderFormat::R8G8B8A8_UNORM, RenderTextureFlag::STORAGE | RenderTextureFlag::UNORDERED_ACCESS));
+            currentTexture = device->createTexture(RenderTextureDesc::Texture2D(traceWidth, traceHeight, 1, RenderFormat::R32G32_FLOAT, RenderTextureFlag::STORAGE | RenderTextureFlag::UNORDERED_ACCESS));
+        }
+
+        Slot &slot = slots[currentSlot];
+        if ((slot.history[0] == nullptr) || (slot.historyWidth != traceWidth) || (slot.historyHeight != traceHeight)) {
+            slot.historyWidth = traceWidth;
+            slot.historyHeight = traceHeight;
+            for (auto &history : slot.history) {
+                history = device->createTexture(RenderTextureDesc::Texture2D(traceWidth, traceHeight, 1, RenderFormat::R16_FLOAT, RenderTextureFlag::STORAGE | RenderTextureFlag::UNORDERED_ACCESS));
+            }
+
+            slot.historyValid = false;
+        }
+
+        // Composite pipeline matching the target's format and sample count; blend depends on the mode.
+        if ((compositePipeline == nullptr) || (compositeFormat != colorTarget->format) || (compositeSamples != colorTarget->multisampling.sampleCount) || (compositeMode != mode)) {
+            compositeFormat = colorTarget->format;
+            compositeSamples = colorTarget->multisampling.sampleCount;
+            compositeMode = mode;
+
+            RenderGraphicsPipelineDesc pipelineDesc;
+            pipelineDesc.pipelineLayout = compositeLayout.get();
+            pipelineDesc.vertexShader = fullScreenVS.get();
+            pipelineDesc.pixelShader = compositePS.get();
+            pipelineDesc.renderTargetFormat[0] = compositeFormat;
+            pipelineDesc.renderTargetCount = 1;
+            pipelineDesc.depthTargetFormat = RenderFormat::D32_FLOAT;
+            pipelineDesc.multisampling = colorTarget->multisampling;
+            if ((mode == WCW_RT_MODE_SHADOW) || (mode == WCW_RT_MODE_AO)) {
+                RenderBlendDesc multiply;
+                multiply.blendEnabled = true;
+                multiply.srcBlend = RenderBlend::ZERO;
+                multiply.dstBlend = RenderBlend::SRC_COLOR;
+                multiply.blendOp = RenderBlendOperation::ADD;
+                multiply.srcBlendAlpha = RenderBlend::ZERO;
+                multiply.dstBlendAlpha = RenderBlend::ONE;
+                multiply.blendOpAlpha = RenderBlendOperation::ADD;
+                pipelineDesc.renderTargetBlend[0] = multiply;
+            }
+            else {
+                pipelineDesc.renderTargetBlend[0] = RenderBlendDesc::AlphaBlend();
+            }
+
+            pipelineDesc.renderTargetBlend[0].renderTargetWriteMask = uint8_t(RenderColorWriteEnable::RED) | uint8_t(RenderColorWriteEnable::GREEN) | uint8_t(RenderColorWriteEnable::BLUE);
+            compositePipeline = device->createGraphicsPipeline(pipelineDesc);
+        }
+
+        // Parameters.
+        interop::WcwRtParams params;
+        const hlslpp::float4x4 viewProj = hlslpp::mul(viewMatrix, projMatrix);
+        const hlslpp::float4x4 invView = hlslpp::inverse(viewMatrix);
+        params.invViewProj = hlslpp::inverse(viewProj);
+        params.eyePosition = hlslpp::float4(invView[3].xyz, 1.0f);
+        params.lightPosition = hlslpp::float4(envFloat(getenv("WCW_RT_LIGHT_X"), 0.0f), envFloat(getenv("WCW_RT_LIGHT_Y"), 460.0f), envFloat(getenv("WCW_RT_LIGHT_Z"), 0.0f), 1.0f);
+        params.viewport = hlslpp::float4(viewport.x, viewport.y, viewport.width, viewport.height);
+        params.resolution = { traceWidth, traceHeight };
+        params.mode = mode;
+        params.shadowStrength = envFloat(getenv("WCW_RT_SHADOW"), 0.6f);
+        params.lightSpread = envFloat(getenv("WCW_RT_LIGHT_SPREAD"), 200.0f);
+        params.lightCount = uint32_t(envFloat(getenv("WCW_RT_LIGHTS"), 4.0f));
+        params.cullSign = envFloat(getenv("WCW_RT_CULL_SIGN"), 1.0f);
+        params.keyWeight = envFloat(getenv("WCW_RT_KEY_WEIGHT"), 0.5f);
+        params.characterShadowStrength = envFloat(getenv("WCW_RT_SHADOW_CHAR"), 0.35f);
+        params.lightSize = envFloat(getenv("WCW_RT_LIGHT_SIZE"), 20.0f);
+        params.temporalAlpha = envFloat(getenv("WCW_RT_TEMPORAL"), 0.1f);
+        params.frameIndex = frameIndex++;
+        params.prevViewProj = slot.prevViewProj;
+        params.historyValid = slot.historyValid ? 1 : 0;
+        params.samplesPerLight = std::max(uint32_t(envFloat(getenv("WCW_RT_SAMPLES"), float(presetSamples))), 1u);
+        params.aoSamples = uint32_t(envFloat(getenv("WCW_RT_AO_SAMPLES"), float(presetSamples)));
+        params.aoRadius = envFloat(getenv("WCW_RT_AO_RADIUS"), 25.0f);
+        params.aoStrength = envFloat(getenv("WCW_RT_AO"), 0.5f);
+        params.traceScale = float(traceWidth) / float(outputWidth);
+
+        // Trace only this workload's screen footprint (plus a margin for the bilinear upsample
+        // and the resolve's 3x3 neighborhood).
+        if (boundsFullScreen) {
+            traceRect[0] = traceRect[1] = 0;
+            traceRect[2] = traceWidth;
+            traceRect[3] = traceHeight;
+        }
+        else {
+            const float scale = params.traceScale;
+            traceRect[0] = uint32_t(std::clamp(std::floor(boundsMin[0] * scale) - 3.0f, 0.0f, float(traceWidth)));
+            traceRect[1] = uint32_t(std::clamp(std::floor(boundsMin[1] * scale) - 3.0f, 0.0f, float(traceHeight)));
+            traceRect[2] = uint32_t(std::clamp(std::ceil(boundsMax[0] * scale) + 3.0f, 0.0f, float(traceWidth)));
+            traceRect[3] = uint32_t(std::clamp(std::ceil(boundsMax[1] * scale) + 3.0f, 0.0f, float(traceHeight)));
+        }
+
+        traceRectEmpty = (traceRect[2] <= traceRect[0]) || (traceRect[3] <= traceRect[1]);
+        if (traceRectEmpty) {
+            return;
+        }
+
+        params.traceOffset = { traceRect[0], traceRect[1] };
+        params.receiverRadius = receiverRadius;
+        void *paramsBytes = paramsBuffer->map();
+        memcpy(paramsBytes, &params, sizeof(params));
+        paramsBuffer->unmap();
+
+        traceSet->setBuffer(0, paramsBuffer.get(), alignUp(sizeof(interop::WcwRtParams), 256));
+        traceSet->setAccelerationStructure(1, tlas.get());
+        const RenderBufferStructuredView float4View(sizeof(float) * 4);
+        const RenderBufferStructuredView uintView(sizeof(uint32_t));
+        traceSet->setBuffer(2, worldPosBuffer, worldPosSize, &float4View);
+        traceSet->setBuffer(3, faceIndicesBuffer, faceIndicesSize, &uintView);
+        traceSet->setBuffer(4, meshStartsBuffer.get(), meshStartsBufferSize, &uintView);
+        traceSet->setTexture(5, outputTexture.get(), RenderTextureLayout::GENERAL);
+        traceSet->setTexture(6, currentTexture.get(), RenderTextureLayout::GENERAL);
+        const RenderBufferStructuredView rdpTileView(sizeof(interop::RDPTile));
+        const RenderBufferStructuredView gpuTileView(sizeof(interop::GPUTile));
+        const RenderBufferStructuredView float2View(sizeof(float) * 2);
+        traceSet->setBuffer(7, (rdpTilesBuffer != nullptr) ? rdpTilesBuffer : meshTilesBuffer.get(), 0, &rdpTileView);
+        traceSet->setBuffer(8, (gpuTilesBuffer != nullptr) ? gpuTilesBuffer : meshTilesBuffer.get(), 0, &gpuTileView);
+        traceSet->setBuffer(9, (texCoordBuffer != nullptr) ? texCoordBuffer : meshTilesBuffer.get(), 0, &float2View);
+        traceSet->setBuffer(10, meshTilesBuffer.get(), meshTilesBufferSize, &uintView);
+        compositeSet->setTexture(0, outputTexture.get(), RenderTextureLayout::SHADER_READ);
+
+        // Trace.
+        worker->commandList->barriers(RenderBarrierStage::COMPUTE, {
+            RenderTextureBarrier(outputTexture.get(), RenderTextureLayout::GENERAL),
+            RenderTextureBarrier(currentTexture.get(), RenderTextureLayout::GENERAL)
+        });
+        if (timingPool != nullptr) {
+            worker->commandList->writeTimestamp(timingPool.get(), StampTraceBegin);
+            timingWritten |= (1u << StampTraceBegin);
+        }
+
+        worker->commandList->setPipeline(tracePipeline.get());
+        worker->commandList->setComputePipelineLayout(traceLayout.get());
+        worker->commandList->setComputeDescriptorSet(traceSet.get(), 0);
+        worker->commandList->setComputeDescriptorSet(textureSet, 1);
+        const uint32_t rectWidth = traceRect[2] - traceRect[0];
+        const uint32_t rectHeight = traceRect[3] - traceRect[1];
+        worker->commandList->dispatch((rectWidth + 7) / 8, (rectHeight + 7) / 8, 1);
+        if (timingPool != nullptr) {
+            worker->commandList->writeTimestamp(timingPool.get(), StampTraceEnd);
+            timingWritten |= (1u << StampTraceEnd);
+            timingPixels = rectWidth * rectHeight;
+            timingFullScreen = boundsFullScreen;
+            timingTraceHeight = traceHeight;
+            // WCW_RT_TRACELOG=1: every 100th frame; =<present>: every trace for 30 presents from there.
+            static const int traceLogAt = getenv("WCW_RT_TRACELOG") ? atoi(getenv("WCW_RT_TRACELOG")) : -1;
+            const bool traceLogNow = (traceLogAt == 1) ? ((frameCounter % 100) == 0) : ((traceLogAt > 1) && (wcwRtPresentCounter >= traceLogAt) && (wcwRtPresentCounter < traceLogAt + 30));
+            if (traceLogNow) {
+                fprintf(stderr, "[wcw rt trace] present %d frame %llu slot %u others %u hist %d target %p %ux%u rect (%u,%u)-(%u,%u) of %ux%u meshes %u tris %u world (%.0f,%.0f,%.0f)-(%.0f,%.0f,%.0f)\n",
+                    int(wcwRtPresentCounter), (unsigned long long)frameCounter, currentSlot, uint32_t(instances.size() - 1), slot.historyValid ? 1 : 0, (void *)colorTarget, outputWidth, outputHeight, traceRect[0], traceRect[1], traceRect[2], traceRect[3],
+                    traceWidth, traceHeight, timingMeshes, timingTriangles, worldMin[0], worldMin[1], worldMin[2], worldMax[0], worldMax[1], worldMax[2]);
+            }
+        }
+
+        // Shadow mode: temporal resolve of the jittered samples into this slot's history.
+        if ((mode == WCW_RT_MODE_SHADOW) || (mode == WCW_RT_MODE_AO)) {
+            RenderTexture *historyIn = slot.history[slot.historyIndex].get();
+            RenderTexture *historyOut = slot.history[slot.historyIndex ^ 1].get();
+            resolveSet->setBuffer(0, paramsBuffer.get(), alignUp(sizeof(interop::WcwRtParams), 256));
+            resolveSet->setTexture(1, currentTexture.get(), RenderTextureLayout::SHADER_READ);
+            resolveSet->setTexture(2, historyIn, RenderTextureLayout::SHADER_READ);
+            resolveSet->setTexture(3, historyOut, RenderTextureLayout::GENERAL);
+            resolveSet->setTexture(4, outputTexture.get(), RenderTextureLayout::GENERAL);
+            worker->commandList->barriers(RenderBarrierStage::COMPUTE, {
+                RenderTextureBarrier(currentTexture.get(), RenderTextureLayout::SHADER_READ),
+                RenderTextureBarrier(historyIn, RenderTextureLayout::SHADER_READ),
+                RenderTextureBarrier(historyOut, RenderTextureLayout::GENERAL),
+                RenderTextureBarrier(outputTexture.get(), RenderTextureLayout::GENERAL)
+            });
+
+            worker->commandList->setPipeline(resolvePipeline.get());
+            worker->commandList->setComputePipelineLayout(resolveLayout.get());
+            worker->commandList->setComputeDescriptorSet(resolveSet.get(), 0);
+            worker->commandList->dispatch((rectWidth + 7) / 8, (rectHeight + 7) / 8, 1);
+
+            slot.historyIndex ^= 1;
+            slot.historyValid = true;
+            slot.prevViewProj = viewProj;
+        }
+
+        if (timingPool != nullptr) {
+            worker->commandList->writeTimestamp(timingPool.get(), StampResolveEnd);
+            timingWritten |= (1u << StampResolveEnd);
+        }
+
+        worker->commandList->barriers(RenderBarrierStage::GRAPHICS, RenderTextureBarrier(outputTexture.get(), RenderTextureLayout::SHADER_READ));
+    }
+
+    void WcwRaytracer::recordComposite(RenderWorker *worker) {
+        if (!structuresBuilt || (compositePipeline == nullptr) || traceRectEmpty) {
+            return;
+        }
+
+        // Composite only the traced rect (inside its margin), in color target pixels.
+        const float invScale = float(outputWidth) / float(traceWidth);
+        const RenderViewport fullViewport(0.0f, 0.0f, float(outputWidth), float(outputHeight));
+        const RenderRect fullRect(int32_t((traceRect[0] + 1) * invScale), int32_t((traceRect[1] + 1) * invScale),
+            std::min(int32_t((traceRect[2] - 1) * invScale), int32_t(outputWidth)), std::min(int32_t((traceRect[3] - 1) * invScale), int32_t(outputHeight)));
+        worker->commandList->setPipeline(compositePipeline.get());
+        worker->commandList->setGraphicsPipelineLayout(compositeLayout.get());
+        interop::WcwRtCompositeCB compositeCB;
+        compositeCB.scale = { float(traceWidth) / float(outputWidth), float(traceHeight) / float(outputHeight) };
+        compositeCB.traceSize = { float(traceWidth), float(traceHeight) };
+        worker->commandList->setGraphicsPushConstants(0, &compositeCB);
+        worker->commandList->setGraphicsDescriptorSet(compositeSet.get(), 0);
+        worker->commandList->setViewports(fullViewport);
+        worker->commandList->setScissors(fullRect);
+        if (timingPool != nullptr) {
+            worker->commandList->writeTimestamp(timingPool.get(), StampCompositeBegin);
+        }
+
+        worker->commandList->drawInstanced(3, 1, 0, 0);
+        if (timingPool != nullptr) {
+            worker->commandList->writeTimestamp(timingPool.get(), StampCompositeEnd);
+            timingWritten |= (1u << StampCompositeBegin) | (1u << StampCompositeEnd);
+        }
+    }
+
+    void WcwRaytracer::collectTimings() {
+        if ((timingPool == nullptr) || (timingWritten == 0)) {
+            return;
+        }
+
+        static double sums[5] = {};
+        static double maxTotal = 0.0;
+        static uint64_t triangleSum = 0, meshSum = 0, alphaSum = 0, pixelSum = 0, fullScreenSum = 0;
+        static uint32_t count = 0;
+        timingPool->queryResults();
+        const uint64_t *t = timingPool->getResults();
+        auto span = [&](uint32_t a, uint32_t b) {
+            const uint32_t need = (1u << a) | (1u << b);
+            return ((timingWritten & need) == need) ? double(t[b] - t[a]) / 1000000.0 : 0.0;
+        };
+
+        const double build = span(StampBuildBegin, StampBuildEnd);
+        const double trace = span(StampTraceBegin, StampTraceEnd);
+        const double resolve = span(StampTraceEnd, StampResolveEnd);
+        const double composite = span(StampCompositeBegin, StampCompositeEnd);
+        const double total = span(StampBuildBegin, StampCompositeEnd);
+        sums[0] += build;
+        sums[1] += trace;
+        sums[2] += resolve;
+        sums[3] += composite;
+        sums[4] += total;
+        maxTotal = std::max(maxTotal, total);
+        triangleSum += timingTriangles;
+        meshSum += timingMeshes;
+        alphaSum += timingAlphaMeshes;
+        pixelSum += timingPixels;
+        fullScreenSum += timingFullScreen ? 1 : 0;
+        timingWritten = 0;
+        if (++count == 300) {
+            fprintf(stderr, "[wcw rt gpu] per traced workload avg: build=%.3f trace=%.3f resolve=%.3f composite=%.3f ms, build->composite span=%.3f (max %.3f) ms; %llu meshes (%llu alpha-tested), %llu tris, %llu trace px of %u lines, %llu full-screen (300 workloads)\n",
+                sums[0] / count, sums[1] / count, sums[2] / count, sums[3] / count, sums[4] / count, maxTotal,
+                (unsigned long long)(meshSum / count), (unsigned long long)(alphaSum / count), (unsigned long long)(triangleSum / count), (unsigned long long)(pixelSum / count), timingTraceHeight, (unsigned long long)fullScreenSum);
+            memset(sums, 0, sizeof(sums));
+            maxTotal = 0.0;
+            triangleSum = meshSum = alphaSum = pixelSum = fullScreenSum = 0;
+            count = 0;
+        }
+    }
+};
diff --git a/src/render/rt64_wcw_raytracer.h b/src/render/rt64_wcw_raytracer.h
new file mode 100644
index 0000000..110ddc1
--- /dev/null
+++ b/src/render/rt64_wcw_raytracer.h
@@ -0,0 +1,192 @@
+//
+// RT64
+//
+
+#pragma once
+
+#include <atomic>
+#include <memory>
+#include <vector>
+
+#include "common/rt64_common.h"
+#include "common/rt64_plume.h"
+#include "shared/rt64_wcw_rt.h"
+
+namespace RT64 {
+    // [wcw rt] Presented frame count (mirrors the WCW_PRESENT_LUM counter) for targeted dumps.
+    extern std::atomic<int> wcwRtPresentCounter;
+
+    struct RenderTarget;
+    struct RenderWorker;
+
+    // [wcw rt] Hybrid ray tracing for forceMatrix-only AKI games (WCW_RT=1, D3D12 + DXR 1.1).
+    //
+    // The raster image is left untouched. Per workload, the depth-writing triangles of the
+    // first perspective projection are gathered (addMesh) into one bottom-level structure built
+    // straight from RT64's world-space vertex and face index buffers (recordBuild), and after
+    // that projection's raster scene a compute pass casts inline rays from the game camera
+    // (recordTrace). Its output is composited over the color target: alpha blended for the
+    // debug views, multiplied for shadows. WCW_RT_MODE selects the output (rt64_wcw_rt.h).
+    struct WcwRaytracer {
+        RenderDevice *device = nullptr;
+        RenderShaderFormat shaderFormat = RenderShaderFormat::UNKNOWN;
+        bool supported = false;
+        uint32_t mode = WCW_RT_MODE_SHADOW;
+        bool wasActive = false;
+
+        // Scene gathered for the current workload.
+        bool sceneActive = false;
+        std::vector<RenderBottomLevelASMesh> meshes;
+        std::vector<uint32_t> meshIndexStarts;
+        const RenderBuffer *worldPosBuffer = nullptr;
+        const RenderBuffer *rdpTilesBuffer = nullptr;
+        const RenderBuffer *gpuTilesBuffer = nullptr;
+        const RenderBuffer *texCoordBuffer = nullptr;
+        std::vector<uint32_t> meshTiles;
+        std::unique_ptr<RenderBuffer> meshTilesBuffer;
+        uint64_t meshTilesBufferSize = 0;
+        const RenderBuffer *faceIndicesBuffer = nullptr;
+        uint64_t worldPosSize = 0;
+        uint64_t faceIndicesSize = 0;
+        hlslpp::float4x4 viewMatrix;
+        hlslpp::float4x4 projMatrix;
+        RenderViewport viewport;
+        bool structuresBuilt = false;
+
+        // Screen bounds (color target pixels) of this workload's gathered geometry.
+        hlslpp::float4x4 boundsViewProj;
+        float boundsMin[2] = {};
+        float boundsMax[2] = {};
+        bool boundsFullScreen = false;
+        // Shadows and AO are only cast onto surfaces within receiverRadius (XZ) of the lights'
+        // center: the ring and ringside. The arena and crowd beyond it only get primary rays,
+        // and geometry entirely outside it doesn't widen the traced rect (WCW_RT_RADIUS, 0 = off).
+        float receiverRadius = 750.0f;
+        float receiverCenter[2] = {};
+        float worldMin[3] = {};
+        float worldMax[3] = {};
+
+        // AKI games build one frame from several RSP workloads (WCW: floor bits, ring and
+        // wrestlers apart), and each workload gets its own pass. Every slot keeps one scene's
+        // bottom-level structure so the others' passes can include it as a shadow caster, plus
+        // that scene's soft-shadow history. Slots follow scene identity (mesh count and world
+        // bounds), not the workload's position within the present: the game's workload cycle
+        // drifts against presents, so positions would swap scenes from frame to frame.
+        static const uint32_t MaxSlots = 8;
+        static const uint32_t StaleWorkloads = 8;
+        struct Slot {
+            std::unique_ptr<RenderBuffer> blasBuffer;
+            std::unique_ptr<RenderAccelerationStructure> blas;
+            uint64_t blasBufferSize = 0;
+            uint64_t builtWorkload = 0;
+            uint32_t meshCount = 0;
+            float boundsMin[3] = {};
+            float boundsMax[3] = {};
+            bool valid = false;
+
+            // Soft-shadow history (ping-pong) of this workload's pass, with the camera it used.
+            std::unique_ptr<RenderTexture> history[2];
+            uint32_t historyIndex = 0;
+            uint32_t historyWidth = 0;
+            uint32_t historyHeight = 0;
+            bool historyValid = false;
+            hlslpp::float4x4 prevViewProj;
+        };
+
+        Slot slots[MaxSlots];
+        uint32_t currentSlot = 0;
+        uint32_t workloadInFrame = 0;
+        uint64_t workloadCounter = 0;
+        // Picks the slot whose last scene best matches the gathered one (or the oldest slot).
+        uint32_t chooseSlot() const;
+        uint64_t lastPresentId = UINT64_MAX;
+        uint64_t frameCounter = 0;
+        std::vector<RenderTopLevelASInstance> instances;
+
+        // Acceleration structures (grow-only).
+        RenderBottomLevelASBuildInfo blasInfo;
+        RenderTopLevelASBuildInfo tlasInfo;
+        std::unique_ptr<RenderBuffer> tlasBuffer;
+        std::unique_ptr<RenderBuffer> scratchBuffer;
+        std::unique_ptr<RenderBuffer> instancesBuffer;
+        std::unique_ptr<RenderAccelerationStructure> tlas;
+        uint64_t tlasBufferSize = 0;
+        uint64_t scratchBufferSize = 0;
+        uint64_t instancesBufferSize = 0;
+
+        // Trace pass.
+        std::unique_ptr<RenderBuffer> paramsBuffer;
+        std::unique_ptr<RenderBuffer> meshStartsBuffer;
+        uint64_t meshStartsBufferSize = 0;
+        std::unique_ptr<RenderTexture> outputTexture;
+        std::unique_ptr<RenderTexture> currentTexture;
+        uint32_t frameIndex = 0;
+        std::unique_ptr<RenderDescriptorSet> resolveSet;
+        std::unique_ptr<RenderPipelineLayout> resolveLayout;
+        std::unique_ptr<RenderPipeline> resolvePipeline;
+        uint32_t outputWidth = 0;
+        uint32_t outputHeight = 0;
+        uint32_t traceWidth = 0;
+        uint32_t traceHeight = 0;
+        float traceScale = 0.5f;
+        bool traceRectEmpty = true;
+        uint32_t traceRect[4] = {};
+        bool outputNeedsTransition = false;
+        std::unique_ptr<RenderDescriptorSet> traceSet;
+        std::unique_ptr<RenderPipelineLayout> traceLayout;
+        std::unique_ptr<RenderPipeline> tracePipeline;
+        std::unique_ptr<RenderDescriptorSet> compositeSet;
+        std::unique_ptr<RenderPipelineLayout> compositeLayout;
+        std::unique_ptr<RenderShader> fullScreenVS;
+        std::unique_ptr<RenderShader> compositePS;
+        std::unique_ptr<RenderPipeline> compositePipeline;
+        RenderFormat compositeFormat = RenderFormat::UNKNOWN;
+        RenderSampleCounts compositeSamples = RenderSampleCount::COUNT_0;
+        uint32_t compositeMode = UINT32_MAX;
+
+        // WCW_GPU_LOG=1: per-stage GPU timestamps (build, trace, resolve, composite) of each workload.
+        enum TimingStamp : uint32_t { StampBuildBegin, StampBuildEnd, StampTraceBegin, StampTraceEnd, StampResolveEnd, StampCompositeBegin, StampCompositeEnd, StampCount };
+        std::unique_ptr<RenderQueryPool> timingPool;
+        uint32_t timingWritten = 0;
+        uint32_t timingTriangles = 0;
+        uint32_t timingMeshes = 0;
+        uint32_t timingAlphaMeshes = 0;
+        uint32_t timingPixels = 0;
+        uint32_t timingTraceHeight = 0;
+        bool timingFullScreen = false;
+
+        // Runtime settings from the frontend's graphics menu. Quality: 0 Performance (half-res,
+        // 1 sample per light, 1 AO ray), 1 Balanced (half-res, 2/2), 2 Quality (full-res, 2/2).
+        // WCW_RT forces it on; WCW_RT_SCALE / WCW_RT_SAMPLES / WCW_RT_AO_SAMPLES override quality.
+        static void setUserSettings(bool enabled, uint32_t quality);
+        // True when ray tracing should run this frame (WCW_RT or the menu option). The camera
+        // hand-off in rt64_rsp.cpp follows it, so Off keeps the original rendering.
+        static bool active();
+        static uint32_t userQuality();
+
+        WcwRaytracer(RenderDevice *device, RenderShaderFormat shaderFormat);
+        void reset();
+        // Called before each workload is recorded. Workloads sharing a presentId belong to the
+        // same displayed frame; the slot is the workload's index within it.
+        void beginWorkload(uint64_t presentId);
+        bool wantsScene() const;
+        // Shadow mode drops the game's blob shadows (WCW_RT_KEEP_BLOBS=1 keeps them).
+        bool replacesBlobShadows() const;
+        void beginScene(const hlslpp::float4x4 &view, const hlslpp::float4x4 &proj, const RenderViewport &viewport,
+            const RenderBuffer *worldPosBuffer, uint64_t worldPosSize, const RenderBuffer *faceIndicesBuffer, uint64_t faceIndicesSize,
+            const RenderBuffer *rdpTilesBuffer, const RenderBuffer *gpuTilesBuffer, const RenderBuffer *texCoordBuffer);
+        // culled: the draw has N64 face culling on, so primary rays skip its back faces.
+        // character: a wrestler draw, shadowed with the weaker character strength.
+        // alphaTest: rays skip the draw's transparent texels (tileIndex, uvCorrection: its texture).
+        void addMesh(uint32_t faceIndicesStart, uint32_t triangleCount, uint32_t vertexCount, bool culled, bool character,
+            bool alphaTest, uint32_t tileIndex, bool uvCorrection);
+        // Grows the screen bounds with a world-space triangle (3 xyz positions) of a gathered draw.
+        void extendBounds(const float *positions);
+        void recordBuild(RenderWorker *worker);
+        // textureSet: the framebuffer renderer's bindless texture cache set (alpha tests).
+        void recordTrace(RenderWorker *worker, RenderTarget *colorTarget, RenderDescriptorSet *textureSet);
+        void recordComposite(RenderWorker *worker);
+        // After the workload's GPU work finished: accumulates and logs the stage timings (WCW_GPU_LOG).
+        void collectTimings();
+    };
+};
diff --git a/src/shaders/WcwRtCompositePS.hlsl b/src/shaders/WcwRtCompositePS.hlsl
new file mode 100644
index 0000000..334836e
--- /dev/null
+++ b/src/shaders/WcwRtCompositePS.hlsl
@@ -0,0 +1,26 @@
+//
+// RT64
+//
+
+// [wcw rt] Composites the hybrid ray tracing output onto the framebuffer's color target:
+// alpha blended for the debug views, multiplied for shadows (pipeline blend state).
+
+#include "shared/rt64_wcw_rt.h"
+
+[[vk::push_constant]] ConstantBuffer<WcwRtCompositeCB> gComposite : register(b0);
+Texture2D<float4> gRtOutput : register(t0);
+
+// The trace may run below the color target's resolution: bilinear upsample (soft shadows are
+// low frequency; no-hit texels carry factor 1 so edges just fade).
+float4 PSMain(in float4 pos : SV_Position, in float2 uv : TEXCOORD0) : SV_TARGET {
+    const float2 coord = pos.xy * gComposite.scale - 0.5f;
+    const int2 maxTexel = int2(gComposite.traceSize) - 1;
+    const int2 t0 = clamp(int2(floor(coord)), int2(0, 0), maxTexel);
+    const int2 t1 = clamp(t0 + 1, int2(0, 0), maxTexel);
+    const float2 f = saturate(coord - floor(coord));
+    const float4 a = gRtOutput.Load(int3(t0.x, t0.y, 0));
+    const float4 b = gRtOutput.Load(int3(t1.x, t0.y, 0));
+    const float4 c = gRtOutput.Load(int3(t0.x, t1.y, 0));
+    const float4 d = gRtOutput.Load(int3(t1.x, t1.y, 0));
+    return lerp(lerp(a, b, f.x), lerp(c, d, f.x), f.y);
+}
diff --git a/src/shaders/WcwRtResolveCS.hlsl b/src/shaders/WcwRtResolveCS.hlsl
new file mode 100644
index 0000000..7a32b71
--- /dev/null
+++ b/src/shaders/WcwRtResolveCS.hlsl
@@ -0,0 +1,88 @@
+//
+// RT64
+//
+
+// [wcw rt] Temporal resolve for the hybrid ray tracing shadows (D3D12 only).
+// The trace pass samples each area light once per pixel per frame; this pass reprojects the
+// pixel's world position into the previous frame of the same workload slot, clamps that
+// history to the current 3x3 neighborhood (limits ghosting on moving wrestlers) and blends.
+
+#include "shared/rt64_wcw_rt.h"
+
+ConstantBuffer<WcwRtParams> gParams : register(b0);
+Texture2D<float2> gCurrent : register(t1);
+Texture2D<float> gHistoryIn : register(t2);
+RWTexture2D<float> gHistoryOut : register(u3);
+RWTexture2D<float4> gOutput : register(u4);
+
+[numthreads(8, 8, 1)]
+void CSMain(uint2 dispatchPixel : SV_DispatchThreadID) {
+    const uint2 pixel = dispatchPixel + gParams.traceOffset;
+    if (any(pixel >= gParams.resolution)) {
+        return;
+    }
+
+    const float2 current = gCurrent[pixel];
+    if (current.y <= 0.0f) {
+        gHistoryOut[pixel] = 1.0f;
+        gOutput[pixel] = float4(1.0f, 1.0f, 1.0f, 0.0f);
+        return;
+    }
+
+    // Neighborhood range of this frame's samples (hit pixels only) and a depth-aware 3x3 tent
+    // filter of them: neighbors on the same surface (similar hit distance) are averaged, so a
+    // single jittered sample per light doesn't speckle penumbrae, while object edges stay sharp.
+    float filteredSum = 0.0f;
+    float filteredSqSum = 0.0f;
+    float weightSum = 0.0f;
+    for (int y = -1; y <= 1; y++) {
+        for (int x = -1; x <= 1; x++) {
+            const int2 neighbor = clamp(int2(pixel) + int2(x, y), int2(0, 0), int2(gParams.resolution) - 1);
+            const float2 sample = gCurrent[neighbor];
+            if (sample.y > 0.0f) {
+                const float spatial = ((x == 0) ? 2.0f : 1.0f) * ((y == 0) ? 2.0f : 1.0f);
+                const float depth = exp(-abs(sample.y - current.y) / max(current.y * 0.01f, 0.5f));
+                filteredSum += sample.x * spatial * depth;
+                filteredSqSum += sample.x * sample.x * spatial * depth;
+                weightSum += spatial * depth;
+            }
+        }
+    }
+
+    const float filtered = filteredSum / max(weightSum, 1e-4f);
+
+    // History is clipped to the same-surface neighborhood's mean +- spread (variance clipping).
+    // A min/max clamp of one or two noisy samples per light is so tight it rejects the history
+    // every frame and the penumbrae shimmer; the spread bound still drops history when the
+    // shadow really moves (a wrestler steps away).
+    const float variance = max(filteredSqSum / max(weightSum, 1e-4f) - filtered * filtered, 0.0f);
+    const float spread = 1.25f * sqrt(variance) + 0.04f;
+    const float minFactor = filtered - spread;
+    const float maxFactor = filtered + spread;
+
+    // Same primary ray as the trace pass, so the hit distance gives the world position.
+    const float2 local = ((float2(pixel) + 0.5f) / gParams.traceScale - gParams.viewport.xy) / gParams.viewport.zw;
+    const float2 ndc = float2(local.x * 2.0f - 1.0f, 1.0f - local.y * 2.0f);
+    const float4 nearPoint = mul(gParams.invViewProj, float4(ndc, -1.0f, 1.0f));
+    const float4 farPoint = mul(gParams.invViewProj, float4(ndc, 1.0f, 1.0f));
+    const float3 rayStart = nearPoint.xyz / nearPoint.w;
+    const float3 rayDir = normalize(farPoint.xyz / farPoint.w - rayStart);
+    const float3 worldPos = rayStart + rayDir * current.y;
+
+    float result = filtered;
+    if (gParams.historyValid != 0) {
+        const float4 prevClip = mul(gParams.prevViewProj, float4(worldPos, 1.0f));
+        if (prevClip.w > 0.0f) {
+            const float2 prevNdc = prevClip.xy / prevClip.w;
+            const float2 prevLocal = float2(prevNdc.x * 0.5f + 0.5f, 0.5f - prevNdc.y * 0.5f);
+            const float2 prevPixel = (gParams.viewport.xy + prevLocal * gParams.viewport.zw) * gParams.traceScale;
+            if (all(prevPixel >= 0.0f) && all(prevPixel < float2(gParams.resolution))) {
+                const float history = clamp(gHistoryIn[int2(prevPixel)], minFactor, maxFactor);
+                result = lerp(history, filtered, gParams.temporalAlpha);
+            }
+        }
+    }
+
+    gHistoryOut[pixel] = result;
+    gOutput[pixel] = float4(result, result, result, 1.0f);
+}
diff --git a/src/shaders/WcwRtTraceCS.hlsl b/src/shaders/WcwRtTraceCS.hlsl
new file mode 100644
index 0000000..3e04335
--- /dev/null
+++ b/src/shaders/WcwRtTraceCS.hlsl
@@ -0,0 +1,359 @@
+//
+// RT64
+//
+
+// [wcw rt] Hybrid ray tracing pass (D3D12 only, inline ray queries, cs_6_5).
+// Casts a primary ray from the game camera through every pixel of the traced projection's
+// viewport against the frame's world-space geometry, then either visualizes the hit
+// (debug modes) or traces a shadow ray toward the scene light (shadow mode).
+
+#include "shared/rt64_wcw_rt.h"
+#include "shared/rt64_f3d_defines.h"
+#include "shared/rt64_gpu_tile.h"
+#include "shared/rt64_rdp_tile.h"
+
+ConstantBuffer<WcwRtParams> gParams : register(b0);
+RaytracingAccelerationStructure gScene : register(t1);
+StructuredBuffer<float4> gWorldPos : register(t2);
+StructuredBuffer<uint> gFaceIndices : register(t3);
+StructuredBuffer<uint> gMeshIndexStarts : register(t4);
+RWTexture2D<float4> gOutput : register(u5);
+// Shadow mode: (shadow factor, primary hit distance; 0 = no hit) for the resolve pass.
+RWTexture2D<float2> gCurrent : register(u6);
+StructuredBuffer<RDPTile> gRDPTiles : register(t7);
+StructuredBuffer<GPUTile> gGPUTiles : register(t8);
+StructuredBuffer<float2> gTexCoords : register(t9);
+StructuredBuffer<uint> gMeshTiles : register(t10);
+// The framebuffer renderer's bindless RGBA texture cache.
+Texture2D<float4> gTextures[8192] : register(t0, space1);
+
+int moduloInt(int a, int b) {
+    return (b > 0) ? (a - b * int(floor(float(a) / float(b)))) : a;
+}
+
+// Texel alpha of an alpha-tested draw at a hit, point sampled with the same tile transform
+// and clamp/wrap/mirror rules as TextureSampler.hlsli. Tiles needing raw TMEM decoding are
+// treated as opaque.
+float hitAlpha(uint geometryIndex, uint primitiveIndex, float2 barycentrics) {
+    const uint tileWord = gMeshTiles[geometryIndex];
+    const uint base = (gMeshIndexStarts[geometryIndex] & ~WCW_RT_MESH_FLAGS) + primitiveIndex * 3;
+    const float2 uv0 = gTexCoords[gFaceIndices[base + 0]];
+    const float2 uv1 = gTexCoords[gFaceIndices[base + 1]];
+    const float2 uv2 = gTexCoords[gFaceIndices[base + 2]];
+    const float2 inputUV = uv0 * (1.0f - barycentrics.x - barycentrics.y) + uv1 * barycentrics.x + uv2 * barycentrics.y;
+
+    const uint tileIndex = tileWord & WCW_RT_TILE_INDEX_MASK;
+    const RDPTile rdpTile = gRDPTiles[tileIndex];
+    const GPUTile gpuTile = gGPUTiles[tileIndex];
+    if (gpuTileFlagRawTMEM(gpuTile.flags)) {
+        return 1.0f;
+    }
+
+    const float correction = ((tileWord & WCW_RT_TILE_UV_CORRECTION) != 0) ? 0.5f : 1.0f;
+    float2 uvCoord = inputUV * correction * float2(rdpTile.shifts, rdpTile.shiftt);
+    if (gpuTileFlagShiftedByHalf(gpuTile.flags)) {
+        uvCoord += float2(0.5f, 0.5f);
+    }
+
+    uvCoord *= gpuTile.tcScale;
+    uvCoord -= (float2(rdpTile.uls, rdpTile.ult) * gpuTile.ulScale) / 4.0f;
+    int2 texel = int2(floor(uvCoord));
+    const float2 tcScale = gpuTile.tcScale;
+    if (rdpTile.cms & G_TX_CLAMP) {
+        texel.x = clamp(texel.x, 0, int(round(tcScale.x * rdpTile.lrs) / 4 - round(tcScale.x * rdpTile.uls) / 4 + round(tcScale.x - 1.0f)));
+    }
+
+    if (rdpTile.cmt & G_TX_CLAMP) {
+        texel.y = clamp(texel.y, 0, int(round(tcScale.y * rdpTile.lrt) / 4 - round(tcScale.y * rdpTile.ult) / 4 + round(tcScale.y - 1.0f)));
+    }
+
+    const int masks = int(round(rdpTile.masks * tcScale.x));
+    if ((rdpTile.cms & G_TX_MIRROR) && (masks > 0) && (moduloInt(texel.x, masks * 2) >= masks)) {
+        texel.x = (masks - 1) - moduloInt(texel.x, masks);
+    }
+    else {
+        texel.x = moduloInt(texel.x, masks);
+    }
+
+    const int maskt = int(round(rdpTile.maskt * tcScale.y));
+    if ((rdpTile.cmt & G_TX_MIRROR) && (maskt > 0) && (moduloInt(texel.y, maskt * 2) >= maskt)) {
+        texel.y = (maskt - 1) - moduloInt(texel.y, maskt);
+    }
+    else {
+        texel.y = moduloInt(texel.y, maskt);
+    }
+
+    const int2 size = int2(gpuTile.textureDimensions.xy);
+    texel = clamp(texel, int2(0, 0), max(size - 1, int2(0, 0)));
+    return gTextures[NonUniformResourceIndex(gpuTile.textureIndex)].Load(int3(texel, 0)).a;
+}
+
+// Non-opaque candidates of this workload's alpha-tested draws only count where the texel is
+// solid; other workloads' geometry (instance ID > 0) has no bound texture data here.
+bool candidateIsSolid(uint instanceId, uint geometryIndex, uint primitiveIndex, float2 barycentrics) {
+    if ((instanceId != 0) || ((gMeshTiles[geometryIndex] & WCW_RT_TILE_ALPHA_TEST) == 0)) {
+        return true;
+    }
+
+    return hitAlpha(geometryIndex, primitiveIndex, barycentrics) >= 0.5f;
+}
+
+// Interleaved gradient noise, decorrelated per frame and per use.
+float noise(uint2 pixel, uint seed) {
+    const float2 p = float2(pixel) + float(seed) * 5.588238f;
+    return frac(52.9829189f * frac(0.06711056f * p.x + 0.00583715f * p.y));
+}
+
+bool resolvedMode() {
+    return (gParams.mode == WCW_RT_MODE_SHADOW) || (gParams.mode == WCW_RT_MODE_AO);
+}
+
+void writeNoHit(uint2 pixel) {
+    if (resolvedMode()) {
+        gCurrent[pixel] = float2(1.0f, 0.0f);
+    }
+    else {
+        gOutput[pixel] = float4(1.0f, 1.0f, 1.0f, 0.0f);
+    }
+}
+
+// Unnormalized: the winding (v0, v1, v2) is kept, which back-face culling relies on.
+float3 triangleCross(uint geometryIndex, uint primitiveIndex) {
+    const uint base = (gMeshIndexStarts[geometryIndex] & ~WCW_RT_MESH_FLAGS) + primitiveIndex * 3;
+    const float3 v0 = gWorldPos[gFaceIndices[base + 0]].xyz;
+    const float3 v1 = gWorldPos[gFaceIndices[base + 1]].xyz;
+    const float3 v2 = gWorldPos[gFaceIndices[base + 2]].xyz;
+    return cross(v1 - v0, v2 - v0);
+}
+
+float3 triangleNormal(uint geometryIndex, uint primitiveIndex) {
+    const uint base = (gMeshIndexStarts[geometryIndex] & ~WCW_RT_MESH_FLAGS) + primitiveIndex * 3;
+    const float3 v0 = gWorldPos[gFaceIndices[base + 0]].xyz;
+    const float3 v1 = gWorldPos[gFaceIndices[base + 1]].xyz;
+    const float3 v2 = gWorldPos[gFaceIndices[base + 2]].xyz;
+    const float3 n = cross(v1 - v0, v2 - v0);
+    const float len = length(n);
+    return (len > 1e-8f) ? (n / len) : float3(0.0f, 1.0f, 0.0f);
+}
+
+[numthreads(8, 8, 1)]
+void CSMain(uint2 dispatchPixel : SV_DispatchThreadID) {
+    const uint2 pixel = dispatchPixel + gParams.traceOffset;
+    if (any(pixel >= gParams.resolution)) {
+        return;
+    }
+
+    const float2 pixelCenter = (float2(pixel) + 0.5f) / gParams.traceScale;
+    const float2 local = (pixelCenter - gParams.viewport.xy) / gParams.viewport.zw;
+    if (any(local < 0.0f) || any(local > 1.0f)) {
+        writeNoHit(pixel);
+        return;
+    }
+
+    // Primary rays span the clip volume (N64 projections map near/far to NDC z -1/+1), so
+    // geometry the raster clips at the near plane (e.g. a wrestler right at the camera) is skipped.
+    const float2 ndc = float2(local.x * 2.0f - 1.0f, 1.0f - local.y * 2.0f);
+    const float4 nearPoint = mul(gParams.invViewProj, float4(ndc, -1.0f, 1.0f));
+    const float4 farPoint = mul(gParams.invViewProj, float4(ndc, 1.0f, 1.0f));
+    const float3 rayStart = nearPoint.xyz / nearPoint.w;
+    const float3 rayEnd = farPoint.xyz / farPoint.w;
+
+    RayDesc ray;
+    ray.Origin = rayStart;
+    ray.Direction = normalize(rayEnd - rayStart);
+    ray.TMin = 0.0f;
+    ray.TMax = length(rayEnd - rayStart);
+
+    // Culled draws are non-opaque: commit their candidates only when front-facing, matching
+    // the raster (N64 front faces wind counter-clockwise as seen from the camera).
+    // Primary rays only see this workload's geometry (instance mask 0x1); the other workloads'
+    // geometry (0x2) is drawn and shaded by their own passes but still casts shadows here.
+    RayQuery<RAY_FLAG_NONE> primary;
+    primary.TraceRayInline(gScene, RAY_FLAG_NONE, 0x1, ray);
+    while (primary.Proceed()) {
+        if (primary.CandidateType() == CANDIDATE_NON_OPAQUE_TRIANGLE) {
+            const uint geometryIndex = primary.CandidateGeometryIndex();
+            const uint primitiveIndex = primary.CandidatePrimitiveIndex();
+            const bool culled = (gMeshIndexStarts[geometryIndex] & WCW_RT_MESH_CULLED) != 0;
+            const float3 n = triangleCross(geometryIndex, primitiveIndex);
+            const bool facing = !culled || ((dot(n, ray.Direction) * gParams.cullSign) < 0.0f);
+            if (facing && candidateIsSolid(primary.CandidateInstanceID(), geometryIndex, primitiveIndex, primary.CandidateTriangleBarycentrics())) {
+                primary.CommitNonOpaqueTriangleHit();
+            }
+        }
+    }
+
+    if (primary.CommittedStatus() != COMMITTED_TRIANGLE_HIT) {
+        writeNoHit(pixel);
+        return;
+    }
+
+    const float hitT = primary.CommittedRayT();
+    float3 normal = triangleNormal(primary.CommittedGeometryIndex(), primary.CommittedPrimitiveIndex());
+    if (dot(normal, ray.Direction) > 0.0f) {
+        normal = -normal;
+    }
+
+    if (gParams.mode == WCW_RT_MODE_HIT_NORMAL) {
+        gOutput[pixel] = float4(normal * 0.5f + 0.5f, 0.75f);
+        return;
+    }
+    else if (gParams.mode == WCW_RT_MODE_HIT_MESH) {
+        const uint id = primary.CommittedGeometryIndex();
+        const float3 hue = frac(float(id) * float3(0.618034f, 0.414214f, 0.732051f));
+        gOutput[pixel] = float4(hue, 0.75f);
+        return;
+    }
+    else if (gParams.mode == WCW_RT_MODE_HIT_DEPTH) {
+        const float shade = frac(hitT / 200.0f);
+        gOutput[pixel] = float4(shade, shade, shade, 0.75f);
+        return;
+    }
+
+    const float3 hitPos = ray.Origin + ray.Direction * hitT;
+    if (gParams.mode == WCW_RT_MODE_HIT_POSITION) {
+        // R/B: 50-unit X/Z grid; G: height in 0..300.
+        const float2 grid = step(0.5f, frac(hitPos.xz / 50.0f));
+        gOutput[pixel] = float4(grid.x, saturate(hitPos.y / 300.0f), grid.y, 0.85f);
+        return;
+    }
+
+    if (gParams.mode == WCW_RT_MODE_SHADOW_DISTANCE) {
+        // Key light only, closest hit: red = hit distance / light distance, blue = unoccluded.
+        const float3 toLight = gParams.lightPosition.xyz - hitPos;
+        const float lightDist = length(toLight);
+        RayDesc probe;
+        probe.Origin = hitPos + normal * 0.5f;
+        probe.Direction = toLight / lightDist;
+        probe.TMin = 0.5f;
+        probe.TMax = lightDist;
+        RayQuery<RAY_FLAG_FORCE_OPAQUE> q;
+        q.TraceRayInline(gScene, RAY_FLAG_NONE, 0xFF, probe);
+        q.Proceed();
+        if (q.CommittedStatus() == COMMITTED_TRIANGLE_HIT) {
+            gOutput[pixel] = float4(saturate(q.CommittedRayT() / lightDist), 0.0f, 0.0f, 0.85f);
+        }
+        else {
+            gOutput[pixel] = float4(0.0f, 0.0f, 1.0f, 0.85f);
+        }
+
+        return;
+    }
+
+    // Outside the receiver radius (arena, crowd): no shadow or AO rays, faded out over its
+    // last 15% so the cutoff has no visible edge.
+    float receiverFade = 0.0f;
+    if (resolvedMode() && (gParams.receiverRadius > 0.0f)) {
+        const float receiverDist = length(hitPos.xz - gParams.lightPosition.xz);
+        if (receiverDist >= gParams.receiverRadius) {
+            gCurrent[pixel] = float2(1.0f, hitT);
+            return;
+        }
+
+        receiverFade = smoothstep(gParams.receiverRadius * 0.85f, gParams.receiverRadius, receiverDist);
+    }
+
+    const float2 lightOffsets[5] = { float2(0.0f, 0.0f), float2(-1.0f, -1.0f), float2(1.0f, -1.0f), float2(-1.0f, 1.0f), float2(1.0f, 1.0f) };
+    const uint fillCount = min(gParams.lightCount, 4);
+    const float keyWeight = (fillCount > 0) ? gParams.keyWeight : 1.0f;
+    const float fillWeight = (fillCount > 0) ? (1.0f - keyWeight) / float(fillCount) : 0.0f;
+    float lit = 0.0f;
+    int occluderId = -1;
+    const uint samples = max(gParams.samplesPerLight, 1);
+    for (uint i = 0; i < (fillCount + 1) * samples; i++) {
+        // Area light: jittered samples on the light's panel (soft penumbrae, refined over
+        // frames by the resolve pass).
+        const uint l = i / samples;
+        const uint seed = gParams.frameIndex * 64 + i * 2;
+        const float2 jitter = float2(noise(pixel, seed), noise(pixel + uint2(37, 113), seed + 1)) - 0.5f;
+        const float2 offset = lightOffsets[l] * gParams.lightSpread + jitter * gParams.lightSize;
+        const float weight = ((l == 0) ? keyWeight : fillWeight) / float(samples);
+        const float3 lightPos = gParams.lightPosition.xyz + float3(offset.x, 0.0f, offset.y);
+        const float3 toLight = lightPos - hitPos;
+        const float lightDist = length(toLight);
+
+        // Surfaces facing away from a light are already dark from N64 vertex lighting:
+        // only light-facing surfaces receive its shadow (no double darkening).
+        if (dot(normal, toLight) <= 0.0f) {
+            lit += weight;
+            continue;
+        }
+
+        RayDesc shadowRay;
+        shadowRay.Origin = hitPos + normal * 0.5f;
+        shadowRay.Direction = toLight / lightDist;
+        shadowRay.TMin = 0.5f;
+        shadowRay.TMax = lightDist;
+
+        RayQuery<RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH> shadow;
+        shadow.TraceRayInline(gScene, RAY_FLAG_NONE, 0xFF, shadowRay);
+        while (shadow.Proceed()) {
+            if (candidateIsSolid(shadow.CandidateInstanceID(), shadow.CandidateGeometryIndex(), shadow.CandidatePrimitiveIndex(), shadow.CandidateTriangleBarycentrics())) {
+                shadow.CommitNonOpaqueTriangleHit();
+            }
+        }
+
+        if (shadow.CommittedStatus() == COMMITTED_TRIANGLE_HIT) {
+            occluderId = int(shadow.CommittedGeometryIndex());
+        }
+        else {
+            lit += weight;
+        }
+    }
+
+    if (gParams.mode == WCW_RT_MODE_SHADOW_OCCLUDER) {
+        if (occluderId >= 0) {
+            gOutput[pixel] = float4(frac(float(occluderId) * float3(0.618034f, 0.414214f, 0.732051f)), 0.75f);
+        }
+        else {
+            gOutput[pixel] = float4(1.0f, 1.0f, 1.0f, 0.0f);
+        }
+
+        return;
+    }
+
+    const bool characterReceiver = (gMeshIndexStarts[primary.CommittedGeometryIndex()] & WCW_RT_MESH_CHARACTER) != 0;
+    const float strength = characterReceiver ? gParams.characterShadowStrength : gParams.shadowStrength;
+    float factor = 1.0f - strength * (1.0f - lit);
+
+    // Contact shadows: short cosine-weighted hemisphere rays against all workloads' geometry.
+    if (gParams.aoSamples > 0) {
+        const float3 helper = (abs(normal.y) < 0.99f) ? float3(0.0f, 1.0f, 0.0f) : float3(1.0f, 0.0f, 0.0f);
+        const float3 tangent = normalize(cross(helper, normal));
+        const float3 bitangent = cross(normal, tangent);
+        float occluded = 0.0f;
+        for (uint a = 0; a < gParams.aoSamples; a++) {
+            const uint seed = gParams.frameIndex * 64 + 40 + a * 2;
+            const float u = noise(pixel + uint2(71, 29), seed);
+            const float v = noise(pixel + uint2(13, 97), seed + 1);
+            const float r = sqrt(u);
+            const float phi = 6.2831853f * v;
+            const float3 dir = normalize(tangent * (r * cos(phi)) + bitangent * (r * sin(phi)) + normal * sqrt(max(1.0f - u, 0.0f)));
+
+            RayDesc aoRay;
+            aoRay.Origin = hitPos + normal * 0.5f;
+            aoRay.Direction = dir;
+            aoRay.TMin = 0.5f;
+            aoRay.TMax = gParams.aoRadius;
+            RayQuery<RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH> ao;
+            ao.TraceRayInline(gScene, RAY_FLAG_NONE, 0xFF, aoRay);
+            while (ao.Proceed()) {
+                if (candidateIsSolid(ao.CandidateInstanceID(), ao.CandidateGeometryIndex(), ao.CandidatePrimitiveIndex(), ao.CandidateTriangleBarycentrics())) {
+                    ao.CommitNonOpaqueTriangleHit();
+                }
+            }
+
+            if (ao.CommittedStatus() == COMMITTED_TRIANGLE_HIT) {
+                occluded += 1.0f;
+            }
+        }
+
+        const float aoStrength = gParams.aoStrength * (characterReceiver ? 0.5f : 1.0f);
+        const float aoFactor = 1.0f - aoStrength * (occluded / float(gParams.aoSamples));
+        factor = (gParams.mode == WCW_RT_MODE_AO) ? aoFactor : factor * aoFactor;
+    }
+
+    factor = lerp(factor, 1.0f, receiverFade);
+
+    gCurrent[pixel] = float2(factor, hitT);
+}
